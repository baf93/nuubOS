+	depends on SPL && MACH_SUN50I_H616
+	help
+	  Reproduce the H700 boot0 DRAM.ext GPIO selector and the vendor
+	  rank/width, geometry, training and final validation flow.  DEVICE=
+	  is deliberately not used to identify DRAM.
+
 config DRAM_TYPE
 	int "sunxi dram type"
 	depends on MACH_SUN8I_A83T
