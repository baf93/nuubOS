+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+static void h700_ddr3_set_timing_params_bank(const struct dram_para *para,
+					      uintptr_t bank_offset)
+{
+	struct sunxi_mctl_ctl_reg * const mctl_ctl =
+		(struct sunxi_mctl_ctl_reg *)(SUNXI_DRAM_CTL0_BASE + bank_offset);
+	struct sunxi_mctl_ctl_reg * const common_ctl =
+		(struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
+	u8 tfaw = ns_to_t(para, 50);
+	u8 trrd = max(ns_to_t(para, 10), 2);
+	u8 trcd = ns_to_t(para, 15);
+	u8 trc = ns_to_t(para, 53);
+	u8 txp = max(ns_to_t(para, 8), 2);
+	u8 trp = trcd;
+	u8 tras = ns_to_t(para, 38);
+	u16 trefi = ns_to_t(para, 7800) / 32;
+	u16 trfc = ns_to_t(para, 350);
+	u8 txs = ns_to_t(para, 360) / 32;
+	u8 tcksrx = ns_to_t(para, 10);
+	u8 tcksre = ns_to_t(para, 8);
+	u8 tcke = tcksrx <= 2 ? 6 : (tcksre < 2 ? 2 : tcksre);
+	u8 trasmax = (para->clk / 2) / 15;
+	bool high_speed = para->tpr2 & BIT(8);
+	u8 tcl = high_speed ? 5 : 7;
+	u8 tcwl = high_speed ? 4 : 5;
+	u8 dfi_tphy_wrlat = high_speed ? 4 : 6;
+	u8 dfi_trddata_en = high_speed ? 6 : 10;
+	u8 trtp = txp;
+	u8 twtp = tcl + tcwl + 2;
+	u8 twr2rd = txp + tcwl + 2;
+	u8 trd2wr = tcl + 3 - tcwl;
+	u16 mr0 = high_speed ? 0x1b50 : 0x1f14;
+	u16 mr2 = high_speed ? 0x0010 : 0x0020;
+	u32 dfitmg0;
+
+	/* boot0 0x269b4..0x26b76 raises tRTP only when this constraint wins. */
+	if (tcl + 1 >= txp + trp)
+		trtp = tcl + 2 - trp;
+
+	/* boot0 0x26534, type 3. */
+	writel((twtp << 24) | (tfaw << 16) | (trasmax << 8) | tras,
+	       &mctl_ctl->dramtmg[0]);
+	writel((txp << 16) | (trtp << 8) | trc, &mctl_ctl->dramtmg[1]);
+	writel((tcwl << 24) | (tcl << 16) | (trd2wr << 8) | twr2rd,
+	       &mctl_ctl->dramtmg[2]);
+	writel((4U << 12) | 12U, &mctl_ctl->dramtmg[3]);
+	writel((trcd << 24) | (2U << 16) | (trrd << 8) | trp,
+	       &mctl_ctl->dramtmg[4]);
