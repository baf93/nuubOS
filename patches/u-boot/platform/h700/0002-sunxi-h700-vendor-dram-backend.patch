+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+/*
+ * Dedicated H700 controller wrapper.
+ *
+ * This intentionally does not call the H616 controller orchestrator.
+ * The order mirrors the vendor boot0 call graph:
+ *
+ *   0x2779c wrapper
+ *     -> CLKEN / COM preparation
+ *     -> 0x27150 controller setup
+ *     -> 0x257ec PHY reset/preparation
+ *     -> 0x25818 PHY setup + 0x24ba8 DFI/MR init
+ *     -> 0x275f0 training
+ *     -> 0x26458 controller post
+ *
+ * Low-level helpers already proven register-equivalent are reused, but
+ * the H700 sequence is owned here so later clean-room replacements do not
+ * perturb the upstream H616 path.
+ */
+static bool h700_vendor_ctrl_init(const struct dram_para *para,
+				  const struct dram_config *config)
+{
+	struct sunxi_mctl_com_reg * const mctl_com =
+			(struct sunxi_mctl_com_reg *)SUNXI_DRAM_COM_BASE;
+	struct sunxi_mctl_ctl_reg * const mctl_ctl =
+			(struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
+	u32 reg_val;
+
+	/* boot0 0x2779c wrapper entry / 0x27150 preparation. */
+	clrsetbits_le32(&mctl_com->unk_0x500, BIT(24), 0x200);
+	writel(0x8000, &mctl_ctl->clken);
+	/* boot0 0x24a84(0xff): replace COM+0x08[15:8], do not only OR it. */
+	clrsetbits_le32(&mctl_com->unk_0x008, 0xff00, 0xff00);
+
+	if (para->type == SUNXI_DRAM_TYPE_LPDDR4)
+		writel(1, SUNXI_DRAM_COM_BASE + 0x50);
+	clrsetbits_le32(&mctl_ctl->sched[0], 0xff00, 0x3000);
+
+	/* boot0 0x2779c writes HWLPCTL before entering 0x27150. */
+	writel(0, &mctl_ctl->hwlpctl);
+
+	/* boot0 0x27150 begins with a second 0x24a84(0xff). */
+	clrsetbits_le32(&mctl_com->unk_0x008, 0xff00, 0xff00);
+
+	/* boot0 0x2710c: MSTR is built directly from the active para2. */
+	{
+		u32 para2 = h700_dram_runtime.current_para2;
+
+		reg_val = ((para2 & BIT(12)) ? 3U : 1U) << 24;
+		switch (para->type) {
+		case SUNXI_DRAM_TYPE_DDR3:
+			reg_val |= 0x00040001;
+			break;
+		case SUNXI_DRAM_TYPE_LPDDR3:
+			reg_val |= 0x00040008;
+			break;
+		case SUNXI_DRAM_TYPE_LPDDR4:
+			reg_val |= 0x00080020;
+			break;
+		default:
+			panic("H700 vendor backend: unsupported DRAM type\n");
+		}
+		if (para2 & BIT(0))
+			reg_val |= MSTR_BUSWIDTH_HALF;
+		writel(BIT(31) | BIT(30) | reg_val, &mctl_ctl->mstr);
+
+
+		/* boot0 0x270d8 is used by the selectable DDR3 profile. */
+		if (para->type == SUNXI_DRAM_TYPE_DDR3) {
+			if ((readl(&mctl_ctl->mstr) & BIT(11)) ||
+			    (para->tpr13 & BIT(5)))
+				clrbits_le32(&mctl_ctl->mstr, MSTR_2TMODE);
+			else
+				setbits_le32(&mctl_ctl->mstr, MSTR_2TMODE);
+		}
+
+		/* boot0 0x2703c: ODTMAP also consumes para2.bit12. */
+		writel((para2 & BIT(12)) ? 0x0303 : 0x0201,
+		       &mctl_ctl->odtmap);
+	}
+
+	switch (para->type) {
+	case SUNXI_DRAM_TYPE_DDR3:
+		reg_val = 0x06000400;
+		break;
+	case SUNXI_DRAM_TYPE_LPDDR3: {
+		u32 q = (7 * para->clk) / 2000;
+		u32 top = para->clk < 400 ? 3 : 4;
+
+		/* boot0 0x2709c derives LPDDR3 ODT from the active clock. */
+		reg_val = ((q + 7) << 24) | ((top - q) << 16) | 0x400;
+		break;
+	}
+	case SUNXI_DRAM_TYPE_LPDDR4:
+		reg_val = 0x04000400;
+		break;
+	default:
+		panic("H700 vendor backend: unsupported ODT type\n");
+	}
+	writel(reg_val, &mctl_ctl->odtcfg);
+	writel(reg_val, &mctl_ctl->unk_0x2240);
+	writel(reg_val, &mctl_ctl->unk_0x3240);
+	writel(reg_val, &mctl_ctl->unk_0x4240);
+
+	writel(BIT(31), &mctl_com->cr);
+
+	/* boot0 0x26e60 + 0x26534. */
+	mctl_set_addrmap(config);
+	mctl_set_timing_params(para);
+
+	/* boot0 0x27150 tail / 0x264f4 + 0x264a4. */
+	writel(0, &mctl_ctl->pwrctl);
+	setbits_le32(&mctl_ctl->dfiupd[0], BIT(31) | BIT(30));
+	setbits_le32(&mctl_ctl->zqctl[0], BIT(31) | BIT(30));
+	setbits_le32(&mctl_ctl->unk_0x2180, BIT(31) | BIT(30));
+	setbits_le32(&mctl_ctl->unk_0x3180, BIT(31) | BIT(30));
+	setbits_le32(&mctl_ctl->unk_0x4180, BIT(31) | BIT(30));
+
+	/* boot0 0x264dc: DBI enable is type/TPR13 dependent. */
+	if (para->type == SUNXI_DRAM_TYPE_LPDDR4 &&
+	    (h700_dram_runtime.current_tpr13 & BIT(29)))
+		setbits_le32(&mctl_ctl->dbictl, BIT(2));
+
+	/*
+	 * boot0 tail-calls 0x264a4 here. Keep the hardware transition order
+	 * literal: RFSHCTL3 first, then a second PWRCTL=0 write, then
+	 * DFIMISC/MAER, and finally an RMW setting PWRCTL.bit5.
+	 */
+	setbits_le32(&mctl_ctl->rfshctl3, BIT(0));
+	writel(0, &mctl_ctl->pwrctl);
+	clrbits_le32(&mctl_ctl->dfimisc, BIT(0));
+	writel(0, &mctl_com->maer0);
+	writel(0, &mctl_com->maer1);
+	writel(0, &mctl_com->maer2);
+	setbits_le32(&mctl_ctl->pwrctl, BIT(5));
+
+	/* boot0 0x257ec PHY reset/preparation. */
+	clrsetbits_le32(&mctl_com->unk_0x500, BIT(24), 0x300);
+	udelay(1);
+	setbits_le32(&mctl_com->unk_0x500, BIT(24));
+	udelay(1);
+
+	/* boot0 0x25818 gates the H700 PHY calibration path first. */
+	clrbits_le32((void *)0x070001f4UL, BIT(0));
+
+	/*
+	 * mctl_phy_init() still supplies the proven-equivalent low-level PHY
+	 * programming/training helpers. Its H700 hooks reproduce 0x25818,
+	 * 0x24ba8 and the 0x275f0 training semantics. A following patch will
+	 * split those helpers into H700-named functions as well; importantly,
+	 * controller orchestration no longer flows through H616 here.
+	 */
+	{
+		bool phy_ok = mctl_phy_init(para, config);
+
+		/* boot0 0x26458 controller post runs regardless of PHY result. */
+	writel(0, &mctl_ctl->swctl);
+	clrbits_le32(&mctl_ctl->rfshctl3, BIT(0));
+	setbits_le32(&mctl_com->unk_0x014, BIT(31));
+	writel(0xffffffff, &mctl_com->maer0);
+	writel(0x7ff, &mctl_com->maer1);
+	writel(0xffff, &mctl_com->maer2);
+	writel(1, &mctl_ctl->swctl);
+	mctl_await_completion(&mctl_ctl->swstat, 1, 1);
+
+		return phy_ok;
+	}
+}
