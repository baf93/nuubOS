+/*
+ * Dedicated translation of vendor boot0 training orchestrator 0x275f0.
+ *
+ * Low-level training primitives are still shared with the H616 file,
+ * but H700 owns stage ordering, local retry count, error aggregation and
+ * the "skip read/write training after failed read calibration" rule.
+ */
+static bool h700_vendor_training(const struct dram_para *para,
+				 const struct dram_config *config)
+{
+	unsigned int attempts = (para->tpr10 & TPR10_TRAINING_RETRY) ? 5 : 1;
+	unsigned int errors = 0;
+	unsigned int i;
+	bool result = true;
+
+	if (para->tpr10 & TPR10_WRITE_LEVELING) {
+		for (i = 0; i < attempts; i++) {
+			result = h700_vendor_write_leveling(para);
+			if (result)
+				break;
+		}
+		if (!result)
+			errors |= BIT(0);
+	}
+
+	if (para->tpr10 & TPR10_READ_CALIBRATION) {
+		for (i = 0; i < attempts; i++) {
+			result = h700_vendor_read_calibration(para);
+			if (result)
+				break;
+		}
+		if (!result)
+			errors |= BIT(1);
+	}
+
+	if ((para->tpr10 & TPR10_READ_TRAINING) && !(errors & BIT(1))) {
+		for (i = 0; i < attempts; i++) {
+			result = mctl_phy_read_training(para, config);
+			if (result)
+				break;
+		}
+		if (!result)
+			errors |= BIT(2);
+	}
+
+	if ((para->tpr10 & TPR10_WRITE_TRAINING) && !(errors & BIT(1))) {
+		for (i = 0; i < attempts; i++) {
+			result = mctl_phy_write_training(para, config);
