+static bool h616_mctl_phy_write_leveling(const struct dram_para *para,
+					 const struct dram_config *config)
 {
 	bool result = true;
 	u32 val;
@@ -324,8 +405,11 @@ static bool mctl_phy_write_leveling(const struct dram_para *para,
 	clrsetbits_le32(SUNXI_DRAM_PHY0_BASE + 8, 0xc0, 0x80);
 
 	if (para->type == SUNXI_DRAM_TYPE_LPDDR4) {
