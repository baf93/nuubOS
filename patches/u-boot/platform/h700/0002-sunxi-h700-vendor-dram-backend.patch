 		writel(4, SUNXI_DRAM_PHY0_BASE + 0xc);
@@ -333,14 +417,8 @@ static bool mctl_phy_write_leveling(const struct dram_para *para,
 	}
 
 	setbits_le32(SUNXI_DRAM_PHY0_BASE + 8, 4);
-
-	if (config->bus_full_width)
-		val = 0xf;
-	else
-		val = 3;
-
