+ * For each of the 16 base pattern words, boot0 alternates the probe:
+ * boot0 0x272dc group probe: compare all 16 words at +0x40 first;
+ * only after a mismatch perform a second complete pass at +0x80.
+ */
+static u8 h700_vendor_probe_groups(const struct dram_para *work)
+{
+	volatile u32 *base = (volatile u32 *)CFG_SYS_SDRAM_BASE;
+	unsigned int i;
+
+	/* boot0 first tests all 16 pattern words at +0x40. */
+	for (i = 0; i < 16; i++) {
+		u32 address = CFG_SYS_SDRAM_BASE + i * sizeof(u32);
+		u32 expected = (i & 1) ? address : ~address;
+
+		if (base[0x40 / sizeof(u32) + i] != expected)
+			break;
+	}
+	if (i == 16)
+		return 1;
+
+	/* A +0x40 mismatch causes a complete second pass at +0x80. */
+	for (i = 0; i < 16; i++) {
+		u32 address = CFG_SYS_SDRAM_BASE + i * sizeof(u32);
+		u32 expected = (i & 1) ? address : ~address;
+
+		if (base[0x80 / sizeof(u32) + i] != expected)
+			break;
+	}
+
+	/* boot0 selects 2 for type 4 (DDR4), 0 for all other types. */
+	return work->type == SUNXI_DRAM_TYPE_DDR4 ? 2 : 0;
+}
+
+/* boot0 0x27484: rank/width scan used by the internal DST autoscan. */
+static bool h700_vendor_rank_width_scan(struct dram_para *work,
+					struct dram_config *config)
+{
+	static const u16 candidate[] = { 0x1000, 0x0000, 0x1001, 0x0001 };
+	u32 saved_tpr10 = work->tpr10;
+	u32 saved_tpr13 = h700_dram_runtime.current_tpr13;
+	u32 saved_para1 = h700_dram_runtime.current_para1;
+	u32 saved_para2 = h700_dram_runtime.current_para2;
+	unsigned int i;
+
+	work->tpr10 |= BIT(28);
+	h700_dram_runtime.current_tpr13 |= BIT(0);
+	h700_dram_runtime.current_para1 =
+		work->type == SUNXI_DRAM_TYPE_DDR4 ? 0x000060b7 : 0x000020b7;
+
+	for (i = 0; i < ARRAY_SIZE(candidate); i++) {
+		h700_dram_runtime.current_para2 = candidate[i];
+		if (!h700_vendor_decode_config(h700_dram_runtime.current_para1,
+					       h700_dram_runtime.current_para2,
+					       config))
+			continue;
+
+		if (mctl_core_init(work, config)) {
+			u32 found_para2 = h700_dram_runtime.current_para2;
+
+			/*
+			 * boot0 0x274c0..0x274d2 restores the temporary
+			 * rank-scan state before returning success.  Only the
+			 * discovered low 16 bits of para2 survive the scan.
+			 */
+			h700_dram_runtime.current_tpr13 = saved_tpr13;
+			h700_dram_runtime.current_para1 = saved_para1;
+			h700_dram_runtime.current_para2 =
+				(saved_para2 & 0xffff0000U) | (found_para2 & 0xffffU);
+			work->tpr10 = saved_tpr10;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+/* boot0 0x272dc: alias-based column/bank/row scan. */
+static bool h700_vendor_size_scan(struct dram_para *work,
+				  struct dram_config *config)
+{
+	u32 saved_tpr10 = work->tpr10;
+	int rank_factor, temp_groups, col, banks, row;
+	int base_exp;
+	u8 groups;
+
+	work->tpr10 |= BIT(28);
+	h700_dram_runtime.current_para1 =
+		work->type == SUNXI_DRAM_TYPE_DDR4 ? 0x0000b0eb : 0x000030eb;
+	rank_factor = (h700_dram_runtime.current_para2 & 0xf) ? 1 : 2;
+	if (!h700_vendor_decode_config(h700_dram_runtime.current_para1,
+				       h700_dram_runtime.current_para2, config) ||
+	    !mctl_core_init(work, config))
+		return false;
+
+	h700_vendor_write_alias_pattern();
+	groups = h700_vendor_probe_groups(work);
+
+	temp_groups = (h700_dram_runtime.current_para1 >> 14) & 0x3;
+	base_exp = temp_groups + rank_factor;
+	for (col = 7; col <= 10; col++) {
+		if (h700_vendor_aliases(1UL << (base_exp + col)))
+			break;
+	}
+	if (col > 10)
+		col = 11;
+
+	banks = h700_vendor_aliases(1UL << (base_exp + 13)) ? 2 : 3;
+
+	h700_dram_runtime.current_para1 =
+		work->type == SUNXI_DRAM_TYPE_DDR4 ? 0x00006118 : 0x00002118;
+	if (!h700_vendor_decode_config(h700_dram_runtime.current_para1,
+				       h700_dram_runtime.current_para2, config) ||
+	    !mctl_core_init(work, config))
+		return false;
+
+	h700_vendor_write_alias_pattern();
+	temp_groups = (h700_dram_runtime.current_para1 >> 14) & 0x3;
+	base_exp = temp_groups + 10 + rank_factor;
+	for (row = 12; row <= 16; row++) {
+		if (h700_vendor_aliases(1UL << (base_exp + row)))
+			break;
+	}
+	if (row > 16)
+		row = 17;
+
+	h700_dram_runtime.current_para1 = (u32)col | ((u32)row << 4) |
+					 ((u32)banks << 12) |
+					 ((u32)groups << 14);
+	work->tpr10 = saved_tpr10;
+
+	return h700_vendor_decode_config(h700_dram_runtime.current_para1,
+					 h700_dram_runtime.current_para2,
+					 config);
+}
+
+static unsigned int h700_vendor_size_mib(void);
+
+/* boot0 0x2751c autoscan. */
+static bool h700_vendor_autoscan(struct dram_para *work,
+				 struct dram_config *config)
+{
+	u32 tpr13 = h700_dram_runtime.current_tpr13;
+	unsigned int size_mib;
+
+	if (!(tpr13 & BIT(14)) && !h700_vendor_rank_width_scan(work, config))
+		return false;
+	if (!h700_vendor_size_scan(work, config))
+		return false;
+
+	if (!(h700_dram_runtime.current_tpr13 & BIT(15)))
+		h700_dram_runtime.current_tpr13 |= 0x00006001;
+
+	/* boot0 0x27556..0x275e6: optional high-address geometry probe. */
+	if (!(h700_dram_runtime.current_tpr13 & BIT(19)))
+		return true;
+
+	if (!mctl_core_init(work, config))
+		return false;
+
+	size_mib = h700_vendor_size_mib();
+	h700_dram_runtime.current_tpr13 &= ~BIT(19);
+
+	if (size_mib == 4096) {
+		volatile u32 *probe = (volatile u32 *)(uintptr_t)0xa0000000UL;
+
+		*probe = 0xa0a0a0a0;
+		asm volatile("dsb sy" ::: "memory");
+		if (*probe != 0xa0a0a0a0)
+			h700_dram_runtime.current_tpr13 |= BIT(16);
+	} else if (size_mib == 2048) {
+		volatile u32 *probe700 = (volatile u32 *)(uintptr_t)0x70000000UL;
+		volatile u32 *probe800 = (volatile u32 *)(uintptr_t)0x80000000UL;
+		volatile u32 *probea00 = (volatile u32 *)(uintptr_t)0xa0000000UL;
+
+		*probe700 = 0x70707070;
+		asm volatile("dsb sy" ::: "memory");
+		if (*probe700 != 0x70707070) {
+			h700_dram_runtime.current_tpr13 |= BIT(17);
+		} else {
+			*probea00 = 0xa0a0a0a0;
+			*probe800 = 0x80808080;
+			udelay(1);
+			if (*probea00 != 0xa0a0a0a0)
+				h700_dram_runtime.current_tpr13 |= BIT(16) | BIT(18);
+		}
+	}
+
+	return true;
+}
+
+static bool h700_vendor_config(struct dram_config *config)
+{
+	h700_vendor_select_raw(para.para1, para.para2, para.tpr13, config);
+
+	return config->cols && config->rows;
+}
+
+/*
+ * H700 boot0 performs validator memory operations through VFP/NEON bulk
+ * transfers. Keep the validator policy and pattern generation in C, while
+ * the H700-only assembly helpers reproduce the bulk memory semantics.
+ */
+void h700_vendor_fill(volatile u32 *start, unsigned int bytes,
+		      u32 first, u32 second);
+void h700_vendor_copy(volatile u32 *src, volatile u32 *dst,
+		      unsigned int bytes);
+u32 h700_vendor_compare(volatile u32 *a, volatile u32 *b,
+			unsigned int bytes);
+
+static bool h700_vendor_compare_pass(volatile u32 *a, volatile u32 *b,
+				     unsigned int bytes,
+				     unsigned int lane, bool full)
+{
+	u32 mismatch = h700_vendor_compare(a, b, bytes);
+
+	if (full)
+		return mismatch == 0;
+
+	return !((mismatch >> (lane * 8)) & 0xff);
+}
+
+/* Clean-room translation of boot0 helper 0x236d8. */
+static bool h700_vendor_validate(u32 half_size, unsigned int bytes,
+				 unsigned int lane, bool full)
+{
+	static const u32 seeds[] = {
+		0xffffffff, 0x0000ffff, 0x00ff00ff,
+		0x0f0f0f0f, 0x5a5a5a5a, 0x55555555,
+	};
+	volatile u32 *base = (volatile u32 *)CFG_SYS_SDRAM_BASE;
+	volatile u32 *copy = (volatile u32 *)(uintptr_t)(CFG_SYS_SDRAM_BASE +
+						 half_size + 8);
+	volatile u32 *mirror = (volatile u32 *)(uintptr_t)(CFG_SYS_SDRAM_BASE +
+						   half_size / 2 + 12);
+	unsigned int first_bit, last_bit, normalized_lane = lane;
+	unsigned int i, bit, phase;
+
+	if (lane >= 4 && lane <= 7)
+		normalized_lane = lane - 4;
+	else if (lane == 8)
+		normalized_lane = 0;
+	else if (lane > 8)
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(seeds); i++) {
+		h700_vendor_fill(mirror, bytes, ~seeds[i], seeds[i]);
+		h700_vendor_fill(base, bytes, ~seeds[i], seeds[i]);
+		h700_vendor_copy(base, copy, bytes);
+		if (!h700_vendor_compare_pass(copy, mirror, bytes,
+					      normalized_lane, full))
+			return false;
+	}
+
+	first_bit = normalized_lane * 8;
+	last_bit = first_bit + 8;
+	if (lane == 8)
+		last_bit += 24;
+
+	for (bit = first_bit; bit < last_bit; bit++) {
+		u32 value = BIT(bit);
+
+		h700_vendor_fill(mirror, bytes, ~value, value);
+		h700_vendor_fill(base, bytes, ~value, value);
+		h700_vendor_copy(base, copy, bytes);
+		if (!h700_vendor_compare_pass(copy, mirror, bytes,
+					      normalized_lane, full))
+			return false;
+	}
+
+	for (phase = 0; phase < 2; phase++) {
+		for (bit = first_bit; bit < last_bit; bit++) {
+			u32 value = BIT(bit);
+			u32 first = phase ? 0xffffffff : ~value;
+			u32 second = phase ? value : 0;
+
+			h700_vendor_fill(mirror, bytes, first, second);
+			h700_vendor_fill(base, bytes, first, second);
+			h700_vendor_copy(base, copy, bytes);
+			if (!h700_vendor_compare_pass(copy, mirror, bytes,
+						      normalized_lane, full))
+				return false;
+		}
+	}
+
+	return true;
+}
+
+/* boot0 0x23864 matrix pattern and byte-lane reduction. */
+static void h700_vendor_prepare_matrix(u32 half_size)
+{
+	volatile u32 *base = (volatile u32 *)CFG_SYS_SDRAM_BASE;
+	volatile u32 *mirror = (volatile u32 *)(uintptr_t)(CFG_SYS_SDRAM_BASE +
+						   half_size + 12);
+	u32 index = 0;
+	unsigned int i;
+
+	for (i = 0; i < H700_VENDOR_MATRIX_WORDS; i++) {
+		base[i] = index + 0x01234567;
+		mirror[i] = index + 0xfedcba98;
+		index += 0x01010101;
+	}
+	dmb();
+}
+
+static bool h700_vendor_matrix_test(u32 half_size, unsigned int lane)
+{
+	volatile u32 *base = (volatile u32 *)CFG_SYS_SDRAM_BASE;
+	volatile u32 *mirror = (volatile u32 *)(uintptr_t)(CFG_SYS_SDRAM_BASE +
+						   half_size + 12);
+	u32 index = 0;
+	u32 mismatch = 0;
+	unsigned int i;
+
+	for (i = 0; i < H700_VENDOR_MATRIX_WORDS; i++) {
+		mismatch |= base[i] ^ (index + 0x01234567);
+		mismatch |= mirror[i] ^ (index + 0xfedcba98);
+		index += 0x01010101;
+	}
+
+	return !((mismatch >> (lane * 8)) & 0xff);
+}
+
+static bool h700_vendor_bootstrap(const struct dram_para *nominal,
+				  struct dram_para *work,
+				  struct dram_config *config,
+				  u32 *half_size)
+{
+	static const u16 odt_seed[] = { 0x8888, 0xaaaa, 0xcccc, 0xeeee };
+	u32 nominal_odt = nominal->odt_en;
+	u32 nominal_tpr6 = nominal->tpr6;
+	u32 nominal_tpr10 = nominal->tpr10;
+	unsigned int i;
+
+	*work = *nominal;
+	work->clk = H700_VENDOR_BOOTSTRAP_CLK;
+	work->tpr10 &= 0xffff0000;
+	work->tpr11 = work->type == SUNXI_DRAM_TYPE_LPDDR4 ? 0x10101010 : 0;
+	work->tpr12 = 0;
+
+	for (i = 0; i < ARRAY_SIZE(odt_seed); i++) {
+		bool initial_ok, auto_ok = true, second_ok = true;
+		unsigned int size_mib;
+
+		work->odt_en = odt_seed[i];
+		initial_ok = mctl_core_init(work, config);
+
+		if (!(h700_dram_runtime.current_tpr13 & BIT(0))) {
+			auto_ok = h700_vendor_autoscan(work, config);
+			/* boot0 executes this second core-init regardless of autoscan result. */
+			second_ok = mctl_core_init(work, config);
+		}
+
+		size_mib = h700_vendor_size_mib();
+		if (!size_mib)
+			continue;
+		*half_size = (size_mib / 2) << 20;
+
+		if (initial_ok && auto_ok && second_ok &&
+		    h700_vendor_validate(*half_size, 0x8000, 8, true)) {
+			work->clk = nominal->clk;
+			work->odt_en = nominal_odt;
+			work->tpr6 = nominal_tpr6;
+			work->tpr10 = nominal_tpr10;
+			return true;
+		}
+
+		/* boot0 retries by adding 0x2222 to the current ODT seed. */
+	}
+
+	return false;
+}
+
+static unsigned int h700_vendor_r2d_offset(unsigned int tpr6,
+					       unsigned int delay)
+{
+	/*
+	 * boot0 indexes its 0x800-byte scratch area as
+	 *   scratch[(tpr6 >> 2) * 32 + delay]
+	 * even though delay spans 0..62.  Adjacent TPR6 rows therefore
+	 * overlap by 31 bytes.  Preserve that layout exactly: it affects
+	 * the subsequent eye-selection scans and is not a conventional
+	 * row-major matrix.
+	 */
+	return (tpr6 >> 2) * 32 + delay;
+}
+
+static u8 h700_vendor_r2d_cell(const u8 workspace[H700_VENDOR_R2D_WORKSPACE],
+				    unsigned int tpr6, unsigned int delay)
+{
+	return workspace[h700_vendor_r2d_offset(tpr6, delay)];
+}
+
+/*
+ * Clean-room translation of the LPDDR4 R_2d branch in boot0 0x238b4.
+ * For the 32-bit H700 target boot0 tunes TPR6 byte 3 and TPR12 byte 2.
+ * The scratch-buffer aliasing and both vendor eye-selection scans are
+ * deliberately retained instead of normalising them into a clean matrix.
+ */
+static bool h700_vendor_r2d(struct dram_para *work,
+			    const struct dram_config *config, u32 half_size,
+			    struct h700_vendor_r2d_result *result)
+{
+	u8 workspace[H700_VENDOR_R2D_WORKSPACE];
+	u8 horizontal[H700_VENDOR_TPR6_BUCKETS];
+	int best_start = 0, best_end = 0, best_delay = 0;
+	int best_span = 0;
+	int tpr6, delay;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(workspace); i++)
+		workspace[i] = 0;
+	for (i = 0; i < ARRAY_SIZE(horizontal); i++)
+		horizontal[i] = 0;
+
+	for (tpr6 = H700_VENDOR_TPR6_FIRST;
+	     tpr6 <= H700_VENDOR_TPR6_LAST;
+	     tpr6 += H700_VENDOR_TPR6_STEP) {
+		struct dram_para candidate = *work;
+
+		candidate.tpr6 = h700_set_tpr6_byte(candidate.tpr6, 3, tpr6);
+		if (!mctl_core_init(&candidate, config))
+			continue;
+
+		for (delay = 0; delay < H700_VENDOR_R2D_DELAYS; delay++) {
+			unsigned int offset = h700_vendor_r2d_offset(tpr6, delay);
+
+			candidate.tpr12 = h700_set_delay_lane(candidate.tpr12, 2,
+							 delay);
+			mctl_phy_bit_delay_compensation(&candidate);
+			workspace[offset] = h700_vendor_matrix_test(half_size, 2) ? 1 : 0;
+		}
+	}
+
+	/*
+	 * First boot0 scan: delay 62..0, TPR6 high..low.  Pick the widest
+	 * contiguous vertical run.  The measured span is in raw TPR6 units
+	 * (end - start + 1), exactly as in boot0; <= 11 is rejected.
+	 */
+	for (delay = H700_VENDOR_R2D_DELAYS - 1; delay >= 0; delay--) {
+		int run_end = -1;
+
+		for (tpr6 = H700_VENDOR_TPR6_LAST;
+		     tpr6 >= H700_VENDOR_TPR6_FIRST;
+		     tpr6 -= H700_VENDOR_TPR6_STEP) {
+			if (h700_vendor_r2d_cell(workspace, tpr6, delay) == 1) {
+				if (run_end < 0)
+					run_end = tpr6;
+				continue;
+			}
+
+			if (run_end >= 0) {
+				int run_start = tpr6 + H700_VENDOR_TPR6_STEP;
+				int span = run_end - run_start + 1;
+
+				if (span > best_span) {
+					best_span = span;
+					best_start = run_start;
+					best_end = run_end;
+					best_delay = delay;
+				}
+				run_end = -1;
+			}
+		}
+
+		if (run_end >= 0) {
+			int span = run_end - H700_VENDOR_TPR6_FIRST + 1;
+
+			if (span > best_span) {
+				best_span = span;
+				best_start = H700_VENDOR_TPR6_FIRST;
+				best_end = run_end;
+				best_delay = delay;
+			}
+		}
+	}
+
+	if (best_span <= 11)
+		return false;
+
+	/*
+	 * Second boot0 scan.  Count the contiguous horizontal eye through
+	 * best_delay for each TPR6 value in the selected vertical run.  The
+	 * count array is indexed by (tpr6 >> 2), just like the vendor stack.
+	 */
+	for (tpr6 = best_start; tpr6 <= best_end;
+	     tpr6 += H700_VENDOR_TPR6_STEP) {
+		unsigned int bucket = tpr6 >> 2;
+		int pos;
+
+		for (pos = best_delay; pos >= 0; pos--) {
+			u8 cell = h700_vendor_r2d_cell(workspace, tpr6, pos);
+
+			if (cell == 1)
+				horizontal[bucket]++;
+			else if (cell == 0)
+				break;
+		}
+		for (pos = best_delay + 1;
+		     pos < H700_VENDOR_R2D_DELAYS; pos++) {
+			u8 cell = h700_vendor_r2d_cell(workspace, tpr6, pos);
+
+			if (cell == 1)
+				horizontal[bucket]++;
+			else if (cell == 0)
+				break;
+		}
+	}
+
+	{
+		int best_tpr6 = best_start;
+		int left, right;
+		u8 best_width = horizontal[best_tpr6 >> 2];
+
+		for (tpr6 = best_start; tpr6 <= best_end;
+		     tpr6 += H700_VENDOR_TPR6_STEP) {
+			u8 width = horizontal[tpr6 >> 2];
+
+			if (width > best_width) {
+				best_width = width;
+				best_tpr6 = tpr6;
+			}
+		}
+
+		left = best_tpr6;
+		while (left - H700_VENDOR_TPR6_STEP >= best_start &&
+		       horizontal[(left - H700_VENDOR_TPR6_STEP) >> 2] + 3 >=
+		       best_width)
+			left -= H700_VENDOR_TPR6_STEP;
+
+		right = best_tpr6;
+		while (right + H700_VENDOR_TPR6_STEP <= best_end &&
+		       horizontal[(right + H700_VENDOR_TPR6_STEP) >> 2] + 1 >=
+		       best_width)
+			right += H700_VENDOR_TPR6_STEP;
+
+		result->start = best_start;
+		result->end = best_end;
+		result->delay = best_delay;
+		result->center = (left + right) / 2;
+	}
+
+	work->tpr6 = h700_set_tpr6_byte(work->tpr6, 3, result->center);
+	return mctl_core_init(work, config);
+}
+
+static bool h700_vendor_lane_test(struct dram_para *work, u32 half_size,
+				 unsigned int lane, bool write, u8 delay)
+{
+	u32 *value = write ? &work->tpr11 : &work->tpr12;
+
+	*value = h700_set_delay_lane(*value, lane, delay);
+	mctl_phy_bit_delay_compensation(work);
+
+	return write ? h700_vendor_validate(half_size, 0x1000, lane, false) :
+		h700_vendor_matrix_test(half_size, lane);
+}
+
+/*
+ * R_1st/W_2st share the same boot0 edge policy.  This is intentionally
+ * streamed instead of first collecting a 64-entry pass array:
+ *
+ * - windows <= 3 codes are discarded as fake and scanning continues;
+ * - a window starting at zero raises the corresponding ODT nibble and
+ *   restarts at delay zero;
+ * - a window reaching 63 lowers ODT, shifts the saved start by two and
+ *   resumes at delay 61 (boot0 sets loop delay to 60, then increments).
+ */
+static bool h700_vendor_sweep_lane(struct dram_para *work, u32 half_size,
+				   unsigned int lane, bool write,
+				   u8 min_window,
+				   struct h700_vendor_window *window)
+{
+	unsigned int odt_nibble = write ? lane + 4 : lane;
+	u8 original_odt = h700_get_odt_nibble(work->odt_en, odt_nibble);
+	u8 adjusted_odt = original_odt;
+	int delay = 0;
+	int start = -1;
+	int end = -1;
+	bool in_window = false;
+
+	while (delay < 64) {
+		bool pass = h700_vendor_lane_test(work, half_size, lane, write,
+						 delay);
+
+		if (pass) {
+			if (!in_window) {
+				start = delay;
+				in_window = true;
+
+				if (delay == 0 && adjusted_odt <= 0xd) {
+					adjusted_odt++;
+					work->odt_en = h700_set_odt_nibble(
+						work->odt_en, odt_nibble, adjusted_odt);
+					start = -1;
+					in_window = false;
+					delay = 0;
+					continue;
+				}
+			}
+
+			if (delay == 63) {
+				end = 63;
+				if (adjusted_odt > 1 && start > 2) {
+					adjusted_odt--;
+					work->odt_en = h700_set_odt_nibble(
+						work->odt_en, odt_nibble, adjusted_odt);
+					start -= 2;
+					/* boot0 stores end=61 and resumes at 61. */
+					end = 61;
+					delay = 61;
+					continue;
+				}
+				break;
+			}
+
+			delay++;
+			continue;
+		}
+
+		if (in_window) {
+			end = delay - 1;
+			if (end - start > 2)
+				break;
+
+			/* Fake eye: resume after this failure looking for another run. */
+			start = -1;
+			end = -1;
+			in_window = false;
+		}
+		delay++;
+	}
+
+	if (start < 0 || end < start)
+		return false;
+
+	window->start = start;
+	window->end = end;
+	window->width = end - start + 1;
+	window->odt = adjusted_odt;
+	if (window->width < min_window)
+		return false;
+
+	{
+		int center = (start + end) / 2 -
+			2 * ((int)adjusted_odt - original_odt);
+
+		center &= 0x3f;
+		window->center = center;
+		if (write)
+			work->tpr11 = h700_set_delay_lane(work->tpr11, lane, center);
+		else
+			work->tpr12 = h700_set_delay_lane(work->tpr12, lane, center);
+		mctl_phy_bit_delay_compensation(work);
+	}
+
+	return true;
+}
+
+static bool h700_vendor_r1st(struct dram_para *work, u32 half_size,
+			     u8 min_window,
+			     struct h700_vendor_window window[H700_VENDOR_LANES])
+{
+	u32 original_odt = work->odt_en;
+	unsigned int lane;
+
+	for (lane = 0; lane < H700_VENDOR_LANES; lane++) {
+		if (!h700_vendor_sweep_lane(work, half_size, lane, false,
+					    min_window, &window[lane]))
+			return false;
+	}
+	work->odt_en = original_odt;
+
+	return true;
+}
+
+static bool h700_vendor_w2st(struct dram_para *work, u32 half_size,
+			     u8 min_window)
+{
+	struct h700_vendor_window window;
+	u32 original_odt = work->odt_en;
+	unsigned int lane;
+
+	for (lane = 0; lane < H700_VENDOR_LANES; lane++) {
+		if (!h700_vendor_sweep_lane(work, half_size, lane, true,
+					    min_window, &window))
+			return false;
+	}
+	work->odt_en = original_odt;
+
+	return true;
+}
+
+static bool h700_vendor_test_read_delay(struct dram_para *work, u32 half_size,
+					unsigned int lane, u8 delay)
+{
+	work->tpr12 = h700_set_delay_lane(work->tpr12, lane, delay);
+	mctl_phy_bit_delay_compensation(work);
+
+	return h700_vendor_validate(half_size, 0x1000, lane, false);
+}
+
+/*
+ * Clean-room translation of boot0 R_2st.  Keep its 4/2/1 state machine
+ * literally, including the existing R_1st bounds as fallbacks and the
+ * modulo-64 initial delay calculation.
+ */
+static bool h700_vendor_r2st(struct dram_para *work, u32 half_size,
+				     u8 min_window,
+				     struct h700_vendor_window window[H700_VENDOR_LANES],
+				     u32 original_odt)
+{
+	static const u8 steps[] = { 1, 2, 4 };
+	unsigned int lane;
+
+	for (lane = 0; lane < H700_VENDOR_LANES; lane++) {
+		u32 baseline_tpr12 = work->tpr12;
+		u8 original = h700_get_odt_nibble(original_odt, lane);
+		int initial = (h700_get_delay_lane(baseline_tpr12, lane) +
+			       window[lane].odt - original) & 0x3f;
+		int current = initial;
+		int step_index = 2;
+		bool upper = false;
+		bool done = false;
+
+		work->odt_en = h700_set_odt_nibble(work->odt_en, lane,
+						      window[lane].odt);
+		work->tpr12 = h700_set_delay_lane(work->tpr12, lane, initial);
+
+		while (!done) {
+			int step = steps[step_index];
+			int candidate;
+			bool pass;
+
+			if (!upper)
+				candidate = current > step ? current - step : 0;
+			else {
+				candidate = current + step;
+				if (candidate > 63)
+					candidate = 63;
+			}
+
+			pass = h700_vendor_test_read_delay(work, half_size, lane,
+						      candidate);
+			if (pass) {
+				current = candidate;
+				if (!upper) {
+					window[lane].start = current;
+					if (current == 0) {
+						upper = true;
+						step_index = 2;
+						work->tpr12 = baseline_tpr12;
+						current = h700_get_delay_lane(
+							baseline_tpr12, lane);
+					}
+				} else {
+					window[lane].end = current;
+					if (current == 63)
+						done = true;
+				}
+				continue;
+			}
+
+			if (!upper) {
+				if (step_index == 0) {
+					upper = true;
+					step_index = 2;
+					work->tpr12 = baseline_tpr12;
+					current = h700_get_delay_lane(
+						baseline_tpr12, lane);
+					continue;
+				}
+
+				/* boot0 backs out the failed lower probe, modulo 64. */
+				current = (candidate + step) & 0x3f;
+				step_index--;
+				work->tpr12 = h700_set_delay_lane(work->tpr12, lane,
+								 current);
+				continue;
+			}
+
+			if (step_index == 0) {
+				done = true;
+				continue;
+			}
+
+			/*
+			 * The upper-side boot0 sequence subtracts the failed step and
+			 * immediately adds it again before reducing the step index;
+			 * retain that observable state transition literally.
+			 */
+			current = candidate;
+			step_index--;
+			work->tpr12 = h700_set_delay_lane(work->tpr12, lane, current);
+		}
+
+		window[lane].width = window[lane].end + 1 - window[lane].start;
+		if (window[lane].width < min_window)
+			return false;
+
+		{
+			int center = (window[lane].start + window[lane].end) / 2 -
+				2 * ((int)window[lane].odt - original);
+
+			center &= 0x3f;
+			window[lane].center = center;
+			work->tpr12 = h700_set_delay_lane(work->tpr12, lane, center);
+		}
+	}
+
+	work->odt_en = original_odt;
+	mctl_phy_bit_delay_compensation(work);
+	return true;
+}
+
+/* boot0 RV_C: TPR6 centre +/-6, step 3; read eye centre +/-3. */
+static bool h700_vendor_rv_c(struct dram_para *work,
+				     const struct dram_config *config, u32 half_size,
+				     const struct h700_vendor_r2d_result *r2d,
+				     const struct h700_vendor_window window[H700_VENDOR_LANES])
+{
+	unsigned int half_eye = (h700_dram_runtime.current_tpr13 >> 8) & 0x7;
+	int first = r2d->center - 6 > r2d->start ?
+		    r2d->center - 6 : r2d->start;
+	int last = r2d->center + 6 < r2d->end ?
+		   r2d->center + 6 : r2d->end;
+	int delay_step;
+	int tpr6;
+
+	if (!half_eye)
+		return true;
+
+	delay_step = half_eye - 1;
+
+	/*
+	 * boot0 RV_C mutates the live parameter block in place.
+	 * TPR6 and TPR12 survive RV_C and are consumed by the
+	 * wrapper's final mctl_core_init().
+	 */
+	for (tpr6 = first; tpr6 <= last; tpr6 += 3) {
+		unsigned int lane;
+
+		work->tpr6 = h700_set_tpr6_byte(work->tpr6, 3, tpr6);
+		if (!mctl_core_init(work, config))
+			return false;
+
+		for (lane = 0; lane < H700_VENDOR_LANES; lane++) {
+			int start = window[lane].center + 1 - half_eye;
+			int end = window[lane].center + delay_step;
+			int delay;
+
+			if ((u32)start > (u32)end)
+				continue;
+
+			for (delay = start; (u32)delay <= (u32)end;
+			     delay += delay_step) {
+				work->tpr12 =
+					h700_set_delay_lane(work->tpr12, lane, delay);
+
+				mctl_phy_bit_delay_compensation(work);
+
+				if (!h700_vendor_validate(half_size, 0x800,
+							  lane, false))
+					return false;
+			}
+		}
+	}
+
+	return true;
+}
+
+static bool h700_vendor_dst_once(struct dram_para *runtime,
+				 struct dram_config *config,
+				 u8 min_window)
+{
+	struct dram_para nominal = *runtime;
+	struct dram_para work;
+	struct h700_vendor_window read_window[H700_VENDOR_LANES];
+	u32 original_odt = nominal.odt_en;
+	struct h700_vendor_r2d_result r2d;
+	u32 half_size = 0;
+
+	if (!h700_vendor_bootstrap(&nominal, &work, config, &half_size)) {
+		*runtime = work;
+		return false;
+	}
+
+	h700_vendor_prepare_matrix(half_size);
+
+	if ((h700_dram_runtime.current_tpr13 & H700_VENDOR_TPR13_R2D) &&
+	    !h700_vendor_r2d(&work, config, half_size, &r2d)) {
+		*runtime = work;
+		return false;
+	}
+
+	if (!h700_vendor_r1st(&work, half_size, min_window, read_window)) {
+		*runtime = work;
+		return false;
+	}
+
+	/* CubeXX/40XX-V have BIT26 clear: boot0 skips W_2d but runs W_2st. */
+	if (h700_dram_runtime.current_tpr13 & H700_VENDOR_TPR13_W2D) {
+		*runtime = work;
+		return false;
+	}
+
+	if (!h700_vendor_w2st(&work, half_size, min_window)) {
+		*runtime = work;
+		return false;
+	}
+
+	if (!h700_vendor_r2st(&work, half_size, min_window, read_window,
+			      original_odt)) {
+		*runtime = work;
+		return false;
+	}
+
+	if ((h700_dram_runtime.current_tpr13 & H700_VENDOR_TPR13_R2D) &&
+	    !h700_vendor_rv_c(&work, config, half_size, &r2d,
+			      read_window)) {
+		*runtime = work;
+		return false;
+	}
+
+	*runtime = work;
+	return true;
+}
+
+/* Clean-room translation of boot0 wrapper 0x24770: four in-place tries. */
+static bool h700_vendor_dst(struct dram_para *runtime,
+			    struct dram_config *config, u8 min_window)
+{
+	unsigned int attempt;
+
+	for (attempt = 0; attempt < H700_VENDOR_RETRIES; attempt++) {
+		unsigned int size_mib;
+		u32 half_size;
+
+		if (!h700_vendor_dst_once(runtime, config, min_window))
+			continue;
+
+		if (!mctl_core_init(runtime, config))
+			continue;
+		size_mib = h700_vendor_size_mib();
+		if (!size_mib)
+			continue;
+		half_size = (size_mib / 2) << 20;
+		if (!h700_vendor_validate(half_size, 0x8000, 8, true))
+			continue;
+
+		return true;
+	}
+
+	return false;
+}
+
+static bool h700_vendor_final_memtest(unsigned int size_mib)
+{
+	volatile u32 *low = (volatile u32 *)CFG_SYS_SDRAM_BASE;
+	volatile u32 *high = (volatile u32 *)(uintptr_t)(CFG_SYS_SDRAM_BASE +
+						 ((size_mib / 2) << 20));
+	unsigned int i;
+
+	for (i = 0; i < 0x1000; i++) {
+		low[i] = 0x01234567U + i;
+		high[i] = 0xfedcba98U + i;
+	}
+	asm volatile("dsb sy" ::: "memory");
+
+	for (i = 0; i < 0x1000; i++) {
+		if (high[i] != 0xfedcba98U + i)
+			return false;
+		if (low[i] != 0x01234567U + i)
+			return false;
+	}
+
+	return true;
+}
+
+#endif /* CONFIG_NUUBOS_H700_VENDOR_DRAM */
+
+unsigned long sunxi_dram_init(void)
+{
+	void *const prcm = (void *)SUNXI_PRCM_BASE;
+	struct dram_config config;
+	unsigned long size;
+
+	setbits_le32(prcm + CCU_PRCM_RES_CAL_CTRL, BIT(8));
+	clrbits_le32(prcm + CCU_PRCM_OHMS240, 0x3f);
+
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+	if (h700_vendor_select_profile()) {
+		unsigned int size_mib;
+		if (!h700_vendor_set_dram_voltage())
+			hang();
+
+		if (!h700_vendor_config(&config))
+			hang();
+
+		/*
+		 * TPR13 bit11 selects the vendor DST wrapper.  Profiles which do
+		 * not request DST still use the vendor autoscan and final raw
+		 * geometry/controller path.
+		 */
+		if (h700_dram_runtime.current_tpr13 & BIT(11)) {
+			if (!h700_vendor_dst(&para, &config,
+					     h700_dram_runtime.min_window))
+				hang();
+		} else {
+			if (!(h700_dram_runtime.current_tpr13 & BIT(0)) &&
+			    !h700_vendor_autoscan(&para, &config))
+				hang();
+		}
+
+		/* boot0 performs one final core init with the discovered geometry. */
+		if (!mctl_core_init(&para, &config))
+			hang();
+		size_mib = h700_vendor_finalize_size();
+		if (!size_mib)
+			hang();
+
+		if (!(h700_dram_runtime.current_tpr13 & BIT(27)))
+			mctl_set_master_priority();
+
+		/*
+		 * boot0 final base/half-memory test: one complete re-init and
+		 * retest is permitted before declaring the DRAM unusable.
+		 */
+		if (!h700_vendor_final_memtest(size_mib)) {
+			if (!mctl_core_init(&para, &config))
+				hang();
+			size_mib = h700_vendor_finalize_size();
+			if (!size_mib)
+				hang();
+			if (!(h700_dram_runtime.current_tpr13 & BIT(27)))
+				mctl_set_master_priority();
+			if (!h700_vendor_final_memtest(size_mib))
+				hang();
+		}
+
+		/*
+		 * boot0 top flow 0x27900 -> 0x231e0 always clears the H700
+		 * DRAM/boot scratch register at 0x070001f8 after the final
+		 * memory test succeeds.  On the cold path bit 16 is clear, so
+		 * the remainder of 0x231e0 returns immediately after this write.
+		 */
+		writel(0, (void *)0x070001f8UL);
+
+		return (unsigned long)size_mib << 20;
+	}
+#endif
+
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+	/* A successful H700 selector always activates the vendor backend. */
+	hang();
+#endif
+
+	/*
+	 * Historical H616 initialization. H700 always returns or stops above.
+	 */
+	mctl_auto_detect_rank_width(&para, &config);
+	mctl_auto_detect_dram_size(&para, &config);
+	mctl_core_init(&para, &config);
+
+	size = mctl_calc_size(&config);
 	mctl_set_master_priority();
 
 	return size;
