+#endif
 
 enum {
 	MBUS_QOS_LOWEST = 0,
@@ -92,6 +99,32 @@ static void mctl_set_master_priority(void)
 	dmb();
 }
 
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+static bool h700_vendor_training_active(void);
+static bool h700_vendor_core_init(const struct dram_para *para,
+				  const struct dram_config *config);
+static const u8 *h700_vendor_get_phy_init(const struct dram_para *para);
+
+struct h700_dram_runtime_state {
+	u32 current_para1;
+	u32 current_para2;
+	u32 current_tpr13;
+	u8 active;
+	u8 min_window;
+	u8 retry_count;
+};
+
+/*
+ * Keep this in initialized SRAM .data. SPL BSS is deliberately not relied
+ * on before DRAM is trained. This declaration must precede the vendor
+ * training primitives, which consume the active para2/rank state.
+ */
+static struct h700_dram_runtime_state h700_dram_runtime = {
+	.active = 0xff,
+};
+
+#endif
+
 static void mctl_sys_init(u32 clk_rate)
 {
 	void * const ccm = (void *)SUNXI_CCM_BASE;
@@ -100,6 +133,76 @@ static void mctl_sys_init(u32 clk_rate)
 	struct sunxi_mctl_ctl_reg * const mctl_ctl =
 			(struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
 
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+	{
+		u32 value;
+
+		/* Exact H700 boot0 0x271d4 reset/clock ordering. */
+		clrbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_ENABLE);
+		clrbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_RESET);
+		clrbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(GATE_SHIFT));
+		clrbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(RESET_SHIFT));
+		clrbits_le32(ccm + CCU_H6_PLL5_CFG, CCM_PLL_CTRL_EN);
+		clrbits_le32(ccm + CCU_H6_DRAM_CLK_CFG, DRAM_MOD_RESET);
+		udelay(5);
+
+		/*
+		 * H700 boot0 0x24b64 does not use the H616 one-shot PLL5
+		 * programming sequence.  Preserve the existing PLL register,
+		 * replace N/div fields, enable the PLL, apply the H700 analog
+		 * side effect from 0x24b08, toggle the vendor control bits and
+		 * only then wait for lock.
+		 *
+		 * All currently reconstructed H700 DRAM.ext profiles have
+		 * TPR13[22:20] == 0, for which 0x24b08 sets BIT(24) at
+		 * 0x03001010.
+		 */
+		value = readl(ccm + CCU_H6_PLL5_CFG);
+		value &= ~((0xffU << 8) | 0x3U);
+		value |= CCM_PLL5_CTRL_N(clk_rate * 2 / 24);
+
+		writel(value | BIT(31), ccm + CCU_H6_PLL5_CFG);
+
+		/*
+		 * boot0 0x24b12: selector zero branches directly to 0x24b22,
+		 * skipping the analogue-control write at 0x24b20. Preserve
+		 * 0x03001110 and only set PLL5 bit 24. All reconstructed
+		 * DRAM.ext profiles use selector zero.
+		 */
+		setbits_le32((void *)0x03001010UL, BIT(24));
+
+		writel(value | BIT(31) | BIT(30) | BIT(29),
+		       ccm + CCU_H6_PLL5_CFG);
+		writel(value | BIT(31) | BIT(29),
+		       ccm + CCU_H6_PLL5_CFG);
+
+		mctl_await_completion(ccm + CCU_H6_PLL5_CFG,
+				      CCM_PLL_LOCK, CCM_PLL_LOCK);
+
+		value = readl(ccm + CCU_H6_DRAM_CLK_CFG);
+		value &= ~((0x3U << 24) | 0x3U);
+		value |= BIT(27);
+		writel(value, ccm + CCU_H6_DRAM_CLK_CFG);
+
+		setbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(RESET_SHIFT));
+		setbits_le32(ccm + CCU_H6_DRAM_GATE_RESET, BIT(GATE_SHIFT));
+
+		writel(0, &mctl_com->maer0);
+		writel(0, &mctl_com->maer1);
+		writel(0, &mctl_com->maer2);
+
+		setbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_RESET);
+		setbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_ENABLE);
+		clrbits_le32(&mctl_com->unk_0x500, BIT(25));
+		setbits_le32(ccm + CCU_H6_DRAM_CLK_CFG, DRAM_MOD_RESET);
+		udelay(5);
+		writel(0x8000, &mctl_ctl->clken);
+
+		if (!(readl((void *)0x070001f8UL) >> 16))
+			setbits_le32((void *)0x070001f4UL, BIT(0));
+	}
+#else
+
 	/* Put all DRAM-related blocks to reset state */
 	clrbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_ENABLE);
 	clrbits_le32(ccm + CCU_H6_MBUS_CFG, MBUS_RESET);
@@ -139,8 +242,13 @@ static void mctl_sys_init(u32 clk_rate)
 
 	/* Unknown hack, which enables access of mctl_ctl regs */
 	writel(0x8000, &mctl_ctl->clken);
+#endif
 }
 
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+static bool h700_vendor_set_addrmap(struct sunxi_mctl_ctl_reg *mctl_ctl);
+#endif
