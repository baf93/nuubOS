From: nuubOS Project <noreply@nuubos.invalid>
Subject: [PATCH] sunxi: consolidate the qualified H700 vendor DRAM backend

Consolidate the qualified H700 vendor DRAM implementation into one final
patch instead of layering the bring-up fixes incrementally.

Preserve runtime DRAM.ext selection, DDR3/LPDDR3/LPDDR4 training and
timing, and the separate H616 path. DDR4 remains audited source excluded
from SPL because no current vendor profile selects it.

Keep the vendor-matched SPL CPUX clock setup and the H700-only ASIMD
validator bulk memory operations. Preserve the scalar tails for arbitrary
word-aligned byte counts, with the compare mismatch accumulated outside
w0 so x0 remains valid until the tail completes.

Remove the pre-DRAM MMC/FAT resolver and image-specific base profiles.
Unsupported DRAM strap indices fail closed in SPL; valid profiles retain
the qualified timing and training paths.

Hardware baseline: RG35XX Pro, RG CubeXX and RG40XX-V reach userspace
with this final DRAM state.

Signed-off-by: nuubOS Project <noreply@nuubos.invalid>

---
diff --git a/arch/arm/include/asm/arch-sunxi/dram_sun50i_h616.h b/arch/arm/include/asm/arch-sunxi/dram_sun50i_h616.h
index a8fdda1..f843b12 100644
--- a/arch/arm/include/asm/arch-sunxi/dram_sun50i_h616.h
+++ b/arch/arm/include/asm/arch-sunxi/dram_sun50i_h616.h
@@ -141,24 +141,51 @@ check_member(sunxi_mctl_ctl_reg, unk_0x4240, 0x4240);
 #define TPR10_CA_BIT_DELAY	BIT(16)
 #define TPR10_DX_BIT_DELAY0	BIT(17)
 #define TPR10_DX_BIT_DELAY1	BIT(18)
+#define TPR10_TRAINING_RETRY	BIT(19)
 #define TPR10_WRITE_LEVELING	BIT(20)
 #define TPR10_READ_CALIBRATION	BIT(21)
 #define TPR10_READ_TRAINING	BIT(22)
 #define TPR10_WRITE_TRAINING	BIT(23)
 
+/*
+ * H700 boot0 uses a 0x80-byte parameter block. Keep the same logical
+ * layout so the runtime selector, mode-register programming and training
+ * policy all consume one coherent profile instead of board-specific
+ * sideband state.
+ */
 struct dram_para {
-	u32 clk;
-	enum sunxi_dram_type type;
-	u32 dx_odt;
-	u32 dx_dri;
-	u32 ca_dri;
-	u32 odt_en;
-	u32 tpr0;
-	u32 tpr2;
-	u32 tpr6;
-	u32 tpr10;
-	u32 tpr11;
-	u32 tpr12;
+	u32 clk;          /* 0x00 */
+	enum sunxi_dram_type type; /* 0x04 */
+	u32 dx_odt;       /* 0x08 */
+	u32 dx_dri;       /* 0x0c */
+	u32 ca_dri;       /* 0x10 */
+	u32 odt_en;       /* 0x14 */
+	u32 para1;        /* 0x18 */
+	u32 para2;        /* 0x1c */
+	u32 mr0;          /* 0x20 */
+	u32 mr1;          /* 0x24 */
+	u32 mr2;          /* 0x28 */
+	u32 mr3;          /* 0x2c */
+	u32 mr4;          /* 0x30 */
+	u32 mr5;          /* 0x34 */
+	u32 mr6;          /* 0x38 */
+	u32 mr11;         /* 0x3c */
+	u32 mr12;         /* 0x40 */
+	u32 mr13;         /* 0x44 */
+	u32 mr14;         /* 0x48 */
+	u32 mr16;         /* 0x4c */
+	u32 mr17;         /* 0x50 */
+	u32 mr22;         /* 0x54 */
+	u32 tpr0;         /* 0x58 */
+	u32 tpr1;         /* 0x5c */
+	u32 tpr2;         /* 0x60 */
+	u32 tpr3;         /* 0x64 */
+	u32 tpr6;         /* 0x68 */
+	u32 tpr10;        /* 0x6c */
+	u32 tpr11;        /* 0x70 */
+	u32 tpr12;        /* 0x74 */
+	u32 tpr13;        /* 0x78 */
+	u32 tpr14;        /* 0x7c, vendor auxiliary word */
 };
 
 struct dram_config {
@@ -168,13 +195,65 @@ struct dram_config {
 	u8 bus_full_width;
 };
 
-static inline int ns_to_t(int nanoseconds)
+#define H616_PHY_INIT_LEN	27
+
+static inline int ns_to_t(const struct dram_para *para, int nanoseconds)
 {
-	const unsigned int ctrl_freq = CONFIG_DRAM_CLK / 2;
+	const unsigned int ctrl_freq = para->clk / 2;
 
 	return DIV_ROUND_UP(ctrl_freq * nanoseconds, 1000);
 }
 
-void mctl_set_timing_params(const struct dram_para *para);
+void h616_ddr3_set_timing_params(const struct dram_para *para);
+void h616_lpddr3_set_timing_params(const struct dram_para *para);
+void h616_lpddr4_set_timing_params(const struct dram_para *para);
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+const u8 *h700_phy_get_map0_2(unsigned int map);
+const u8 *h700_phy_get_map5_6(unsigned int map);
+const u8 *h700_phy_get_map7_8(unsigned int map);
+#endif
+
+const u8 *h616_ddr3_get_phy_init(void);
+const u8 *h616_lpddr3_get_phy_init(void);
+const u8 *h616_lpddr4_get_phy_init(void);
+
+static inline void mctl_set_timing_params(const struct dram_para *para)
+{
+#if defined(CONFIG_NUUBOS_H700_VENDOR_DRAM) || defined(CONFIG_SUNXI_DRAM_H616_DDR3_1333)
+	if (para->type == SUNXI_DRAM_TYPE_DDR3) {
+		h616_ddr3_set_timing_params(para);
+		return;
+	}
+#endif
+#if defined(CONFIG_NUUBOS_H700_VENDOR_DRAM) || defined(CONFIG_SUNXI_DRAM_H616_LPDDR3)
+	if (para->type == SUNXI_DRAM_TYPE_LPDDR3) {
+		h616_lpddr3_set_timing_params(para);
+		return;
+	}
+#endif
+#if defined(CONFIG_NUUBOS_H700_VENDOR_DRAM) || defined(CONFIG_SUNXI_DRAM_H616_LPDDR4)
+	if (para->type == SUNXI_DRAM_TYPE_LPDDR4) {
+		h616_lpddr4_set_timing_params(para);
+		return;
+	}
+#endif
+}
+
+static inline const u8 *h616_get_phy_init(const struct dram_para *para)
+{
+#if defined(CONFIG_NUUBOS_H700_VENDOR_DRAM) || defined(CONFIG_SUNXI_DRAM_H616_DDR3_1333)
+	if (para->type == SUNXI_DRAM_TYPE_DDR3)
+		return h616_ddr3_get_phy_init();
+#endif
+#if defined(CONFIG_NUUBOS_H700_VENDOR_DRAM) || defined(CONFIG_SUNXI_DRAM_H616_LPDDR3)
+	if (para->type == SUNXI_DRAM_TYPE_LPDDR3)
+		return h616_lpddr3_get_phy_init();
+#endif
+#if defined(CONFIG_NUUBOS_H700_VENDOR_DRAM) || defined(CONFIG_SUNXI_DRAM_H616_LPDDR4)
+	if (para->type == SUNXI_DRAM_TYPE_LPDDR4)
+		return h616_lpddr4_get_phy_init();
+#endif
+	return NULL;
+}
 
 #endif /* _SUNXI_DRAM_SUN50I_H616_H */
