 	mctl_await_completion((u32 *)(SUNXI_DRAM_PHY0_BASE + 0x188), val, val);
-
 	clrbits_le32(SUNXI_DRAM_PHY0_BASE + 8, 4);
 
 	val = readl(SUNXI_DRAM_PHY0_BASE + 0x258);
