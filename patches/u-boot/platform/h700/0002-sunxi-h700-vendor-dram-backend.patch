 static void mctl_set_addrmap(const struct dram_config *config)
 {
 	struct sunxi_mctl_ctl_reg * const mctl_ctl =
@@ -149,6 +257,11 @@ static void mctl_set_addrmap(const struct dram_config *config)
 	u8 rows = config->rows;
 	u8 ranks = config->ranks;
 
