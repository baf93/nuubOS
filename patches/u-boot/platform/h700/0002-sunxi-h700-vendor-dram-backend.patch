 	writel(0x00330000, &mctl_ctl->init[4]);
 	writel(0x00040072, &mctl_ctl->init[6]);
@@ -92,3 +138,31 @@ void mctl_set_timing_params(const struct dram_para *para)
 	/* set refresh timing */
 	writel((trefi << 16) | trfc, &mctl_ctl->rfshtmg);
 }
+
+void h616_lpddr4_set_timing_params(const struct dram_para *para)
+{
+#ifdef CONFIG_NUUBOS_H700_VENDOR_DRAM
+	/*
+	 * H700 boot0 0x26534 programs four controller timing banks.
+	 * For a nominal DRAM clock, the controller clock is clk / 2 and
+	 * boot0 successively uses divisors 4, 3, 2 and 1, mapping them to
+	 * banks +0x4000, +0x3000, +0x2000 and +0x0000 respectively.
+	 *
+	 * Keep the normal H616 path unchanged and reproduce this only for
+	 * the H700 vendor backend.
+	 */
+	static const u8 divisors[] = { 4, 3, 2, 1 };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(divisors); i++) {
+		struct dram_para scaled = *para;
+		u8 div = divisors[i];
+		uintptr_t bank_offset = div == 1 ? 0 : (uintptr_t)div << 12;
+
+		scaled.clk = para->clk / div;
+		h616_lpddr4_set_timing_params_bank(&scaled, bank_offset);
+	}
+#else
+	h616_lpddr4_set_timing_params_bank(para, 0);
+#endif
+}
diff --git a/arch/arm/mach-sunxi/dram_timings/h700_ddr4.c b/arch/arm/mach-sunxi/dram_timings/h700_ddr4.c
new file mode 100644
index 0000000..569800f
--- /dev/null
+++ b/arch/arm/mach-sunxi/dram_timings/h700_ddr4.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Allwinner H700 DDR4 timings, clean-room translated from vendor boot0.
+ */
+
+#include <asm/arch/cpu.h>
+#include <asm/arch/dram.h>
+
+static const u8 h700_phy_init_map3[H616_PHY_INIT_LEN] = {
+	0x12, 0x02, 0x0d, 0x13, 0x07, 0x05, 0x06, 0x0e,
+	0x00, 0x17, 0x09, 0x16, 0x0a, 0x01, 0x08, 0x10,
+	0x0b, 0x11, 0x18, 0x0f, 0x03, 0x15, 0x0c, 0x04,
+	0x14, 0x19, 0x1a
+};
+
+static const u8 h700_phy_init_map4[H616_PHY_INIT_LEN] = {
+	0x00, 0x01, 0x03, 0x06, 0x04, 0x13, 0x16, 0x0c,
+	0x10, 0x09, 0x0a, 0x0b, 0x07, 0x0d, 0x0e, 0x0f,
+	0x18, 0x11, 0x12, 0x05, 0x14, 0x08, 0x02, 0x17,
+	0x15, 0x19, 0x1a
+};
+
+const u8 *h700_phy_get_map3_4(unsigned int map)
+{
+	return map ? h700_phy_init_map4 : h700_phy_init_map3;
+}
+
+static void h700_ddr4_set_timing_params_bank(const struct dram_para *para,
+					      uintptr_t bank_offset)
+{
+	struct sunxi_mctl_ctl_reg * const mctl_ctl =
+		(struct sunxi_mctl_ctl_reg *)(SUNXI_DRAM_CTL0_BASE + bank_offset);
+	struct sunxi_mctl_ctl_reg * const common_ctl =
+		(struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
+	u8 tfaw = ns_to_t(para, 35);
+	u8 trrd = max(ns_to_t(para, 8), 2);
+	u8 txp = max(ns_to_t(para, 6), 2);
+	u8 tmrd_pda = max(ns_to_t(para, 10), 8);
+	u8 trp = ns_to_t(para, 15);
+	u8 trc = ns_to_t(para, 49);
+	u8 wr2rd_s = max(ns_to_t(para, 3), 1) + 7;
+	u8 tras = ns_to_t(para, 34);
+	u16 trefi = ns_to_t(para, 7800) / 32;
+	u16 trfc = ns_to_t(para, 350);
+	u8 txs = ns_to_t(para, 360) / 32;
+	u8 tmod = max(ns_to_t(para, 15), 12);
+	u8 tcke = max(ns_to_t(para, 5), 2);
+	u8 tcksrx = max(ns_to_t(para, 10), 3);
+	u8 txsabort = ns_to_t(para, 170) / 32;
+	u8 trasmax = ns_to_t(para, 70200) / 1024;
+	u8 rd2pre = trp < 5 ? 9 - trp : 4;
+	u8 wr2rd = trrd + 7;
+	u8 tckesr = tcke + 1;
+	u8 dfi_tphy_wrlat = 6;
+	u8 dfi_trddata_en = 10;
+	u32 dfitmg0;
+
+	/* boot0 0x26534, type 4. */
+	writel(tras | (trasmax << 8) | (tfaw << 16) | (14U << 24),
+	       &mctl_ctl->dramtmg[0]);
+	writel(trc | (rd2pre << 8) | (txp << 16), &mctl_ctl->dramtmg[1]);
+	writel(wr2rd | (5U << 8) | (7U << 16) | (5U << 24),
+	       &mctl_ctl->dramtmg[2]);
+	writel(tmod | (4U << 12), &mctl_ctl->dramtmg[3]);
+	writel(trp | (trrd << 8) | (3U << 16) | (trp << 24),
+	       &mctl_ctl->dramtmg[4]);
+	writel(tcke | (tckesr << 8) | (tcksrx << 16) | (tcksrx << 24),
+	       &mctl_ctl->dramtmg[5]);
+	writel((txp + 2) | 0x02020000, &mctl_ctl->dramtmg[6]);
+	writel(txs | (16U << 8) | (txsabort << 16) | (txsabort << 24),
+	       &mctl_ctl->dramtmg[8]);
+	writel(wr2rd_s | (txp << 8) | 0x00020000, &mctl_ctl->dramtmg[9]);
+	writel(0x000e0c05, &mctl_ctl->dramtmg[10]);
+	writel(0x440c021c, &mctl_ctl->dramtmg[11]);
+	writel(tmrd_pda, &mctl_ctl->dramtmg[12]);
+	writel(0x0a100002, &mctl_ctl->dramtmg[13]);
+	writel(4, &mctl_ctl->dramtmg[14]);
+
+	/* boot0 0x26b28..0x26d62: these registers are common, not banked. */
+	clrsetbits_le32(&common_ctl->init[0], 0xc0000fff,
+			 0x112 | ((readl((void *)0x070001f8UL) >> 16) ?
+				  BIT(30) : 0));
+	writel(0x01f20000, &common_ctl->init[1]);
+	clrsetbits_le32(&common_ctl->init[2], 0xff0f, 0x0d05);
+	writel(0, &common_ctl->dfimisc);
+
+	/* 0x26534 normalizes DDR4 MR0/MR2 before INIT and DFI programming. */
+	writel((0x0520U << 16) | para->mr1, &mctl_ctl->init[3]);
+	writel((0x0008U << 16) | para->mr3, &mctl_ctl->init[4]);
+	writel((para->mr4 << 16) | para->mr5, &mctl_ctl->init[6]);
+	writel(para->mr6, &mctl_ctl->init[7]);
+	clrsetbits_le32(&mctl_ctl->rankctl, 0xff0, 0x660);
+
+	if (para->tpr13 & BIT(5))
+		dfitmg0 = dfi_tphy_wrlat | 0x02000000 |
+			  (dfi_trddata_en << 16) | 0x00808000;
+	else
+		dfitmg0 = (dfi_tphy_wrlat - 1) | 0x02000000 |
+			  ((dfi_trddata_en - 1) << 16) | 0x00808000;
+	writel(dfitmg0, &mctl_ctl->dfitmg0);
+	writel(0x00100202, &mctl_ctl->dfitmg1);
+	writel((trefi << 16) | trfc, &mctl_ctl->rfshtmg);
+}
+
+void h700_ddr4_set_timing_params(const struct dram_para *para)
+{
+	static const u8 divisors[] = { 4, 3, 2, 1 };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(divisors); i++) {
+		struct dram_para scaled = *para;
+		u8 div = divisors[i];
+		uintptr_t bank_offset = div == 1 ? 0 : (uintptr_t)div << 12;
+
+		scaled.clk = para->clk / div;
+		h700_ddr4_set_timing_params_bank(&scaled, bank_offset);
+	}
+}
diff --git a/arch/arm/mach-sunxi/h700_dram_memops.S b/arch/arm/mach-sunxi/h700_dram_memops.S
new file mode 100644
index 0000000..15b7f7b
--- /dev/null
+++ b/arch/arm/mach-sunxi/h700_dram_memops.S
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * H700 DRAM validator bulk memory operations.
+ *
+ * H700 boot0 uses VFP/NEON bulk transfers for these helpers. Keep the
+ * validator algorithm in C and reproduce the bulk memory semantics here.
+ *
+ * Operate on 64-byte blocks. Scalar tails preserve the original API for
+ * arbitrary word-aligned byte counts.
+ */
+
+	.text
+	.align	2
+
+	.global	h700_vendor_fill
+	.type	h700_vendor_fill, %function
+h700_vendor_fill:
+	dup	v0.4s, w2
+	dup	v1.4s, w3
+	zip1	v0.4s, v0.4s, v1.4s
+	mov	v1.16b, v0.16b
+	mov	v2.16b, v0.16b
+	mov	v3.16b, v0.16b
+
+	lsr	w4, w1, #6
+	cbz	w4, 2f
+1:
+	st1	{v0.16b-v3.16b}, [x0], #64
+	subs	w4, w4, #1
+	b.ne	1b
+
+2:
+	and	w1, w1, #63
+	lsr	w1, w1, #2
+	cbz	w1, 4f
+3:
+	str	w2, [x0], #4
+	subs	w1, w1, #1
+	b.eq	4f
+	str	w3, [x0], #4
+	subs	w1, w1, #1
+	b.ne	3b
+
+4:
+	dmb	sy
+	ret
+	.size	h700_vendor_fill, .-h700_vendor_fill
+
+
+	.align	2
+	.global	h700_vendor_copy
+	.type	h700_vendor_copy, %function
+h700_vendor_copy:
+	lsr	w3, w2, #6
+	cbz	w3, 2f
+1:
+	ld1	{v0.16b-v3.16b}, [x0], #64
+	st1	{v0.16b-v3.16b}, [x1], #64
+	subs	w3, w3, #1
+	b.ne	1b
+
+2:
+	and	w2, w2, #63
+	lsr	w2, w2, #2
+	cbz	w2, 4f
+3:
+	ldr	w3, [x0], #4
+	str	w3, [x1], #4
+	subs	w2, w2, #1
+	b.ne	3b
+
+4:
+	dmb	sy
+	ret
+	.size	h700_vendor_copy, .-h700_vendor_copy
+
+
+	.align	2
+	.global	h700_vendor_compare
+	.type	h700_vendor_compare, %function
+h700_vendor_compare:
+	eor	v0.16b, v0.16b, v0.16b
+
+	lsr	w3, w2, #6
+	cbz	w3, 2f
+1:
+	ld1	{v1.16b-v2.16b}, [x0], #32
+	ld1	{v3.16b-v4.16b}, [x1], #32
+	eor	v1.16b, v1.16b, v3.16b
+	eor	v2.16b, v2.16b, v4.16b
+	orr	v0.16b, v0.16b, v1.16b
+	orr	v0.16b, v0.16b, v2.16b
+
+	ld1	{v1.16b-v2.16b}, [x0], #32
+	ld1	{v3.16b-v4.16b}, [x1], #32
+	eor	v1.16b, v1.16b, v3.16b
+	eor	v2.16b, v2.16b, v4.16b
+	orr	v0.16b, v0.16b, v1.16b
+	orr	v0.16b, v0.16b, v2.16b
+
+	subs	w3, w3, #1
+	b.ne	1b
+
+2:
+	umov	w3, v0.s[0]
+	umov	w4, v0.s[1]
+	umov	w5, v0.s[2]
+	umov	w6, v0.s[3]
+	orr	w7, w3, w4
+	orr	w7, w7, w5
+	orr	w7, w7, w6
+
+	and	w2, w2, #63
+	lsr	w2, w2, #2
+	cbz	w2, 4f
+3:
+	ldr	w3, [x0], #4
+	ldr	w4, [x1], #4
+	eor	w3, w3, w4
+	orr	w7, w7, w3
+	subs	w2, w2, #1
+	b.ne	3b
+
+4:
+	mov	w0, w7
+	ret
