+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-pro.dts
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Ryan Walklin <ryan@testtoast.com>.
+ * Copyright (C) 2024 Chris Morgan <macroalpha82@gmail.com>.
+ */
+
+#include "sun50i-h700-anbernic-rg35xx-plus.dts"
+#include "sun50i-h700-anbernic-tf2.dtsi"
+#include "sun50i-h700-anbernic-dual-analog.dtsi"
+
+/ {
+	model = "Anbernic RG35XX Pro";
+	compatible = "anbernic,rg35xx-pro", "allwinner,sun50i-h700";
+
+
+};
+
+
+&gpio_keys_gamepad {
+	/*
+	 * RG35XX Pro physical wiring differs from the inherited mapping:
+	 * physical X is PA2 and physical Y is PA3.
+	 */
+	button-x {
+		gpios = <&pio 0 2 GPIO_ACTIVE_LOW>; /* PA2 */
+	};
+
+	button-y {
+		gpios = <&pio 0 3 GPIO_ACTIVE_LOW>; /* PA3 */
+	};
+
+	button-thumbl {
+		label = "GPIO Thumb Left";
+		gpios = <&pio 4 8 GPIO_ACTIVE_LOW>; /* PE8 */
+		linux,input-type = <EV_KEY>;
+		linux,code = <BTN_THUMBL>;
+	};
+
+	button-thumbr {
+		label = "GPIO Thumb Right";
+		gpios = <&pio 4 9 GPIO_ACTIVE_LOW>; /* PE9 */
+		linux,input-type = <EV_KEY>;
+		linux,code = <BTN_THUMBR>;
+	};
+};
+
+&pio {
+	pwm2_pi12_pin: pwm2-pi12-pin {
+		pins = "PI12";
+		function = "pwm2";
+	};
+
+	pwm2_ph2_pin: pwm2-ph2-pin {
+		pins = "PH2";
+		function = "pwm2";
+	};
+
+	ph2_gpio_in_pin: ph2-gpio-in-pin {
+		pins = "PH2";
+		function = "gpio_in";
+	};
+
+};
+
+
+&mmc1 {
+	keep-power-in-suspend;
+};
+
+&{/gpio-keys-gamepad/button-start} {
+	wakeup-source;
+};
+
+/*
+ * PI12 is the RG35XX Pro power LED and can be muxed to PWM2.
+ * Keep the inherited status LED on GPIO, but replace the inherited
+ * GPIO power LED with a hardware-PWM driven power LED.
+ */
+&{/leds} {
+	/delete-node/ led-0;
+};
+
+&pwm {
+	status = "okay";
+};
+
+
+/*
+ * RG35XX Pro PWM2 ownership:
+ *
+ * runtime:
+ *   PH2  -> PWM2 -> vibration motor
+ *   PI12 -> GPIO -> power LED
+ *
+ * suspend:
+ *   PH2  -> GPIO input
+ *   PI12 -> PWM2 -> suspend LED
+ */
+
+/ {
+	haptics_led {
+		compatible = "anbernic,rg35xx-pro-haptics";
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&pwm2_ph2_pin>;
+		pinctrl-1 = <&ph2_gpio_in_pin>, <&pwm2_pi12_pin>;
+
+		power-led-gpios = <&pio 8 12 GPIO_ACTIVE_HIGH>;
+
+		pwms = <&pwm 2 1000000 0>;
+		pwm-names = "enable";
+	};
+};
