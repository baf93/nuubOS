--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rgcubexx.dts
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Ryan Walklin <ryan@testtoast.com>.
+ * Copyright (C) 2024 Chris Morgan <macroalpha82@gmail.com>.
+ */
+
+#include "sun50i-h700-anbernic-rg35xx-plus.dts"
+#include "sun50i-h700-anbernic-uart5-ph.dtsi"
+#include "sun50i-h700-anbernic-tf2.dtsi"
+#include "sun50i-h700-anbernic-pwm0-backlight.dtsi"
+#include <dt-bindings/leds/common.h>
+#include "sun50i-h700-anbernic-pwm3-rumble-pi13.dtsi"
+#include "sun50i-h700-anbernic-dual-analog-inverted.dtsi"
+
+/ {
+	model = "Anbernic RG CubeXX";
+	compatible = "anbernic,rgcubexx", "allwinner,sun50i-h700";
+
+
+};
+
+
+&gpio_keys_gamepad {
+	button-x {
+		gpios = <&pio 0 2 GPIO_ACTIVE_LOW>; /* PA2 */
+	};
+
+	button-y {
+		gpios = <&pio 0 3 GPIO_ACTIVE_LOW>; /* PA3 */
+	};
+
+	button-thumbl {
+		label = "GPIO Thumb Left";
+		gpios = <&pio 4 8 GPIO_ACTIVE_LOW>; /* PE8 */
+		linux,input-type = <EV_KEY>;
+		linux,code = <BTN_THUMBL>;
+	};
+
+	button-thumbr {
+		label = "GPIO Thumb Right";
+		gpios = <&pio 4 9 GPIO_ACTIVE_LOW>; /* PE9 */
+		linux,input-type = <EV_KEY>;
+		linux,code = <BTN_THUMBR>;
+	};
+};
+
+
+/*
+ * The RG CubeXX vibration motor uses PWM3 on PI13.
+ * The generic PH0 PWM3 route conflicts with UART0.
+ */
+
+
+&uart5 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart5_ph_pins>;
+	status = "okay";
+};
+
+&reg_lcd {
+	regulator-min-microvolt = <2800000>;
+	regulator-max-microvolt = <2800000>;
+};
+
+&panel {
+	compatible = "anbernic,rgcubexx-panel", "panel-mipi-dpi-spi";
+};
+
