--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg40xx-v.dts
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * Copyright (C) 2024 Philippe Simons <simons.philippe@gmail.com>.
+ */
+
+#include "sun50i-h700-anbernic-rg35xx-plus.dts"
+#include "sun50i-h700-anbernic-uart5-ph.dtsi"
+#include "sun50i-h700-anbernic-tf2.dtsi"
+#include "sun50i-h700-anbernic-pwm0-backlight.dtsi"
+#include "sun50i-h700-anbernic-pwm3-rumble-pi13.dtsi"
+#include "sun50i-h700-anbernic-dual-analog.dtsi"
+
+/ {
+	model = "Anbernic RG40XX V";
+	compatible = "anbernic,rg40xx-V", "allwinner,sun50i-h700";
+
+};
+
+
+/*
+ * nuubOS: RG40XX-V physical X/Y wiring differs from the inherited
+ * RG35XX Plus mapping: physical X is PA2 and physical Y is PA3.
+ */
+&{/gpio-keys-gamepad/button-x} {
+	gpios = <&pio 0 2 GPIO_ACTIVE_LOW>; /* PA2 */
+};
+
+&{/gpio-keys-gamepad/button-y} {
+	gpios = <&pio 0 3 GPIO_ACTIVE_LOW>; /* PA3 */
+};
+
+/*
+ * RG40XX-V has one physical analog stick.  The shared dual-analog
+ * description provides RX/RY for a second stick which is not present.
+ */
+&{/adc-joystick} {
+	io-channels = <&adc_mux 0>,
+		      <&adc_mux 1>;
+	/delete-node/ axis@2;
+	/delete-node/ axis@3;
+};
+
+/*
+ * The RG40XX-V vibration motor uses PWM3 on PI13.
+ * Do not use the generic PH0 PWM3 route: PH0 belongs to UART0 here.
+ */
+
+
+/*
+ * RGB controller interface.
+ *
+ * UART5 on PH2/PH3 carries RGB frames to the controller MCU.
+ * PE5 powers the MCU and PI7 powers the LED rail.  Those enable
+ * lines are controlled by nuubOS userspace through the GPIO
+ * character interface.
+ */
+&uart5 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart5_ph_pins>;
+	status = "okay";
+};
+
+&panel {
+	compatible = "anbernic,rg40xx-panel", "panel-mipi-dpi-spi";
+};
+
+/*
+ * RG40XX-V has one physical analog stick.
+ * Its stick click is wired to PE8.
+ */
+&gpio_keys_gamepad {
+	button-thumbl {
+		label = "GPIO Thumb Left";
+		gpios = <&pio 4 8 GPIO_ACTIVE_LOW>; /* PE8 */
+		linux,input-type = <EV_KEY>;
+		linux,code = <BTN_THUMBL>;
+	};
+};
+
+
+/*
+ * TF2 microSD slot.
+ * Power enable: PE4
+ * Card detect:  PE22, active low
+ */
