--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-tf2.dtsi
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+/ {
+	reg_tf2_vcc: regulator-tf2-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "tf2-vcc";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pio 4 4 GPIO_ACTIVE_HIGH>; /* PE4 */
+		enable-active-high;
+	};
+};
+&mmc2 {
+	vmmc-supply = <&reg_tf2_vcc>;
+	cd-gpios = <&pio 4 22 GPIO_ACTIVE_LOW>; /* PE22 */
+	bus-width = <4>;
+	max-frequency = <50000000>;
+	no-sdio;
+	no-mmc;
+	status = "okay";
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-uart5-ph.dtsi
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+/*
+ * Shared UART5 routing on PH2/PH3 for Anbernic H700 boards
+ * using the external RGB controller interface.
+ */
+&pio {
+	uart5_ph_pins: uart5-ph-pins {
+		pins = "PH2", "PH3";
+		function = "uart5";
+	};
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-usb0-otg.dtsi
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+/*
+ * Common USB0 OTG wiring for the Anbernic H700 platform.
+ *
+ * PI4  - USB ID detection
+ * PI16 - switched 5 V VBUS enable
+ *
+ * The AXP717 boost regulator provides the upstream 5 V source.
+ */
+
+/ {
+	reg_usb0_vbus: regulator-usb0-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb0-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_boost>;
+		gpio = <&pio 8 16 GPIO_ACTIVE_HIGH>; /* PI16 */
+		enable-active-high;
+	};
+};
+
+&usbphy {
+	usb0_id_det-gpios =
+		<&pio 8 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PI4 */
+	usb0_vbus_power-supply = <&usb_power>;
+	usb0_vbus-supply = <&reg_usb0_vbus>;
+};
+
+&usbotg {
+	dr_mode = "otg";
+};
