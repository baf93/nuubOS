--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg40xx-v.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg40xx-v.dts
@@ -19,6 +19,36 @@
 
 
 /*
+ * nuubOS suspend power LED coordinator. Runtime keeps PI12 as a normal
+ * GPIO power LED. During s2idle the coordinator releases the GPIO, routes
+ * PWM2 to PI12, and drives a 3 s waveform with 1 s high / 2 s low.
+ */
+&pio {
+	pwm2_pi12_power_led_pin: pwm2-pi12-power-led-pin {
+		pins = "PI12";
+		function = "pwm2";
+	};
+};
+
+&{/leds} {
+	/delete-node/ led-0;
+};
+
+/ {
+	suspend_power_led {
+		compatible = "anbernic,rg40xx-v-power-led";
+
+		pinctrl-names = "sleep";
+		pinctrl-0 = <&pwm2_pi12_power_led_pin>;
+
+		power-led-gpios = <&pio 8 12 GPIO_ACTIVE_HIGH>;
+
+		pwms = <&pwm 2 3000000000 0>;
+		pwm-names = "enable";
+	};
+};
+
+/*
  * nuubOS: RG40XX-V physical X/Y wiring differs from the inherited
  * RG35XX Plus mapping: physical X is PA2 and physical Y is PA3.
  */
