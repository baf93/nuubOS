 / {
+	/*
+	 * Replace the generic PWM3 vibrator so one coordinator owns the
+	 * whole PWM2/PWM3 pair. This is required because both channels
+	 * share the pair clock on H616/H700.
+	 */
+	/delete-node/ pwm-vibrator;
+
 	suspend_power_led {
 		compatible = "anbernic,rg40xx-v-power-led";
 
-		pinctrl-names = "sleep";
-		pinctrl-0 = <&pwm2_pi12_power_led_pin>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&pwm3_pi13_pin>;
+		pinctrl-1 = <&pwm2_pi12_power_led_pin>;
 
 		power-led-gpios = <&pio 8 12 GPIO_ACTIVE_HIGH>;
 
-		pwms = <&pwm 2 3000000000 0>;
-		pwm-names = "enable";
+		pwms = <&pwm 2 3000000000 0>,
+		       <&pwm 3 1000000 0>;
+		pwm-names = "sleep-led", "rumble";
 	};
 };
 
diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index be61d2e..65303c0 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -652,9 +652,10 @@ config INPUT_RG35XX_PRO_HAPTICS
 	depends on ARCH_SUNXI && OF && PWM && GPIOLIB && LEDS_CLASS
 	select INPUT_FF_MEMLESS
 	help
-	  Coordinate H700 handheld power LEDs across system suspend.
-	  On RG35XX Pro this also coordinates the vibration motor because
-	  both functions share PWM2 through different physical pins.
+	  Coordinate H700 handheld power LEDs and vibration PWM ownership.
+	  RG35XX Pro multiplexes both functions on PWM2; RG40XX-V uses
+	  PWM2 for the suspend LED and PWM3 for rumble, with both channels
+	  sharing one hardware pair clock that must be coordinated.
 
 config INPUT_PWM_VIBRA
 	tristate "PWM vibrator support"
