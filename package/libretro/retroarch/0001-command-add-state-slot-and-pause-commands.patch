From: nuubOS <noreply@nuubos.invalid>
Subject: [PATCH] command: SAVE_STATE_SLOT, SET_PAUSED and replies with results

nuubos-emud drives RetroArch through the stdin command interface. Hotkey
commands (SAVE_STATE, PAUSE_TOGGLE, STATE_SLOT_PLUS...) are edge-triggered
input bits that collapse when sent in the same frame and report nothing,
so the session manager cannot know their outcome or keep state in sync.

- SAVE_STATE_SLOT <n>: save to slot n (-1 = automatic slot), like the
  SAVE_STATE_SLOT command of later upstream versions; replies
  "SAVE_STATE_SLOT <n> OK|FAILED".
- LOAD_STATE_SLOT <n>: accepts -1, checks that the state exists and
  replies "LOAD_STATE_SLOT <n> OK|FAILED" terminated by a newline.
- SET_PAUSED <0|1>: explicit pause/unpause, replies the resulting state.

Upstream-Status: Inappropriate [nuubOS session manager integration]
---
--- a/command.c
+++ b/command.c
@@ -743,11 +743,10 @@
    char state_path[PATH_MAX_LENGTH] = "";
    size_t _len                  = 0;
    char reply[128]              = "";
-   unsigned int slot            = (unsigned int)strtoul(arg, NULL, 10);
+   /* -1 is the automatic slot (.state.auto) */
+   int slot                     = (int)strtol(arg, NULL, 10);
    bool savestates_enabled      = core_info_current_supports_savestate();
    bool ret                     = false;
-   _len  = strlcpy(reply, "LOAD_STATE_SLOT ", sizeof(reply));
-   _len += snprintf(reply + _len, sizeof(reply) - _len, "%d", slot);
    if (savestates_enabled)
    {
       size_t info_size;
@@ -756,7 +755,7 @@
       info_size          = core_serialize_size();
       savestates_enabled = (info_size > 0);
    }
-   if (savestates_enabled)
+   if (savestates_enabled && path_is_valid(state_path))
    {
       if ((ret = content_load_state(state_path, false, false)))
          command_post_state_loaded();
@@ -764,10 +763,49 @@
    else
       ret = false;
 
+   _len = snprintf(reply, sizeof(reply), "LOAD_STATE_SLOT %d %s\n",
+         slot, ret ? "OK" : "FAILED");
    cmd->replier(cmd, reply, _len);
    return ret;
 }
 
+/* Saves to the given slot (-1 = automatic slot). The reply only reports
+ * that the state was serialized and its write was queued; the file is
+ * complete when the save task closes it. */
+bool command_save_state_slot(command_t *cmd, const char *arg)
+{
+   char state_path[PATH_MAX_LENGTH] = "";
+   size_t _len                  = 0;
+   char reply[128]              = "";
+   int slot                     = (int)strtol(arg, NULL, 10);
+   bool ret                     = false;
+
+   if (     core_info_current_supports_savestate()
+         && core_serialize_size() > 0
+         && runloop_get_savestate_path(state_path, sizeof(state_path), slot))
+      ret = content_save_state(state_path, true);
+
+   _len = snprintf(reply, sizeof(reply), "SAVE_STATE_SLOT %d %s\n",
+         slot, ret ? "OK" : "FAILED");
+   cmd->replier(cmd, reply, _len);
+   return ret;
+}
+
+/* Explicit pause state for an external session manager (a toggle cannot
+ * be kept in sync from outside). */
+bool command_set_paused(command_t *cmd, const char *arg)
+{
+   char reply[64];
+   size_t _len;
+   bool pause = (strtol(arg, NULL, 10) != 0);
+
+   command_event(pause ? CMD_EVENT_PAUSE : CMD_EVENT_UNPAUSE, NULL);
+   _len = snprintf(reply, sizeof(reply), "SET_PAUSED %d\n",
+         (runloop_state_get_ptr()->flags & RUNLOOP_FLAG_PAUSED) ? 1 : 0);
+   cmd->replier(cmd, reply, _len);
+   return true;
+}
+
 bool command_play_replay_slot(command_t *cmd, const char *arg)
 {
 #ifdef HAVE_BSV_MOVIE
--- a/command.h
+++ b/command.h
@@ -427,6 +427,8 @@
 bool command_get_config_param(command_t *cmd, const char* arg);
 bool command_show_osd_msg(command_t *cmd, const char* arg);
 bool command_load_state_slot(command_t *cmd, const char* arg);
+bool command_save_state_slot(command_t *cmd, const char* arg);
+bool command_set_paused(command_t *cmd, const char* arg);
 bool command_play_replay_slot(command_t *cmd, const char* arg);
 bool command_seek_replay(command_t *cmd, const char *arg);
 bool command_save_savefiles(command_t *cmd, const char* arg);
@@ -457,6 +459,8 @@
    { "WRITE_CORE_MEMORY",command_write_memory,     "<address> <byte1> <byte2> ..." },
 
    { "LOAD_STATE_SLOT",command_load_state_slot, "<slot number>"},
+   { "SAVE_STATE_SLOT",command_save_state_slot, "<slot number>"},
+   { "SET_PAUSED",     command_set_paused,      "<0|1>"},
    { "PLAY_REPLAY_SLOT",command_play_replay_slot, "<slot number>"},
    { "SEEK_REPLAY",command_seek_replay, "<frame number>"},
 
