From: nuubOS <noreply@nuubos.invalid>
Subject: [PATCH] nuubOS viewport placement and GET_FPS command

An overscaled integer picture now crops its overscan evenly instead of
following the viewport bias (nuubOS places smaller pictures at the top
of the screen with a bias of 0).

GET_FPS replies with the frames presented per second since the previous
GET_FPS, for the nuubOS performance overlay.

Upstream-Status: Inappropriate [nuubOS specific]
---
--- a/gfx/video_driver.c
+++ b/gfx/video_driver.c
@@ -2737,6 +2737,12 @@
       height -= padding_y;
    }
 
+   /* nuubOS: an overscaled picture crops its overscan evenly; the bias
+    * only places a picture smaller than the screen. */
+   if (padding_x < 0)
+      vp_bias_x = 0.5f;
+   if (padding_y < 0)
+      vp_bias_y = 0.5f;
    x          += padding_x * vp_bias_x;
    y          += padding_y * vp_bias_y;
 
--- a/command.c
+++ b/command.c
@@ -56,6 +56,8 @@
 #endif
 #include "autosave.h"
 #include "command.h"
+#include "gfx/video_driver.h"
+#include <features/features_cpu.h>
 #include "core_info.h"
 #include "cheat_manager.h"
 #include "content.h"
@@ -805,6 +807,27 @@
    cmd->replier(cmd, reply, _len);
    return true;
 }
+
+/* Frames presented per second since the previous GET_FPS (nuubOS
+ * performance overlay, asked about once a second). */
+bool command_get_fps(command_t *cmd, const char *arg)
+{
+   static uint64_t last_count;
+   static retro_time_t last_time;
+   char reply[64];
+   size_t _len;
+   uint64_t count       = video_state_get_ptr()->frame_count;
+   retro_time_t now     = cpu_features_get_time_usec();
+   double fps           = 0.0;
+
+   if (last_time > 0 && now > last_time && count >= last_count)
+      fps = (double)(count - last_count) * 1000000.0 / (double)(now - last_time);
+   last_count = count;
+   last_time  = now;
+   _len = snprintf(reply, sizeof(reply), "GET_FPS %.1f\n", fps);
+   cmd->replier(cmd, reply, _len);
+   return true;
+}
 
 bool command_play_replay_slot(command_t *cmd, const char *arg)
 {
--- a/command.h
+++ b/command.h
@@ -429,6 +429,7 @@
