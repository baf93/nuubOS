config BR2_PACKAGE_RETROARCH
	bool "retroarch"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_HAS_LIBEGL
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_ZLIB
	help
	  RetroArch, the libretro frontend used by nuubOS as its
	  emulation backend (EPIC-013). Built for Wayland + EGL/GLES
	  (Mesa Panfrost), udev joypads, ALSA/PipeWire audio and the
	  stdin command interface driven by nuubos-emud. No X11, SDL,
	  Vulkan, FFmpeg, Qt or network command interface.

	  https://www.retroarch.com
