+/* -control: machine readable "@event key=value" lines on stdout for the
+ * process that runs the session, commands on stdin. */
+static bool control;
+
+static void report(const char* format, ...) {
+  va_list ap;
+
+  if (!control)
+    return;
+  va_start(ap, format);
+  vprintf(format, ap);
+  va_end(ap);
+  putchar('\n');
+  fflush(stdout);
+}
+
+static void report_stats(PCONFIGURATION config) {
+  uint32_t rtt = 0, rtt_var = 0;
+  bool have_rtt = LiGetEstimatedRttInfo(&rtt, &rtt_var);
+
+  #ifdef HAVE_WAYLAND
+  struct wayland_video_stats v;
+  wayland_video_stats(&v);
+  report("@stats rtt=%d rtt_var=%d width=%d height=%d fps=%d bitrate=%d decoded=%llu presented=%llu skipped=%llu errors=%llu decode_us=%llu latency_us=%llu",
+         have_rtt ? (int) rtt : -1, have_rtt ? (int) rtt_var : -1,
+         config->stream.width, config->stream.height, config->stream.fps, config->stream.bitrate,
+         (unsigned long long) v.decoded, (unsigned long long) v.presented, (unsigned long long) v.skipped,
+         (unsigned long long) v.decode_errors, (unsigned long long) v.decode_us_total,
+         (unsigned long long) v.receive_to_present_us_total);
+  #else
+  report("@stats rtt=%d rtt_var=%d width=%d height=%d fps=%d bitrate=%d",
+         have_rtt ? (int) rtt : -1, have_rtt ? (int) rtt_var : -1,
+         config->stream.width, config->stream.height, config->stream.fps, config->stream.bitrate);
+  #endif
+}
+
+static PCONFIGURATION control_config;
+static char control_line[128];
+static size_t control_used;
+
+static int control_handler(int fd) {
+  char buf[128];
+  ssize_t n = read(fd, buf, sizeof(buf));
+
+  if (n <= 0)
+    return LOOP_RETURN; // The controlling process is gone: end the session
+  for (ssize_t i = 0; i < n; i++) {
+    if (buf[i] != '\n') {
+      if (control_used + 1 < sizeof(control_line))
+        control_line[control_used++] = buf[i];
+      continue;
+    }
+    control_line[control_used] = 0;
+    control_used = 0;
+    if (strcmp(control_line, "QUIT") == 0)
+      return LOOP_RETURN;
+    if (strcmp(control_line, "STATS") == 0)
+      report_stats(control_config);
+  }
+  return LOOP_OK;
+}
+
