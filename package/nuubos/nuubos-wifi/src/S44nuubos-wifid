#!/bin/sh

DAEMON=/usr/sbin/nuubos-wifid
PIDFILE=/run/nuubos/wifid.pid
WPA_CONF=/state/network/wpa_supplicant.conf
ENABLED_FILE=/state/network/wifi/enabled

pid_command()
{
    PID="$1"
    [ -n "$PID" ] || return 1
    [ -r "/proc/$PID/cmdline" ] || return 1
    tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p'
}

wifid_running()
{
    [ -r "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ "$(pid_command "$PID")" = "$DAEMON" ]
}

wifi_enabled()
{
    [ -r "$ENABLED_FILE" ] || return 0
    [ "$(sed -n '1p' "$ENABLED_FILE" 2>/dev/null)" != "0" ]
}

ensure_wpa()
{
    wifi_enabled || return 0
    # S02nuubos-probe loads the Wi-Fi driver in the background: wait for
    # the interface while it is at it (at most 5 s), never on a device
    # without Wi-Fi.
    I=0
    while [ ! -d /sys/class/net/wlan0 ] && [ -e /run/nuubos/wifi-probing ] && [ "$I" -lt 100 ]; do
        sleep 0.05
        I=$((I + 1))
    done
    [ -d /sys/class/net/wlan0 ] || return 0

    ip link set wlan0 up >/dev/null 2>&1 || true

    if wpa_cli -i wlan0 ping 2>/dev/null | grep -q '^PONG'; then
        return 0
    fi

    # Clean STATE (first boot, Reset): start with the same base config
    # wifid writes (rewrite_wpa_config), so scanning works before any
    # network is saved and wifid and the status listener can attach.
    if [ ! -e "$WPA_CONF" ]; then
        mkdir -p "${WPA_CONF%/*}"
        (umask 077 && printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n' > "$WPA_CONF") || return 0
    fi
    [ -r "$WPA_CONF" ] || return 0
    # The regulatory domain follows the user's region (regionald); drop
    # the fixed country older releases wrote.
    (umask 077 && sed -i '/^country=/d' "$WPA_CONF") 2>/dev/null || true
    wpa_supplicant -B -D nl80211 -i wlan0 -c "$WPA_CONF" >/dev/null 2>&1 || true
}

start_service()
{
    mkdir -p /run/nuubos
    ensure_wpa

    if ! wifid_running; then
        rm -f "$PIDFILE"
        # wifid logs to stderr (power save, roaming, WPA3 upgrade); -b alone
        # sent it to /dev/null. exec keeps the pid in the pid file.
        start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh -- \
            -c "exec $DAEMON >>/run/nuubos/wifid.log 2>&1"
        RC=$?
        if [ "$RC" -ne 0 ]; then
            echo "nuubOS Wi-Fi: failed to start wifid" >&2
            return "$RC"
        fi
    fi

    return 0
}

stop_service()
{
    if wifid_running; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"
        kill -TERM "$PID" 2>/dev/null || true
    fi

    rm -f "$PIDFILE"
    return 0
}

case "${1:-}" in
    start)
        if [ -e /run/nuubos/booting ]; then
            # Boot (docs/dev/platform.md "Boot time"): waiting for the
            # firmware and wpa_supplicant (~1 s) runs alongside the rest of
            # the boot. statusd's wpa_cli event listener needs a running
            # wpa_supplicant: when statusd started first, start the listener
            # again now (an association takes longer than this).
            (
                start_service
                if [ -r /run/nuubos/statusd.pid ] && \
                    kill -0 "$(cat /run/nuubos/statusd.pid)" 2>/dev/null; then
                    /etc/init.d/S48nuubos-status start
                fi
            ) </dev/null >/dev/null 2>&1 &
            exit 0
        fi
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service
        start_service
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac

exit 0
