#!/bin/sh

IFACE="${interface:-wlan0}"
RESOLV=/run/resolv.conf

netmask_to_prefix()
{
    MASK="$1"
    OLDIFS="$IFS"
    IFS=.
    set -- $MASK
    IFS="$OLDIFS"

    PREFIX=0
    for OCTET in "$@"; do
        case "$OCTET" in
            255) BITS=8 ;;
            254) BITS=7 ;;
            252) BITS=6 ;;
            248) BITS=5 ;;
            240) BITS=4 ;;
            224) BITS=3 ;;
            192) BITS=2 ;;
            128) BITS=1 ;;
            0) BITS=0 ;;
            *) echo 24; return 0 ;;
        esac
        PREFIX=$((PREFIX + BITS))
    done
    echo "$PREFIX"
}

write_dns()
{
    : > "$RESOLV"
    for SERVER in ${dns:-}; do
        printf 'nameserver %s\n' "$SERVER" >> "$RESOLV"
    done
    chmod 644 "$RESOLV" 2>/dev/null || true
}

case "${1:-}" in
    deconfig)
        ip -4 addr flush dev "$IFACE" 2>/dev/null || true
        ip route del default dev "$IFACE" 2>/dev/null || true
        ;;
    bound|renew)
        PREFIX="$(netmask_to_prefix "${subnet:-255.255.255.0}")"
        ip -4 addr flush dev "$IFACE" 2>/dev/null || true
        ip link set "$IFACE" up 2>/dev/null || true
        ip addr add "$ip/$PREFIX" dev "$IFACE" 2>/dev/null || exit 1
        ip route del default dev "$IFACE" 2>/dev/null || true
        if [ -n "${router:-}" ]; then
            set -- $router
            ip route replace default via "$1" dev "$IFACE" 2>/dev/null || true
        fi
        write_dns
        ;;
esac

PID="$(cat /run/nuubos/wifid.pid 2>/dev/null)"
if [ -n "$PID" ] && [ -r "/proc/$PID/cmdline" ]; then
    CMD="$(tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p')"
    if [ "$CMD" = "/usr/sbin/nuubos-wifid" ]; then
        kill -USR1 "$PID" 2>/dev/null || true
    fi
fi

exit 0
