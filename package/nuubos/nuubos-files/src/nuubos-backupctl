#!/bin/sh
# nuubOS user Backup & Restore (EPIC-035). Independent from Syncthing.
#
#   backup USER DESTDIR [screenshots] [appdata]
#                                 nuubos-backup-<name>-<UTC>.tar in DESTDIR
#   restore FILE TARGET_USER      validate, then replace TARGET_USER's data
#   list DIR...                   backup=<path>\t<user name>\t<created>\t<bytes> ... end=1
#
# A backup holds one profile: settings (STATE, never the secrets folder),
# saves, save states and library statistics/favorites/collections; with the
# options also screenshots and application data. ROMs and BIOS are never
# included. Format: a tar with MANIFEST (format=1) and SHA256SUMS.
#
# Restore checks format and every checksum in a staging folder first; the
# live data is replaced only afterwards, folder by folder, and every replaced
# folder is put back if a step fails. The profile's identity (id, name,
# picture) is kept: a backup can be restored into any profile. Refused while
# a game runs. Run as nuubos-jobd workers (@progress/@result/@error).
# NUUBOS_ROOT prefixes paths for the host test.

R="${NUUBOS_ROOT:-}"
STATE_USERS="$R/state/users"
USERDATA_USERS="$R/userdata/users"
FORMAT=1
DATA_DIRS="saves states library"
STATE_FILES="settings.conf localization.conf lighting.conf input-feedback.conf controllers.conf"

job() { [ -n "${NUUBOS_JOB_ID:-}" ]; }
progress() { job && echo "@progress $1"; return 0; }
fail() { if job; then echo "@error $1"; else echo "ERR $1"; fi; exit 1; }
valid_uuid() { printf '%s' "$1" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; }
user_name() { sed -n 's/^USER_NAME=//p' "$STATE_USERS/$1/profile.conf" 2>/dev/null | head -n 1; }

backup()
{
    user="$1"; dest="$2"; shift 2
    valid_uuid "$user" && [ -f "$STATE_USERS/$user/profile.conf" ] || fail user
    [ -d "$dest" ] && [ -w "$dest" ] || fail destination
    extra=""
    for opt in "$@"; do
        case "$opt" in screenshots|appdata) extra="$extra $opt" ;; *) fail option ;; esac
    done
    name="$(user_name "$user" | tr -c 'A-Za-z0-9_-' '_' | cut -c1-24)"
    stamp="$(date -u '+%Y%m%d-%H%M%S')"
    file="nuubos-backup-${name:-user}-$stamp.tar"
    stage="$(mktemp -d "$dest/.nuubos-backup.XXXXXX")" || fail storage
    trap 'rm -rf "$stage" "$dest/$file.part"' EXIT
    trap 'rm -rf "$stage" "$dest/$file.part"; exit 1' INT TERM

    progress 5
    mkdir -p "$stage/state" "$stage/userdata"
    for f in $STATE_FILES; do
        [ -f "$STATE_USERS/$user/$f" ] && cp "$STATE_USERS/$user/$f" "$stage/state/"
    done
    [ -d "$STATE_USERS/$user/controllers" ] && cp -r "$STATE_USERS/$user/controllers" "$stage/state/"
    contents=""
    for d in $DATA_DIRS $extra; do
        if [ -d "$USERDATA_USERS/$user/$d" ]; then
            cp -r "$USERDATA_USERS/$user/$d" "$stage/userdata/" || fail storage
            contents="$contents $d"
        fi
    done
    progress 50
    {
        echo "format=$FORMAT"
        echo "product=nuubOS"
        echo "version=$(sed -n 's/^VERSION_ID=//p' "$R/etc/os-release" 2>/dev/null | tr -d '"')"
        echo "created=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        echo "user_id=$user"
        echo "user_name=$(user_name "$user")"
        echo "contents=${contents# }"
    } > "$stage/MANIFEST"
    ( cd "$stage" && find state userdata -type f | sort | while IFS= read -r f; do sha256sum "$f"; done ) \
        > "$stage/SHA256SUMS" || fail storage
    progress 70
    tar -C "$stage" -cf "$dest/$file.part" MANIFEST SHA256SUMS state userdata 2>/dev/null || fail storage
    mv "$dest/$file.part" "$dest/$file" || fail storage
    sync
    if job; then echo "@result $dest/$file"; else echo "OK $dest/$file"; fi
}

restore()
{
    file="$1"; target="$2"
    valid_uuid "$target" && [ -f "$STATE_USERS/$target/profile.conf" ] || fail user
    [ -f "$file" ] || fail file
    if command -v nuubos-emuctl >/dev/null 2>&1 &&
       nuubos-emuctl status 2>/dev/null | grep -q '^state=running'; then
        fail busy
    fi
    mkdir -p "$USERDATA_USERS/$target" || fail storage
    stage="$(mktemp -d "$USERDATA_USERS/$target/.nuubos-restore.XXXXXX")" || fail storage
    trap 'rm -rf "$stage"' EXIT
    trap 'rm -rf "$stage"; exit 1' INT TERM

    progress 5
    # A crafted archive must not write outside the staging folder: no
    # absolute or ".." names, no links.
    tar -tf "$file" 2>/dev/null > "$stage/.list" || fail archive
    if grep -Eq '^/|(^|/)\.\.(/|$)' "$stage/.list" ||
       tar -tvf "$file" 2>/dev/null | grep -q '^[lh]'; then
        fail archive
    fi
    rm -f "$stage/.list"
    tar -C "$stage" -xf "$file" 2>/dev/null || fail archive
    # Only the expected layout: nothing outside state/ and userdata/.
    [ "$(sed -n 's/^format=//p' "$stage/MANIFEST" 2>/dev/null)" = "$FORMAT" ] || fail format
    if ( cd "$stage" && find . -mindepth 1 -maxdepth 1 ! -name MANIFEST ! -name SHA256SUMS \
           ! -name state ! -name userdata | grep -q . ); then
        fail archive
    fi
    progress 30
    ( cd "$stage" && sha256sum -c SHA256SUMS >/dev/null 2>&1 ) || fail checksum
    ( cd "$stage" && find state userdata -type f | sort ) > "$stage/.files"
    [ "$(wc -l < "$stage/.files")" = "$(wc -l < "$stage/SHA256SUMS")" ] || fail checksum
    progress 60

    # Replace folder by folder; remember what was moved to roll back.
    moved=""
    rollback()
    {
        for d in $moved; do
            rm -rf "${USERDATA_USERS:?}/$target/$d"
            mv "$stage/old/$d" "$USERDATA_USERS/$target/$d"
        done
    }
    mkdir -p "$stage/old"
    for d in $(ls "$stage/userdata" 2>/dev/null); do
        case "$d" in saves|states|library|screenshots|appdata) ;; *) continue ;; esac
        if [ -e "$USERDATA_USERS/$target/$d" ]; then
            mv "$USERDATA_USERS/$target/$d" "$stage/old/$d" || { rollback; fail storage; }
        else
            mkdir -p "$stage/old/$d"
        fi
        moved="$moved $d"
        if ! mv "$stage/userdata/$d" "$USERDATA_USERS/$target/$d"; then
            rollback
            fail storage
        fi
    done
    # Settings: the backup's files replace the profile's (identity kept).
    for f in $STATE_FILES; do
        if [ -f "$stage/state/$f" ]; then
            cp "$stage/state/$f" "$STATE_USERS/$target/$f.tmp" && chmod 600 "$STATE_USERS/$target/$f.tmp" &&
                mv "$STATE_USERS/$target/$f.tmp" "$STATE_USERS/$target/$f" || { rollback; fail storage; }
        fi
    done
    if [ -d "$stage/state/controllers" ]; then
        rm -rf "${STATE_USERS:?}/$target/controllers.new"
        cp -r "$stage/state/controllers" "$STATE_USERS/$target/controllers.new" &&
            rm -rf "${STATE_USERS:?}/$target/controllers" &&
            mv "$STATE_USERS/$target/controllers.new" "$STATE_USERS/$target/controllers"
    fi
    sync
    active="$(cat "$R/run/nuubos/user/active" 2>/dev/null)"
    if [ "$active" = "$target" ]; then r="restart-required"; else r="restored"; fi
    if job; then echo "@result $r"; else echo "OK $r"; fi
}

list()
{
    for dir in "$@"; do
        for f in "$dir"/nuubos-backup-*.tar; do
            [ -f "$f" ] || continue
            m="$(tar -xOf "$f" MANIFEST 2>/dev/null)"
            [ "$(printf '%s\n' "$m" | sed -n 's/^format=//p')" = "$FORMAT" ] || continue
            printf 'backup=%s\t%s\t%s\t%s\n' "$f" \
                "$(printf '%s\n' "$m" | sed -n 's/^user_name=//p' | tr '\t' ' ')" \
                "$(printf '%s\n' "$m" | sed -n 's/^created=//p')" "$(wc -c < "$f")"
        done
    done
    echo "end=1"
}

case "${1:-}" in
    backup) shift; [ $# -ge 2 ] || fail usage; backup "$@" ;;
    restore) [ $# -eq 3 ] || fail usage; restore "$2" "$3" ;;
    list) shift; list "$@" ;;
    *) echo "Usage: nuubos-backupctl backup USER DESTDIR [screenshots] [appdata] | restore FILE USER | list DIR..." >&2; exit 2 ;;
esac
