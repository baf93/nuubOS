config BR2_PACKAGE_NUUBOS_FILES
	bool "nuubos-files"
	depends on BR2_USE_MMU
	select BR2_PACKAGE_NUUBOS_JOBS
	help
	  EPIC-031/032/035/036 and USB storage (EPIC-024): File Manager
	  operations (nuubos-filesctl), removable media mount/eject
	  (nuubos-mediactl), SMB network shares (nuubos-sharesctl) and
	  per-user Backup & Restore (nuubos-backupctl), long operations
	  as nuubos-jobd jobs.
