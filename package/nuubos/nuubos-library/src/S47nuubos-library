#!/bin/sh
# nuubOS Game Library service: catalog, ROM discovery, play history and
# applications. Starts after usersd (active user) and before the UI.

DAEMON=/usr/sbin/nuubos-libraryd
PIDFILE=/run/nuubos/libraryd.pid
SOCKET=/run/nuubos/libraryd.sock

libraryd_running()
{
    [ -r "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$PID" ] || return 1
    [ "$(tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p')" = "$DAEMON" ]
}

start_service()
{
    mkdir -p /run/nuubos
    libraryd_running && return 0
    rm -f "$PIDFILE" "$SOCKET"
    "$DAEMON" >>/run/nuubos/libraryd.log 2>&1 &
    return 0
}

stop_service()
{
    if libraryd_running; then
        kill -TERM "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true
    fi
    rm -f "$PIDFILE" "$SOCKET"
    return 0
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
