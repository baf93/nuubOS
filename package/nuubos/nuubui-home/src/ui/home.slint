                    title: device.name;
                    detail: device.kind == "controller" ? root.i18n-strings[14]
                        : device.kind == "headphones" ? root.i18n-strings[330] : root.i18n-strings[161];
                    value: device.battery >= 0 ? device.battery + "%" : root.i18n-strings[205];
                    show-slider: device.battery >= 0;
                    slider-fraction: device.battery / 100;
                    selected: root.settings-view == 69 && root.power-index == root.power-devices-start + k;
                    visible: root.page-power
                        && root.sec-row-visible(root.power-devices-start + k, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.power-devices-start, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[825];
                    enabled: false;
                    selected: root.settings-view == 69 && root.power-index == root.power-devices-start;
                    visible: root.page-power && root.power-devices.length == 0
                        && root.sec-row-visible(root.power-devices-start, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }

                /* ----------------------------------------------------------- System */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.system-support-start, root.system-scroll-offset, root.system-support-start, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[733];
                    scope-label: root.i18n-strings[313];
                    visible: root.page-system
                        && root.system-scroll-offset < root.system-support-start
                        && root.sec-row-visible(root.system-support-start, root.system-scroll-offset, root.system-support-start, 0, 0);
                }
                for row[k] in [
                    { title: root.i18n-strings[19], value: root.system-storage-summary },
                    { title: root.i18n-strings[651], value: "" },
                    { title: root.i18n-strings[20], value: "" },
                    { title: root.i18n-strings[498], value: "" },
                    { title: root.i18n-strings[982], value: "" },
                    { title: root.i18n-strings[499], value: root.safe-mode ? root.i18n-strings[518] : "" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.system-scroll-offset, root.system-support-start, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    navigates: true;
                    selected: root.settings-view == 19 && root.system-index == k;
                    visible: root.page-system
                        && root.sec-row-visible(k, root.system-scroll-offset, root.system-support-start, 0, 0);
                }

                /* Live System Information. All rows are selectable for consistent
                 * controller navigation, but Confirm intentionally performs no action. */
                for row[k] in [
                    { title: "nuubOS", value: root.system-version + " • " + root.system-build },
                    { title: root.i18n-strings[98], value: root.system-device-model },
                    { title: root.i18n-strings[99], value: root.system-kernel },
                    { title: root.i18n-strings[100], value: root.battery-state == "absent" ? root.i18n-strings[1301] : root.battery-percent >= 0 ? root.battery-percent + "% • " + root.battery-state : root.i18n-strings[205] },
                    { title: root.i18n-strings[101], value: root.system-cpu-clock + " • " + root.system-cpu-temperature },
                    { title: root.i18n-strings[102], value: root.system-gpu-clock + " • " + root.system-gpu-temperature },
                    { title: root.i18n-strings[103], value: root.system-network },
                    { title: root.i18n-strings[19], value: root.system-storage-usage },
                    { title: root.i18n-strings[104], value: root.system-memory },
                    { title: root.i18n-strings[105], value: root.system-uptime },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.system-info-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    title-fraction: 0.30;
                    selected: root.settings-view == 21 && root.system-info-index == k;
                    visible: root.settings-view == 21
                        && root.srow-visible(k, root.system-info-scroll-offset, root.settings-list-visible-rows);
                }

                /* Diagnostics: one action and the read-only output location. */
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[500];
                    value: root.diag-busy ? root.i18n-strings[501] : "";
                    detail: root.i18n-strings[504];
                    selected: root.settings-view == 27 && root.diag-index == 0;
                    visible: root.settings-view == 27;
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[1350];
                    value: root.diag-mode-value;
                    detail: root.i18n-strings[1352];
                    selected: root.settings-view == 27 && root.diag-index == 1;
                    visible: root.settings-view == 27;
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(2, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[521];
                    value: "USERDATA/diagnostics";
                    selected: root.settings-view == 27 && root.diag-index == 2;
                    visible: root.settings-view == 27;
                }


                /* Data-driven pages: inline headers of the second, third
                 * and fourth sections while they are below the top. */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.gen-split, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.gen-split-label;
                    scope-label: root.gen-scopes.length > 1 ? root.gen-scopes[1] : root.settings-section-scope;
                    visible: root.gen-view
                        && root.gen-split > 0 && root.gen-scroll < root.gen-split
                        && root.sec-row-visible(root.gen-split, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3);
                }
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.gen-split2, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.gen-split2-label;
                    scope-label: root.gen-scopes.length > 2 ? root.gen-scopes[2] : root.settings-section-scope;
                    visible: root.gen-view
                        && root.gen-split2 > 0 && root.gen-scroll < root.gen-split2
                        && root.sec-row-visible(root.gen-split2, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3);
                }
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.gen-split3, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.gen-split3-label;
                    scope-label: root.gen-scopes.length > 3 ? root.gen-scopes[3] : root.settings-section-scope;
                    visible: root.gen-view
                        && root.gen-split3 > 0 && root.gen-scroll < root.gen-split3
                        && root.sec-row-visible(root.gen-split3, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3);
                }
                for row[k] in root.gen-rows: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    navigates: row.navigates;
                    toggle: row.toggle;
                    toggle-on: row.toggle-on;
                    enabled: row.enabled;
                    armed: row.armed;
                    progress-shown: row.progress-shown;
                    progress: row.progress;
                    selected: root.gen-index == k;
                    visible: root.gen-view
                        && (root.gen-split > 0 ? root.sec-row-visible(k, root.gen-scroll, root.gen-split, root.gen-split2, root.gen-split3)
                            : root.srow-visible(k, root.gen-scroll, root.settings-list-visible-rows));
                }

                /* ---------------------------------------------- Controllers & Input */
                /* CONTROLLERS (Player Assignment, Controllers), then RUMBLE &
                 * LIGHTING (Internal Rumble, RGB Lighting). Without RGB
                 * hardware the RGB Lighting row is gone and the section is
                 * RUMBLE. */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(3, root.controllers-menu-scroll-offset, 3, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[root.lighting-supported ? 735 : 899];
                    scope-label: root.i18n-strings[312];
                    visible: root.page-controllers
                        && root.controllers-menu-scroll-offset < 3
                        && root.sec-row-visible(3, root.controllers-menu-scroll-offset, 3, 0, 0);
                }
                for row[k] in [
                    { title: root.i18n-strings[13], value: root.i18n-strings[111], enabled: true, toggle: false, detail: "" },
                    { title: root.i18n-strings[14], value: root.controllers.length + root.i18n-strings[219], enabled: true, toggle: false, detail: "" },
                    {
                        title: root.i18n-strings[1371],
                        value: "",
                        enabled: true,
                        toggle: true,
                        detail: root.i18n-strings[1372],
                    },
                    {
                        title: root.i18n-strings[1407],
                        value: root.rumble-mode-label,
                        enabled: true,
                        toggle: false,
                        detail: "",
                    },
                    {
                        title: root.i18n-strings[18],
                        value: root.lighting-supported ? root.lighting-effect-label : root.i18n-strings[205],
                        enabled: root.lighting-supported,
                        toggle: false,
                        detail: "",
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.controllers-menu-scroll-offset, 3, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    toggle: row.toggle;
                    toggle-on: k == 2 && root.action-button-swapped;
                    enabled: row.enabled;
                    navigates: row.enabled && !row.toggle;
                    selected: root.settings-view == 10 && root.controllers-menu-index == k;
                    visible: root.page-controllers
                        && root.sec-row-visible(k, root.controllers-menu-scroll-offset, 3, 0, 0)
                        && (k != 4 || root.lighting-supported);
                }

                /* Preferred player assignment. */
                for assignment[i] in root.player-assignments: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.player-assignment-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[220] + assignment.player;
                    value: assignment.controller-name == "" ? root.i18n-strings[122] : assignment.controller-name
                        + (assignment.available ? "" : root.i18n-strings[221]);
                    selected: root.settings-view == 11 && root.player-assignment-index == i;
                    visible: root.settings-view == 11
                        && root.srow-visible(i, root.player-assignment-scroll-offset, root.settings-list-visible-rows);
                }

                /* Available controller inventory. */
                for controller[i] in root.controllers: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.controller-list-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: controller.name;
                    value: controller.effective-player > 0 ? "P" + controller.effective-player : controller.transport;
                    navigates: true;
                    emphasized: controller.connected;
                    selected: root.settings-view == 12 && root.controller-list-index == i;
                    visible: root.settings-view == 12
                        && root.srow-visible(i, root.controller-list-scroll-offset, root.settings-list-visible-rows);
                }

                for row[k] in [root.i18n-strings[16], root.i18n-strings[15]]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row;
                    navigates: true;
                    selected: root.settings-view == 13 && root.controller-detail-index == k;
                    visible: root.settings-view == 13;
                }

                /* Per-controller Input Tester: the controller drawing fills
                 * the page above the last-input chip and the exit combo. */
                tester-visual := ControllerTesterVisual {
                    x: root.settings-content-x;
                    y: root.settings-content-y;
                    width: root.settings-content-width;
                    height: min(root.settings-content-width * 200 / 360,
                        max(120px, root.settings-list-bottom - root.settings-content-y
                            - root.settings-row-height - 2 * root.settings-row-gap - 28px));
                    visible: root.settings-view == 14;
                    face-south: root.tester-face-south;
                    face-east: root.tester-face-east;
                    face-north: root.tester-face-north;
                    face-west: root.tester-face-west;
                    dpad-up: root.tester-dpad-up;
                    dpad-down: root.tester-dpad-down;
                    dpad-left: root.tester-dpad-left;
                    dpad-right: root.tester-dpad-right;
                    l1: root.tester-l1; r1: root.tester-r1;
                    l2: root.tester-l2; r2: root.tester-r2;
                    l3: root.tester-l3; r3: root.tester-r3;
                    start: root.tester-start;
                    select: root.tester-select;
                    hotkey: root.tester-hotkey;
                    left-x: root.tester-left-x; left-y: root.tester-left-y;
                    right-x: root.tester-right-x; right-y: root.tester-right-y;
                    left-trigger: root.tester-left-trigger;
                    right-trigger: root.tester-right-trigger;
                }
                /* Last input: logical control • physical source. */
                Rectangle {
                    x: root.settings-content-x;
                    y: tester-visual.y + tester-visual.drawn-height + root.settings-row-gap;
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    border-radius: Shape.medium;
                    background: Theme.surface-container-high;
                    visible: root.settings-view == 14;
                    MarqueeText {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        label: root.tester-action;
                        text-color: Theme.text;
                        text-size: 18px;
                        text-weight: 700;
                        align-center: true;
                    }
                }
                /* Exit combo: the tester owns every control of this
                 * controller, so Back cannot leave the page. */
                HorizontalLayout {
                    x: root.settings-content-x;
                    y: tester-visual.y + tester-visual.drawn-height + root.settings-row-height + 2 * root.settings-row-gap;
                    width: root.settings-content-width;
                    height: 28px;
                    alignment: center;
                    spacing: 8px;
                    visible: root.settings-view == 14;
                    VerticalLayout { alignment: center; MenuActionHint { } }
                    Text { text: "+"; color: Theme.text-secondary; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                    VerticalLayout { alignment: center; StartActionHint { } }
                    Text {
                        text: root.i18n-strings[740];
                        color: Theme.text-secondary;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 0;
                    }
                }

                /* Controller Mapping: buttons, stick axes with their deadzones and
                 * Restore Default Mapping are rows of one service-ordered list. */
                for mapping[i] in root.controller-mapping: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.controller-mapping-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: mapping.label;
                    /* The capture prompt itself is the page notice line. */
                    value: root.controller-remap-waiting && root.controller-mapping-index == i ? "…"
                        : mapping.kind == 2 ? (mapping.control == "left_deadzone" ? root.controller-left-deadzone : root.controller-right-deadzone) + "%"
                        : mapping.value;
                    detail: mapping.kind == 3 && root.controller-mapping-reset-armed ? root.i18n-strings[366] : "";
                    armed: mapping.kind == 3 && root.controller-mapping-reset-armed;
                    selected: root.settings-view == 15 && root.controller-mapping-index == i;
                    visible: root.settings-view == 15
                        && root.srow-visible(i, root.controller-mapping-scroll-offset, root.settings-list-visible-rows);
                }

                /* Vibration Intensity (every controller), Test Rumble (the
                 * built-in motor). */
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(0, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[1402];
                    value: root.rumble-mode-label;
                    detail: root.rumble-mode == "light" ? root.i18n-strings[1405]
                        : root.rumble-mode == "strong" ? root.i18n-strings[1406] : "";
                    selected: root.settings-view == 16 && root.rumble-index == 0;
                    visible: root.settings-view == 16;
                }
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(1, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[125];
                    enabled: root.rumble-mode != "off";
                    selected: root.settings-view == 16 && root.rumble-index == 1;
                    visible: root.settings-view == 16 && root.rumble-supported;
                }

                /* RGB Lighting: LIGHTING (0-3) | SYSTEM SIGNALS (4-8). */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(4, root.lighting-scroll-offset, 4, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[129];
                    scope-label: root.i18n-strings[312];
                    visible: root.settings-view == 17 && root.lighting-scroll-offset < 4
                        && root.sec-row-visible(4, root.lighting-scroll-offset, 4, 0, 0);
                }
                for row[k] in [
                    {
                        title: root.i18n-strings[126], detail: root.i18n-strings[root.lighting-effect-detail-index(root.lighting-effect)],
                        value: root.lighting-effect-label, enabled: true, toggle: false, on: false, swatch: false,
                    },
                    {
                        title: root.i18n-strings[128], detail: "",
                        value: root.lighting-color-capable ? root.i18n-strings[root.lighting-color-index(root.lighting-color)] : root.i18n-strings[122],
                        enabled: root.lighting-color-capable, toggle: false, on: false, swatch: root.lighting-color-capable,
                    },
                    {
                        title: root.i18n-strings[127], detail: "", value: root.lighting-brightness + "%",
                        enabled: true, toggle: false, on: false, swatch: false,
                    },
                    {
                        title: root.i18n-strings[121], detail: "",
                        value: !root.lighting-speed-capable ? root.i18n-strings[205]
                            : root.lighting-speed == "slow" ? root.i18n-strings[144]
                            : root.lighting-speed == "fast" ? root.i18n-strings[146] : root.i18n-strings[145],
                        enabled: root.lighting-speed-capable, toggle: false, on: false, swatch: false,
                    },
                    { title: root.i18n-strings[147], detail: root.i18n-strings[151], value: "", enabled: true, toggle: true, on: mod(root.lighting-signals, 2) == 1, swatch: false },
                    { title: root.i18n-strings[100], detail: root.i18n-strings[152], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 2), 2) == 1, swatch: false },
                    { title: root.i18n-strings[148], detail: root.i18n-strings[153], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 4), 2) == 1, swatch: false },
                    { title: root.i18n-strings[149], detail: root.i18n-strings[154], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 8), 2) == 1, swatch: false },
                    { title: root.i18n-strings[150], detail: root.i18n-strings[155], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 16), 2) == 1, swatch: false },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.lighting-scroll-offset, 4, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    detail: row.detail;
                    value: row.value;
                    enabled: row.enabled;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    show-swatch: row.swatch;
                    swatch: root.lighting-color == "theme" ? Theme.accent : root.lighting-swatch;
                    selected: root.settings-view == 17 && root.lighting-index == k;
                    visible: root.settings-view == 17
                        && root.sec-row-visible(k, root.lighting-scroll-offset, 4, 0, 0);
                }

                /* --------------------------------------------------- Display & Audio */
                for section[i] in [
                    { start: root.da-audio-start, label: root.i18n-strings[729], shown: true, scope: root.i18n-strings[313] },
                    { start: root.da-sounds-start, label: root.i18n-strings[730], shown: true, scope: root.i18n-strings[313] },
                    /* Casting preferences belong to the user (castd, appdata/cast). */
                    { start: root.da-cast-start, label: root.i18n-strings[1224], shown: root.cast-available, scope: root.i18n-strings[312] },
                ]: SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(section.start, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, root.da-cast-section) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: section.label;
                    scope-label: section.scope;
                    visible: section.shown && root.page-display-audio
                        && root.display-audio-scroll-offset < section.start
                        && root.sec-row-visible(section.start, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, root.da-cast-section);
                }
                for row[k] in [
                    {
                        pos: 0,
                        title: root.i18n-strings[127],
                        value: root.display-brightness-available ? root.display-brightness + "%" : root.i18n-strings[132],
                        enabled: root.display-brightness-available, toggle: false, on: false, shown: true,
                        slider: root.display-brightness-available, fraction: root.display-brightness / 100,
                    },
                    {
                        pos: 1,
                        title: root.i18n-strings[143],
                        value: root.display-color-temperature + root.i18n-strings[224],
                        enabled: true, toggle: false, on: false,
                        shown: root.display-color-temperature-available, slider: false, fraction: 0,
                    },
                    { pos: root.da-audio-start, title: root.i18n-strings[133], value: root.audio-output-label, enabled: true, toggle: false, on: false, shown: true, slider: false, fraction: 0 },
                    {
                        pos: root.da-audio-start + 1,
                        title: root.i18n-strings[134],
                        value: !root.audio-volume-supported ? (root.audio-selected == "hdmi" || root.audio-selected == "cast" ? root.i18n-strings[223] : root.i18n-strings[205])
                            : root.audio-volume == 0 ? root.i18n-strings[812] : root.audio-volume + "%",
                        enabled: root.audio-volume-supported, toggle: false, on: false, shown: true,
                        slider: root.audio-volume-supported, fraction: root.audio-volume / 100,
                    },
                    { pos: root.da-audio-start + 2, title: root.i18n-strings[1418], value: root.volume-step + "%", enabled: true, toggle: false, on: false, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-audio-start + 3, title: root.i18n-strings[135], value: root.applications-volume == 0 ? root.i18n-strings[812] : root.applications-volume + "%", enabled: true, toggle: false, on: false, shown: true, slider: true, fraction: root.applications-volume / 100 },
                    /* Home Music On/Off (user request 2026-10-28), then its volume. */
                    { pos: root.da-audio-start + 4, title: root.i18n-strings[139], value: "", enabled: true, toggle: true, on: root.home-music-enabled, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-audio-start + 5, title: root.i18n-strings[1116], value: root.home-music-volume == 0 ? root.i18n-strings[812] : root.home-music-volume + "%", enabled: root.home-music-enabled, toggle: false, on: false, shown: true, slider: true, fraction: root.home-music-volume / 100 },
                    { pos: root.da-audio-start + 6, title: root.i18n-strings[140], value: root.audio-test-tone-playing ? root.i18n-strings[141] : root.i18n-strings[142], enabled: true, toggle: false, on: false, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-sounds-start, title: root.i18n-strings[136], value: root.system-sounds-volume + "%", enabled: true, toggle: false, on: false, shown: true, slider: true, fraction: root.system-sounds-volume / 100 },
                    { pos: root.da-sounds-start + 1, title: root.i18n-strings[137], value: "", enabled: true, toggle: true, on: root.navigation-sounds-enabled, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-sounds-start + 2, title: root.i18n-strings[851], value: "", enabled: true, toggle: true, on: root.notify-sounds-enabled, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-sounds-start + 3, title: root.i18n-strings[138], value: "", enabled: true, toggle: true, on: root.power-sounds-enabled, shown: true, slider: false, fraction: 0 },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(row.pos, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, root.da-cast-section);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    show-slider: row.slider;
                    slider-fraction: row.fraction;
                    selected: root.settings-view == 18 && root.display-audio-index == row.pos;
                    visible: row.shown && root.page-display-audio
                        && root.sec-row-visible(row.pos, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, root.da-cast-section);
                }

                for row[k] in [
                    { title: root.i18n-strings[1214], detail: "", value: "", toggle: true, on: root.cast-audio },
                    {
                        title: root.i18n-strings[1215], detail: root.i18n-strings[1222],
                        value: root.cast-latency == "low" ? root.i18n-strings[1216]
                            : root.cast-latency == "smooth" ? root.i18n-strings[1217] : root.i18n-strings[145],
                        toggle: false, on: false,
                    },
                    {
                        title: root.i18n-strings[1218],
                        /* Cisco's licence asks for this exact attribution. */
                        detail: root.cast-h264 == "installed" ? root.i18n-strings[1219] : root.i18n-strings[1223],
                        value: root.cast-encoder-value,
                        toggle: false, on: false,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.da-cast-start + k, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, root.da-cast-section);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    detail: row.detail;
                    value: row.value;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    selected: root.settings-view == 18 && root.display-audio-index == root.da-cast-start + k;
                    visible: root.cast-available && root.page-display-audio
                        && root.sec-row-visible(root.da-cast-start + k, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, root.da-cast-section);
                }

                /* ------------------------------------------------------ Connectivity */
                for row[k] in [
                    { title: root.i18n-strings[157], value: "", toggle: true, on: root.wifi-enabled, enabled: true, nav: false },
                    {
                        title: root.i18n-strings[158],
                        value: root.connectivity-wifi-active ? root.wifi-current-ssid : root.i18n-strings[159],
                        toggle: false, on: false, enabled: root.wifi-enabled, nav: root.wifi-enabled,
                    },
                    {
                        title: root.i18n-strings[10],
                        value: root.wifi-saved-networks.length + root.i18n-strings[225],
                        toggle: false, on: false, enabled: true, nav: true,
                    },
                    { title: root.i18n-strings[161], value: "", toggle: true, on: root.bluetooth-enabled, enabled: true, nav: false },
                    { title: root.i18n-strings[11], value: "", toggle: false, on: false, enabled: root.bluetooth-enabled, nav: root.bluetooth-enabled },
                    {
                        title: root.i18n-strings[12],
                        value: root.bluetooth-known-devices.length + root.i18n-strings[226],
                        toggle: false, on: false, enabled: root.bluetooth-enabled, nav: root.bluetooth-enabled,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.connectivity-scroll-offset, 3, 6, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    enabled: row.enabled;
                    navigates: row.nav;
                    selected: root.settings-view == 1 && root.connectivity-selected-index == k;
                    visible: root.page-connectivity
                        && root.sec-row-visible(k, root.connectivity-scroll-offset, 3, 6, 0);
                }

                /* SERVICES: the optional network services themselves (rows
                 * from 6, built by gameui.rs from nuubos-remotectl and
                 * nuubos-syncctl). */
                for row[i] in root.connectivity-services: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(6 + i, root.connectivity-scroll-offset, 3, 6, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    toggle: row.toggle;
                    toggle-on: row.toggle-on;
                    enabled: row.enabled;
                    navigates: row.navigates;
                    armed: row.armed;
                    selected: root.settings-view == 1 && root.connectivity-selected-index == 6 + i;
                    visible: root.page-connectivity
                        && root.sec-row-visible(6 + i, root.connectivity-scroll-offset, 3, 6, 0);
                }

                /* Connect page. Entering this view starts a product-service scan
                 * session; results stay live until this page is left. */
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(0, root.wifi-network-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[162];
                    navigates: true;
                    selected: root.settings-view == 2 && root.wifi-network-index == 0;
                    visible: root.settings-view == 2
                        && root.srow-visible(0, root.wifi-network-scroll-offset, root.settings-list-visible-rows);
                }
                for network[i] in root.wifi-networks: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i + 1, root.wifi-network-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: network.ssid;
                    detail: network.current ? root.i18n-strings[198]
                        : network.saved ? network.security + root.i18n-strings[228]
                        : network.security;
                    value: root.signal-label(network.signal-dbm);
                    emphasized: network.current;
                    title-fraction: 0.62;
                    selected: root.settings-view == 2 && root.wifi-network-index == i + 1;
                    visible: root.settings-view == 2
                        && root.srow-visible(i + 1, root.wifi-network-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.wifi-scanning ? root.i18n-strings[163] : root.i18n-strings[164];
                    visible: root.settings-view == 2 && root.wifi-networks.length == 0;
                }

                /* Saved networks are a flat list. Selecting one opens the same
                 * editor used by the current network. */
                for network[i] in root.wifi-saved-networks: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.wifi-saved-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: network.ssid;
                    detail: network.current ? root.i18n-strings[198] : network.security + root.i18n-strings[228];
                    value: root.signal-label(network.signal-dbm);
                    emphasized: network.current;
                    navigates: true;
                    title-fraction: 0.62;
                    selected: root.settings-view == 3 && root.wifi-saved-index == i;
                    visible: root.settings-view == 3
                        && root.srow-visible(i, root.wifi-saved-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.i18n-strings[165];
                    visible: root.settings-view == 3 && root.wifi-saved-networks.length == 0;
                }

                /* Network editor. Password and IP parameters live on one scrollable
                 * list to avoid a stack of nested settings pages. */
                for row[k] in [
                    {
                        title: root.wifi-selected-current ? root.i18n-strings[169] : root.i18n-strings[158],
                        value: root.wifi-selected-current ? root.i18n-strings[198] : "",
                        enabled: true,
                    },
                    {
                        title: root.wifi-wps-active ? root.i18n-strings[706] : root.i18n-strings[705],
                        value: "",
                        enabled: root.wifi-wps-active || root.wifi-wps-available,
                    },
                    {
                        title: root.i18n-strings[172],
                        value: root.wifi-selected-security == root.i18n-strings[212] ? root.i18n-strings[173] : root.i18n-strings[174],
                        enabled: root.wifi-selected-security != root.i18n-strings[212],
                    },
                    { title: root.i18n-strings[175], value: root.wifi-ip-mode == "automatic" ? root.i18n-strings[122] : root.i18n-strings[176], enabled: true },
                    { title: root.i18n-strings[177], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-address : root.wifi-ip-address, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[178], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-netmask : root.wifi-ip-netmask, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[179], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-gateway : root.wifi-ip-gateway, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[180], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-dns : root.wifi-ip-dns, enabled: root.wifi-ip-mode == "manual" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    selected: root.settings-view == 4 && root.wifi-detail-index == k;
                    visible: root.settings-view == 4
                        && root.srow-visible(k, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(8, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[181];
                    selected: root.settings-view == 4 && root.wifi-detail-index == 8;
                    visible: root.settings-view == 4
                        && root.srow-visible(8, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(9, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[182];
                    danger: true;
                    enabled: root.wifi-selected-saved;
                    selected: root.settings-view == 4 && root.wifi-detail-index == 9;
                    visible: root.settings-view == 4
                        && root.srow-visible(9, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }

                /* Bluetooth discovery is active only while this page is open. */
                for device[i] in root.bluetooth-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.bluetooth-device-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind;
                    value: root.bluetooth-state-label(device.connected, device.paired, device.rssi);
                    emphasized: device.connected;
                    title-fraction: 0.62;
                    selected: root.settings-view == 7 && root.bluetooth-device-index == i;
                    visible: root.settings-view == 7
                        && root.srow-visible(i, root.bluetooth-device-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.bluetooth-scanning ? root.i18n-strings[163] : root.i18n-strings[166];
                    visible: root.settings-view == 7 && root.bluetooth-devices.length == 0;
                }

                /* Paired/connected Bluetooth devices. */
                for device[i] in root.bluetooth-known-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.bluetooth-known-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind;
                    value: root.bluetooth-state-label(device.connected, device.paired, device.rssi);
                    emphasized: device.connected;
                    navigates: true;
                    title-fraction: 0.62;
                    selected: root.settings-view == 8 && root.bluetooth-known-index == i;
                    visible: root.settings-view == 8
                        && root.srow-visible(i, root.bluetooth-known-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.i18n-strings[167];
                    visible: root.settings-view == 8 && root.bluetooth-known-devices.length == 0;
                }

                /* One device, one management surface. */
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: !root.bluetooth-selected-paired ? root.i18n-strings[168]
                        : root.bluetooth-selected-connected ? root.i18n-strings[169]
                        : root.i18n-strings[158];
                    selected: root.bluetooth-detail-index == 0;
                    visible: root.settings-view == 9;
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.bluetooth-selected-paired ? root.i18n-strings[170] : root.i18n-strings[171];
                    selected: root.bluetooth-detail-index == 1;
                    danger: root.bluetooth-selected-paired;
                    visible: root.settings-view == 9;
                }

                /* Generic dropdown used by every discrete multi-value Settings
                 * choice. */
                SettingsChoiceSheet {
                    x: root.settings-content-x - 6px;
                    y: root.settings-section-y - 4px;
                    width: root.settings-content-width + 12px;
                    height: min(
                        parent.height - self.y - 12px,
                        root.settings-choice-list-y + min(root.settings-choice-options.length, root.settings-choice-visible-rows) * root.settings-row-step + 4px
                    );
                    title: root.settings-choice-title;
                    options: root.settings-choice-options;
                    index: root.settings-choice-index;
                    scroll: root.settings-choice-scroll;
                    visible-rows: root.settings-choice-visible-rows;
                    list-y: root.settings-choice-list-y;
                    row-step: root.settings-row-step;
                    row-height: root.settings-row-height;
                    visible: root.settings-choice-open && !root.details-page && !root.app-page-shown && !root.files-open && !root.media-open;
                    z: 95;
                }

                /* One status line at the pane bottom, reserved by the row grid. */
                MarqueeText {
                    x: root.settings-content-x;
                    y: parent.height - root.settings-notice-height - 4px;
                    width: root.settings-content-width;
                    height: root.settings-notice-height;
                    label: root.settings-notice;
                    text-color: #d5a34c;
                    text-size: 11px;
                    align-right: true;
                    visible: root.settings-notice != "";
                }
            }

            details-page-view := GameDetailsPage {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.details-page;
                /* Height scale, capped by the width (square screens). */
                s: min(root.home-s, max(1.0, self.width / 640px));
                title: root.details-title;
                system-name: root.details-subtitle;
                meta: root.details-meta;
                description: root.details-description;
                cover: root.details-cover;
                has-cover: root.details-has-cover;
                backdrop: root.details-backdrop;
                has-backdrop: root.details-has-backdrop;
                chips: root.details-chips;
                actions: root.details-actions;
                index: root.gen-index;
                caption: root.details-caption;
                caption-armed: root.details-caption-armed;
                notice: root.gen-notice;
                desc-step: root.details-desc-step;
            }
            AppPage {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.app-page-shown;
                s: min(root.home-s, max(1.0, self.width / 640px));
                kicker: root.app-page-kicker;
                title: root.app-page-title;
                meta: root.app-page-meta;
                description: root.app-page-description;
                icon: root.app-page-icon;
                has-icon: root.app-page-has-icon;
                chips: root.app-page-chips;
                entries: root.app-page-entries;
                actions: root.app-page-actions;
                action-captions: root.app-page-captions;
                index: root.app-page-gen || root.netplay-active || root.portmaster-active ? root.gen-index : root.steamlink-active ? root.steamlink-index : root.moonlight-index;
                notice: root.app-page-gen || root.netplay-active || root.portmaster-active ? root.gen-notice : root.steamlink-active ? root.steamlink-notice : root.moonlight-notice;
                pin: root.app-page-pin;
                pin-label: root.i18n-strings[449];
                progress: root.app-page-progress;
                progress-label: root.app-page-progress-label;
            }
            MediaApp {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.media-open && root.settings-title-view == 65;
                s: min(root.home-s, max(1.0, self.width / 640px));
                screen: root.media-screen;
                section: root.media-section;
                tab-music: root.i18n-strings[1098];
                tab-video: root.i18n-strings[1096];
                tab-settings: root.i18n-strings[3];
                backdrop: root.media-backdrop;
                has-backdrop: root.media-has-backdrop;
                notice: root.media-notice;
                kicker: root.app-kicker;
                hero-title: root.media-hero-title;
                hero-subtitle: root.media-hero-subtitle;
                empty-text: root.media-empty-text;
                shelves: root.media-shelves;
                shelf-indices: root.media-shelf-indices;
                shelf-index: root.media-shelf-index;
                grid-title: root.media-grid-title;
                grid-tiles: root.media-grid-tiles;
                grid-index: root.media-grid-index;
                grid-shape: root.media-grid-shape;
                album-title: root.media-album-title;
                album-artist: root.media-album-artist;
                album-meta: root.media-album-meta;
                album-art: root.media-album-art;
                album-has-art: root.media-album-has-art;
                album-tracks: root.media-album-tracks;
                album-index: root.media-album-index;
                play-label: root.i18n-strings[1164];
                shuffle-label: root.i18n-strings[1109];
                np-active: root.media-np-active;
                np-playing: root.media-np-playing;
                np-title: root.media-np-title;
                np-artist: root.media-np-artist;
                np-album: root.media-np-album;
                np-art: root.media-np-art;
                np-has-art: root.media-np-has-art;
                np-position: root.media-np-position;
                np-duration: root.media-np-duration;
                np-elapsed: root.media-np-elapsed;
                np-total: root.media-np-total;
                np-shuffle: root.media-np-shuffle;
                np-repeat: root.media-np-repeat;
                np-up-next: root.i18n-strings[1115];
                np-kicker: root.i18n-strings[1114];
                np-queue: root.media-np-queue;
                np-zone: root.media-np-zone;
                np-control: root.media-np-control;
                np-queue-index: root.media-np-queue-index;
            }
            /* Media → Settings tab: rows like Moonlight's Stream Settings,
             * under the app's tabs (50 px·s). */
            if root.media-open && root.settings-title-view == 65 && root.media-screen == 0
                && root.media-section == 2: Rectangle {
                property <float> ms: min(root.home-s, max(1.0, parent.width / 640px));
                property <length> top: 50px * self.ms + 18px + root.settings-section-gap;
                /* Centred column like the full-screen app shell. */
                property <length> col-w: min(self.width - 44px, 1100px);
                property <length> col-x: (self.width - self.col-w) / 2;
                x: 0; y: 0; width: parent.width; height: parent.height;
                SettingsSectionHeader {
                    x: parent.col-x;
                    y: parent.top - root.settings-section-gap;
                    width: parent.col-w;
                    label: root.i18n-strings[18].to-uppercase();
                    scope-label: root.i18n-strings[312];
                }
                if root.lighting-supported: VerticalLayout {
                    x: parent.col-x; y: parent.top;
                    width: parent.col-w;
                    spacing: root.settings-row-gap;
                    for row[k] in [
                        { title: root.i18n-strings[1226], detail: root.i18n-strings[1227], on: root.media-rgb-follow },
                        { title: root.i18n-strings[1228], detail: root.i18n-strings[1229], on: root.media-rgb-keep },
                    ]: SettingsSelectableRow {
                        height: root.settings-row-height;
                        title: row.title;
                        detail: row.detail;
                        toggle: true;
                        toggle-on: row.on;
                        selected: root.media-settings-index == k;
                    }
                }
                if !root.lighting-supported: SettingsSelectableRow {
                    x: parent.col-x; y: parent.top;
                    width: parent.col-w; height: root.settings-row-height;
                    title: root.i18n-strings[18];
                    value: root.i18n-strings[205];
                    enabled: false;
                }
            }
            FilesApp {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.files-open && root.settings-title-view == 58;
                s: min(root.home-s, max(1.0, self.width / 640px));
                left: root.files-left;
                right: root.files-right;
                active: root.files-active;
                kicker: root.app-kicker;
                status: root.files-status;
                status-right: root.files-status-right;
                progress: root.files-progress;
                progress-label: root.files-progress-label;
                notice: root.files-notice;
                empty-text: root.i18n-strings[621];
                loading-text: root.i18n-strings[1156];
                sort-label: root.files-sort-label;
            }
            SettingsChoiceSheet {
                x: (parent.width - self.width) / 2;
                y: 24px;
                width: min(parent.width - 48px, 420px);
                height: min(
                    parent.height - self.y - 24px,
                    root.settings-choice-list-y + min(root.settings-choice-options.length, root.settings-choice-visible-rows) * root.settings-row-step + 4px
                );
                title: root.settings-choice-title;
                options: root.settings-choice-options;
                index: root.settings-choice-index;
                scroll: root.settings-choice-scroll;
                visible-rows: root.settings-choice-visible-rows;
                list-y: root.settings-choice-list-y;
                row-step: root.settings-row-step;
                row-height: root.settings-row-height;
                /* Over the full screen pages (Files actions, Game Details). */
                /* Over the full-screen apps too (Files, Media drew over it: their
                 * action menus never showed, user report 2026-10-12). */
                visible: root.settings-choice-open && (root.details-page || root.app-page-shown || root.files-open || root.media-open);
            }
        }

        /* System-wide virtual keyboard bottom sheet. It intentionally spans the
         * full display width so every Settings domain shares the same keyboard
         * surface, independent of the right-pane width. It sits on the action
         * bar; the field label says what is entered, the page title above
         * stays the page the keyboard was opened from. */
        system-keyboard := SystemVirtualKeyboard {
            x: 0px;
            y: parent.height - 52px - self.content-height;
            width: parent.width;
            height: self.content-height;
            z: 20;
            visible: (root.settings-open || root.find-open) && root.settings-view == 6;
            value <=> root.keyboard-value;
            title: root.keyboard-title;
            secret: root.keyboard-secret;
            shift: root.keyboard-shift;
            caps: root.keyboard-caps;
            input-kind: root.keyboard-input-kind;
            layout-name: root.keyboard-layout;
            selected-index: root.keyboard-index;
            page: root.keyboard-page;
            row-zero: root.keyboard-row-zero;
            row-one: root.keyboard-row-one;
            row-two: root.keyboard-row-two;
            row-three: root.keyboard-row-three;
            accepted => { root.system-keyboard-accepted(); }
        }

        /* Context-sensitive bottom action bar. Cached as one layer: it
         * changes only with the context (~1.2 ms of UI thread per frame). */
        Rectangle {
            cache-rendering-hint: true;
            x: 0;
            y: parent.height - 52px;
            width: parent.width;
            height: 52px;
            background: Theme.background;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Theme.surface;
            }

            HorizontalLayout {
                x: 18px;
                y: 0;
                width: parent.width - 36px;
                height: parent.height;
                spacing: 20px;

                /* System keyboard: West deletes the last character (first,
                 * on the left, user request 2026-10-10). */
                if (root.settings-open || root.find-open) && root.settings-view == 6: ActionHint {
                    kind: "face"; face-position: root.details-face-position; label: root.i18n-strings[618];
                }
                if !root.settings-open && root.home-modal: ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
                if !root.settings-open && !root.home-modal && root.home-focus-valid: ActionHint {
                    kind: "face"; face-position: root.select-face-position;
                    label: root.home-focused.kind == 0 ? root.i18n-strings[413] : root.i18n-strings[414];
                }
                /* Games: North = Details; a collection: North = Manage. */
                if !root.settings-open && !root.home-modal && root.home-focus-valid && root.home-focused.kind == 0: ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.i18n-strings[523];
                }
                if !root.settings-open && !root.home-modal && root.home-focus-valid && root.home-focused.kind == 2: ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.i18n-strings[849];
                }
                if !root.settings-open && (root.find-open && !root.library-open && root.find-zone != 2): ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
                if !root.settings-open && (root.library-open || root.home-modal || root.find-open): ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
                if !root.settings-open: Rectangle { horizontal-stretch: 1; }
                if root.custom-hints: Rectangle { width: 0; }
                for hint in root.custom-hints ? root.app-hints : []: ActionHint {
                    kind: hint.kind;
                    face-position: hint.role == 0 ? root.select-face-position : hint.role == 1 ? root.back-face-position
                        : hint.role == 2 ? root.context-face-position : root.details-face-position;
                    label: hint.label;
                }
                /* Not on the keyboard sheet: its keys are obviously moved with the
                 * D-pad, and Delete/Shift need the room (640x480, long languages). */
                if root.settings-open && !root.custom-hints && root.settings-view != 14 && root.settings-view != 6: ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                if root.settings-select-hint-visible && !root.custom-hints: ActionHint {
                    kind: "face"; face-position: root.select-face-position;
                    label: !root.settings-choice-open && root.gen-view
                        && root.gen-select-label != "" ? root.gen-select-label : root.i18n-strings[185];
                }
                if root.settings-open && !root.custom-hints: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
                if root.settings-open && !root.custom-hints && !root.settings-choice-open && root.settings-north-hint != "" && root.settings-view != 6: ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.settings-north-hint;
                }
                /* System keyboard: North toggles Shift / Caps Lock on letters. */
                if root.settings-open && root.settings-view == 6 && root.keyboard-page == 0
                    && (root.keyboard-input-kind == "text" || root.keyboard-input-kind == "password"): ActionHint {
                    /* What the next press does: one capital → Caps Lock → off
                     * (user report 2026-10-21: one press only capitalizes one
                     * letter, so Caps Lock "did not work"). */
                    kind: "face"; face-position: root.context-face-position;
                    label: root.keyboard-caps ? root.i18n-strings[1338] : root.keyboard-shift ? root.i18n-strings[1337] : root.i18n-strings[791];
                }
                if root.settings-open: Rectangle { horizontal-stretch: 1; }
                /* System keyboard: Start confirms what was typed (Done). */
                if root.settings-open && root.settings-view == 6: ActionHint { kind: "start"; label: root.i18n-strings[697]; }
                if !root.settings-open && !root.home-modal && !root.find-open: ActionHint { kind: "select"; label: root.i18n-strings[828]; }
                if !root.settings-open && !root.library-open: ActionHint { kind: "start"; label: root.i18n-strings[3]; }
                /* The keyboard's Start = Done takes its room at 640x480 (the
                 * Menu button still works). */
                if !(root.settings-open && root.settings-view == 6): ActionHint { kind: "menu"; label: root.i18n-strings[187]; }
            }
        }
    }

    /* OOB Language (step 0) and Ready (step 4): one obvious action each. The
     * column is centred in the logical window and only its type sizes grow
     * mildly with the height, so 640x480 stays compact and TV stays legible.
     * Step 0 greets in every UI language on a rolling drum (the Timer runs
     * only on that step) above the language selector (left/right). */
    /* Game loading screen: the game's cover, title and system, an M3
     * linear indeterminate bar (fills only) and "Starting game…". */
    launch-view := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.launch-open;
        property <float> s: root.home-s;
        property <length> cover-h: min(parent.height * 0.46, 340px * self.s);
        property <float> aspect: root.launch-has-cover && root.launch-cover.height > 0
            ? max(0.5, min(1.8, root.launch-cover.width / root.launch-cover.height)) : 0.75;
        TouchArea { }
        Rectangle {
            width: parent.width; height: parent.height * 0.6; y: 0;
            background: @linear-gradient(180deg, root.launch-accent.transparentize(0.78) 0%,
                Theme.background.transparentize(1.0) 100%);
        }
        VerticalLayout {
            alignment: center;
            spacing: 14px * launch-view.s;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: launch-view.cover-h * launch-view.aspect;
                    height: launch-view.cover-h;
                    border-radius: max(Shape.medium, self.height * 0.06);
                    background: root.launch-has-cover ? #00000000 : Theme.surface-container;
                    if root.launch-has-cover: Image {
                        width: parent.width; height: parent.height;
                        source: root.launch-cover;
                        image-fit: fill;
                    }
                }
            }
            Text {
                horizontal-alignment: center;
                text: root.launch-title;
                color: Theme.text;
                font-size: 24px * launch-view.s;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                alignment: center;
                HomeInfoChip {
                    text: root.launch-system; dot: root.launch-accent; has-dot: true; has-icon: false;
                    s: launch-view.s;
                }
            }
            HorizontalLayout {
                alignment: center;
                /* M3 linear indeterminate progress: a primary segment
                 * travelling over a tonal track. */
                Rectangle {
                    property <length> seg: self.width * 0.32;
                    property <float> t: root.launch-busy ? mod(animation-tick() / 1ms, 1300) / 1300 : 0.0;
                    width: min(260px * launch-view.s, launch-view.width * 0.5);
                    height: 4px * launch-view.s;
                    border-radius: self.height / 2;
                    background: Theme.surface-container-highest;
                    clip: true;
                    Rectangle {
                        x: -parent.seg + parent.t * (parent.width + parent.seg);
                        width: parent.seg; height: parent.height;
                        border-radius: parent.height / 2;
                        background: Theme.primary;
                        visible: root.launch-busy;
                    }
                }
            }
            Text {
                horizontal-alignment: center;
                text: root.i18n-strings[811];
                color: Theme.text-secondary;
                font-size: 15px * launch-view.s;
            }
        }
    }

    oob-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.oob-active && (root.oob-step == 0 || root.oob-step == 4);
        z: 150;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <bool> ready: root.oob-step == 4;
        /* Endonyms, deliberately not translated; order = UI_LANGUAGES. */
        property <[string]> greetings: ["Welcome", "Benvenuto", "Bienvenue", "Willkommen", "Bienvenido", "Bienvenido", "Bem-vindo", "Boas-vindas", "Welkom", "Witamy", "Vítejte", "Välkommen", "Velkommen", "Velkommen", "Tervetuloa", "Üdvözöljük", "Bun venit", "Hoş geldiniz", "Καλώς ήρθατε", "Добро пожаловать", "Ласкаво просимо", "Selamat datang", "Chào mừng", "ยินดีต้อนรับ", "स्वागत है", "ようこそ", "欢迎", "歡迎", "환영합니다"];
        property <float> greet-tick: 0;
        animate greet-tick { duration: 700ms; easing: ease-in-out; }
        property <int> greet-n: floor(self.greet-tick);
        property <float> greet-p: self.greet-tick - self.greet-n;
        property <length> greet-h: 26px * self.type-scale * 1.5;

        Timer {
            interval: 2600ms;
            running: root.oob-active && root.oob-step == 0;
            triggered => { oob-hero.greet-tick += 1; }
        }

        VerticalLayout {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height - 58px;
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                NuubLogo { logo-height: 42px * oob-hero.type-scale; }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 86px; height: 3px; background: Theme.accent; border-radius: 2px; }
            }
            Rectangle { height: 4px; }
            if oob-hero.ready: Text {
                text: root.i18n-strings[394];
                color: Theme.text;
                font-size: 26px * oob-hero.type-scale;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            /* Drum: the current greeting rolls up and away while the next
             * one rolls in from below (scale-y fakes the rotation). */
            if !oob-hero.ready: Rectangle {
                height: oob-hero.greet-h;
                clip: true;
                for k in 2: Text {
                    property <float> p: k == 0 ? 1 - oob-hero.greet-p : oob-hero.greet-p;
                    x: 0;
                    y: (k == 0 ? -1 : 1) * (1 - self.p) * oob-hero.greet-h * 0.6;
                    width: parent.width;
                    height: oob-hero.greet-h;
                    text: oob-hero.greetings[Math.mod(oob-hero.greet-n + k, oob-hero.greetings.length)];
                    color: Theme.text;
                    font-size: 26px * oob-hero.type-scale;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: self.p;
                    transform-scale-y: self.p;
                    transform-origin: { x: self.width / 2, y: k == 0 ? 0px : self.height };
                }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    max-width: 520px;
                    text: oob-hero.ready ? root.i18n-strings[395] : root.i18n-strings[389];
                    color: Theme.text-secondary;
                    font-size: 16px * oob-hero.type-scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: center;
                SettingsActionButton {
                    width: min(300px, root.width - 64px);
                    height: root.settings-row-height;
                    label: oob-hero.ready ? root.i18n-strings[396] : "‹   " + root.ui-language-name + "   ›";
                    selected: true;
                }
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                for i in 5: Rectangle {
                    width: i == root.oob-step ? 18px : 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: i <= root.oob-step ? Theme.accent : Theme.border-soft;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                if root.oob-step == 0: ActionHint { kind: "nav"; label: root.i18n-strings[193]; }
                ActionHint {
                    kind: "face"; face-position: root.select-face-position;
                    label: root.oob-step == 0 ? root.i18n-strings[390] : root.i18n-strings[185];
                }
                if root.oob-step == 4: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    /* Safe mode (EPIC-050): the supervisor restarted nuubUI after a crash
     * loop. A full-screen recovery screen in the OOB hero style instead of a
     * Settings page; the actions are nuubos-recoveryctl's, the restart is the
     * central lifecycle's. Power stays on the global power menu. */
    safe-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.safe-screen-open;
        z: 190;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <length> column: min(560px * self.type-scale, root.width - 64px);
        property <length> cell: (self.column - 10px) / 2;
        property <length> button-h: root.settings-row-height;
        /* The armed button carries its own prompt; this line always
         * describes the focused action. */
        property <string> detail: root.recovery-notice != "" ? root.recovery-notice
            : root.safe-index == 0 ? root.i18n-strings[712]
            : root.safe-index == 1 ? root.i18n-strings[512]
            : root.safe-index == 2 ? root.i18n-strings[504]
            : root.safe-index == 3 ? root.i18n-strings[513]
            : root.safe-index == 4 ? root.i18n-strings[713]
            : root.safe-index == 5 ? root.i18n-strings[514]
            : root.i18n-strings[515];

        VerticalLayout {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height - 58px;
            alignment: center;
            spacing: 10px;

            HorizontalLayout {
                alignment: center;
                NuubLogo { logo-height: 28px * safe-hero.type-scale; }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 86px; height: 3px; background: Theme.warning; border-radius: 2px; }
            }
            Text {
                text: root.i18n-strings[518];
                color: Theme.text;
                font-size: 24px * safe-hero.type-scale;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: safe-hero.column;
                    text: root.i18n-strings[519];
                    color: Theme.text-secondary;
                    font-size: 15px * safe-hero.type-scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            Rectangle { height: 2px; }
            HorizontalLayout {
                alignment: center;
                SettingsActionButton {
                    width: safe-hero.column;
                    height: safe-hero.button-h;
                    label: root.i18n-strings[520];
                    selected: root.safe-index == 0;
                }
            }
            for pair[r] in [
                { left: root.i18n-strings[505], right: root.i18n-strings[500] },
                { left: root.i18n-strings[508], right: root.i18n-strings[3] },
                { left: root.i18n-strings[510], right: root.i18n-strings[511] },
            ]: HorizontalLayout {
                alignment: center;
                spacing: 10px;
                SettingsActionButton {
                    width: safe-hero.cell;
                    height: safe-hero.button-h;
                    armed: root.recovery-armed == 1 + r * 2;
                    label: pair.left;
                    prompt: root.i18n-strings[191];
                    selected: root.safe-index == 1 + r * 2;
                    danger: r == 2;
                    enabled: r != 1 || root.active-user-id != "";
                }
                SettingsActionButton {
                    width: safe-hero.cell;
                    height: safe-hero.button-h;
                    armed: root.recovery-armed == 2 + r * 2;
                    label: pair.right;
                    prompt: r == 2 && root.recovery-stage == 1 ? root.i18n-strings[517] : root.i18n-strings[191];
                    selected: root.safe-index == 2 + r * 2;
                    danger: r == 2;
                    enabled: r != 0 || !root.diag-busy;
                }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: safe-hero.column;
                    height: 2 * 18px * safe-hero.type-scale;
                    text: safe-hero.detail;
                    color: Theme.text-faint;
                    font-size: 13px * safe-hero.type-scale;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
            }
        }
    }

    /* Syncthing setup guide: title, accent bar, the step's text (code,
     * device ID, QR code for a phone), a waiting line while something
     * must happen on the other device, then the step's rows. */
    sync-guide := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        /* Settings closed (Home, a game): it waits behind until Settings reopens. */
        visible: root.sync-guide-open && root.settings-open;
        z: 193;
        TouchArea { }

        property <float> s: max(1.0, min(1.35, root.height / 480px));
        property <length> column: min(700px * self.s, root.width - 48px);
        property <length> left: (self.width - self.column) / 2;
        property <bool> wide: root.width > root.height * 1.2;
        property <length> qr-size: !root.sync-guide-show-qr ? 0px
            : self.wide ? min(self.column * 0.34, self.height - 170px) : min(self.height * 0.30, 240px * self.s);
        property <length> top: sg-heading.y + sg-heading.preferred-height + 22px;
        property <length> text-x: self.wide && root.sync-guide-show-qr ? self.left + self.qr-size + 20px : self.left;
        property <length> text-w: self.left + self.column - self.text-x;
        property <length> text-y: !self.wide && root.sync-guide-show-qr ? self.top + self.qr-size + 12px : self.top;
        property <length> list-y: sg-text.y + sg-text.preferred-height + 14px;
        property <length> bottom: self.height - 58px - 8px;
        property <int> visible-rows: max(1, floor((self.bottom - self.list-y + root.settings-row-gap) / root.settings-row-step));
        property <int> scroll: max(0, root.sync-guide-index - self.visible-rows + 1);
        property <int> dots: 0;

        /* The waiting line's dots: a slow timer, only while waiting. */
        Timer {
            interval: 600ms;
            running: root.sync-guide-open && root.sync-guide-waiting != "";
            triggered => { sync-guide.dots = Math.mod(sync-guide.dots + 1, 4); }
        }

        sg-heading := Text {
            x: sync-guide.left; y: 22px;
            width: sync-guide.column - (root.sync-guide-step >= 0 ? 110px : 0px);
            text: root.sync-guide-title;
            color: Theme.text;
            font-size: 22px * sync-guide.s;
            font-weight: 700;
            wrap: word-wrap;
        }
        if root.sync-guide-step >= 0: HorizontalLayout {
            x: sync-guide.left + sync-guide.column - 100px; y: 22px + 11px * sync-guide.s - 4px;
            width: 100px; height: 8px;
            alignment: end;
            spacing: 6px;
            for i in root.sync-guide-steps: Rectangle {
                width: i == root.sync-guide-step ? 16px : 8px;
                height: 8px;
                border-radius: 4px;
                background: i <= root.sync-guide-step ? Theme.accent : Theme.border-soft;
            }
        }
        Rectangle {
            x: sync-guide.left; y: sg-heading.y + sg-heading.preferred-height + 8px;
            width: 86px; height: 3px; border-radius: 2px;
            background: Theme.accent;
        }

        /* QR code: dark modules on white with its quiet zone. */
        if root.sync-guide-show-qr: Rectangle {
            x: sync-guide.wide ? sync-guide.left : (sync-guide.width - sync-guide.qr-size) / 2;
            y: sync-guide.top;
            width: sync-guide.qr-size; height: sync-guide.qr-size;
            border-radius: Shape.medium;
            background: #ffffff;
            clip: true;
            Image {
                width: parent.width; height: parent.height;
                source: root.sync-guide-qr;
                image-rendering: pixelated;
                image-fit: contain;
            }
        }

        sg-text := VerticalLayout {
            x: sync-guide.text-x; y: sync-guide.text-y;
            width: sync-guide.text-w;
            height: self.preferred-height;
            spacing: 10px;
            if root.sync-guide-body != "": Text {
                text: root.sync-guide-body;
                color: Theme.text-secondary;
                font-size: 16px * sync-guide.s;
                wrap: word-wrap;
            }
            if root.sync-guide-code != "": Text {
                text: root.sync-guide-code;
                color: Theme.accent;
                font-size: 28px * sync-guide.s;
                font-weight: 800;
                letter-spacing: 4px;
                horizontal-alignment: sync-guide.wide && root.sync-guide-show-qr ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
            }
            if root.sync-guide-id != "": Text {
                text: root.sync-guide-id;
                color: Theme.text;
                font-size: 15px * sync-guide.s;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-alignment: sync-guide.wide && root.sync-guide-show-qr ? TextHorizontalAlignment.left : TextHorizontalAlignment.center;
            }
            if root.sync-guide-waiting != "": Text {
                text: root.sync-guide-waiting + (sync-guide.dots == 0 ? "" : sync-guide.dots == 1 ? " ·" : sync-guide.dots == 2 ? " · ·" : " · · ·");
                color: Theme.text-faint;
                font-size: 15px * sync-guide.s;
                wrap: word-wrap;
            }
            if root.sync-guide-error != "": Text {
                text: root.sync-guide-error;
                color: Theme.warning;
                font-size: 15px * sync-guide.s;
                wrap: word-wrap;
            }
        }

        for item[i] in root.sync-guide-items: SettingsSelectableRow {
            x: sync-guide.text-x;
            y: sync-guide.list-y + (i - sync-guide.scroll) * root.settings-row-step;
            width: sync-guide.text-w;
            height: root.settings-row-height;
            title: item.title;
            value: item.value;
            detail: item.detail;
            navigates: item.navigates;
            toggle: item.toggle;
            toggle-on: item.toggle-on;
            enabled: item.enabled;
            selected: root.sync-guide-index == i;
            visible: i >= sync-guide.scroll && i < sync-guide.scroll + sync-guide.visible-rows;
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                if root.sync-guide-items.length > 1: ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                if root.sync-guide-index >= 0: ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
                ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    /* Release notes of an available update (user request 2026-10-12): only
     * when the user opens What's New; Up/Down scroll, Back closes. */
    notes-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.notes-open;
        z: 196;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <length> column: min(640px * self.type-scale, root.width - 64px);

        notes-heading := Text {
            x: (parent.width - notes-hero.column) / 2; y: 24px;
            width: notes-hero.column;
            text: root.notes-title;
            color: Theme.text;
            font-size: 24px * notes-hero.type-scale;
            font-weight: 700;
            wrap: word-wrap;
        }
        Rectangle {
            x: (parent.width - notes-hero.column) / 2;
            y: notes-heading.y + notes-heading.preferred-height + 10px;
            width: 86px; height: 3px; border-radius: 2px;
            background: Theme.accent;
        }
        notes-view := Rectangle {
            x: (parent.width - notes-hero.column) / 2;
            y: notes-heading.y + notes-heading.preferred-height + 28px;
            width: notes-hero.column;
            height: parent.height - self.y - 58px - 12px;
            clip: true;
            notes-body := Text {
                x: 0;
                y: -min(root.notes-scroll, root.notes-scroll-max);
                width: parent.width - 14px;
                height: self.preferred-height;
                text: root.notes-text;
                color: Theme.text-secondary;
                font-size: 17px * notes-hero.type-scale;
                wrap: word-wrap;
                animate y { duration: 120ms; easing: ease-out; }
            }
            /* Where the view is in the notes, when they do not fit. */
            if root.notes-scroll-max > 0: Rectangle {
                x: parent.width - 4px; y: 0; width: 4px; height: parent.height;
                border-radius: 2px;
                background: Theme.surface;
                Rectangle {
                    x: 0; width: parent.width; border-radius: 2px;
                    height: max(24px, parent.height * notes-view.height / notes-body.preferred-height);
                    y: (parent.height - self.height) * min(root.notes-scroll, root.notes-scroll-max) / root.notes-scroll-max;
                    background: Theme.accent;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                if root.notes-scroll-max > 0: ActionHint { kind: "nav"; label: root.i18n-strings[1006]; }
                ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    /* Operation screen (user requests 2026-10-12): SD2 restore (OOB or
     * Settings) and system update. A full-screen hero that owns the input
     * while the job runs, with its progress and a rotating light-hearted
     * line; the console restarts when it is done. On failure: Try Again |
     * Start from Scratch (OOB restore) or Close. */
    op-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.op-screen-open;
        z: 195;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <length> column: min(560px * self.type-scale, root.width - 64px);
        property <length> cell: (self.column - 10px) / 2;
        property <[int]> phrases: root.op-kind == 1 ? [1007, 1008, 1009, 1010, 1011]
            : [997, 998, 999, 1000, 1001, 1002, 1003, 1004];
        property <float> tick: 0;
        animate tick { duration: 700ms; easing: ease-in-out; }
        property <int> n: floor(self.tick);
        property <float> p: self.tick - self.n;
        property <length> line-h: 20px * self.type-scale * 1.5;

        Timer {
            interval: 3200ms;
            running: root.op-screen-open && !root.op-failed;
            triggered => { op-hero.tick += 1; }
        }

        VerticalLayout {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height - (root.op-failed ? 58px : 0px);
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                NuubLogo { logo-height: 42px * op-hero.type-scale; }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 86px; height: 3px; border-radius: 2px;
                    background: root.op-failed ? Theme.warning : Theme.accent;
                }
            }
            Rectangle { height: 4px; }
            Text {
                text: root.op-failed ? root.i18n-strings[root.op-kind == 1 ? 990 : 640]
                    : root.i18n-strings[root.op-kind == 1 ? 984 : 994];
                color: Theme.text;
                font-size: 26px * op-hero.type-scale;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            /* The OOB greeting drum: the line rolls up, the next one in. */
            if !root.op-failed: Rectangle {
                height: op-hero.line-h;
                clip: true;
                for k in 2: Text {
                    property <float> p: k == 0 ? 1 - op-hero.p : op-hero.p;
                    x: 0;
                    y: (k == 0 ? -1 : 1) * (1 - self.p) * op-hero.line-h * 0.6;
                    width: parent.width;
                    height: op-hero.line-h;
                    text: root.i18n-strings[op-hero.phrases[Math.mod(op-hero.n + k, op-hero.phrases.length)]];
                    color: Theme.text-secondary;
                    font-size: 20px * op-hero.type-scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: self.p;
                    transform-scale-y: self.p;
                    transform-origin: { x: self.width / 2, y: k == 0 ? 0px : self.height };
                }
            }
            if !root.op-failed: HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: op-hero.column * 0.7;
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.surface;
                    clip: true;
                    Rectangle {
                        x: 0; y: 0; height: parent.height;
                        width: parent.width * max(0.03, root.op-progress / 100);
                        border-radius: 3px;
                        background: Theme.accent;
                        animate width { duration: 400ms; easing: ease-out; }
                    }
                }
            }
            if !root.op-failed: Text {
                text: root.i18n-strings[995];
                color: Theme.text-faint;
                font-size: 14px * op-hero.type-scale;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.op-failed: HorizontalLayout {
                alignment: center;
                spacing: 10px;
                SettingsActionButton {
                    width: op-hero.cell;
                    height: root.settings-row-height;
                    label: root.i18n-strings[996];
                    selected: root.op-index == 0;
                }
                SettingsActionButton {
                    width: op-hero.cell;
                    height: root.settings-row-height;
                    label: root.op-oob && root.op-kind == 0 ? root.i18n-strings[964] : root.i18n-strings[239];
                    selected: root.op-index == 1;
                }
            }
        }

        if root.op-failed: Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
            }
        }
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.user-picker-open;
        z: 180;
        clip: true;

        /* Same nuubOS chrome as Home/Settings: matte top bar and the
         * controller-agnostic action bar remain visible during user selection. */
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 58px;
            background: Theme.background;
            z: 2;
            /* No player chosen yet: the nuubOS wordmark (user 2026-10-30);
             * the player's name takes its place from Home on. */
            NuubLogo { x: 20px; y: (58px - self.height) / 2; logo-height: 28px; }
            Text {
                x: 0; y: 13px; width: parent.width; height: 28px;
                text: root.i18n-strings[291];
                color: Theme.text;
                font-size: 19px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: 16px; y: 57px; width: parent.width - 32px; height: 1px; background: Theme.surface; }
        }

        for user[i] in root.users : user-card := Rectangle {
            property <bool> focused: root.user-picker-index == i;
            /* Sized from the free height between the bars (not fixed px), so
             * users stay big on every screen; width capped on square panels. */
            property <length> card-height: max(194px, min((parent.height - 116px) * 0.78, 440px));
            property <length> card-width: min(user-card.card-height * 0.78, parent.width * 0.5);
            property <length> card-gap: user-card.card-width + 24px;
            property <length> avatar-size: (user-card.card-width - 36px) * (user-card.focused ? 1 : 0.8);

            x: parent.width / 2 - user-card.card-width / 2
                + (i - root.user-picker-index) * user-card.card-gap;
            y: 58px + (parent.height - 116px) / 2 - user-card.card-height / 2;
            width: user-card.card-width;
            height: user-card.card-height;
            border-radius: Shape.large;
            background: user-card.focused ? Theme.secondary-container : Theme.surface-container-low;
            border-width: user-card.focused ? 3px : 0px;
            border-color: Theme.primary;
            visible: i >= root.user-picker-index - 2 && i <= root.user-picker-index + 2;

            Rectangle {
                x: (parent.width - user-card.avatar-size) / 2;
                y: 18px + ((user-card.card-width - 36px) - user-card.avatar-size) / 2;
                width: user-card.avatar-size;
                height: user-card.avatar-size;
                border-radius: self.width * 0.22;
                border-width: 1px;
                border-color: user-card.focused ? Theme.primary : Theme.outline-variant;
                background: #11151a;
                clip: true;

                Image {
                    x: parent.border-width;
                    y: parent.border-width;
                    width: parent.width - 2 * parent.border-width;
                    height: parent.height - 2 * parent.border-width;
                    source: user.avatar;
                    image-fit: contain;
                }
            }

            MarqueeText {
                x: 10px;
                y: parent.height - 51px;
                width: parent.width - 20px;
                height: 30px;
                label: user.name;
                text-color: user-card.focused ? Theme.text : Theme.text-secondary;
                text-size: user-card.focused ? 22px : 17px;
                text-weight: user-card.focused ? 600 : 500;
                active: user-card.focused;
                align-center: true;
                
                
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            z: 2;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint { kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185]; }
                if !root.user-picker-forced: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    if root.settings-dialog-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #000000a0;
        z: 186;

        dialog := Rectangle {
            property <length> pad: 24px;
            property <length> button-h: 44px;
            width: min(parent.width - 32px, 560px);
            height: min(parent.height - 32px, body.y + body.height + 20px + self.button-h + self.pad);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            /* M3 dialog: tonal surface, extra-large shape. */
            background: Theme.surface-container-high;
            border-radius: Shape.extra-large;
            clip: true;

            title := Text {
                x: dialog.pad; y: dialog.pad; width: parent.width - 2 * dialog.pad;
                text: root.settings-dialog-title;
                color: Theme.text;
                font-size: 22px; font-weight: 600;
                wrap: word-wrap;
            }
            body := Text {
                x: dialog.pad; y: title.y + title.preferred-height + 14px; width: parent.width - 2 * dialog.pad;
                height: self.preferred-height;
                text: root.settings-dialog-body;
                color: Theme.text-secondary;
                font-size: 15px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                x: dialog.pad; y: parent.height - dialog.pad - dialog.button-h;
                width: parent.width - 2 * dialog.pad; height: dialog.button-h;
                spacing: 12px;
                alignment: end;
                SettingsActionButton {
                    min-width: 150px;
                    label: root.i18n-strings[619];
                    selected: root.settings-dialog-index == 0;
                }
                SettingsActionButton {
                    min-width: 150px;
                    label: root.settings-dialog-confirm;
                    selected: root.settings-dialog-index == 1;
                }
            }
        }
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #05070bdc;
        visible: root.avatar-picker-open;
        z: 185;

        Rectangle {
            width: root.avatar-picker-card-width;
            height: root.avatar-picker-card-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            /* M3 dialog: tonal surface, extra-large shape. */
            background: Theme.surface-container-high;
            border-radius: Shape.extra-large;

            MarqueeText {
                x: 22px; y: 14px;
                width: parent.width - 44px; height: 32px;
                label: root.i18n-strings[321];
                text-color: Theme.text;
                text-size: 20px;
                text-weight: 600;
                align-center: true;
            }
            for avatar[i] in root.avatar-choices : tile := Rectangle {
                property <bool> focused: root.avatar-picker-index == i;
                property <int> grid-row: floor(i / root.avatar-picker-columns);
                property <length> cell-width: (parent.width - 32px) / root.avatar-picker-columns;
                property <length> size: min(tile.cell-width - 28px, root.avatar-picker-tile-height - 46px);
                x: 16px + mod(i, root.avatar-picker-columns) * tile.cell-width + 4px;
                y: 62px + (tile.grid-row - root.avatar-picker-scroll) * root.avatar-picker-tile-height;
                width: tile.cell-width - 8px;
                height: root.avatar-picker-tile-height - 8px;
                border-radius: Shape.large;
                background: tile.focused ? Theme.secondary-container : transparent;
                border-width: tile.focused ? 3px : 0px;
                border-color: Theme.primary;
                visible: tile.grid-row >= root.avatar-picker-scroll
                    && tile.grid-row < root.avatar-picker-scroll + root.avatar-picker-rows;

                Rectangle {
                    x: (parent.width - tile.size) / 2;
                    y: 8px;
                    width: tile.size;
                    height: tile.size;
                    border-radius: tile.size * 0.22;
                    border-width: 1px;
                    border-color: tile.focused ? Theme.primary : Theme.outline-variant;
                    background: #11151a;
                    clip: true;

                    Image {
                        x: parent.border-width;
                        y: parent.border-width;
                        width: parent.width - 2 * parent.border-width;
                        height: parent.height - 2 * parent.border-width;
                        source: avatar.avatar;
                        image-fit: contain;
                    }
                }
                MarqueeText {
                    x: 6px;
                    y: parent.height - 30px;
                    width: parent.width - 12px;
                    height: 24px;
                    label: avatar.label;
                    text-color: tile.focused ? Theme.text : Theme.text-secondary;
                    text-size: 13px;
                    text-weight: tile.focused ? 600 : 500;
                    active: tile.focused;
                    align-center: true;
                }
            }
            MarqueeText {
                x: 22px;
                y: parent.height - 28px;
                width: parent.width - 44px;
                label: root.i18n-strings[294] + " • /userdata/users/" + root.profile-edit-user-id + "/profile/avatars";
                text-color: #737b86;
                text-size: 10px;
                align-center: true;
                
            }
        }
    }

    /* Manual Date & Time picker: full screen with the nuubOS chrome (top
     * bar, action bar). Day / Month / Year on the first line, Hour : Minute
     * on the second; each wheel shows the next value above and the previous
     * one below. Geometry adapts to 4:3, square and 16:9. */
    property <length> dt-cell: root.layout-class == 2 ? 104px : 88px;
    property <length> dt-month: root.layout-class == 2 ? 240px : 200px;
    property <length> dt-year: root.layout-class == 2 ? 132px : 116px;
    property <length> dt-colon: 32px;
    property <length> dt-gap: 14px;
    property <length> dt-label: 24px;
    property <length> dt-preview-height: 34px;
    property <length> dt-spacing: root.height < 600px ? 18px : 28px;
    property <length> dt-wheel: max(88px, min(156px,
        (root.height - 116px - 16px - root.dt-preview-height - 2 * root.dt-spacing - 2 * root.dt-label) / 2));
    property <length> dt-block: root.dt-preview-height + 2 * root.dt-spacing + 2 * (root.dt-label + root.dt-wheel);
    property <length> dt-top: 58px + max(0px, (root.height - 116px - root.dt-block) / 2);
    property <length> dt-row0: root.dt-top + root.dt-preview-height + root.dt-spacing;
    property <length> dt-row1: root.dt-row0 + root.dt-label + root.dt-wheel + root.dt-spacing;
    property <length> dt-date-x: (root.width - root.dt-cell - root.dt-month - root.dt-year - 2 * root.dt-gap) / 2;
    property <length> dt-time-x: (root.width - 2 * root.dt-cell - root.dt-colon - 2 * root.dt-gap) / 2;
    pure function dt-x(i: int) -> length {
        if i == 0 { return root.dt-date-x; }
        if i == 1 { return root.dt-date-x + root.dt-cell + root.dt-gap; }
        if i == 2 { return root.dt-date-x + root.dt-cell + root.dt-month + 2 * root.dt-gap; }
        if i == 3 { return root.dt-time-x; }
        return root.dt-time-x + root.dt-cell + root.dt-colon + 2 * root.dt-gap;
    }
    pure function dt-w(i: int) -> length {
        if i == 1 { return root.dt-month; }
        if i == 2 { return root.dt-year; }
        return root.dt-cell;
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.datetime-picker-open;
        z: 186;
        clip: true;

        Rectangle {
            x: 0; y: 0; width: parent.width; height: 58px;
            background: Theme.background;
            /* The player's name where the wordmark was (user request
             * 2026-10-28); a quarter of the width keeps it off the title. */
            Text {
                x: 20px; y: 13px; width: parent.width * 0.25 - 20px; height: 28px;
                text: root.current-user-name;
                color: Theme.text;
                font-size: 19px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 0; y: 13px; width: parent.width; height: 28px;
                text: root.i18n-strings[46];
                color: Theme.text;
                font-size: 19px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: 16px; y: 57px; width: parent.width - 32px; height: 1px; background: Theme.surface; }
        }

        Text {
            x: 16px; y: root.dt-top; width: parent.width - 32px; height: root.dt-preview-height;
            text: root.datetime-preview;
            color: Theme.text-secondary;
            font-size: 20px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        for field[i] in root.datetime-fields : wheel := Rectangle {
            property <bool> focused: root.datetime-field-index == i;
            property <length> value-size: i == 1
                ? (root.layout-class == 2 ? 30px : 26px)
                : (root.layout-class == 2 ? 40px : 34px);
            x: root.dt-x(i);
            y: i < 3 ? root.dt-row0 : root.dt-row1;
            width: root.dt-w(i);
            height: root.dt-label + root.dt-wheel;

            Text {
                x: 0; y: 0; width: parent.width; height: root.dt-label - 4px;
                text: field.label;
                color: wheel.focused ? Theme.primary : Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: 0; y: root.dt-label; width: parent.width; height: root.dt-wheel;
                /* M3: tonal surface, the focused wheel in the selection
                 * roles with the primary outline (as Settings rows). */
                background: wheel.focused ? Theme.secondary-container : Theme.surface-container;
                border-radius: Shape.large;
                border-width: wheel.focused ? 3px : 0px;
                border-color: Theme.primary;
                animate background, border-width { duration: 120ms; }

                Text {
                    x: 4px; y: 6px; width: parent.width - 8px; height: parent.height * 0.26;
                    text: field.above;
                    color: Theme.text-faint;
                    font-size: wheel.value-size * 0.5;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 12px; y: parent.height * 0.29; width: parent.width - 24px; height: 1px;
                    background: wheel.focused ? Theme.outline-variant : Theme.border-soft;
                }
                Text {
                    x: 4px; y: parent.height * 0.3; width: parent.width - 8px; height: parent.height * 0.4;
                    text: field.value;
                    color: wheel.focused ? Theme.on-secondary-container : Theme.text;
                    font-size: wheel.value-size;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 12px; y: parent.height * 0.71; width: parent.width - 24px; height: 1px;
                    background: wheel.focused ? Theme.outline-variant : Theme.border-soft;
                }
                Text {
                    x: 4px; y: parent.height * 0.74 - 6px; width: parent.width - 8px; height: parent.height * 0.26;
                    text: field.below;
                    color: Theme.text-faint;
                    font-size: wheel.value-size * 0.5;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Text {
            x: root.dt-time-x + root.dt-cell + root.dt-gap;
            y: root.dt-row1 + root.dt-label;
            width: root.dt-colon; height: root.dt-wheel;
            text: ":";
            color: Theme.text;
            font-size: root.layout-class == 2 ? 40px : 34px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint { kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[82]; }
                ActionHint { kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[619]; }
            }
        }
    }

    /* Lifecycle splash layer (src/splash.rs drives every frame), above
     * every full-screen view (user picker z 180, OOB 150/190, safe mode
     * 185/186): without it the boot animation was hidden by the picker. */
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.splash-base;
        image-fit: fill;
        z: 1000;
        opacity: root.splash-base-alpha;
        visible: root.lifecycle-on && root.splash-base-alpha > 0;
    }

    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.splash-image;
        image-fit: fill;
        z: 1001;
        opacity: root.splash-top-alpha;
        visible: root.lifecycle-on && root.splash-top-alpha > 0;
    }

    Rectangle {
        x: root.splash-track-x + root.splash-track-w * root.splash-fill-from;
        y: root.splash-track-y;
        width: root.splash-track-w * max(0, root.splash-fill-to - root.splash-fill-from);
        height: root.splash-track-h;
        border-radius: self.height / 2;
        background: root.splash-accent;
        z: 1002;
        opacity: root.splash-fill-alpha;
        visible: root.lifecycle-on && root.splash-fill-alpha > 0 && root.splash-fill-to > root.splash-fill-from;
    }
}
