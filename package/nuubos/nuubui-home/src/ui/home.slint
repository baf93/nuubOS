component SettingsActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;

    height: 40px;
    border-radius: 6px;
    background: root.danger
        ? (root.selected ? #542329 : #28171a)
        : (root.selected ? #24589a : #17345b);
    border-width: 1px;
    border-color: root.danger
        ? (root.selected ? #d95a67 : #74343c)
        : (root.selected ? #73a8ff : #315f9f);
    opacity: root.enabled ? 1.0 : 0.42;

    Text {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: root.danger ? #ffc0c6 : #e8f1ff;
        font-size: 17px;
        font-weight: 700;
    }
}

component WifiToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> selected: false;

    width: 42px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? #234b80 : #24272d;
    border-width: 1px;
    border-color: root.selected ? #73a8ff : root.checked ? #3a86ff : #40454d;

    Rectangle {
        x: root.checked ? parent.width - 18px : 4px;
        y: 4px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? #dbe9ff : #9aa0a8;
        animate x { duration: 120ms; easing: ease-in-out; }
    }
}

component WifiNetworkListRow inherits Rectangle {
    in property <string> ssid: "";
    in property <string> security: "";
    in property <int> signal-dbm: 0;
    in property <bool> saved: false;
    in property <bool> current: false;
    in property <bool> selected: false;

    height: 44px;
    border-radius: 6px;
    background: root.selected ? #1b2940 : #15171b;
    border-width: 1px;
    border-color: root.selected ? #3a86ff : root.current ? #315f9f : #24272d;

    Text {
        x: 12px;
        y: 5px;
        width: parent.width - 128px;
        text: root.ssid;
        color: #f0f2f5;
        font-size: 17px;
        font-weight: root.current || root.selected ? 700 : 600;
        overflow: elide;
    }

    Text {
        x: 12px;
        y: 25px;
        width: parent.width - 128px;
        text: root.current ? "Connected"
            : root.saved ? root.security + " • Saved"
            : root.security;
        color: #7f858e;
        font-size: 12px;
        overflow: elide;
    }

    Text {
        x: parent.width - 112px;
        y: 0;
        width: 100px;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.signal-dbm == 0 ? ""
            : root.signal-dbm >= -55 ? "Excellent"
            : root.signal-dbm >= -67 ? "Good"
            : root.signal-dbm >= -75 ? "Fair"
            : "Weak";
        color: root.signal-dbm >= -67 ? #9dc1ff : #8e949d;
        font-size: 12px;
        font-weight: 600;
    }
}


component BluetoothDeviceListRow inherits Rectangle {
    in property <string> name: "";
    in property <string> kind: "Device";
    in property <bool> paired: false;
    in property <bool> connected: false;
    in property <int> rssi: 0;
    in property <bool> selected: false;

    height: 44px;
    border-radius: 6px;
    background: root.selected ? #1b2940 : #15171b;
    border-width: 1px;
    border-color: root.selected ? #3a86ff : root.connected ? #315f9f : #24272d;

    Text {
        x: 12px;
        y: 5px;
        width: parent.width - 116px;
        text: root.name;
        color: #f0f2f5;
        font-size: 17px;
        font-weight: root.connected || root.selected ? 700 : 600;
        overflow: elide;
    }

    Text {
        x: 12px;
        y: 25px;
        width: parent.width - 116px;
        text: root.connected ? root.kind + " • Connected"
            : root.paired ? root.kind + " • Paired"
            : root.kind;
        color: #7f858e;
        font-size: 12px;
        overflow: elide;
    }

    Text {
        x: parent.width - 104px;
        y: 0;
        width: 92px;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.connected ? "Connected"
            : root.paired ? "Saved"
            : root.rssi == 0 ? ""
            : root.rssi >= -55 ? "Excellent"
            : root.rssi >= -67 ? "Good"
            : root.rssi >= -75 ? "Fair"
            : "Weak";
        color: root.connected ? #9dc1ff : #8e949d;
        font-size: 12px;
        font-weight: 600;
    }
}

