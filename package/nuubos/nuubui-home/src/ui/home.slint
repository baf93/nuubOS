    /* Name of the active user's theme (General → Theme). */
    in-out property <string> theme-name: "nuubOS";
    in-out property <string> details-title: "";
    in-out property <string> details-subtitle: "";
    in-out property <string> details-description: "";
    in-out property <image> details-cover;
    in-out property <bool> details-has-cover: false;
    in-out property <int> details-face-position: -1;
    in-out property <bool> diag-busy: false;
    in-out property <bool> safe-mode: false;
    in-out property <string> recovery-notice: "";
    /* Safe mode screen (EPIC-050): full screen like the OOB hero. safe-index:
     * 0 Exit Safe Mode, then two columns: 1 Repair | 2 Support Bundle,
     * 3 Reset User Profile | 4 Settings, 5 Factory Reset | 6 Factory Reset
     * and Erase. Arming reuses recovery-armed/recovery-stage. Settings hides
     * it; Back from the categories shows it again. */
    in-out property <bool> safe-screen-open: false;
    in-out property <int> safe-index: 0;

    /* Initial setup / OOB (EPIC-002). nuubos-usersd owns the setup state; the
     * OOB is the Settings shell with a step rail instead of the categories and
     * reuses the real Settings pages and dropdowns. oob-step: 0 Language,
     * 1 Date & Time (settings-view 30), 2 Wi-Fi (31, then the Wi-Fi pages 2/4
     * and keyboard 6), 3 Users (32, user detail 26, keyboard 6), 4 Ready.
     * Language and Ready are full-screen. */
    in-out property <bool> oob-active: false;
    in-out property <int> oob-step: 0;
    in-out property <int> oob-index: 0;
    in-out property <int> oob-scroll: 0;
    in-out property <string> oob-notice: "";
    /* Users page rows: users, Add User, [Startup, Boot User when more than
     * one user], Continue. Rust uses the same row order. */
    property <int> oob-user-extra: root.user-count > 1 ? 2 : 0;
    property <int> oob-users-continue: root.user-count + 1 + root.oob-user-extra;

    /* PC game streaming (EPIC-025). nuubos-streamd owns the user's PCs,
     * pairing, their applications and the stream settings; this is its
     * client. Like the OOB, Moonlight is the Settings shell with its own rail:
     * settings-view 40 PCs (PCs, Search, Add by Address, Stream Settings),
     * 41 one PC (paired: its applications; else Pair with the PIN; then
     * Remove PC), 42 Stream Settings; the system keyboard (6) adds a PC. */
    in-out property <bool> moonlight-active: false;
    in-out property <int> moonlight-index: 0;
    in-out property <int> moonlight-scroll: 0;
    in-out property <string> moonlight-notice: "";
    in-out property <[MoonlightHostEntry]> moonlight-hosts: [];
    in-out property <bool> moonlight-discovering: false;
    in-out property <MoonlightHostEntry> moonlight-host;
    in-out property <[string]> moonlight-apps: [];
    in-out property <string> moonlight-apps-state: "none";
    in-out property <string> moonlight-pairing-pin: "";
    in-out property <bool> moonlight-remove-confirm: false;
    in-out property <string> moonlight-resolution-label: "";
    in-out property <string> moonlight-fps-label: "";
    in-out property <string> moonlight-codec-label: "";
    in-out property <string> moonlight-bitrate-label: "";
    in-out property <float> moonlight-bitrate-fraction: 0;
    in-out property <string> moonlight-audio-label: "";
    in-out property <bool> moonlight-local-audio: false;
    in-out property <bool> moonlight-optimize: true;
    in-out property <bool> moonlight-quit-app: false;
    /* Row of Remove PC on page 41 (Rust uses the same order). */
    property <int> moonlight-remove-row: root.moonlight-host.paired ? root.moonlight-apps.length : 1;

    /* Steam Link (EPIC-026). nuubos-streamd downloads Valve's application
     * and runs it; Valve's interface handles the PCs and pairing. Settings
     * shell like Moonlight, settings-view 45: absent → Download (with the
     * Steam Subscriber Agreement notice), installing → progress (A
     * cancels), installed → Open, Update / Check for Updates, Remove. */
    in-out property <bool> steamlink-active: false;
    in-out property <int> steamlink-index: 0;
    in-out property <string> steamlink-notice: "";
    in-out property <string> steamlink-state: "absent";
    in-out property <string> steamlink-progress-label: "";
    in-out property <string> steamlink-download-detail: "";
    in-out property <string> steamlink-version-label: "";
    in-out property <string> steamlink-update-title: "";
    in-out property <string> steamlink-update-value: "";
    in-out property <bool> steamlink-remove-confirm: false;
    /* Application page of Moonlight (views 40, 41) and Steam Link (45),
     * filled by apppage.rs. */
    in-out property <string> app-page-kicker;
    in-out property <string> app-page-title;
    in-out property <string> app-page-meta;
    in-out property <string> app-page-description;
    in-out property <image> app-page-icon;
    in-out property <bool> app-page-has-icon: false;
    in-out property <[DetailChip]> app-page-chips: [];
    in-out property <[AppEntry]> app-page-entries: [];
    in-out property <[DetailAction]> app-page-actions: [];
    in-out property <[string]> app-page-captions: [];
    in-out property <string> app-page-pin;
    in-out property <float> app-page-progress: -1;
    in-out property <string> app-page-progress-label;
    /* Files (58, 60) and Media (65) drawn as application pages from
     * their generic rows (apppage::gen_page). */
    in-out property <bool> app-page-gen: false;
    /* settings-title-view: the page stays behind the keyboard it opened. */
    property <bool> app-page-shown: (root.moonlight-active && (root.settings-title-view == 40 || root.settings-title-view == 41))
        || (root.steamlink-active && root.settings-title-view == 45)
        || (root.app-page-gen && (root.settings-title-view == 58 || root.settings-title-view == 60 || root.settings-title-view == 65));
    /* Application settings drawn with the Settings rows (Moonlight Stream
     * Settings 42, Web 67) are full screen like the application page: no
     * rail, the app's colour and name above the page title (user request
     * 2026-10-10). */
    property <bool> app-shell: root.settings-open
        && ((root.moonlight-active && root.settings-title-view == 42)
            || (root.details-active && root.details-shell-title != "" && root.settings-title-view == 67));
    property <string> app-shell-kicker: root.moonlight-active ? root.i18n-strings[435] : root.details-shell-title;
    property <string> app-shell-meta: root.moonlight-active ? "" : root.details-description;

    /* Global lifecycle overlays. Business logic remains in nuubos-systemd. */

    /* Settings navigation depth:
     * 0 categories, 1 Connectivity, 2 Wi-Fi connect/scan,
     * 3 saved networks, 4 network detail, 6 system keyboard,
     * 7 Bluetooth discovery, 8 known Bluetooth devices, 9 Bluetooth device detail,
     * 10 Controllers & Input, 11 Player Assignment, 12 controller list/picker,
     * 13 controller detail, 14 per-controller mapping, 15 input tester,
     * 17 RGB Lighting, 18 Display & Audio,
     * 19 System, 20 Storage, 21 System Information, 22 Restore Defaults,
     * 23 General, 24 Profile, 25 Users, 26 User Detail,
     * 27 Diagnostics, 28 Recovery,
     * 30 OOB Date & Time, 31 OOB Wi-Fi, 32 OOB Users,
     * 40 Moonlight PCs, 41 Moonlight PC, 42 Moonlight Stream Settings,
     * 45 Steam Link,
     * 50 Game Details, 51 Game Settings (the Details shell, details-active),
     * 52 BIOS Files, 53 BIOS Files of a system, 54 RetroAchievements,
     * 55 Game Hotkeys, 56 Performance Overlay, 57 Start Game (Details shell),
     * 58 Files and 60 Network Shares (the Files shell), 61 Removable Media,
     * 62 Backup & Restore, 63 Software Update,
     * 65 Media (its own shell), 66 Syncthing (generic rows, gen-rows),
     * 67 Web (Details shell, generic rows), 68 Gaming. */
    in-out property <int> settings-view: 0;
    /* The page title: the system keyboard (6) keeps the title of the page it
     * was opened from; its field label names what is entered. */
    property <int> settings-title-view: root.settings-view == 6 ? root.keyboard-return-view : root.settings-view;
    /* Keep read-only/unavailable rows visually consistent with the rest of Settings.
     * The bottom action bar, not row opacity, communicates whether Confirm/Select
     * has an action for the currently focused row. */
    property <bool> settings-select-hint-visible: root.settings-open && (
        root.settings-choice-open ? true
        : root.gen-view ? root.gen-select
        : root.settings-view == 68 ? root.gaming-select
        : root.settings-view == 69 ? root.power-index < root.power-battery-start
        : root.settings-view >= 30 ? true
        : root.settings-view == 23 ? true
        : root.settings-view == 24 ? true
        : root.settings-view == 25 ? true
        : root.settings-view == 26 ? true
        : root.settings-view == 21 ? false
        : root.settings-view == 14 ? false
        : root.settings-view == 27 ? root.diag-index == 0
        : root.settings-view == 28 ? true
        : root.settings-view == 20 ? (
            root.system-storage-index == 3 ? root.system-storage-job-state != "running"
            : root.system-storage-index == 4 ? (root.system-storage-job-state != "running"
                && (root.system-tf2-state == "FOREIGN" || root.system-tf2-state == "OWNED"))
            : root.system-storage-index == 5 ? (root.system-storage-job-state != "running"
                && root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2")
            : false)
        : root.settings-view == 18 && root.display-audio-index == 0 ? root.display-brightness-available
        : root.settings-view == 18 && root.display-audio-index == root.da-audio-start + 1 ? root.audio-volume-supported
        : root.settings-view == 4 && root.wifi-detail-index == 1 ? root.wifi-wps-active || root.wifi-wps-available
        : root.settings-view == 4 && root.wifi-detail-index == 2 ? root.wifi-selected-security != root.i18n-strings[212]
        : root.settings-view == 4 && root.wifi-detail-index >= 4 && root.wifi-detail-index <= 7 ? root.wifi-ip-mode == "manual"
        : root.settings-view == 4 && root.wifi-detail-index == 9 ? root.wifi-selected-saved
        : root.settings-view == 1 && root.connectivity-selected-index == 1 ? root.wifi-enabled
        : root.settings-view == 1 && (root.connectivity-selected-index == 4 || root.connectivity-selected-index == 5) ? root.bluetooth-enabled
        : root.settings-view == 10 && root.controllers-menu-index == 2 ? root.rumble-supported
        : root.settings-view == 10 && root.controllers-menu-index == 3 ? root.lighting-supported
        : root.settings-view == 17 && root.lighting-index == 1 ? root.lighting-color-capable
        : root.settings-view == 17 && root.lighting-index == 3 ? root.lighting-speed-capable
        : true
    );
    in-out property <int> connectivity-selected-index: 0;
    /* Connectivity has three sections: WI-FI (0-2), BLUETOOTH (3-5) and
     * SERVICES (from 6: SSH, SMB, Web Administration, Password, Regenerate
     * Password, Syncthing; user requests 2026-10-08: the services sit on
     * the page itself, no Remote/Online Services sub-pages). Rust keeps the focused row visible (sectioned_scroll); the
     * category preview stays at offset 0. */
    in-out property <int> connectivity-scroll: 0;
    in-out property <[GenRow]> connectivity-services: [];
    property <int> connectivity-scroll-offset: root.settings-view == 1 ? root.connectivity-scroll : 0;
    /* Gaming: GAMING (USER: RetroAchievements and the emulation settings),
     * then LIBRARY (DEVICE, from row gaming-split: Scan for New Games,
     * metadata source and account, Get Metadata for All Games, BIOS Files). Rows = GenRows built by gameui.rs
     * (render_gaming); gaming-select: the focused row has an action. */
    in-out property <int> gaming-index: 0;
    in-out property <int> gaming-split: 1;
    in-out property <[GenRow]> gaming-rows: [];
    in-out property <bool> gaming-select: true;
    property <int> gaming-scroll-offset:
        root.settings-view == 68
            ? max(0, root.gaming-index - root.settings-sectioned-visible-rows + 1)
            : 0;
    in-out property <int> wifi-menu-index: 0;
    in-out property <int> wifi-menu-scroll-offset: 0;
    in-out property <int> wifi-network-index: 0;
    in-out property <int> wifi-network-scroll-offset: 0;
    in-out property <int> wifi-saved-index: 0;
    in-out property <int> wifi-saved-scroll-offset: 0;
    in-out property <int> wifi-detail-index: 0;
    in-out property <int> wifi-detail-scroll-offset: 0;
    in-out property <int> wifi-detail-return-view: 2;

    /* UI foundation layout classes: 0=4:3/handheld, 1=square, 2=wide/TV.
     * Geometry changes by class and by available size; this is not a single
     * 640x480 raster scaled uniformly. */
    property <int> layout-class: root.width * 4 >= root.height * 7 ? 2 : root.width * 10 <= root.height * 11 ? 1 : 0;
    property <length> settings-rail-width:
        root.layout-class == 2 ? max(220px, min(300px, root.width / 5))
        : root.layout-class == 1 ? max(198px, min(260px, root.width * 0.245))
        : max(198px, min(280px, root.width * 0.31));
    property <length> settings-pane-x: root.app-shell ? 0px : root.settings-rail-width + 32px;
    /* Page column: full pane on handhelds, capped on wide/TV outputs so
     * titles and values stay close together and next to the rail; a full
     * screen application page centres its wider column. */
    property <length> settings-pane-width: root.width - root.settings-pane-x;
    property <length> settings-content-width: root.app-shell ? min(root.width - 44px, 1100px)
        : min(root.settings-pane-width - 44px, 860px);
    property <length> settings-content-x: root.app-shell ? (root.width - root.settings-content-width) / 2 : 22px;

    /* Settings grid. One set of metrics for every page, rail and dropdown:
     * rows grow with the logical height (42px at 480 lines, 60px cap), the
     * pane header band is fixed, and every row is placed by srow-y(). Pixel
     * density for HDMI/TV belongs to the compositor output scale, so these
     * logical sizes stay readable at any physical resolution. */
    property <length> settings-row-height: max(42px, min(60px, root.height * 0.0875));
    property <length> settings-row-gap: 8px;
    property <length> settings-row-step: root.settings-row-height + root.settings-row-gap;
    /* An application header's meta line needs one more band. */
    property <length> settings-section-y: !root.app-shell || root.app-shell-meta == "" ? 62px : 78px;
    property <length> settings-content-y: root.settings-section-y + 26px;
    property <length> settings-section-gap: 26px;
    property <length> settings-notice-height: 16px;
    property <length> settings-choice-list-y: 46px;
    property <length> settings-pane-height: root.height - 102px;
    property <length> settings-list-bottom: root.settings-pane-height - root.settings-notice-height - 6px;

    /* Responsive Settings viewport capacities. These bindings are derived from
     * the actual logical Window height, so HDMI/output resize immediately
     * changes how many rows fit without carrying 640x480 scroll thresholds.
     * Sectioned pages (General, Connectivity) reserve one inline header. */
    in-out property <int> settings-list-visible-rows:
        max(1, floor((root.settings-list-bottom - root.settings-content-y + root.settings-row-gap) / root.settings-row-step));
    in-out property <int> settings-sectioned-visible-rows:
        max(1, floor((root.settings-list-bottom - root.settings-content-y - root.settings-section-gap + root.settings-row-gap) / root.settings-row-step));
    in-out property <int> wifi-detail-visible-rows: root.settings-list-visible-rows;

    pure function srow-y(k: int, scroll: int, split: int) -> length {
        root.settings-content-y + (k - scroll) * root.settings-row-step
            + (split > 0 && scroll < split && k >= split ? root.settings-section-gap : 0px)
    }
    /* General has four sections: PROFILE (0-2, user), USERS (3-5), DATE &
     * TIME (6-10) and KEYBOARD (11), the last three device-scoped. */
    pure function srow-visible(k: int, scroll: int, rows: int) -> bool {
        k >= scroll && k < scroll + rows
    }
    /* Sectioned category pages (user request 2026-10-08): a, b and c are the
     * first rows of the second, third and fourth section (0 = none). The
     * section of the first visible row is the sticky header; every later
     * section below it gets an inline header. Rust keeps the focused row
     * visible through sec-row-visible (sectioned_scroll in main.rs). */
    pure function sec-row-y(k: int, scroll: int, a: int, b: int, c: int) -> length {
        root.settings-content-y + (k - scroll) * root.settings-row-step
            + ((a > 0 && scroll < a && k >= a ? 1 : 0) + (b > 0 && scroll < b && k >= b ? 1 : 0)
               + (c > 0 && scroll < c && k >= c ? 1 : 0)) * root.settings-section-gap
    }
    public pure function sec-row-visible(k: int, scroll: int, a: int, b: int, c: int) -> bool {
        k >= scroll && root.sec-row-y(k, scroll, a, b, c) + root.settings-row-height <= root.settings-list-bottom
    }
    pure function signal-label(dbm: int) -> string {
        dbm == 0 ? ""
            : dbm >= -55 ? root.i18n-strings[200]
            : dbm >= -67 ? root.i18n-strings[201]
            : dbm >= -75 ? root.i18n-strings[202]
            : root.i18n-strings[203]
    }
    pure function bluetooth-state-label(connected: bool, paired: bool, rssi: int) -> string {
        connected ? root.i18n-strings[198]
            : paired ? root.i18n-strings[199]
            : root.signal-label(rssi)
    }

    /* Which category page is rendered (focused or merely highlighted). */
    property <bool> page-general: root.settings-view == 23 || (root.settings-view == 0 && root.settings-selected-index == 0);
    property <bool> page-connectivity: root.settings-view == 1 || (root.settings-view == 0 && root.settings-selected-index == 1);
    property <bool> page-controllers: root.settings-view == 10 || (root.settings-view == 0 && root.settings-selected-index == 2);
    property <bool> page-gaming: root.settings-view == 68 || (root.settings-view == 0 && root.settings-selected-index == 3);
    property <bool> page-display-audio: root.settings-view == 18 || (root.settings-view == 0 && root.settings-selected-index == 4);
    property <bool> page-power: root.settings-view == 69 || (root.settings-view == 0 && root.settings-selected-index == 5);
    property <bool> page-system: root.settings-view == 19 || (root.settings-view == 0 && root.settings-selected-index == 6);
    property <bool> controllers-group: root.page-controllers || (root.settings-view >= 11 && root.settings-view <= 17);

    property <string> settings-section-label:
        root.page-general ? (root.general-scroll-offset >= 11 ? root.i18n-strings[336]
            : root.general-scroll-offset >= 6 ? root.i18n-strings[335]
            : root.general-scroll-offset >= 3 ? root.i18n-strings[334]
            : root.i18n-strings[333])
        /* Sub-pages keep the section they were opened from. */
        : root.settings-view == 24 ? root.i18n-strings[333]
        : root.settings-view == 25 || root.settings-view == 26 ? root.i18n-strings[334]
        : root.settings-view == 30 ? root.i18n-strings[335]
        : root.settings-view == 31 ? root.i18n-strings[156]
        : root.settings-view == 32 ? root.i18n-strings[334]
        : root.settings-view == 40 ? root.i18n-strings[436]
        : root.settings-view == 41 ? (root.moonlight-host.paired ? root.i18n-strings[135] : root.i18n-strings[436])
        : root.settings-view == 42 ? (root.moonlight-scroll >= 6 ? root.i18n-strings[858]
            : root.moonlight-scroll >= 4 ? root.i18n-strings[729] : root.i18n-strings[857])
        : root.settings-view == 45 ? root.i18n-strings[477]
        : root.settings-view == 28 && root.safe-mode ? root.i18n-strings[518]
        : root.gen-view
            ? (root.gen-split > 0 && root.gen-scroll >= root.gen-split ? root.gen-split-label : root.gen-section)
        : root.page-gaming ? (root.gaming-scroll-offset >= root.gaming-split ? root.i18n-strings[704] : root.i18n-strings[703])
        : root.page-connectivity ? (root.connectivity-scroll-offset >= 6 ? root.i18n-strings[727]
            : root.connectivity-scroll-offset >= 3 ? root.i18n-strings[160] : root.i18n-strings[156])
        : root.settings-view >= 2 && root.settings-view <= 4 ? root.i18n-strings[156]
        : root.settings-view >= 7 && root.settings-view <= 9 ? root.i18n-strings[160]
        /* Controller Mapping: 17 button rows, then the sticks. */
        : root.settings-view == 15 ? (root.controller-mapping-scroll-offset >= 17 ? root.i18n-strings[368] : root.i18n-strings[367])
        : root.page-controllers || (root.settings-view >= 11 && root.settings-view <= 14) ? root.i18n-strings[734]
        : root.settings-view == 16 ? root.i18n-strings[735]
        : root.settings-view == 17 ? (root.lighting-scroll-offset >= 4 ? root.i18n-strings[129] : root.i18n-strings[130])
        : root.page-display-audio ? (root.display-audio-scroll-offset >= root.da-sounds-start ? root.i18n-strings[730]
            : root.display-audio-scroll-offset >= root.da-audio-start ? root.i18n-strings[729] : root.i18n-strings[728])
        : root.page-power ? (root.power-scroll-offset >= root.power-devices-start ? root.i18n-strings[815]
            : root.power-scroll-offset >= root.power-battery-start ? root.i18n-strings[814] : root.i18n-strings[826])
        : root.page-system ? (root.system-scroll-offset >= root.system-support-start ? root.i18n-strings[733] : root.i18n-strings[732])
        : root.settings-view == 20 || root.settings-view == 21 ? root.i18n-strings[732]
        : root.settings-view == 27 || root.settings-view == 28 ? root.i18n-strings[733]
        : "";
    /* Ownership chip. General and the user pages are split purely by
     * ownership, so they show the USER/DEVICE chip alone. */
    property <string> settings-section-scope:
        root.page-general ? (root.general-scroll-offset >= 3 ? root.i18n-strings[313] : root.i18n-strings[312])
        : root.settings-view == 24 ? root.i18n-strings[312]
        : root.settings-view == 25 || root.settings-view == 26 ? root.i18n-strings[313]
        /* PCs, their pairing and the stream settings are the user's. */
        : root.settings-view >= 40 && root.settings-view <= 42 ? root.i18n-strings[312]
        /* The Steam Link application is shared by every user. */
        : root.settings-view == 45 ? root.i18n-strings[313]
        /* A game's details and settings and achievements are the user's;
         * BIOS files and the ScreenScraper account are device-wide. */
        : root.settings-view == 50 || root.settings-view == 51 || (root.settings-view >= 54 && root.settings-view <= 57) || root.settings-view == 62 || root.settings-view == 66 || root.settings-view == 67 || root.settings-view == 70 || root.settings-view == 71 ? root.i18n-strings[312]
        : root.settings-view == 52 || root.settings-view == 53 ? root.i18n-strings[313]
        : root.page-gaming ? (root.gaming-scroll-offset >= root.gaming-split ? root.i18n-strings[313] : root.i18n-strings[312])
        : root.settings-section-label == "" ? ""
        : root.controllers-group ? root.i18n-strings[312]
        : root.i18n-strings[313];

    property <string> settings-notice:
        root.moonlight-active && (root.settings-view >= 40 || root.settings-view == 6) ? root.moonlight-notice
        : root.steamlink-active && root.settings-view == 45 ? root.steamlink-notice
        : root.settings-view >= 2 && root.settings-view <= 4 ? (root.wifi-notice != "" ? root.wifi-notice
            /* A scan with networks already listed (e.g. the current one)
             * still says it is searching. */
            : root.settings-view == 2 && root.wifi-scanning && root.wifi-networks.length > 0 ? root.i18n-strings[164]
            : "")
        : root.gen-view ? root.gen-notice
        : root.settings-view == 68 ? root.gen-notice
        : root.settings-view == 31 ? (root.wifi-notice != "" ? root.wifi-notice : root.oob-notice)
        : root.settings-view >= 30 ? root.oob-notice
        : root.settings-view == 27 || root.settings-view == 28 ? root.recovery-notice
        : root.settings-view >= 7 && root.settings-view <= 9 ? root.bluetooth-notice
        : root.page-connectivity ? (root.wifi-notice != "" ? root.wifi-notice : root.bluetooth-notice)
        : root.settings-view == 15 && root.controller-remap-waiting ? root.controller-remap-prompt
        : "";

    pure function lighting-effect-index(effect: string) -> int {
        effect == "solid" ? 114 : effect == "breathe" ? 115 : effect == "orbit" ? 116
            : effect == "aurora" ? 117 : effect == "spectrum" ? 118 : effect == "battery" ? 119
            : effect == "game" ? 120 : 54
    }
    pure function lighting-effect-detail-index(effect: string) -> int {
        effect == "solid" ? 742 : effect == "breathe" ? 743 : effect == "orbit" ? 744
            : effect == "aurora" ? 745 : effect == "spectrum" ? 746 : effect == "battery" ? 747
            : effect == "game" ? 748 : 741
    }
    /* Same palette as lighting.rs COLORS. */
    pure function lighting-color-index(value: string) -> int {
        value == "theme" ? 749 : value == "3a86ff" ? 209 : value == "00c2e0" ? 750
            : value == "2ee6a6" ? 751 : value == "a6e22e" ? 752 : value == "ffb020" ? 753
            : value == "ff6a1a" ? 754 : value == "ff2e3e" ? 755 : value == "ff3ea5" ? 756
            : value == "9b5cff" ? 757 : value == "ffffff" ? 758 : 759
    }
    property <string> lighting-effect-label: root.i18n-strings[root.lighting-effect-index(root.lighting-effect)];
    property <bool> lighting-color-capable: root.lighting-effect == "solid"
        || root.lighting-effect == "breathe" || root.lighting-effect == "orbit"
        || root.lighting-effect == "aurora";
    property <bool> lighting-speed-capable: root.lighting-effect == "breathe"
        || root.lighting-effect == "orbit" || root.lighting-effect == "aurora"
        || root.lighting-effect == "spectrum";
    property <int> lighting-scroll-offset: root.settings-view == 17 ? root.lighting-scroll : 0;
    in-out property <int> wifi-ip-index: 0;

    in-out property <bool> wifi-enabled: false;
    in-out property <bool> wifi-scanning: false;
    in-out property <string> wifi-current-ssid: "";
    in-out property <string> wifi-notice: "";
    in-out property <[WifiNetworkEntry]> wifi-networks: [];
    in-out property <[WifiNetworkEntry]> wifi-saved-networks: [];

    in-out property <string> wifi-selected-ssid: "";
    in-out property <string> wifi-selected-security: "";
    in-out property <bool> wifi-selected-saved: false;
    in-out property <bool> wifi-selected-current: false;
    in-out property <bool> wifi-pending-hidden: false;
    /* A WPS push-button session runs in the Wi-Fi service. */
    in-out property <bool> wifi-wps-active: false;
    /* WPS only applies to personal (PSK/SAE) networks; raw service values. */
    property <bool> wifi-wps-available: !root.wifi-selected-current
        && root.wifi-selected-security != "Open"
        && root.wifi-selected-security != "Enterprise"
        && root.wifi-selected-security != "WEP";

    /* System virtual keyboard. Layout is a product setting boundary: Language/Region
     * can change keyboard-layout later without any Wi-Fi-specific UI changes. */
    in-out property <string> keyboard-layout: "qwerty";
    in-out property <string> keyboard-input-kind: "text";

    /* Controller-first system keyboard state; TextInput keeps physical keyboard support. */
    in-out property <int> keyboard-purpose: 0;
    in-out property <int> keyboard-return-view: 2;
    in-out property <int> keyboard-index: 0;
    in-out property <int> keyboard-page: 0;
    in-out property <bool> keyboard-shift: false;
    /* Shift locked (Caps Lock). */
    in-out property <bool> keyboard-caps: false;
    in-out property <bool> keyboard-secret: false;
    in-out property <string> keyboard-title: "";
    in-out property <string> keyboard-value: "";
    in-out property <[string]> keyboard-row-zero: [];
    in-out property <[string]> keyboard-row-one: [];
    in-out property <[string]> keyboard-row-two: [];
    in-out property <[string]> keyboard-row-three: [];

    /* Per-network IP configuration. Automatic values are runtime/read-only. */
    in-out property <string> wifi-ip-mode: "automatic";
    in-out property <string> wifi-ip-address: "";
    in-out property <int> wifi-ip-prefix: 0;
    in-out property <string> wifi-ip-netmask: "";
    in-out property <string> wifi-ip-gateway: "";
    in-out property <string> wifi-ip-dns: "";
    in-out property <string> wifi-runtime-address: "";
    in-out property <int> wifi-runtime-prefix: 0;
    in-out property <string> wifi-runtime-netmask: "";
    in-out property <string> wifi-runtime-gateway: "";
    in-out property <string> wifi-runtime-dns: "";

    callback focus-system-keyboard();
    callback system-keyboard-place-cursor(int);
    callback system-keyboard-accepted();

    property <length> bluetooth-audio-topbar-reserve:
        root.audio-bluetooth-available ? 30px : 0px;

    /* Controllers end left of the status icons and must not reach the
     * centered clock (76px wide); when the full icons do not fit they
     * switch to compact badges sharing one gamepad icon. */
    property <length> controllers-right: root.width - 117px - root.bluetooth-audio-topbar-reserve;
    property <length> controllers-room: root.controllers-right - (root.width / 2 + 46px);
    property <bool> controllers-compact: root.controller-count * 34px > root.controllers-room;
    property <length> controllers-step: !root.controllers-compact ? 34px
        : max(13px, min(16px, (root.controllers-room - 26px) / max(1, root.controller-count)));
    property <length> controllers-start-x: root.controllers-right
        - (root.controllers-compact ? 26px + root.controller-count * root.controllers-step
           : root.controller-count * 34px);

    title: "nuubOS";
    background: Theme.background;
    default-font-family: "Cantarell";

    animate line-progress {
        duration: 220ms;
        easing: ease-in-out;
    }

    animate curtain-progress {
        duration: 460ms;
        easing: ease-in-out;
    }

    focus-system-keyboard() => { system-keyboard.focus-entry(); }
    system-keyboard-place-cursor(offset) => { system-keyboard.place-cursor-at(offset); }

    /* Physical keyboard (EPIC-023): arrows, Enter/Space and Escape/Backspace
     * act like the controller's navigation actions. The scope has focus
     * except while the system keyboard's text field has it, so typing never
     * doubles as navigation. */
    callback keyboard-action(string);
    callback focus-navigation();
    focus-navigation() => { keyboard-scope.focus(); }
    forward-focus: keyboard-scope;
    keyboard-scope := FocusScope {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.keyboard-action("menu_up"); return accept; }
            if (event.text == Key.DownArrow) { root.keyboard-action("menu_down"); return accept; }
            if (event.text == Key.LeftArrow) { root.keyboard-action("menu_left"); return accept; }
            if (event.text == Key.RightArrow) { root.keyboard-action("menu_right"); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.keyboard-action("menu_confirm"); return accept; }
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.keyboard-action("menu_back"); return accept; }
            if (event.text == Key.Tab) { root.keyboard-action("face_west"); return accept; }
            reject
        }
    }

    /* HOME stays completely still behind the lifecycle curtain.
     * No background here or on home-view: the window clear already paints
     * Theme.background, and every full-screen fill is a whole shading pass
     * the single-core Mali pays per frame (1080p HDMI is fill-bound). */
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        /* Topbar: matte background shared with the Quick Menu. */
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 50px;
            background: Theme.background;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.surface;
            }

            /* Left: nuubOS wordmark + current user. Keep both color runs content-sized
             * in one zero-spacing layout so the mark reads as one continuous word. */
            HorizontalLayout {
                x: 18px;
                y: 13px;
                width: 96px;
                height: 25px;
                spacing: 0px;
                alignment: start;

                wordmark-nuub := Text {
                    text: "nuub";
                    color: Theme.text;
                    font-size: 21px;
                    font-weight: 700;
                }
                wordmark-os := Text {
                    text: "OS";
                    color: Theme.accent;
                    font-size: 21px;
                    font-weight: 700;
                }
            }
            /* Current user right after the wordmark. */
            Rectangle {
                x: 18px + wordmark-nuub.preferred-width + wordmark-os.preferred-width + 8px;
                y: 11px;
                width: 28px;
                height: 28px;
                border-radius: self.width * 0.22;
                /* Frame = this fill under an inset one (no stroke, no
                 * rounded clip: both go through the stencil buffer). */
                background: root.current-user-avatar-available ? Theme.accent : Theme.border-soft;
                Rectangle {
                    x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                    border-radius: self.width * 0.22;
                    background: #11151a;
                }

                /* Avatar arrives pre-masked (Rust round_avatar); inset it
                 * inside the frame so the frame stays visible. */
                Image {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    source: root.current-user-avatar;
                    image-fit: contain;
                    visible: root.current-user-avatar-available;
                }

                Image {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    source: @image-url("assets/icons/user.svg");
                    image-fit: contain;
                    visible: !root.current-user-avatar-available;
                }
            }

            /* Center: wall clock supplied by nuubos-statusd. */
            Text {
                x: (parent.width - 76px) / 2;
                y: 15px;
                width: 76px;
                horizontal-alignment: center;
                text: root.topbar-time;
                color: Theme.text;
                font-size: 19px;
                font-weight: 500;
            }

            /* Right: connected external controllers (up to eight players). */
            Image {
                x: root.controllers-start-x;
                y: 14px;
                width: 22px;
                height: 22px;
                source: @image-url("assets/icons/gamepad.svg");
                image-fit: contain;
                visible: root.controllers-compact && root.controller-count > 0;
            }
            for controller[i] in root.topbar-controllers: ControllerStatus {
                x: root.controllers-start-x
                    + (root.controllers-compact ? 26px : 0px) + i * root.controllers-step;
                y: 0px;
                player: controller.player;
                battery-percent: controller.battery;
                compact: root.controllers-compact;
            }

            Image {
                x: parent.width - 143px;
                y: 14px;
                width: 22px;
                height: 22px;
                source: @image-url("assets/icons/headphones.svg");
                image-fit: contain;
                visible: root.audio-bluetooth-available;
            }

            WifiStatus {
                x: parent.width - 113px;
                y: 0px;
                state: root.wifi-state;
            }

            BatteryGlyph {
                x: parent.width - 84px;
                y: 13px;
                percent: root.battery-percent;
                charging: root.battery-state == "charging";
                battery-saver: root.system-effective-profile == "battery-saver";
            }

            Text {
                x: parent.width - 56px;
                y: 14px;
                width: 48px;
                height: 24px;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.battery-label;
                color: #e5e7eb;
                font-size: 18px;
                font-weight: 700;
            }
        }

        /* Home: Recently Played covers with the focused game's title +
         * metadata, then the Systems & Collections and Applications chip
         * shelves, all on one screen; or the library grid of one system /
         * collection. */
        home-view := Rectangle {
            x: 0;
            y: 50px;
            width: parent.width;
            height: parent.height - 102px;
            visible: !root.settings-open;
            clip: true;

            /* Fixed positions: moving between sections never moves the
             * layout. Every section stays on screen; an empty one shows a
             * playful empty-state card instead of covers or chips. */
            property <int> variant: root.home-empty-variant;
            property <string> status: root.library-scanning ? root.i18n-strings[410] : "";

            Rectangle {
                x: 0;
                y: root.home-top-pad;
                width: parent.width;
                height: root.home-rows-h;
                clip: true;
                visible: !root.library-open && !root.find-open;

              /* The column glides to the selected section. */
              home-column := Rectangle {
                x: 0; y: -root.home-v-scroll;
                width: parent.width; height: root.home-total-h;
                animate y { duration: 300ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

                HomeRow {
                    x: 0; y: 0; width: parent.width;
                    label: root.i18n-strings[0];
                    cards: root.home-recent;
                    index: root.home-recent-index;
                    active: root.home-row == 0;
                    card-h: root.home-big-h;
                    label-h: root.home-label-h;
                    info-h: root.home-info-h;
                    pad: root.home-pad;
                    gap: root.home-gap;
                    s: root.home-s;
                    notice: root.home-notice;
                    status: home-view.status;
                    unavailable-label: root.i18n-strings[205];
                    empty-headline: root.i18n-strings[714 + 2 * mod(home-view.variant, 4)];
                    empty-body: root.i18n-strings[715 + 2 * mod(home-view.variant, 4)];
                    empty-icon: 0;
                }
                HomeRow {
                    x: 0; y: root.home-y1; width: parent.width;
                    label: root.i18n-strings[840];
                    cards: root.home-systems;
                    index: root.home-systems-index;
                    active: root.home-row == 1;
                    card-h: root.home-show-h;
                    show-w: root.home-show-w;
                    label-h: root.home-label-h;
                    pad: root.home-pad;
                    gap: root.home-gap;
                    s: root.home-s;
                    notice: root.home-notice;
                    status: home-view.status;
                    unavailable-label: root.i18n-strings[205];
                    empty-headline: root.i18n-strings[722 + mod(home-view.variant, 3)];
                    empty-body: root.library-scanning ? root.i18n-strings[410] : root.i18n-strings[2];
                    empty-icon: 1;
                }
                HomeRow {
                    x: 0; y: root.home-y2; width: parent.width;
                    label: root.i18n-strings[537];
                    cards: root.home-collections;
                    index: root.home-collections-index;
                    active: root.home-row == 2;
                    card-h: root.home-show-h;
                    show-w: root.home-show-w;
                    label-h: root.home-label-h;
                    pad: root.home-pad;
                    gap: root.home-gap;
                    s: root.home-s;
                    notice: root.home-notice;
                    status: home-view.status;
                    unavailable-label: root.i18n-strings[205];
                    empty-headline: "";
                    empty-body: "";
                    empty-icon: 1;
                }
                HomeRow {
                    x: 0; y: root.home-y3; width: parent.width;
                    label: root.i18n-strings[135];
                    cards: root.home-apps;
                    index: root.home-apps-index;
                    active: root.home-row == 3;
                    card-h: root.home-chip-h;
                    chip-w: root.home-chip-w;
                    label-h: root.home-label-h;
                    pad: root.home-pad;
                    gap: root.home-gap * 0.8;
                    s: root.home-s;
                    notice: root.home-notice;
                    status: home-view.status;
                    unavailable-label: root.i18n-strings[205];
                    empty-headline: root.i18n-strings[725];
                    empty-body: root.i18n-strings[726];
                    empty-icon: 2;
                }
              }

                /* Edges of the column fade under the bars while there is
                 * more above or below. */
                Rectangle {
                    y: 0; width: parent.width; height: root.home-fade-h;
                    background: @linear-gradient(180deg, Theme.background 0%, Theme.background.transparentize(1.0) 100%);
                    opacity: root.home-v-scroll > 0px ? 1.0 : 0.0;
                    animate opacity { duration: 200ms; }
                }
                Rectangle {
                    y: parent.height - self.height; width: parent.width; height: 28px * root.home-s;
                    background: @linear-gradient(180deg, Theme.background.transparentize(1.0) 0%, Theme.background 100%);
                    opacity: root.home-v-scroll < root.home-max-scroll ? 1.0 : 0.0;
                    animate opacity { duration: 200ms; }
                }
            }

            /* Find a Game: search bar, filter chips, live results, surprise. */
            find-view := Rectangle {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.find-open && !root.library-open;
                property <float> s: root.home-s;
                property <length> pad: root.home-pad;
                /* One vertical rhythm: the same gap between search bar,
                 * chips, results and the Surprise buttons; every block on
                 * the Home side margins. */
                property <length> gap: 16px * self.s;
                property <length> top: 14px * self.s;
                property <length> bar-h: 50px * self.s;
                property <length> chip-h: 36px * self.s;
                property <length> pill-h: 46px * self.s;
                property <length> chips-y: self.top + self.bar-h + self.gap;
                property <length> results-y: self.chips-y + self.chip-h + self.gap - 6px * self.s;
                property <length> pills-y: self.height - self.top - self.pill-h;
                property <length> label-h: 34px * self.s;
                /* HomeRow: label, then 12 px of glow room above the covers. */
                property <length> card-h: max(80px, self.pills-y - self.gap - self.results-y - self.label-h - 12px);

                /* A wash of the accent behind the search. */
                Rectangle {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height * 0.45;
                    background: @linear-gradient(180deg, Theme.primary.transparentize(0.86) 0%, Theme.background.transparentize(1.0) 100%);
                }

                /* M3 search bar. */
                Rectangle {
                    x: find-view.pad; y: find-view.top;
                    width: parent.width - 2 * find-view.pad; height: find-view.bar-h;
                    HomeFocusRing { width: parent.width; height: parent.height; radius: parent.height / 2; shown: root.find-zone == 0; }
                    Rectangle {
                        width: parent.width; height: parent.height;
                        border-radius: self.height / 2;
                        background: root.find-zone == 0 ? Theme.secondary-container : Theme.surface-container-high;
                        Image {
                            x: 18px * find-view.s; y: (parent.height - self.height) / 2;
                            width: parent.height * 0.40; height: self.width;
                            source: @image-url("assets/icons/magnifying-glass.svg");
                            colorize: root.find-zone == 0 ? Theme.on-secondary-container : Theme.text-secondary;
                        }
                        Text {
                            x: 18px * find-view.s + parent.height * 0.40 + 14px * find-view.s;
                            width: parent.width - self.x - 18px * find-view.s; height: parent.height;
                            text: root.find-query != "" ? root.find-query : root.i18n-strings[831];
                            overflow: elide;
                            vertical-alignment: center;
                            color: root.find-query != "" ? Theme.text : Theme.text-faint;
                            font-size: 18px * find-view.s;
                            font-weight: root.find-query != "" ? 600 : 400;
                        }
                    }
                }

                /* Filter chips, scrolled to keep the focused one visible. */
                Rectangle {
                    x: 0; y: find-view.chips-y - 6px;
                    width: parent.width; height: find-view.chip-h + 12px;
                    clip: true;
                    chip-strip := HorizontalLayout {
                        x: find-view.pad - min(max(0, root.find-chip-index - 1) * 120px * find-view.s,
                            max(0px, self.preferred-width - (parent.width - 2 * find-view.pad)));
                        y: 6px; height: find-view.chip-h;
                        spacing: 8px * find-view.s;
                        animate x { duration: 220ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
                        for chip[i] in root.find-chips: chip-box := Rectangle {
                            property <bool> sel: root.find-zone == 1 && i == root.find-chip-index;
                            width: chip-text.preferred-width + (chip.active ? 40px : 28px) * find-view.s;
                            border-radius: Shape.small;
                            background: chip.active ? Theme.secondary-container : Theme.outline-variant;
                            HomeFocusRing { width: parent.width; height: parent.height; radius: Shape.small; shown: parent.sel; }
                            Rectangle {
                                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                                border-radius: Shape.small;
                                background: chip.active || parent.sel ? Theme.secondary-container : Theme.background;
                                if chip.active: Image {
                                    x: 12px * find-view.s; y: (parent.height - self.height) / 2;
                                    width: 14px * find-view.s; height: self.width;
                                    source: @image-url("assets/icons/check.svg");
                                    colorize: Theme.on-secondary-container;
                                }
                                chip-text := Text {
                                    x: (chip.active ? 30px : 14px) * find-view.s;
                                    height: parent.height;
                                    text: chip.label;
                                    vertical-alignment: center;
                                    color: chip.active || chip-box.sel ? Theme.on-secondary-container : Theme.text-secondary;
                                    font-size: 14px * find-view.s;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }

                /* Live results: the covers themselves. */
                HomeRow {
                    x: 0; y: find-view.results-y; width: parent.width;
                    label: root.i18n-strings[837];
                    cards: root.find-results;
                    index: root.find-result-index;
                    active: root.find-zone == 2;
                    card-h: find-view.card-h;
                    label-h: find-view.label-h;
                    pad: find-view.pad;
                    gap: root.home-gap;
                    s: find-view.s;
                    status: root.find-status;
                    unavailable-label: root.i18n-strings[205];
                    empty-headline: root.find-status;
                    empty-body: "";
                    empty-icon: 1;
                }

                /* Surprise me. */
                HorizontalLayout {
                    x: find-view.pad; y: find-view.pills-y;
                    width: parent.width - 2 * find-view.pad; height: find-view.pill-h;
                    spacing: 12px * find-view.s;
                    /* Both buttons the same width (user request 2026-10-10). */
                    for label[i] in [root.i18n-strings[829], root.i18n-strings[830]]: pill := Rectangle {
                        property <bool> sel: root.find-zone == 3 && i == root.find-surprise-index;
                        width: (find-view.width - 2 * find-view.pad - 12px * find-view.s) / 2;
                        HomeFocusRing { width: parent.width; height: parent.height; radius: parent.height / 2; shown: parent.sel; }
                        Rectangle {
                            width: parent.width; height: parent.height;
                            border-radius: self.height / 2;
                            background: parent.sel ? Theme.primary : Theme.surface-container-high;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 10px * find-view.s;
                                Image {
                                    width: find-view.pill-h * 0.38;
                                    source: @image-url("assets/icons/rotate.svg");
                                    colorize: pill.sel ? Theme.on-primary : Theme.primary;
                                    image-fit: contain;
                                }
                                Text {
                                    text: label;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: pill.sel ? Theme.on-primary : Theme.text;
                                    font-size: 15px * find-view.s;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }
            }

            /* Library grid: one system or collection. Cells share the
             * collection's box-art shape; a real cover keeps its own
             * proportions inside the cell. Focused title + metadata sit
             * under the grid. */
            library-grid := Rectangle {
                x: 0;
                y: root.home-top-pad;
                width: parent.width;
                height: root.home-rows-h;
                visible: root.library-open;

                property <length> step: root.library-cell-h + root.home-gap;
                property <int> focus-row: floor(root.library-index / root.library-columns);
                property <int> row-count: ceil(root.library-games.length / root.library-columns);
                property <length> content-h: self.row-count * self.step - root.home-gap + root.library-info-h;
                property <length> v-scroll: max(0px, min(self.focus-row * self.step,
                    self.content-h + 8px - root.library-view-h));
                property <length> grid-w: root.library-columns * (root.library-cell-w + root.home-gap) - root.home-gap;
                property <length> grid-x: (self.width - self.grid-w) / 2;
                /* The game the info panel shows: it follows the focus once
                 * the rows have moved (the panel hides at once and fades
                 * in), so it never slides across the covers; the same on
                 * a sideways move (user request 2026-10-10). */
                property <int> info-index: 0;
                Timer {
                    interval: 170ms;
                    running: library-grid.info-index != root.library-index;
                    triggered => { library-grid.info-index = root.library-index; }
                }

                /* Header: a light wash of the system colour and the platform
                 * silhouette, both clipped to the header (user request
                 * 2026-10-10: the earlier, stronger and taller ones
                 * distracted), the icon in its tinted well, name and count. */
                Rectangle {
                    x: 0; y: -root.home-top-pad; width: parent.width;
                    height: root.library-head-h + root.home-top-pad - 6px * root.home-s;
                    clip: true;
                    Rectangle {
                        width: parent.width; height: parent.height;
                        background: @linear-gradient(180deg,
                            (root.library-card.kind == 3 ? root.library-card.accent : Theme.primary).transparentize(0.84) 0%,
                            Theme.background.transparentize(1.0) 100%);
                    }
                    if root.library-card.kind == 3 && root.library-card.has-cover: Image {
                        property <length> d: parent.height * 1.7;
                        x: parent.width - self.d * 0.9 - root.home-pad; y: (parent.height - self.d) / 2;
                        width: self.d; height: self.d;
                        source: root.library-card.cover;
                        image-fit: contain;
                        colorize: root.library-card.accent.transparentize(0.86);
                    }
                }
                lib-well := Rectangle {
                    property <length> d: 30px * root.home-s;
                    property <length> icon: self.d * 0.62;
                    x: root.home-pad; y: (root.library-head-h - self.d) / 2 - 6px * root.home-s;
                    width: self.d; height: self.d;
                    border-radius: Shape.medium;
                    background: root.library-card.kind == 3 ? root.library-card.accent.transparentize(0.3)
                        : Theme.primary-container;
                    if root.library-card.kind == 5: Image {
                        x: (parent.width - parent.icon * 0.8) / 2; y: (parent.height - parent.icon * 0.8) / 2;
                        width: parent.icon * 0.8; height: parent.icon * 0.8;
                        source: @image-url("assets/icons/magnifying-glass.svg");
                        colorize: Theme.on-primary-container;
                    }
                    if root.library-card.kind == 2: HomeCollectionGlyph {
                        x: (parent.width - parent.icon * 0.86) / 2; y: (parent.height - parent.icon * 0.8) / 2;
                        width: parent.icon * 0.86; height: parent.icon * 0.80;
                        ink: Theme.on-primary-container;
                    }
                    if root.library-card.kind == 3 && root.library-card.has-cover: Image {
                        x: (parent.width - parent.icon) / 2; y: (parent.height - parent.icon) / 2;
                        width: parent.icon; height: parent.icon;
                        source: root.library-card.cover;
                        image-fit: contain;
                        colorize: #ffffff;
                    }
                }
                /* One line: name, then the game count (or scan status). */
                HorizontalLayout {
                    x: lib-well.x + lib-well.width + 12px * root.home-s;
                    y: lib-well.y;
                    width: parent.width - self.x - root.home-pad;
                    height: lib-well.height;
                    alignment: start;
                    spacing: 12px * root.home-s;
                    MarqueeText {
                        width: min(self.content-width, parent.width - lib-count.preferred-width - 12px * root.home-s);
                        label: root.library-title;
                        active: true;
                        text-color: Theme.text;
                        text-size: 20px * root.home-s;
                        text-weight: 700;
                    }
                    lib-count := Text {
                        text: home-view.status != "" ? home-view.status : root.library-detail;
                        color: Theme.text-secondary;
                        font-size: 14px * root.home-s;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    x: 0;
                    y: root.library-head-h - 12px;
                    width: parent.width;
                    height: root.library-view-h + 12px;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 12px - library-grid.v-scroll;
                        width: parent.width;
                        height: library-grid.content-h;
                        animate y { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

                        /* Only rows near the visible ones instantiate a card:
                         * a system can hold hundreds of games, and every card
                         * keeps its GPU layer (and cover texture) until it is
                         * destroyed, even while clipped out. */
                        for card[i] in root.library-games: cell := Rectangle {
                            property <int> grid-row: floor(i / root.library-columns);
                            x: library-grid.grid-x + mod(i, root.library-columns) * (root.library-cell-w + root.home-gap);
                            /* Rows under the focused one make room for the info. */
                            y: self.grid-row * library-grid.step
                                + (self.grid-row > library-grid.focus-row ? root.library-info-h : 0px);
                            animate y { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
                            width: root.library-cell-w;
                            height: root.library-cell-h;
                            background: #00000000;
                            if abs(cell.grid-row - library-grid.focus-row) <= root.library-visible-rows + 1: Rectangle {
                                property <bool> wide: card.aspect > root.library-aspect;
                                width: self.wide ? root.library-cell-w : root.library-cell-h * card.aspect;
                                height: self.wide ? root.library-cell-w / card.aspect : root.library-cell-h;
                                x: (root.library-cell-w - self.width) / 2;
                                y: (root.library-cell-h - self.height) / 2;
                                background: #00000000;
                                /* Ring outside the cached card layer. */
                                HomeFocusRing {
                                    width: parent.width; height: parent.height;
                                    radius: max(Shape.medium, parent.height * 0.06);
                                    shown: i == root.library-index;
                                }
                                HomeCardView {
                                    width: parent.width; height: parent.height;
                                    cache-rendering-hint: true;
                                    draw-ring: false;
                                    card: card;
                                    focused: card.focused;
                                    unavailable-label: root.i18n-strings[205];
                                }
                            }
                        }
                        /* Under the focused cover, kept inside the grid. */
                        if root.home-focus-valid: HomeInfoPanel {
                            /* Always on the screen's side margin, like the
                             * header (user request 2026-10-10), whatever the
                             * column, cover shape or grid centring. */
                            x: root.home-pad;
                            y: library-grid.focus-row * library-grid.step + root.library-cell-h + 10px * root.home-s;
                            visible: library-grid.info-index == root.library-index;
                            opacity: library-grid.info-index == root.library-index ? 1.0 : 0.0;
                            animate opacity { duration: 120ms; }
                            width: parent.width - 2 * root.home-pad;
                            height: root.library-info-h - 10px * root.home-s;
                            card: root.home-focused;
                            notice: root.home-notice;
                            unavailable-label: root.i18n-strings[205];
                            s: root.home-s;
                        }
                    }
                    Rectangle {
                        y: 0; width: parent.width; height: 22px * root.home-s;
                        background: @linear-gradient(180deg, Theme.background 0%, Theme.background.transparentize(1.0) 100%);
                        opacity: library-grid.v-scroll > 0px ? 1.0 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                }
            }

        }

        /* Home modal sheet (Add to Collection, Manage a collection): M3
         * dialog surface over a scrim; rows like the Settings dropdown,
         * a check box for multiple choices, armed rows in the error roles. */
        if root.home-sheet-open && !root.settings-open: Rectangle {
            x: 0; y: 50px; width: parent.width; height: parent.height - 102px;
            background: #000000a0;
            sheet := Rectangle {
                property <length> row-h: 46px;
                property <length> step: 52px;
                property <int> shown: min(root.home-sheet-items.length, root.home-sheet-visible-rows);
                width: min(parent.width - 48px, 460px);
                height: 58px + self.shown * self.step + 6px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.surface-container-high;
                border-radius: Shape.extra-large;
                clip: true;
                MarqueeText {
                    x: 22px; y: 14px; width: parent.width - 44px; height: 30px;
                    label: root.home-sheet-title;
                    text-color: Theme.text; text-size: 19px; text-weight: 700;
                    active: true;
                }
                for item[i] in root.home-sheet-items: sheet-row := Rectangle {
                    property <bool> sel: i == root.home-sheet-index;
                    x: 10px; y: 54px + (i - root.home-sheet-scroll) * sheet.step;
                    width: parent.width - 20px; height: sheet.row-h;
                    visible: i >= root.home-sheet-scroll && i < root.home-sheet-scroll + root.home-sheet-visible-rows;
                    border-radius: Shape.medium;
                    background: item.armed ? Theme.error-container : self.sel ? Theme.secondary-container : #00000000;
                    if item.check >= 0: Rectangle {
                        x: 14px; y: (parent.height - self.height) / 2;
                        width: 20px; height: 20px;
                        border-radius: 5px;
                        background: item.check == 1 ? Theme.primary : Theme.outline;
                        Rectangle {
                            x: 2px; y: 2px; width: 16px; height: 16px; border-radius: 3px;
                            background: item.check == 1 ? Theme.primary : Theme.surface-container-high;
                        }
                        if item.check == 1: Image {
                            x: 3px; y: 3px; width: 14px; height: 14px;
                            source: @image-url("assets/icons/check.svg");
                            colorize: Theme.on-primary;
                        }
                    }
                    VerticalLayout {
                        x: item.check >= 0 ? 46px : 16px;
                        width: parent.width - self.x - 16px;
                        alignment: center;
                        MarqueeText {
                            height: 22px;
                            label: item.label;
                            text-color: item.armed ? Theme.on-error-container : sheet-row.sel ? Theme.on-secondary-container : Theme.text;
                            text-size: 16px; text-weight: sheet-row.sel ? 600 : 500;
                            active: sheet-row.sel;
                        }
                        if item.detail != "": MarqueeText {
                            height: 16px;
                            label: item.detail;
                            text-color: item.armed ? Theme.on-error-container : Theme.text-dim;
                            text-size: 12px;
                            active: sheet-row.sel;
                        }
                    }
                }
            }
        }

        /* Settings shell: thematic categories only, no fake functionality. */
        Rectangle {
            x: 0;
            y: 50px;
            width: parent.width;
            height: parent.height - 102px;
            background: Theme.background;
            visible: root.settings-open;

            Text {
                x: 18px;
                y: 14px;
                text: root.oob-active ? root.i18n-strings[386]
                    : root.details-active ? (root.details-shell-title != "" ? root.details-shell-title : root.i18n-strings[522])
                    : root.i18n-strings[3];
                color: Theme.text;
                font-size: 28px;
                font-weight: 600;
                visible: !root.app-shell;
            }

            Rectangle {
                x: 18px;
                y: 54px;
                width: root.settings-rail-width;
                visible: !root.app-shell;
                height: parent.height - 70px;
                background: Theme.surface-container-low;
                border-radius: Shape.large;
                clip: true;
                /* Seven categories do not fit at 640x480: the rail scrolls
                 * just enough to keep the selected one visible. */
                property <int> rail-visible: max(1, floor((self.height - 16px + root.settings-row-step - root.settings-row-height) / root.settings-row-step));
                property <int> rail-scroll: max(0, min(7 - self.rail-visible, root.settings-selected-index - self.rail-visible + 1));

                for category[i] in [4, 5, 6, 702, 7, 813, 8]: SettingsCategory {
                    x: 8px;
                    y: 8px + (i - parent.rail-scroll) * root.settings-row-step;
                    width: parent.width - 16px;
                    height: root.settings-row-height;
                    label: root.i18n-strings[category];
                    selected: root.settings-selected-index == i;
                    visible: !root.oob-active && !root.moonlight-active && !root.steamlink-active && !root.details-active;
                }

                /* Game Details: the game itself (cover, title, system and the
                 * description when metadata has one); it never takes focus. */
                VerticalLayout {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    spacing: 6px;
                    alignment: start;
                    visible: root.details-active;

                    if root.details-has-cover: Image {
                        source: root.details-cover;
                        height: min(parent.height * 0.45, (parent.width) * 1.0);
                        image-fit: contain;
                        horizontal-alignment: left;
                    }
                    Text {
                        text: root.details-title;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    /* Long system names wrap in the narrow rail. */
                    Text {
                        text: root.details-subtitle;
                        color: Theme.primary;
                        font-size: 13px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    /* Game Settings and Start Game: title and platform only
                     * (user request 2026-10-10). */
                    Text {
                        text: root.settings-view == 51 || root.settings-view == 57 ? "" : root.details-description;
                        color: Theme.text-secondary;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                        overflow: elide;
                    }
                }

                /* OOB: the rail shows setup progress; it never takes focus. */
                for step[i] in [193, 46, 157, 275, 397]: SettingsCategory {
                    x: 8px;
                    y: 8px + i * root.settings-row-step;
                    width: parent.width - 16px;
                    height: root.settings-row-height;
                    label: root.i18n-strings[step];
                    selected: root.oob-step == i;
                    opacity: i > root.oob-step ? 0.55 : 1.0;
                    visible: root.oob-active;
                }
            }

            Rectangle {
                x: root.settings-pane-x;
                y: 0px;
                width: parent.width - root.settings-pane-x;
                height: parent.height;
                background: Theme.background;
                clip: true;

                /* Full screen application page: the app's colour washes down
                 * from the top and its name sits above the title, like AppPage. */
                if root.app-shell: Rectangle {
                    x: 0; y: 0; width: parent.width; height: root.settings-content-y + 24px;
                    background: @linear-gradient(180deg, Theme.primary.transparentize(0.68) 0%, Theme.background.transparentize(1.0) 100%);
                }
                if root.app-shell: Text {
                    x: root.settings-content-x; y: 6px;
                    width: root.settings-content-width; height: 16px;
                    vertical-alignment: center;
                    text: root.app-shell-kicker.to-uppercase();
                    color: Theme.primary;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    overflow: elide;
                }
                if root.app-shell && root.app-shell-meta != "": MarqueeText {
                    x: root.settings-content-x; y: 54px;
                    width: root.settings-content-width; height: 18px;
                    label: root.app-shell-meta;
                    text-color: Theme.text-secondary;
                    text-size: 13px;
                    text-weight: 400;
                    active: true;
                }

                /* settings-view == 0 means the category rail owns focus.
                 * The right pane is still the real page for the selected category;
                 * entering a category changes interaction/focus, never content. */
                MarqueeText {
                    x: root.settings-content-x;
                    y: root.app-shell ? 20px : 14px;
                    width: root.settings-content-width;
                    height: 36px;
                    label: root.settings-title-view == 0
                        ? (root.settings-selected-index == 0 ? root.i18n-strings[4]
                            : root.settings-selected-index == 1 ? root.i18n-strings[5]
                            : root.settings-selected-index == 2 ? root.i18n-strings[6]
                            : root.settings-selected-index == 3 ? root.i18n-strings[702]
                            : root.settings-selected-index == 4 ? root.i18n-strings[7]
                            : root.settings-selected-index == 5 ? root.i18n-strings[813]
                            : root.i18n-strings[8])
                        : root.settings-title-view == 1 ? root.i18n-strings[5]
                        : root.settings-title-view == 2 ? root.i18n-strings[9]
                        : root.settings-title-view == 3 ? root.i18n-strings[10]
                        : root.settings-title-view == 4 ? root.wifi-selected-ssid
                        : root.settings-title-view == 6 ? root.keyboard-title
                        : root.settings-title-view == 7 ? root.i18n-strings[11]
                        : root.settings-title-view == 8 ? root.i18n-strings[12]
                        : root.settings-title-view == 9 ? root.bluetooth-selected-name
                        : root.settings-title-view == 10 ? root.i18n-strings[6]
                        : root.settings-title-view == 11 ? root.i18n-strings[13]
                        : root.settings-title-view == 12 ? root.i18n-strings[14]
                        : root.settings-title-view == 13 ? root.controller-selected-name
                        : root.settings-title-view == 14 ? root.i18n-strings[15]
                        : root.settings-title-view == 15 ? root.i18n-strings[16]
                        : root.settings-title-view == 16 ? root.i18n-strings[17]
                        : root.settings-title-view == 17 ? root.i18n-strings[18]
                        : root.settings-title-view == 18 ? root.i18n-strings[7]
                        : root.settings-title-view == 19 ? root.i18n-strings[8]
                        : root.settings-title-view == 69 ? root.i18n-strings[813]
                        : root.settings-title-view == 20 ? root.i18n-strings[19]
                        : root.settings-title-view == 21 ? root.i18n-strings[20]
                        : root.settings-title-view == 22 ? root.i18n-strings[109]
                        : root.settings-title-view == 23 ? root.i18n-strings[4]
                        : root.settings-title-view == 24 ? root.i18n-strings[284]
                        : root.settings-title-view == 25 ? root.i18n-strings[287]
                        : root.settings-title-view == 26 ? root.profile-edit-name
                        : root.settings-title-view == 30 ? root.i18n-strings[46]
                        : root.settings-title-view == 31 ? root.i18n-strings[157]
                        : root.settings-title-view == 32 ? root.i18n-strings[275]
                        : root.settings-title-view == 40 ? root.i18n-strings[436]
                        : root.settings-title-view == 41 ? root.moonlight-host.name
                        : root.settings-title-view == 42 ? root.i18n-strings[437]
                        : root.settings-title-view == 45 ? root.i18n-strings[477]
                        : root.settings-title-view == 27 ? root.i18n-strings[498]
                        : root.settings-title-view == 28 ? (root.safe-mode ? root.i18n-strings[518] : root.i18n-strings[499])
                        : root.settings-title-view == 50 ? root.i18n-strings[523]
                        : root.settings-title-view == 51 ? root.i18n-strings[524]
                        : root.settings-title-view == 52 || root.settings-title-view == 53 ? root.i18n-strings[576]
                        : root.settings-title-view == 54 ? root.i18n-strings[584]
                        : root.settings-title-view == 55 ? root.i18n-strings[772]
                        : root.settings-title-view == 56 ? root.i18n-strings[774]
                        : root.settings-title-view == 57 ? root.i18n-strings[762]
                        : root.settings-title-view == 58 ? root.i18n-strings[609]
                        : root.settings-title-view == 60 ? root.i18n-strings[611]
                        : root.settings-title-view == 61 ? root.i18n-strings[625]
                        : root.settings-title-view == 62 ? root.i18n-strings[630]
                        : root.settings-title-view == 63 ? root.i18n-strings[651]
                        : root.settings-title-view == 65 ? root.i18n-strings[665]
                        : root.settings-title-view == 66 ? root.i18n-strings[669]
                        : root.settings-title-view == 67 ? root.i18n-strings[678]
                        : root.settings-title-view == 68 ? root.i18n-strings[702]
                        : root.settings-title-view == 70 ? root.i18n-strings[827]
                        : root.settings-title-view == 71 ? root.i18n-strings[537]
                        : root.i18n-strings[3];
                    text-color: Theme.text;
                    text-size: 26px;
                    text-weight: 700;
                }

                /* One sticky section header for every page. It names the section
                 * of the first visible row and its USER/DEVICE ownership, so
                 * scope is always explicit (EPIC-004 US-SET-003). */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.settings-section-y;
                    width: root.settings-content-width;
                    label: root.settings-section-label;
                    scope-label: root.settings-section-scope;
                    visible: root.settings-section-label != "" || root.settings-section-scope != "";
                }

                /* Inline headers for Connectivity's later sections while they
                 * are below the top. */
                for section[i] in [
                    { start: 3, label: root.i18n-strings[160] },
                    { start: 6, label: root.i18n-strings[727] },
                ]: SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(section.start, root.connectivity-scroll-offset, 3, 6, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: section.label;
                    scope-label: root.i18n-strings[313];
                    visible: root.page-connectivity
                        && root.connectivity-scroll-offset < section.start
                        && root.sec-row-visible(section.start, root.connectivity-scroll-offset, 3, 6, 0);
                }

                /* Inline headers for General's later sections. */
                for section[i] in [
                    { start: 3, label: root.i18n-strings[334] },
                    { start: 6, label: root.i18n-strings[335] },
                    { start: 11, label: root.i18n-strings[336] },
                ]: SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(section.start, root.general-scroll-offset, 3, 6, 11) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: section.label;
                    scope-label: root.i18n-strings[313];
                    visible: root.page-general
                        && root.general-scroll-offset < section.start
                        && root.sec-row-visible(section.start, root.general-scroll-offset, 3, 6, 11);
                }

                /* ---------------------------------------------------------- General */
                for row[k] in [
                    { title: root.i18n-strings[192], value: root.current-user-name, enabled: true, nav: true, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[193], value: root.ui-language-name, enabled: true, nav: false, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[194], value: root.theme-name, enabled: true, nav: false, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[287], value: root.user-count + "", enabled: true, nav: true, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[276], value: root.user-login-mode == "default" ? root.i18n-strings[278] : root.i18n-strings[277], enabled: root.user-count > 1, nav: false, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[324], value: root.default-user-name == "" ? root.i18n-strings[173] : root.default-user-name, enabled: root.user-count > 1 && root.user-login-mode == "default", nav: false, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[280], value: root.timezone, enabled: true, nav: false, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[281], value: "", enabled: true, nav: false, toggle: true, on: root.automatic-time, detail: "" },
                    { title: root.i18n-strings[326], value: root.manual-date-label, enabled: !root.automatic-time, nav: !root.automatic-time, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[327], value: root.manual-time-label, enabled: !root.automatic-time, nav: !root.automatic-time, toggle: false, on: false, detail: "" },
                    { title: root.i18n-strings[282], value: root.last-time-sync-label, enabled: root.automatic-time, nav: false, toggle: false, on: false, detail: root.regional-notice },
                    { title: root.i18n-strings[283], value: root.keyboard-layout-label, enabled: true, nav: false, toggle: false, on: false, detail: "" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.general-scroll-offset, 3, 6, 11);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    enabled: row.enabled;
                    navigates: row.nav;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    selected: root.settings-view == 23 && root.general-index == k;
                    visible: root.page-general
                        && root.sec-row-visible(k, root.general-scroll-offset, 3, 6, 11);
                }

                /* ------------------------------------------- Profile (own / other) */
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(0, root.profile-row-scroll, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[285];
                    value: root.profile-edit-name;
                    selected: (root.settings-view == 24 || root.settings-view == 26) && root.profile-index == 0;
                    visible: (root.settings-view == 24 || root.settings-view == 26)
                        && root.srow-visible(0, root.profile-row-scroll, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(1, root.profile-row-scroll, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[286];
                    detail: root.i18n-strings[294];
                    preview: root.profile-edit-avatar;
                    show-preview: true;
                    selected: (root.settings-view == 24 || root.settings-view == 26) && root.profile-index == 1;
                    visible: (root.settings-view == 24 || root.settings-view == 26)
                        && root.srow-visible(1, root.profile-row-scroll, root.settings-list-visible-rows);
                }
                /* Own profile only: per-user features. */
                for item[k] in [630]: SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(k + 2, root.profile-row-scroll, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[item];
                    navigates: true;
                    selected: root.settings-view == 24 && root.profile-index == k + 2;
                    visible: root.settings-view == 24 && root.srow-visible(k + 2, root.profile-row-scroll, root.settings-list-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x; y: root.srow-y(2, root.profile-row-scroll, 0); width: root.settings-content-width; height: root.settings-row-height;
                    armed: root.user-delete-confirm;
                    label: root.i18n-strings[289];
                    prompt: root.i18n-strings[290];
                    danger: true;
                    selected: root.settings-view == 26 && root.profile-index == 2;
                    enabled: root.profile-edit-user-id != root.active-user-id && root.user-count > 1;
                    visible: root.settings-view == 26;
                }
                SettingsHint {
                    x: root.settings-content-x; y: root.srow-y(3, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    text: root.i18n-strings[305];
                    visible: root.settings-view == 26;
                }

                /* ---------------------------------------------------- Manage Users */
                for user[i] in root.users : SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.user-list-scroll, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: user.name;
                    value: user.active ? root.i18n-strings[304] : user.default-user ? root.i18n-strings[303] : "";
                    preview: user.avatar;
                    show-preview: true;
                    selected: root.settings-view == 25 && root.user-list-index == i;
                    visible: root.settings-view == 25
                        && root.srow-visible(i, root.user-list-scroll, root.settings-list-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(root.user-count, root.user-list-scroll, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[288];
                    selected: root.settings-view == 25 && root.user-list-index == root.user-count;
                    visible: root.settings-view == 25
                        && root.srow-visible(root.user-count, root.user-list-scroll, root.settings-list-visible-rows);
                }

                /* --------------------------------------------- OOB Date & Time (30) */
                /* Same regional rows and Product Service as General → DATE & TIME. */
                for row[k] in [
                    { title: root.i18n-strings[280], value: root.timezone, toggle: false, on: false, enabled: true, detail: "" },
                    { title: root.i18n-strings[281], value: "", toggle: true, on: root.automatic-time, enabled: true, detail: root.i18n-strings[310] },
                    { title: root.i18n-strings[326], value: root.manual-date-label, toggle: false, on: false, enabled: !root.automatic-time, detail: "" },
                    { title: root.i18n-strings[327], value: root.manual-time-label, toggle: false, on: false, enabled: !root.automatic-time, detail: "" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    enabled: row.enabled;
                    navigates: k >= 2 && !root.automatic-time;
                    selected: root.settings-view == 30 && root.oob-index == k;
                    visible: root.settings-view == 30;
                }
                SettingsActionButton {
                    x: root.settings-content-x; y: root.srow-y(4, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    label: root.i18n-strings[391];
                    selected: root.settings-view == 30 && root.oob-index == 4;
                    visible: root.settings-view == 30;
                }

                /* ---------------------------------------------------- OOB Wi-Fi (31) */
                /* Wi-Fi switch and the real Connect page (view 2); Skip continues
                 * offline. */
                for row[k] in [
                    { title: root.i18n-strings[157], value: "", toggle: true, on: root.wifi-enabled, enabled: true, nav: false },
                    {
                        title: root.i18n-strings[158],
                        value: root.connectivity-wifi-active ? root.wifi-current-ssid : root.i18n-strings[159],
                        toggle: false, on: false, enabled: root.wifi-enabled, nav: root.wifi-enabled,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    enabled: row.enabled;
                    navigates: row.nav;
                    emphasized: k == 1 && root.connectivity-wifi-active;
                    selected: root.settings-view == 31 && root.oob-index == k;
                    visible: root.settings-view == 31;
                }
                SettingsActionButton {
                    x: root.settings-content-x; y: root.srow-y(2, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    label: root.connectivity-wifi-active ? root.i18n-strings[391] : root.i18n-strings[392];
                    selected: root.settings-view == 31 && root.oob-index == 2;
                    visible: root.settings-view == 31;
                }
                SettingsHint {
                    x: root.settings-content-x; y: root.srow-y(3, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    text: root.i18n-strings[393];
                    visible: root.settings-view == 31 && !root.connectivity-wifi-active;
                }

                /* ---------------------------------------------------- OOB Users (32) */
                /* Users are created/edited through the same usersd contract and
                 * user detail page (26) as Settings → Manage Users. */
                for user[i] in root.users : SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.oob-scroll, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: user.name;
                    value: root.user-count > 1 && user.default-user ? root.i18n-strings[303] : "";
                    preview: user.avatar;
                    show-preview: true;
                    selected: root.settings-view == 32 && root.oob-index == i;
                    visible: root.settings-view == 32
                        && root.srow-visible(i, root.oob-scroll, root.settings-list-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(root.user-count, root.oob-scroll, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[288];
                    selected: root.settings-view == 32 && root.oob-index == root.user-count;
                    visible: root.settings-view == 32
                        && root.srow-visible(root.user-count, root.oob-scroll, root.settings-list-visible-rows);
                }
                for row[k] in [
                    { title: root.i18n-strings[276], value: root.user-login-mode == "default" ? root.i18n-strings[278] : root.i18n-strings[277], enabled: true },
                    { title: root.i18n-strings[324], value: root.default-user-name == "" ? root.i18n-strings[173] : root.default-user-name, enabled: root.user-login-mode == "default" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(root.user-count + 1 + k, root.oob-scroll, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    selected: root.settings-view == 32 && root.oob-index == root.user-count + 1 + k;
                    visible: root.settings-view == 32 && root.user-count > 1
                        && root.srow-visible(root.user-count + 1 + k, root.oob-scroll, root.settings-list-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(root.oob-users-continue, root.oob-scroll, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[391];
                    enabled: root.user-count > 0;
                    selected: root.settings-view == 32 && root.oob-index == root.oob-users-continue;
                    visible: root.settings-view == 32
                        && root.srow-visible(root.oob-users-continue, root.oob-scroll, root.settings-list-visible-rows);
                }

                /* ----------------------------------- Moonlight Stream Settings (42) */
                /* Like Moonlight's own settings: VIDEO | AUDIO (from 4) | PC
                 * (from 6); moonlight.rs SETTINGS_ROWS. */
                for section[i] in [
                    { start: 4, label: root.i18n-strings[729] },
                    { start: 6, label: root.i18n-strings[858] },
                ]: SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(section.start, root.moonlight-scroll, 4, 6, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: section.label;
                    scope-label: root.i18n-strings[312];
                    visible: root.settings-view == 42 && root.moonlight-scroll < section.start
                        && root.sec-row-visible(section.start, root.moonlight-scroll, 4, 6, 0);
                }
                for row[k] in [
                    { title: root.i18n-strings[454], value: root.moonlight-resolution-label, detail: "", toggle: false, on: false, slider: false, fraction: 0 },
                    { title: root.i18n-strings[455], value: root.moonlight-fps-label, detail: "", toggle: false, on: false, slider: false, fraction: 0 },
                    { title: root.i18n-strings[457], value: root.moonlight-bitrate-label, detail: "", toggle: false, on: false,
                        slider: root.moonlight-bitrate-fraction > 0, fraction: root.moonlight-bitrate-fraction },
                    { title: root.i18n-strings[456], value: root.moonlight-codec-label, detail: "", toggle: false, on: false, slider: false, fraction: 0 },
                    { title: root.i18n-strings[859], value: root.moonlight-audio-label, detail: "", toggle: false, on: false, slider: false, fraction: 0 },
                    { title: root.i18n-strings[863], value: "", detail: "", toggle: true, on: root.moonlight-local-audio, slider: false, fraction: 0 },
                    { title: root.i18n-strings[864], value: "", detail: root.i18n-strings[865], toggle: true, on: root.moonlight-optimize, slider: false, fraction: 0 },
                    { title: root.i18n-strings[866], value: "", detail: "", toggle: true, on: root.moonlight-quit-app, slider: false, fraction: 0 },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.moonlight-scroll, 4, 6, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    show-slider: row.slider;
                    slider-fraction: row.fraction;
                    selected: root.settings-view == 42 && root.moonlight-index == k;
                    visible: root.settings-view == 42
                        && root.sec-row-visible(k, root.moonlight-scroll, 4, 6, 0);
                }

                /* ----------------------------------------------------------- Gaming */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.srow-y(root.gaming-split, root.gaming-scroll-offset, root.gaming-split) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[704];
                    scope-label: root.i18n-strings[313];
                    visible: root.page-gaming
                        && root.gaming-scroll-offset < root.gaming-split
                        && root.gaming-split < root.gaming-scroll-offset + root.settings-sectioned-visible-rows;
                }
                for row[k] in root.gaming-rows: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.gaming-scroll-offset, root.gaming-split);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    navigates: row.navigates;
                    toggle: row.toggle;
                    toggle-on: row.toggle-on;
                    enabled: row.enabled;
                    armed: row.armed;
                    selected: root.settings-view == 68 && root.gaming-index == k;
                    visible: root.page-gaming
                        && root.srow-visible(k, root.gaming-scroll-offset, root.settings-sectioned-visible-rows);
                }

                /* ------------------------------------------------------------ Power */
                for section[i] in [
                    { start: root.power-battery-start, label: root.i18n-strings[814] },
                    { start: root.power-devices-start, label: root.i18n-strings[815] },
                ]: SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(section.start, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: section.label;
                    scope-label: root.i18n-strings[313];
                    visible: root.page-power
                        && root.power-scroll-offset < section.start
                        && root.sec-row-visible(section.start, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }
                for row[k] in [
                    {
                        title: root.i18n-strings[50],
                        value: root.system-profile == "battery-saver" ? root.i18n-strings[51] : root.i18n-strings[52],
                        detail: root.system-effective-profile != root.system-profile
                            ? root.i18n-strings[214] + (root.system-effective-profile == "battery-saver" ? root.i18n-strings[51] : root.i18n-strings[52])
                            : "",
                        nav: false, slider: false, fraction: 0,
                    },
                    {
                        title: root.i18n-strings[53],
                        value: root.system-auto-battery-threshold <= 0 ? root.i18n-strings[54] : "≤ " + root.system-auto-battery-threshold + "%",
                        detail: "", nav: false, slider: false, fraction: 0,
                    },
                    {
                        title: root.i18n-strings[56],
                        value: root.system-sleep-after-min <= 0 ? root.i18n-strings[54] : root.system-sleep-after-min + root.i18n-strings[215],
                        detail: "", nav: false, slider: false, fraction: 0,
                    },
                    {
                        title: root.i18n-strings[816],
                        value: root.battery-percent < 0 ? root.i18n-strings[205] : root.battery-percent + "%",
                        detail: root.battery-state == "charging" ? root.i18n-strings[382]
                            : root.battery-state == "full" ? root.i18n-strings[383]
                            : root.battery-state == "discharging" ? root.i18n-strings[818]
                            : root.battery-state == "not-charging" ? root.i18n-strings[819] : "",
                        nav: false, slider: false, fraction: 0,
                    },
                    {
                        title: root.i18n-strings[817],
                        value: root.battery-health == "good" ? root.i18n-strings[820]
                            : root.battery-health == "overheat" || root.battery-health == "hot" || root.battery-health == "warm" ? root.i18n-strings[821]
                            : root.battery-health == "cold" || root.battery-health == "cool" ? root.i18n-strings[822]
                            : root.battery-health == "dead" ? root.i18n-strings[823]
                            : root.battery-health == "unknown" || root.battery-health == "" ? root.i18n-strings[205]
                            : root.i18n-strings[824],
                        detail: "", nav: false, slider: false, fraction: 0,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    navigates: row.nav;
                    show-slider: row.slider;
                    slider-fraction: row.fraction;
                    selected: root.settings-view == 69 && root.power-index == k;
                    visible: root.page-power
                        && root.sec-row-visible(k, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }
                for device[k] in root.power-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.power-devices-start + k, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind == "controller" ? root.i18n-strings[14]
                        : device.kind == "headphones" ? root.i18n-strings[330] : root.i18n-strings[161];
                    value: device.battery >= 0 ? device.battery + "%" : root.i18n-strings[205];
                    show-slider: device.battery >= 0;
                    slider-fraction: device.battery / 100;
                    selected: root.settings-view == 69 && root.power-index == root.power-devices-start + k;
                    visible: root.page-power
                        && root.sec-row-visible(root.power-devices-start + k, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.power-devices-start, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[825];
                    enabled: false;
                    selected: root.settings-view == 69 && root.power-index == root.power-devices-start;
                    visible: root.page-power && root.power-devices.length == 0
                        && root.sec-row-visible(root.power-devices-start, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }

                /* ----------------------------------------------------------- System */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.system-support-start, root.system-scroll-offset, root.system-support-start, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[733];
                    scope-label: root.i18n-strings[313];
                    visible: root.page-system
                        && root.system-scroll-offset < root.system-support-start
                        && root.sec-row-visible(root.system-support-start, root.system-scroll-offset, root.system-support-start, 0, 0);
                }
                for row[k] in [
                    { title: root.i18n-strings[19], value: root.system-storage-active + " • " + root.system-storage-health },
                    { title: root.i18n-strings[651], value: "" },
                    { title: root.i18n-strings[20], value: "" },
                    { title: root.i18n-strings[498], value: "" },
                    { title: root.i18n-strings[499], value: root.safe-mode ? root.i18n-strings[518] : "" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.system-scroll-offset, root.system-support-start, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    navigates: true;
                    selected: root.settings-view == 19 && root.system-index == k;
                    visible: root.page-system
                        && root.sec-row-visible(k, root.system-scroll-offset, root.system-support-start, 0, 0);
                }

                /* Storage page. Every row participates in controller navigation,
                 * including read-only status rows. Confirm is intentionally a no-op
                 * on informational rows. SYSTEM/STATE remain hidden. */
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(0, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[62];
                    value: root.system-storage-active + " • " + root.system-storage-mode;
                    selected: root.settings-view == 20 && root.system-storage-index == 0;
                    visible: root.settings-view == 20
                        && root.srow-visible(0, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(1, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[63];
                    value: root.system-storage-usage;
                    selected: root.settings-view == 20 && root.system-storage-index == 1;
                    visible: root.settings-view == 20
                        && root.srow-visible(1, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(2, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[64];
                    value: root.system-tf2-state == "ABSENT" ? root.i18n-strings[65]
                        : root.system-tf2-state == "OWNED" ? root.i18n-strings[66]
                        : root.system-tf2-state == "FOREIGN" ? root.i18n-strings[67]
                        : root.system-tf2-state;
                    detail: root.system-tf2-state == "FOREIGN" ? root.i18n-strings[68]
                        : root.system-storage-action-required != "NONE" ? root.system-storage-action-required
                        : "";
                    selected: root.settings-view == 20 && root.system-storage-index == 2;
                    visible: root.settings-view == 20
                        && root.srow-visible(2, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(3, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[69];
                    value: root.system-backup-policy == "OFF" ? root.i18n-strings[54]
                        : root.system-backup-policy == "DAILY" ? root.i18n-strings[70]
                        : root.system-backup-policy == "WEEKLY" ? root.i18n-strings[71]
                        : root.system-backup-policy == "MONTHLY" ? root.i18n-strings[72]
                        : root.system-backup-policy;
                    detail: root.system-storage-job-state == "succeeded" && root.system-storage-job-action == "backup" ? root.i18n-strings[73]
                        : root.system-backup-due == "1" ? root.i18n-strings[74]
                        : root.system-backup-reason == "CLOCK_UNAVAILABLE" ? root.i18n-strings[75]
                        : root.system-backup-reason == "CLOCK_BEFORE_LAST_SUCCESS" ? root.i18n-strings[76]
                        : "";
                    enabled: root.system-storage-job-state != "running";
                    selected: root.settings-view == 20 && root.system-storage-index == 3;
                    visible: root.settings-view == 20
                        && root.srow-visible(3, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(4, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2" ? root.i18n-strings[77]
                        : root.system-tf2-state == "OWNED" ? root.i18n-strings[78]
                        : root.i18n-strings[79];
                    value: root.system-storage-job-state == "running" ? root.i18n-strings[80]
                        : root.system-tf2-state == "ABSENT" ? root.i18n-strings[81]
                        : root.system-tf2-state == "FOREIGN" && root.system-storage-confirm ? root.i18n-strings[82]
                        : root.system-tf2-state == "FOREIGN" ? root.i18n-strings[83]
                        : root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2" && root.system-storage-confirm ? root.i18n-strings[82]
                        : root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2" ? root.i18n-strings[84]
                        : root.system-tf2-state == "OWNED" ? root.i18n-strings[85]
                        : root.i18n-strings[205];
                    detail: root.system-tf2-state == "FOREIGN" && root.system-storage-confirm ? root.i18n-strings[86]
                        : root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2" && root.system-storage-confirm ? root.i18n-strings[87]
                        : "";
                    armed: root.system-storage-confirm
                        && (root.system-tf2-state == "FOREIGN"
                            || (root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2"));
                    enabled: root.system-storage-job-state != "running"
                        && (root.system-tf2-state == "FOREIGN" || root.system-tf2-state == "OWNED");
                    selected: root.settings-view == 20 && root.system-storage-index == 4;
                    visible: root.settings-view == 20
                        && root.srow-visible(4, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(5, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[88];
                    value: root.system-storage-job-state == "running" ? root.i18n-strings[80]
                        : root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2" ? root.i18n-strings[217]
                        : root.i18n-strings[89];
                    detail: root.system-backup-due == "1" && root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2" ? root.i18n-strings[74] : "";
                    enabled: root.system-storage-job-state != "running"
                        && root.system-tf2-state == "OWNED" && root.system-storage-active == "TF2";
                    selected: root.settings-view == 20 && root.system-storage-index == 5;
                    visible: root.settings-view == 20
                        && root.srow-visible(5, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(6, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[90];
                    value: root.system-storage-job-state == "running" ? root.i18n-strings[91]
                        : root.system-storage-job-state == "succeeded" ? root.i18n-strings[92]
                        : root.system-storage-job-state == "failed" ? root.i18n-strings[218] + root.system-storage-job-exit + ")"
                        : root.i18n-strings[94];
                    detail: root.system-storage-job-action == "none" ? ""
                        : root.system-storage-job-action == "adopt" ? root.i18n-strings[95]
                        : root.system-storage-job-action == "move-back" ? root.i18n-strings[96]
                        : root.system-storage-job-action == "backup" ? root.i18n-strings[97]
                        : root.system-storage-job-action;
                    selected: root.settings-view == 20 && root.system-storage-index == 6;
                    visible: root.settings-view == 20
                        && root.srow-visible(6, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(7, root.system-storage-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[625];
                    navigates: true;
                    selected: root.settings-view == 20 && root.system-storage-index == 7;
                    visible: root.settings-view == 20
                        && root.srow-visible(7, root.system-storage-scroll-offset, root.settings-list-visible-rows);
                }

                /* Live System Information. All rows are selectable for consistent
                 * controller navigation, but Confirm intentionally performs no action. */
                for row[k] in [
                    { title: "nuubOS", value: root.system-version + " • " + root.system-build },
                    { title: root.i18n-strings[98], value: root.system-device-model },
                    { title: root.i18n-strings[99], value: root.system-kernel },
                    { title: root.i18n-strings[100], value: root.battery-percent >= 0 ? root.battery-percent + "% • " + root.battery-state : root.i18n-strings[205] },
                    { title: root.i18n-strings[101], value: root.system-cpu-clock + " • " + root.system-cpu-temperature },
                    { title: root.i18n-strings[102], value: root.system-gpu-clock + " • " + root.system-gpu-temperature },
                    { title: root.i18n-strings[103], value: root.system-network },
                    { title: root.i18n-strings[19], value: root.system-storage-active + " • " + root.system-storage-usage },
                    { title: root.i18n-strings[104], value: root.system-memory },
                    { title: root.i18n-strings[105], value: root.system-uptime },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.system-info-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    title-fraction: 0.30;
                    selected: root.settings-view == 21 && root.system-info-index == k;
                    visible: root.settings-view == 21
                        && root.srow-visible(k, root.system-info-scroll-offset, root.settings-list-visible-rows);
                }

                /* Diagnostics: one action and the read-only output location. */
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[500];
                    value: root.diag-busy ? root.i18n-strings[501] : "";
                    detail: root.i18n-strings[504];
                    selected: root.settings-view == 27 && root.diag-index == 0;
                    visible: root.settings-view == 27;
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[521];
                    value: "USERDATA/diagnostics";
                    selected: root.settings-view == 27 && root.diag-index == 1;
                    visible: root.settings-view == 27;
                }

                /* Recovery. Destructive rows need a confirming press; the
                 * erase row needs two. Exit Safe Mode exists only in safe mode. */
                for row[k] in [
                    { title: root.i18n-strings[505], detail: root.i18n-strings[512] },
                    { title: root.i18n-strings[508], detail: root.i18n-strings[513] },
                    { title: root.i18n-strings[510], detail: root.i18n-strings[514] },
                    { title: root.i18n-strings[511], detail: root.i18n-strings[515] },
                    { title: root.i18n-strings[520], detail: "" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.recovery-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    detail: root.recovery-armed != k ? row.detail
                        : k == 3 && root.recovery-stage == 1 ? root.i18n-strings[517]
                        : root.i18n-strings[516];
                    armed: root.recovery-armed == k;
                    selected: root.settings-view == 28 && root.recovery-index == k;
                    visible: root.settings-view == 28 && (k < 4 || root.safe-mode)
                        && root.srow-visible(k, root.recovery-scroll-offset, root.settings-list-visible-rows);
                }

                /* Data-driven pages 50-67: inline header of the second
                 * section while it is below the top. */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(root.gen-split, root.gen-scroll, root.gen-split, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.gen-split-label;
                    scope-label: root.settings-section-scope;
                    visible: root.gen-view
                        && root.gen-split > 0 && root.gen-scroll < root.gen-split
                        && root.sec-row-visible(root.gen-split, root.gen-scroll, root.gen-split, 0, 0);
                }
                for row[k] in root.gen-rows: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.gen-scroll, root.gen-split, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    navigates: row.navigates;
                    toggle: row.toggle;
                    toggle-on: row.toggle-on;
                    enabled: row.enabled;
                    armed: row.armed;
                    selected: root.gen-index == k;
                    visible: root.gen-view
                        && (root.gen-split > 0 ? root.sec-row-visible(k, root.gen-scroll, root.gen-split, 0, 0)
                            : root.srow-visible(k, root.gen-scroll, root.settings-list-visible-rows));
                }

                /* ---------------------------------------------- Controllers & Input */
                /* CONTROLLERS (Player Assignment, Controllers), then RUMBLE &
                 * LIGHTING (Internal Rumble, RGB Lighting). */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(2, 0, 2, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[735];
                    scope-label: root.i18n-strings[312];
                    visible: root.page-controllers && root.sec-row-visible(2, 0, 2, 0, 0);
                }
                for row[k] in [
                    { title: root.i18n-strings[13], value: root.i18n-strings[111], enabled: true },
                    { title: root.i18n-strings[14], value: root.controllers.length + root.i18n-strings[219], enabled: true },
                    {
                        title: root.i18n-strings[17],
                        value: root.rumble-supported ? (root.rumble-enabled ? root.i18n-strings[112] : root.i18n-strings[113]) : root.i18n-strings[205],
                        enabled: root.rumble-supported,
                    },
                    {
                        title: root.i18n-strings[18],
                        value: root.lighting-supported ? root.lighting-effect-label : root.i18n-strings[205],
                        enabled: root.lighting-supported,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, 0, 2, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    navigates: row.enabled;
                    selected: root.settings-view == 10 && root.controllers-menu-index == k;
                    visible: root.page-controllers && root.sec-row-visible(k, 0, 2, 0, 0);
                }

                /* Preferred player assignment. */
                for assignment[i] in root.player-assignments: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.player-assignment-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[220] + assignment.player;
                    value: assignment.controller-name == "" ? root.i18n-strings[122] : assignment.controller-name
                        + (assignment.available ? "" : root.i18n-strings[221]);
                    selected: root.settings-view == 11 && root.player-assignment-index == i;
                    visible: root.settings-view == 11
                        && root.srow-visible(i, root.player-assignment-scroll-offset, root.settings-list-visible-rows);
                }

                /* Available controller inventory. */
                for controller[i] in root.controllers: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.controller-list-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: controller.name;
                    value: controller.effective-player > 0 ? "P" + controller.effective-player : controller.transport;
                    navigates: true;
                    emphasized: controller.connected;
                    selected: root.settings-view == 12 && root.controller-list-index == i;
                    visible: root.settings-view == 12
                        && root.srow-visible(i, root.controller-list-scroll-offset, root.settings-list-visible-rows);
                }

                for row[k] in [root.i18n-strings[16], root.i18n-strings[15]]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row;
                    navigates: true;
                    selected: root.settings-view == 13 && root.controller-detail-index == k;
                    visible: root.settings-view == 13;
                }

                /* Per-controller Input Tester: the controller drawing fills
                 * the page above the last-input chip and the exit combo. */
                tester-visual := ControllerTesterVisual {
                    x: root.settings-content-x;
                    y: root.settings-content-y;
                    width: root.settings-content-width;
                    height: min(root.settings-content-width * 200 / 360,
                        max(120px, root.settings-list-bottom - root.settings-content-y
                            - root.settings-row-height - 2 * root.settings-row-gap - 28px));
                    visible: root.settings-view == 14;
                    face-south: root.tester-face-south;
                    face-east: root.tester-face-east;
                    face-north: root.tester-face-north;
                    face-west: root.tester-face-west;
                    dpad-up: root.tester-dpad-up;
                    dpad-down: root.tester-dpad-down;
                    dpad-left: root.tester-dpad-left;
                    dpad-right: root.tester-dpad-right;
                    l1: root.tester-l1; r1: root.tester-r1;
                    l2: root.tester-l2; r2: root.tester-r2;
                    l3: root.tester-l3; r3: root.tester-r3;
                    start: root.tester-start;
                    select: root.tester-select;
                    hotkey: root.tester-hotkey;
                    left-x: root.tester-left-x; left-y: root.tester-left-y;
                    right-x: root.tester-right-x; right-y: root.tester-right-y;
                    left-trigger: root.tester-left-trigger;
                    right-trigger: root.tester-right-trigger;
                }
                /* Last input: logical control • physical source. */
                Rectangle {
                    x: root.settings-content-x;
                    y: tester-visual.y + tester-visual.drawn-height + root.settings-row-gap;
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    border-radius: Shape.medium;
                    background: Theme.surface-container-high;
                    visible: root.settings-view == 14;
                    MarqueeText {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        label: root.tester-action;
                        text-color: Theme.text;
                        text-size: 18px;
                        text-weight: 700;
                        align-center: true;
                    }
                }
                /* Exit combo: the tester owns every control of this
                 * controller, so Back cannot leave the page. */
                HorizontalLayout {
                    x: root.settings-content-x;
                    y: tester-visual.y + tester-visual.drawn-height + root.settings-row-height + 2 * root.settings-row-gap;
                    width: root.settings-content-width;
                    height: 28px;
                    alignment: center;
                    spacing: 8px;
                    visible: root.settings-view == 14;
                    VerticalLayout { alignment: center; MenuActionHint { } }
                    Text { text: "+"; color: Theme.text-secondary; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                    VerticalLayout { alignment: center; StartActionHint { } }
                    Text {
                        text: root.i18n-strings[740];
                        color: Theme.text-secondary;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 0;
                    }
                }

                /* Controller Mapping: buttons, stick axes with their deadzones and
                 * Restore Default Mapping are rows of one service-ordered list. */
                for mapping[i] in root.controller-mapping: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.controller-mapping-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: mapping.label;
                    /* The capture prompt itself is the page notice line. */
                    value: root.controller-remap-waiting && root.controller-mapping-index == i ? "…"
                        : mapping.kind == 2 ? (mapping.control == "left_deadzone" ? root.controller-left-deadzone : root.controller-right-deadzone) + "%"
                        : mapping.value;
                    detail: mapping.kind == 3 && root.controller-mapping-reset-armed ? root.i18n-strings[366] : "";
                    armed: mapping.kind == 3 && root.controller-mapping-reset-armed;
                    selected: root.settings-view == 15 && root.controller-mapping-index == i;
                    visible: root.settings-view == 15
                        && root.srow-visible(i, root.controller-mapping-scroll-offset, root.settings-list-visible-rows);
                }

                /* Internal rumble. */
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(0, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[112];
                    toggle: true;
                    toggle-on: root.rumble-enabled;
                    selected: root.settings-view == 16 && root.rumble-index == 0;
                    visible: root.settings-view == 16;
                }
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(1, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[125];
                    selected: root.settings-view == 16 && root.rumble-index == 1;
                    visible: root.settings-view == 16;
                }

                /* RGB Lighting: LIGHTING (0-3) | SYSTEM SIGNALS (4-8). */
                SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(4, root.lighting-scroll-offset, 4, 0, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: root.i18n-strings[129];
                    scope-label: root.i18n-strings[312];
                    visible: root.settings-view == 17 && root.lighting-scroll-offset < 4
                        && root.sec-row-visible(4, root.lighting-scroll-offset, 4, 0, 0);
                }
                for row[k] in [
                    {
                        title: root.i18n-strings[126], detail: root.i18n-strings[root.lighting-effect-detail-index(root.lighting-effect)],
                        value: root.lighting-effect-label, enabled: true, toggle: false, on: false, swatch: false,
                    },
                    {
                        title: root.i18n-strings[128], detail: "",
                        value: root.lighting-color-capable ? root.i18n-strings[root.lighting-color-index(root.lighting-color)] : root.i18n-strings[122],
                        enabled: root.lighting-color-capable, toggle: false, on: false, swatch: root.lighting-color-capable,
                    },
                    {
                        title: root.i18n-strings[127], detail: "", value: root.lighting-brightness + "%",
                        enabled: true, toggle: false, on: false, swatch: false,
                    },
                    {
                        title: root.i18n-strings[121], detail: "",
                        value: !root.lighting-speed-capable ? root.i18n-strings[205]
                            : root.lighting-speed == "slow" ? root.i18n-strings[144]
                            : root.lighting-speed == "fast" ? root.i18n-strings[146] : root.i18n-strings[145],
                        enabled: root.lighting-speed-capable, toggle: false, on: false, swatch: false,
                    },
                    { title: root.i18n-strings[147], detail: root.i18n-strings[151], value: "", enabled: true, toggle: true, on: mod(root.lighting-signals, 2) == 1, swatch: false },
                    { title: root.i18n-strings[100], detail: root.i18n-strings[152], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 2), 2) == 1, swatch: false },
                    { title: root.i18n-strings[148], detail: root.i18n-strings[153], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 4), 2) == 1, swatch: false },
                    { title: root.i18n-strings[149], detail: root.i18n-strings[154], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 8), 2) == 1, swatch: false },
                    { title: root.i18n-strings[150], detail: root.i18n-strings[155], value: "", enabled: true, toggle: true, on: mod(floor(root.lighting-signals / 16), 2) == 1, swatch: false },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.lighting-scroll-offset, 4, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    detail: row.detail;
                    value: row.value;
                    enabled: row.enabled;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    show-swatch: row.swatch;
                    swatch: root.lighting-color == "theme" ? Theme.accent : root.lighting-swatch;
                    selected: root.settings-view == 17 && root.lighting-index == k;
                    visible: root.settings-view == 17
                        && root.sec-row-visible(k, root.lighting-scroll-offset, 4, 0, 0);
                }

                /* --------------------------------------------------- Display & Audio */
                for section[i] in [
                    { start: root.da-audio-start, label: root.i18n-strings[729] },
                    { start: root.da-sounds-start, label: root.i18n-strings[730] },
                ]: SettingsSectionHeader {
                    x: root.settings-content-x;
                    y: root.sec-row-y(section.start, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, 0) - root.settings-section-gap;
                    width: root.settings-content-width;
                    label: section.label;
                    scope-label: root.i18n-strings[313];
                    visible: root.page-display-audio
                        && root.display-audio-scroll-offset < section.start
                        && root.sec-row-visible(section.start, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, 0);
                }
                for row[k] in [
                    {
                        pos: 0,
                        title: root.i18n-strings[127],
                        value: root.display-brightness-available ? root.display-brightness + "%" : root.i18n-strings[132],
                        enabled: root.display-brightness-available, toggle: false, on: false, shown: true,
                        slider: root.display-brightness-available, fraction: root.display-brightness / 100,
                    },
                    {
                        pos: 1,
                        title: root.i18n-strings[143],
                        value: root.display-color-temperature + root.i18n-strings[224],
                        enabled: true, toggle: false, on: false,
                        shown: root.display-color-temperature-available, slider: false, fraction: 0,
                    },
                    { pos: root.da-audio-start, title: root.i18n-strings[133], value: root.audio-output-label, enabled: true, toggle: false, on: false, shown: true, slider: false, fraction: 0 },
                    {
                        pos: root.da-audio-start + 1,
                        title: root.i18n-strings[134],
                        value: !root.audio-volume-supported ? (root.audio-selected == "hdmi" ? root.i18n-strings[223] : root.i18n-strings[205])
                            : root.audio-volume == 0 ? root.i18n-strings[812] : root.audio-volume + "%",
                        enabled: root.audio-volume-supported, toggle: false, on: false, shown: true,
                        slider: root.audio-volume-supported, fraction: root.audio-volume / 100,
                    },
                    { pos: root.da-audio-start + 2, title: root.i18n-strings[135], value: root.applications-volume == 0 ? root.i18n-strings[812] : root.applications-volume + "%", enabled: true, toggle: false, on: false, shown: true, slider: true, fraction: root.applications-volume / 100 },
                    { pos: root.da-audio-start + 3, title: root.i18n-strings[139], value: root.home-music-volume == 0 ? root.i18n-strings[812] : root.home-music-volume + "%", enabled: true, toggle: false, on: false, shown: true, slider: true, fraction: root.home-music-volume / 100 },
                    { pos: root.da-audio-start + 4, title: root.i18n-strings[140], value: root.audio-test-tone-playing ? root.i18n-strings[141] : root.i18n-strings[142], enabled: true, toggle: false, on: false, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-sounds-start, title: root.i18n-strings[136], value: root.system-sounds-volume + "%", enabled: true, toggle: false, on: false, shown: true, slider: true, fraction: root.system-sounds-volume / 100 },
                    { pos: root.da-sounds-start + 1, title: root.i18n-strings[137], value: "", enabled: true, toggle: true, on: root.navigation-sounds-enabled, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-sounds-start + 2, title: root.i18n-strings[851], value: "", enabled: true, toggle: true, on: root.notify-sounds-enabled, shown: true, slider: false, fraction: 0 },
                    { pos: root.da-sounds-start + 3, title: root.i18n-strings[138], value: "", enabled: true, toggle: true, on: root.power-sounds-enabled, shown: true, slider: false, fraction: 0 },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(row.pos, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    show-slider: row.slider;
                    slider-fraction: row.fraction;
                    selected: root.settings-view == 18 && root.display-audio-index == row.pos;
                    visible: row.shown && root.page-display-audio
                        && root.sec-row-visible(row.pos, root.display-audio-scroll-offset, root.da-audio-start, root.da-sounds-start, 0);
                }

                /* ------------------------------------------------------ Connectivity */
                for row[k] in [
                    { title: root.i18n-strings[157], value: "", toggle: true, on: root.wifi-enabled, enabled: true, nav: false },
                    {
                        title: root.i18n-strings[158],
                        value: root.connectivity-wifi-active ? root.wifi-current-ssid : root.i18n-strings[159],
                        toggle: false, on: false, enabled: root.wifi-enabled, nav: root.wifi-enabled,
                    },
                    {
                        title: root.i18n-strings[10],
                        value: root.wifi-saved-networks.length + root.i18n-strings[225],
                        toggle: false, on: false, enabled: true, nav: true,
                    },
                    { title: root.i18n-strings[161], value: "", toggle: true, on: root.bluetooth-enabled, enabled: true, nav: false },
                    { title: root.i18n-strings[11], value: "", toggle: false, on: false, enabled: root.bluetooth-enabled, nav: root.bluetooth-enabled },
                    {
                        title: root.i18n-strings[12],
                        value: root.bluetooth-known-devices.length + root.i18n-strings[226],
                        toggle: false, on: false, enabled: root.bluetooth-enabled, nav: root.bluetooth-enabled,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(k, root.connectivity-scroll-offset, 3, 6, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    enabled: row.enabled;
                    navigates: row.nav;
                    selected: root.settings-view == 1 && root.connectivity-selected-index == k;
                    visible: root.page-connectivity
                        && root.sec-row-visible(k, root.connectivity-scroll-offset, 3, 6, 0);
                }

                /* SERVICES: the optional network services themselves (rows
                 * from 6, built by gameui.rs from nuubos-remotectl and
                 * nuubos-syncctl). */
                for row[i] in root.connectivity-services: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(6 + i, root.connectivity-scroll-offset, 3, 6, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    toggle: row.toggle;
                    toggle-on: row.toggle-on;
                    enabled: row.enabled;
                    navigates: row.navigates;
                    armed: row.armed;
                    selected: root.settings-view == 1 && root.connectivity-selected-index == 6 + i;
                    visible: root.page-connectivity
                        && root.sec-row-visible(6 + i, root.connectivity-scroll-offset, 3, 6, 0);
                }

                /* Connect page. Entering this view starts a product-service scan
                 * session; results stay live until this page is left. */
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(0, root.wifi-network-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[162];
                    navigates: true;
                    selected: root.settings-view == 2 && root.wifi-network-index == 0;
                    visible: root.settings-view == 2
                        && root.srow-visible(0, root.wifi-network-scroll-offset, root.settings-list-visible-rows);
                }
                for network[i] in root.wifi-networks: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i + 1, root.wifi-network-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: network.ssid;
                    detail: network.current ? root.i18n-strings[198]
                        : network.saved ? network.security + root.i18n-strings[228]
                        : network.security;
                    value: root.signal-label(network.signal-dbm);
                    emphasized: network.current;
                    title-fraction: 0.62;
                    selected: root.settings-view == 2 && root.wifi-network-index == i + 1;
                    visible: root.settings-view == 2
                        && root.srow-visible(i + 1, root.wifi-network-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.wifi-scanning ? root.i18n-strings[163] : root.i18n-strings[164];
                    visible: root.settings-view == 2 && root.wifi-networks.length == 0;
                }

                /* Saved networks are a flat list. Selecting one opens the same
                 * editor used by the current network. */
                for network[i] in root.wifi-saved-networks: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.wifi-saved-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: network.ssid;
                    detail: network.current ? root.i18n-strings[198] : network.security + root.i18n-strings[228];
                    value: root.signal-label(network.signal-dbm);
                    emphasized: network.current;
                    navigates: true;
                    title-fraction: 0.62;
                    selected: root.settings-view == 3 && root.wifi-saved-index == i;
                    visible: root.settings-view == 3
                        && root.srow-visible(i, root.wifi-saved-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.i18n-strings[165];
                    visible: root.settings-view == 3 && root.wifi-saved-networks.length == 0;
                }

                /* Network editor. Password and IP parameters live on one scrollable
                 * list to avoid a stack of nested settings pages. */
                for row[k] in [
                    {
                        title: root.wifi-selected-current ? root.i18n-strings[169] : root.i18n-strings[158],
                        value: root.wifi-selected-current ? root.i18n-strings[198] : "",
                        enabled: true,
                    },
                    {
                        title: root.wifi-wps-active ? root.i18n-strings[706] : root.i18n-strings[705],
                        value: "",
                        enabled: root.wifi-wps-active || root.wifi-wps-available,
                    },
                    {
                        title: root.i18n-strings[172],
                        value: root.wifi-selected-security == root.i18n-strings[212] ? root.i18n-strings[173] : root.i18n-strings[174],
                        enabled: root.wifi-selected-security != root.i18n-strings[212],
                    },
                    { title: root.i18n-strings[175], value: root.wifi-ip-mode == "automatic" ? root.i18n-strings[122] : root.i18n-strings[176], enabled: true },
                    { title: root.i18n-strings[177], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-address : root.wifi-ip-address, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[178], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-netmask : root.wifi-ip-netmask, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[179], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-gateway : root.wifi-ip-gateway, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[180], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-dns : root.wifi-ip-dns, enabled: root.wifi-ip-mode == "manual" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    selected: root.settings-view == 4 && root.wifi-detail-index == k;
                    visible: root.settings-view == 4
                        && root.srow-visible(k, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(8, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[181];
                    selected: root.settings-view == 4 && root.wifi-detail-index == 8;
                    visible: root.settings-view == 4
                        && root.srow-visible(8, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(9, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[182];
                    danger: true;
                    enabled: root.wifi-selected-saved;
                    selected: root.settings-view == 4 && root.wifi-detail-index == 9;
                    visible: root.settings-view == 4
                        && root.srow-visible(9, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }

                /* Bluetooth discovery is active only while this page is open. */
                for device[i] in root.bluetooth-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.bluetooth-device-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind;
                    value: root.bluetooth-state-label(device.connected, device.paired, device.rssi);
                    emphasized: device.connected;
                    title-fraction: 0.62;
                    selected: root.settings-view == 7 && root.bluetooth-device-index == i;
                    visible: root.settings-view == 7
                        && root.srow-visible(i, root.bluetooth-device-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.bluetooth-scanning ? root.i18n-strings[163] : root.i18n-strings[166];
                    visible: root.settings-view == 7 && root.bluetooth-devices.length == 0;
                }

                /* Paired/connected Bluetooth devices. */
                for device[i] in root.bluetooth-known-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.bluetooth-known-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind;
                    value: root.bluetooth-state-label(device.connected, device.paired, device.rssi);
                    emphasized: device.connected;
                    navigates: true;
                    title-fraction: 0.62;
                    selected: root.settings-view == 8 && root.bluetooth-known-index == i;
                    visible: root.settings-view == 8
                        && root.srow-visible(i, root.bluetooth-known-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.i18n-strings[167];
                    visible: root.settings-view == 8 && root.bluetooth-known-devices.length == 0;
                }

                /* One device, one management surface. */
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: !root.bluetooth-selected-paired ? root.i18n-strings[168]
                        : root.bluetooth-selected-connected ? root.i18n-strings[169]
                        : root.i18n-strings[158];
                    selected: root.bluetooth-detail-index == 0;
                    visible: root.settings-view == 9;
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.bluetooth-selected-paired ? root.i18n-strings[170] : root.i18n-strings[171];
                    selected: root.bluetooth-detail-index == 1;
                    danger: root.bluetooth-selected-paired;
                    visible: root.settings-view == 9;
                }

                /* Generic dropdown used by every discrete multi-value Settings
                 * choice. */
                SettingsChoiceSheet {
                    x: root.settings-content-x - 6px;
                    y: root.settings-section-y - 4px;
                    width: root.settings-content-width + 12px;
                    height: min(
                        parent.height - self.y - 12px,
                        root.settings-choice-list-y + min(root.settings-choice-options.length, root.settings-choice-visible-rows) * root.settings-row-step + 4px
                    );
                    title: root.settings-choice-title;
                    options: root.settings-choice-options;
                    index: root.settings-choice-index;
                    scroll: root.settings-choice-scroll;
                    visible-rows: root.settings-choice-visible-rows;
                    list-y: root.settings-choice-list-y;
                    row-step: root.settings-row-step;
                    row-height: root.settings-row-height;
                    visible: root.settings-choice-open && !root.details-page && !root.app-page-shown;
                    z: 95;
                }

                /* One status line at the pane bottom, reserved by the row grid. */
                MarqueeText {
                    x: root.settings-content-x;
                    y: parent.height - root.settings-notice-height - 4px;
                    width: root.settings-content-width;
                    height: root.settings-notice-height;
                    label: root.settings-notice;
                    text-color: #d5a34c;
                    text-size: 11px;
                    align-right: true;
                    visible: root.settings-notice != "";
                }
            }

            details-page-view := GameDetailsPage {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.details-page;
                /* Height scale, capped by the width (square screens). */
                s: min(root.home-s, max(1.0, self.width / 640px));
                title: root.details-title;
                system-name: root.details-subtitle;
                meta: root.details-meta;
                description: root.details-description;
                cover: root.details-cover;
                has-cover: root.details-has-cover;
                backdrop: root.details-backdrop;
                has-backdrop: root.details-has-backdrop;
                chips: root.details-chips;
                actions: root.details-actions;
                index: root.gen-index;
                caption: root.details-caption;
                caption-armed: root.details-caption-armed;
                notice: root.gen-notice;
                desc-step: root.details-desc-step;
            }
            AppPage {
                x: 0; y: 0; width: parent.width; height: parent.height;
                visible: root.app-page-shown;
                s: min(root.home-s, max(1.0, self.width / 640px));
                kicker: root.app-page-kicker;
                title: root.app-page-title;
                meta: root.app-page-meta;
                description: root.app-page-description;
                icon: root.app-page-icon;
                has-icon: root.app-page-has-icon;
                chips: root.app-page-chips;
                entries: root.app-page-entries;
                actions: root.app-page-actions;
                action-captions: root.app-page-captions;
                index: root.app-page-gen ? root.gen-index : root.steamlink-active ? root.steamlink-index : root.moonlight-index;
                notice: root.app-page-gen ? root.gen-notice : root.steamlink-active ? root.steamlink-notice : root.moonlight-notice;
                pin: root.app-page-pin;
                pin-label: root.i18n-strings[449];
                progress: root.app-page-progress;
                progress-label: root.app-page-progress-label;
            }
            SettingsChoiceSheet {
                x: (parent.width - self.width) / 2;
                y: 24px;
                width: min(parent.width - 48px, 420px);
                height: min(
                    parent.height - self.y - 24px,
                    root.settings-choice-list-y + min(root.settings-choice-options.length, root.settings-choice-visible-rows) * root.settings-row-step + 4px
                );
                title: root.settings-choice-title;
                options: root.settings-choice-options;
                index: root.settings-choice-index;
                scroll: root.settings-choice-scroll;
                visible-rows: root.settings-choice-visible-rows;
                list-y: root.settings-choice-list-y;
                row-step: root.settings-row-step;
                row-height: root.settings-row-height;
                /* Over the full screen pages (Files actions, Game Details). */
                visible: root.settings-choice-open && (root.details-page || root.app-page-shown);
            }
        }

        /* System-wide virtual keyboard bottom sheet. It intentionally spans the
         * full display width so every Settings domain shares the same keyboard
         * surface, independent of the right-pane width. It sits on the action
         * bar; the field label says what is entered, the page title above
         * stays the page the keyboard was opened from. */
        system-keyboard := SystemVirtualKeyboard {
            x: 0px;
            y: parent.height - 52px - self.content-height;
            width: parent.width;
            height: self.content-height;
            z: 20;
            visible: (root.settings-open || root.find-open) && root.settings-view == 6;
            value <=> root.keyboard-value;
            title: root.keyboard-title;
            secret: root.keyboard-secret;
            shift: root.keyboard-shift;
            caps: root.keyboard-caps;
            input-kind: root.keyboard-input-kind;
            layout-name: root.keyboard-layout;
            selected-index: root.keyboard-index;
            page: root.keyboard-page;
            row-zero: root.keyboard-row-zero;
            row-one: root.keyboard-row-one;
            row-two: root.keyboard-row-two;
            row-three: root.keyboard-row-three;
            accepted => { root.system-keyboard-accepted(); }
        }

        /* Context-sensitive bottom action bar. */
        Rectangle {
            x: 0;
            y: parent.height - 52px;
            width: parent.width;
            height: 52px;
            background: Theme.background;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Theme.surface;
            }

            HorizontalLayout {
                x: 18px;
                y: 0;
                width: parent.width - 36px;
                height: parent.height;
                spacing: 20px;

                /* System keyboard: West deletes the last character (first,
                 * on the left, user request 2026-10-10). */
                if (root.settings-open || root.find-open) && root.settings-view == 6: ActionHint {
                    kind: "face"; face-position: root.details-face-position; label: root.i18n-strings[618];
                }
                if !root.settings-open && root.home-sheet-open: ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
                if !root.settings-open && !root.home-sheet-open && root.home-focus-valid: ActionHint {
                    kind: "face"; face-position: root.select-face-position;
                    label: root.home-focused.kind == 0 ? root.i18n-strings[413] : root.i18n-strings[414];
                }
                /* Games: North = Details; a collection: North = Manage. */
                if !root.settings-open && !root.home-sheet-open && root.home-focus-valid && root.home-focused.kind == 0: ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.i18n-strings[523];
                }
                if !root.settings-open && !root.home-sheet-open && root.home-focus-valid && root.home-focused.kind == 2: ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.i18n-strings[849];
                }
                if !root.settings-open && (root.find-open && !root.library-open && root.find-zone != 2): ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
                if !root.settings-open && (root.library-open || root.home-sheet-open || root.find-open): ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
                if !root.settings-open: Rectangle { horizontal-stretch: 1; }
                if root.settings-open && root.settings-view != 14: ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                if root.settings-select-hint-visible: ActionHint {
                    kind: "face"; face-position: root.select-face-position;
                    label: !root.settings-choice-open && root.gen-view
                        && root.gen-select-label != "" ? root.gen-select-label : root.i18n-strings[185];
                }
                if root.settings-open: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
                if root.settings-open && !root.settings-choice-open && root.settings-north-hint != "" && root.settings-view != 6: ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.settings-north-hint;
                }
                /* System keyboard: North toggles Shift / Caps Lock on letters. */
                if root.settings-open && root.settings-view == 6 && root.keyboard-page == 0
                    && (root.keyboard-input-kind == "text" || root.keyboard-input-kind == "password"): ActionHint {
                    kind: "face"; face-position: root.context-face-position; label: root.i18n-strings[791];
                }
                if root.settings-open: Rectangle { horizontal-stretch: 1; }
                if !root.settings-open && !root.home-sheet-open && !root.find-open: ActionHint { kind: "select"; label: root.i18n-strings[828]; }
                if !root.settings-open && !root.library-open: ActionHint { kind: "start"; label: root.i18n-strings[3]; }
                ActionHint { kind: "menu"; label: root.i18n-strings[187]; }
            }
        }
    }

    /* OOB Language (step 0) and Ready (step 4): one obvious action each. The
     * column is centred in the logical window and only its type sizes grow
     * mildly with the height, so 640x480 stays compact and TV stays legible.
     * Step 0 greets in every UI language on a rolling drum (the Timer runs
     * only on that step) above the language selector (left/right). */
    /* Game loading screen: the game's cover, title and system, an M3
     * linear indeterminate bar (fills only) and "Starting game…". */
    launch-view := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.launch-open;
        property <float> s: root.home-s;
        property <length> cover-h: min(parent.height * 0.46, 340px * self.s);
        property <float> aspect: root.launch-has-cover && root.launch-cover.height > 0
            ? max(0.5, min(1.8, root.launch-cover.width / root.launch-cover.height)) : 0.75;
        TouchArea { }
        Rectangle {
            width: parent.width; height: parent.height * 0.6; y: 0;
            background: @linear-gradient(180deg, root.launch-accent.transparentize(0.78) 0%,
                Theme.background.transparentize(1.0) 100%);
        }
        VerticalLayout {
            alignment: center;
            spacing: 14px * launch-view.s;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: launch-view.cover-h * launch-view.aspect;
                    height: launch-view.cover-h;
                    border-radius: max(Shape.medium, self.height * 0.06);
                    background: root.launch-has-cover ? #00000000 : Theme.surface-container;
                    if root.launch-has-cover: Image {
                        width: parent.width; height: parent.height;
                        source: root.launch-cover;
                        image-fit: fill;
                    }
                }
            }
            Text {
                horizontal-alignment: center;
                text: root.launch-title;
                color: Theme.text;
                font-size: 24px * launch-view.s;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                alignment: center;
                HomeInfoChip {
                    text: root.launch-system; dot: root.launch-accent; has-dot: true; has-icon: false;
                    s: launch-view.s;
                }
            }
            HorizontalLayout {
                alignment: center;
                /* M3 linear indeterminate progress: a primary segment
                 * travelling over a tonal track. */
                Rectangle {
                    property <length> seg: self.width * 0.32;
                    property <float> t: root.launch-busy ? mod(animation-tick() / 1ms, 1300) / 1300 : 0.0;
                    width: min(260px * launch-view.s, launch-view.width * 0.5);
                    height: 4px * launch-view.s;
                    border-radius: self.height / 2;
                    background: Theme.surface-container-highest;
                    clip: true;
                    Rectangle {
                        x: -parent.seg + parent.t * (parent.width + parent.seg);
                        width: parent.seg; height: parent.height;
                        border-radius: parent.height / 2;
                        background: Theme.primary;
                        visible: root.launch-busy;
                    }
                }
            }
            Text {
                horizontal-alignment: center;
                text: root.i18n-strings[811];
                color: Theme.text-secondary;
                font-size: 15px * launch-view.s;
            }
        }
    }

    oob-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.oob-active && (root.oob-step == 0 || root.oob-step == 4);
        z: 150;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <bool> ready: root.oob-step == 4;
        /* Endonyms, deliberately not translated; order = UI_LANGUAGES. */
        property <[string]> greetings: ["Welcome", "Benvenuto", "Bienvenue", "Willkommen", "Bienvenido", "Bem-vindo", "Welkom"];
        property <float> greet-tick: 0;
        animate greet-tick { duration: 700ms; easing: ease-in-out; }
        property <int> greet-n: floor(self.greet-tick);
        property <float> greet-p: self.greet-tick - self.greet-n;
        property <length> greet-h: 26px * self.type-scale * 1.5;

        Timer {
            interval: 2600ms;
            running: root.oob-active && root.oob-step == 0;
            triggered => { oob-hero.greet-tick += 1; }
        }

        VerticalLayout {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height - 58px;
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                Text { text: "nuub"; color: Theme.text; font-size: 40px * oob-hero.type-scale; font-weight: 700; }
                Text { text: "OS"; color: Theme.accent; font-size: 40px * oob-hero.type-scale; font-weight: 700; }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 86px; height: 3px; background: Theme.accent; border-radius: 2px; }
            }
            Rectangle { height: 4px; }
            if oob-hero.ready: Text {
                text: root.i18n-strings[394];
                color: Theme.text;
                font-size: 26px * oob-hero.type-scale;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            /* Drum: the current greeting rolls up and away while the next
             * one rolls in from below (scale-y fakes the rotation). */
            if !oob-hero.ready: Rectangle {
                height: oob-hero.greet-h;
                clip: true;
                for k in 2: Text {
                    property <float> p: k == 0 ? 1 - oob-hero.greet-p : oob-hero.greet-p;
                    x: 0;
                    y: (k == 0 ? -1 : 1) * (1 - self.p) * oob-hero.greet-h * 0.6;
                    width: parent.width;
                    height: oob-hero.greet-h;
                    text: oob-hero.greetings[Math.mod(oob-hero.greet-n + k, oob-hero.greetings.length)];
                    color: Theme.text;
                    font-size: 26px * oob-hero.type-scale;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    opacity: self.p;
                    transform-scale-y: self.p;
                    transform-origin: { x: self.width / 2, y: k == 0 ? 0px : self.height };
                }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    max-width: 520px;
                    text: oob-hero.ready ? root.i18n-strings[395] : root.i18n-strings[389];
                    color: Theme.text-secondary;
                    font-size: 16px * oob-hero.type-scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: center;
                SettingsActionButton {
                    width: min(300px, root.width - 64px);
                    height: root.settings-row-height;
                    label: oob-hero.ready ? root.i18n-strings[396] : "‹   " + root.ui-language-name + "   ›";
                    selected: true;
                }
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                for i in 5: Rectangle {
                    width: i == root.oob-step ? 18px : 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: i <= root.oob-step ? Theme.accent : Theme.border-soft;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                if root.oob-step == 0: ActionHint { kind: "nav"; label: root.i18n-strings[193]; }
                ActionHint {
                    kind: "face"; face-position: root.select-face-position;
                    label: root.oob-step == 0 ? root.i18n-strings[390] : root.i18n-strings[185];
                }
                if root.oob-step == 4: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    /* Safe mode (EPIC-050): the supervisor restarted nuubUI after a crash
     * loop. A full-screen recovery screen in the OOB hero style instead of a
     * Settings page; the actions are nuubos-recoveryctl's, the restart is the
     * central lifecycle's. Power stays on the global power menu. */
    safe-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.safe-screen-open;
        z: 190;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <length> column: min(560px * self.type-scale, root.width - 64px);
        property <length> cell: (self.column - 10px) / 2;
        property <length> button-h: root.settings-row-height;
        /* The armed button carries its own prompt; this line always
         * describes the focused action. */
        property <string> detail: root.recovery-notice != "" ? root.recovery-notice
            : root.safe-index == 0 ? root.i18n-strings[712]
            : root.safe-index == 1 ? root.i18n-strings[512]
            : root.safe-index == 2 ? root.i18n-strings[504]
            : root.safe-index == 3 ? root.i18n-strings[513]
            : root.safe-index == 4 ? root.i18n-strings[713]
            : root.safe-index == 5 ? root.i18n-strings[514]
            : root.i18n-strings[515];

        VerticalLayout {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height - 58px;
            alignment: center;
            spacing: 10px;

            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                Text { text: "nuub"; color: Theme.text; font-size: 28px * safe-hero.type-scale; font-weight: 700; }
                Text { text: "OS"; color: Theme.accent; font-size: 28px * safe-hero.type-scale; font-weight: 700; }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 86px; height: 3px; background: Theme.warning; border-radius: 2px; }
            }
            Text {
                text: root.i18n-strings[518];
                color: Theme.text;
                font-size: 24px * safe-hero.type-scale;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: safe-hero.column;
                    text: root.i18n-strings[519];
                    color: Theme.text-secondary;
                    font-size: 15px * safe-hero.type-scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            Rectangle { height: 2px; }
            HorizontalLayout {
                alignment: center;
                SettingsActionButton {
                    width: safe-hero.column;
                    height: safe-hero.button-h;
                    label: root.i18n-strings[520];
                    selected: root.safe-index == 0;
                }
            }
            for pair[r] in [
                { left: root.i18n-strings[505], right: root.i18n-strings[500] },
                { left: root.i18n-strings[508], right: root.i18n-strings[3] },
                { left: root.i18n-strings[510], right: root.i18n-strings[511] },
            ]: HorizontalLayout {
                alignment: center;
                spacing: 10px;
                SettingsActionButton {
                    width: safe-hero.cell;
                    height: safe-hero.button-h;
                    armed: root.recovery-armed == 1 + r * 2;
                    label: pair.left;
                    prompt: root.i18n-strings[191];
                    selected: root.safe-index == 1 + r * 2;
                    danger: r == 2;
                    enabled: r != 1 || root.active-user-id != "";
                }
                SettingsActionButton {
                    width: safe-hero.cell;
                    height: safe-hero.button-h;
                    armed: root.recovery-armed == 2 + r * 2;
                    label: pair.right;
                    prompt: r == 2 && root.recovery-stage == 1 ? root.i18n-strings[517] : root.i18n-strings[191];
                    selected: root.safe-index == 2 + r * 2;
                    danger: r == 2;
                    enabled: r != 0 || !root.diag-busy;
                }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    width: safe-hero.column;
                    height: 2 * 18px * safe-hero.type-scale;
                    text: safe-hero.detail;
                    color: Theme.text-faint;
                    font-size: 13px * safe-hero.type-scale;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
            }
        }
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #090b0f;
        visible: root.user-picker-open;
        z: 180;
        clip: true;

        /* Same nuubOS chrome as Home/Settings: matte top bar and the
         * controller-agnostic action bar remain visible during user selection. */
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 58px;
            background: Theme.background;
            z: 2;
            HorizontalLayout {
                x: 20px; y: 10px; height: 32px;
                spacing: 0px;
                alignment: start;
                Text { text: "nuub"; color: Theme.text; font-size: 25px; font-weight: 700; vertical-alignment: center; }
                Text { text: "OS"; color: Theme.accent; font-size: 25px; font-weight: 700; vertical-alignment: center; }
            }
            Text {
                x: 0; y: 13px; width: parent.width; height: 28px;
                text: root.i18n-strings[291];
                color: Theme.text;
                font-size: 19px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: 16px; y: 57px; width: parent.width - 32px; height: 1px; background: Theme.surface; }
        }

        for user[i] in root.users : user-card := Rectangle {
            property <bool> focused: root.user-picker-index == i;
            property <length> card-width: root.layout-class == 2 ? 174px : 142px;
            property <length> card-height: root.layout-class == 2 ? 224px : 194px;
            property <length> card-gap: root.layout-class == 2 ? 196px : 160px;

            x: parent.width / 2 - user-card.card-width / 2
                + (i - root.user-picker-index) * user-card.card-gap;
            y: 58px + (parent.height - 116px) / 2 - user-card.card-height / 2;
            width: user-card.card-width;
            height: user-card.card-height;
            border-radius: Shape.large;
            background: user-card.focused ? Theme.secondary-container : Theme.surface-container-low;
            border-width: user-card.focused ? 3px : 0px;
            border-color: Theme.primary;
            visible: i >= root.user-picker-index - 2 && i <= root.user-picker-index + 2;

            Rectangle {
                x: (parent.width - (user-card.focused ? 112px : 88px)) / 2;
                y: user-card.focused ? 24px : 36px;
                width: user-card.focused ? 112px : 88px;
                height: user-card.focused ? 112px : 88px;
                border-radius: self.width * 0.22;
                border-width: 1px;
                border-color: user-card.focused ? Theme.primary : Theme.outline-variant;
                background: #11151a;
                clip: true;

                Image {
                    x: parent.border-width;
                    y: parent.border-width;
                    width: parent.width - 2 * parent.border-width;
                    height: parent.height - 2 * parent.border-width;
                    source: user.avatar;
                    image-fit: contain;
                }
            }

            MarqueeText {
                x: 10px;
                y: parent.height - 51px;
                width: parent.width - 20px;
                height: 30px;
                label: user.name;
                text-color: user-card.focused ? Theme.text : Theme.text-secondary;
                text-size: user-card.focused ? 20px : 16px;
                text-weight: user-card.focused ? 600 : 500;
                active: user-card.focused;
                align-center: true;
                
                
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            z: 2;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint { kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185]; }
                if !root.user-picker-forced: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #05070bdc;
        visible: root.avatar-picker-open;
        z: 185;

        Rectangle {
            width: root.avatar-picker-card-width;
            height: root.avatar-picker-card-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            /* M3 dialog: tonal surface, extra-large shape. */
            background: Theme.surface-container-high;
            border-radius: Shape.extra-large;

            MarqueeText {
                x: 22px; y: 14px;
                width: parent.width - 44px; height: 32px;
                label: root.i18n-strings[321];
                text-color: Theme.text;
                text-size: 20px;
                text-weight: 600;
                align-center: true;
            }
            for avatar[i] in root.avatar-choices : tile := Rectangle {
                property <bool> focused: root.avatar-picker-index == i;
                property <int> grid-row: floor(i / root.avatar-picker-columns);
                property <length> cell-width: (parent.width - 32px) / root.avatar-picker-columns;
                property <length> size: min(tile.cell-width - 28px, root.avatar-picker-tile-height - 46px);
                x: 16px + mod(i, root.avatar-picker-columns) * tile.cell-width + 4px;
                y: 62px + (tile.grid-row - root.avatar-picker-scroll) * root.avatar-picker-tile-height;
                width: tile.cell-width - 8px;
                height: root.avatar-picker-tile-height - 8px;
                border-radius: Shape.large;
                background: tile.focused ? Theme.secondary-container : transparent;
                border-width: tile.focused ? 3px : 0px;
                border-color: Theme.primary;
                visible: tile.grid-row >= root.avatar-picker-scroll
                    && tile.grid-row < root.avatar-picker-scroll + root.avatar-picker-rows;

                Rectangle {
                    x: (parent.width - tile.size) / 2;
                    y: 8px;
                    width: tile.size;
                    height: tile.size;
                    border-radius: tile.size * 0.22;
                    border-width: 1px;
                    border-color: tile.focused ? Theme.primary : Theme.outline-variant;
                    background: #11151a;
                    clip: true;

                    Image {
                        x: parent.border-width;
                        y: parent.border-width;
                        width: parent.width - 2 * parent.border-width;
                        height: parent.height - 2 * parent.border-width;
                        source: avatar.avatar;
                        image-fit: contain;
                    }
                }
                MarqueeText {
                    x: 6px;
                    y: parent.height - 30px;
                    width: parent.width - 12px;
                    height: 24px;
                    label: avatar.label;
                    text-color: tile.focused ? Theme.text : Theme.text-secondary;
                    text-size: 13px;
                    text-weight: tile.focused ? 600 : 500;
                    active: tile.focused;
                    align-center: true;
                }
            }
            MarqueeText {
                x: 22px;
                y: parent.height - 28px;
                width: parent.width - 44px;
                label: root.i18n-strings[294] + " • /userdata/users/" + root.profile-edit-user-id + "/profile/avatars";
                text-color: #737b86;
                text-size: 10px;
                align-center: true;
                
            }
        }
    }

    /* Manual Date & Time picker: full screen with the nuubOS chrome (top
     * bar, action bar). Day / Month / Year on the first line, Hour : Minute
     * on the second; each wheel shows the next value above and the previous
     * one below. Geometry adapts to 4:3, square and 16:9. */
    property <length> dt-cell: root.layout-class == 2 ? 104px : 88px;
    property <length> dt-month: root.layout-class == 2 ? 240px : 200px;
    property <length> dt-year: root.layout-class == 2 ? 132px : 116px;
    property <length> dt-colon: 32px;
    property <length> dt-gap: 14px;
    property <length> dt-label: 24px;
    property <length> dt-preview-height: 34px;
    property <length> dt-spacing: root.height < 600px ? 18px : 28px;
    property <length> dt-wheel: max(88px, min(156px,
        (root.height - 116px - 16px - root.dt-preview-height - 2 * root.dt-spacing - 2 * root.dt-label) / 2));
    property <length> dt-block: root.dt-preview-height + 2 * root.dt-spacing + 2 * (root.dt-label + root.dt-wheel);
    property <length> dt-top: 58px + max(0px, (root.height - 116px - root.dt-block) / 2);
    property <length> dt-row0: root.dt-top + root.dt-preview-height + root.dt-spacing;
    property <length> dt-row1: root.dt-row0 + root.dt-label + root.dt-wheel + root.dt-spacing;
    property <length> dt-date-x: (root.width - root.dt-cell - root.dt-month - root.dt-year - 2 * root.dt-gap) / 2;
    property <length> dt-time-x: (root.width - 2 * root.dt-cell - root.dt-colon - 2 * root.dt-gap) / 2;
    pure function dt-x(i: int) -> length {
        if i == 0 { return root.dt-date-x; }
        if i == 1 { return root.dt-date-x + root.dt-cell + root.dt-gap; }
        if i == 2 { return root.dt-date-x + root.dt-cell + root.dt-month + 2 * root.dt-gap; }
        if i == 3 { return root.dt-time-x; }
        return root.dt-time-x + root.dt-cell + root.dt-colon + 2 * root.dt-gap;
    }
    pure function dt-w(i: int) -> length {
        if i == 1 { return root.dt-month; }
        if i == 2 { return root.dt-year; }
        return root.dt-cell;
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: Theme.background;
        visible: root.datetime-picker-open;
        z: 186;
        clip: true;

        Rectangle {
            x: 0; y: 0; width: parent.width; height: 58px;
            background: Theme.background;
            HorizontalLayout {
                x: 20px; y: 10px; height: 32px;
                spacing: 0px;
                alignment: start;
                Text { text: "nuub"; color: Theme.text; font-size: 25px; font-weight: 700; vertical-alignment: center; }
                Text { text: "OS"; color: Theme.accent; font-size: 25px; font-weight: 700; vertical-alignment: center; }
            }
            Text {
                x: 0; y: 13px; width: parent.width; height: 28px;
                text: root.i18n-strings[46];
                color: Theme.text;
                font-size: 19px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: 16px; y: 57px; width: parent.width - 32px; height: 1px; background: Theme.surface; }
        }

        Text {
            x: 16px; y: root.dt-top; width: parent.width - 32px; height: root.dt-preview-height;
            text: root.datetime-preview;
            color: Theme.text-secondary;
            font-size: 20px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        for field[i] in root.datetime-fields : wheel := Rectangle {
            property <bool> focused: root.datetime-field-index == i;
            property <length> value-size: i == 1
                ? (root.layout-class == 2 ? 30px : 26px)
                : (root.layout-class == 2 ? 40px : 34px);
            x: root.dt-x(i);
            y: i < 3 ? root.dt-row0 : root.dt-row1;
            width: root.dt-w(i);
            height: root.dt-label + root.dt-wheel;

            Text {
                x: 0; y: 0; width: parent.width; height: root.dt-label - 4px;
                text: field.label;
                color: wheel.focused ? Theme.primary : Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: 0; y: root.dt-label; width: parent.width; height: root.dt-wheel;
                /* M3: tonal surface, the focused wheel in the selection
                 * roles with the primary outline (as Settings rows). */
                background: wheel.focused ? Theme.secondary-container : Theme.surface-container;
                border-radius: Shape.large;
                border-width: wheel.focused ? 3px : 0px;
                border-color: Theme.primary;
                animate background, border-width { duration: 120ms; }

                Text {
                    x: 4px; y: 6px; width: parent.width - 8px; height: parent.height * 0.26;
                    text: field.above;
                    color: Theme.text-faint;
                    font-size: wheel.value-size * 0.5;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 12px; y: parent.height * 0.29; width: parent.width - 24px; height: 1px;
                    background: wheel.focused ? Theme.outline-variant : Theme.border-soft;
                }
                Text {
                    x: 4px; y: parent.height * 0.3; width: parent.width - 8px; height: parent.height * 0.4;
                    text: field.value;
                    color: wheel.focused ? Theme.on-secondary-container : Theme.text;
                    font-size: wheel.value-size;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 12px; y: parent.height * 0.71; width: parent.width - 24px; height: 1px;
                    background: wheel.focused ? Theme.outline-variant : Theme.border-soft;
                }
                Text {
                    x: 4px; y: parent.height * 0.74 - 6px; width: parent.width - 8px; height: parent.height * 0.26;
                    text: field.below;
                    color: Theme.text-faint;
                    font-size: wheel.value-size * 0.5;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Text {
            x: root.dt-time-x + root.dt-cell + root.dt-gap;
            y: root.dt-row1 + root.dt-label;
            width: root.dt-colon; height: root.dt-wheel;
            text: ":";
            color: Theme.text;
            font-size: root.layout-class == 2 ? 40px : 34px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: Theme.background;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Theme.surface; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint { kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[82]; }
                ActionHint { kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[619]; }
            }
        }
    }

    /* Lifecycle curtain. The splash is rendered by Rust (src/splash.rs) at the
     * exact physical output size, identical to the kernel and compositor
     * frames; it is drawn 1:1, never rescaled. The curtain splits on the
     * splash accent line. */
    Rectangle {
        x: 0;
        y: -(parent.height * root.splash-split) * root.curtain-progress;
        width: parent.width;
        height: parent.height * root.splash-split;
        clip: true;
        visible: root.curtain-progress < 0.999;

        Image {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            source: root.splash-image;
            image-fit: fill;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height * root.splash-split
            + (parent.height * (1 - root.splash-split)) * root.curtain-progress;
        width: parent.width;
        height: parent.height * (1 - root.splash-split);
        clip: true;
        visible: root.curtain-progress < 0.999;

        Image {
            x: 0;
            y: -(root.height * root.splash-split);
            width: root.width;
            height: root.height;
            source: root.splash-image;
            image-fit: fill;
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            - (parent.height * root.splash-split) * root.curtain-progress;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: root.splash-line-height;
        background: Theme.accent-muted;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            + (parent.height * (1 - root.splash-split)) * root.curtain-progress
            - self.height;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: root.splash-line-height;
        background: Theme.accent-muted;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            - (parent.height * root.splash-split) * root.curtain-progress
            - 2px;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: 7px;
        background: Theme.accent-muted;
        opacity: 0.06;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            + (parent.height * (1 - root.splash-split)) * root.curtain-progress
            - 5px;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: 7px;
        background: Theme.accent-muted;
        opacity: 0.06;
        visible: root.curtain-progress < 0.999;
    }
}
