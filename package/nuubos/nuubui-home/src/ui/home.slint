    in-out property <bool> user-switch-requested: false;
    in-out property <bool> user-picker-open: false;
    in-out property <bool> user-picker-forced: false;
    in-out property <int> user-picker-index: 0;
    in-out property <int> user-picker-scroll: 0;
    in-out property <int> user-list-index: 0;
    in-out property <int> user-list-scroll: 0;
    in-out property <int> profile-index: 0;
    /* Own profile page (24) scrolls; the user detail page (26) does not. */
    in-out property <int> profile-scroll: 0;
    property <int> profile-row-scroll: root.settings-view == 24 ? root.profile-scroll : 0;
    in-out property <string> profile-edit-user-id: "";
    in-out property <string> profile-edit-name: "";
    in-out property <string> profile-edit-avatar-spec: "builtin:01";
    in-out property <image> profile-edit-avatar;
    in-out property <bool> user-delete-confirm: false;
    in-out property <bool> avatar-picker-open: false;
    /* Settings confirmation dialog (M3 basic dialog): a title, the text
     * explaining what the choice means, Cancel (index 0) and the confirm
     * action (index 1). gameui.rs owns what confirm does. */
    in-out property <bool> settings-dialog-open: false;
    in-out property <string> settings-dialog-title: "";
    in-out property <string> settings-dialog-body: "";
    in-out property <string> settings-dialog-confirm: "";
    in-out property <int> settings-dialog-index: 0;
    in-out property <[AvatarChoiceEntry]> avatar-choices: [];
    in-out property <int> avatar-picker-index: 0;
    /* First visible grid row. */
    in-out property <int> avatar-picker-scroll: 0;
    /* Avatar picker grid: large tiles, as many columns/rows as the screen
     * holds (4×2 at 640×480); Rust reads both for navigation and scroll. */
    property <length> avatar-picker-card-width: min(root.width - 32px, 820px);
    property <length> avatar-picker-card-height: root.height - 32px;
    out property <int> avatar-picker-columns:
        max(1, floor((root.avatar-picker-card-width - 32px) / (root.layout-class == 2 ? 168px : 140px)));
    out property <int> avatar-picker-rows:
        max(1, floor((root.avatar-picker-card-height - 112px) / (root.layout-class == 2 ? 172px : 150px)));
    /* Rows share the whole height (no empty band below the grid). */
    property <length> avatar-picker-tile-height:
        min((root.avatar-picker-card-height - 112px) / root.avatar-picker-rows, 220px);
    in-out property <string> timezone: "UTC";
    in-out property <bool> automatic-time: true;
    in-out property <string> manual-date-label: "---- -- --";
    in-out property <string> manual-time-label: "--:--";
