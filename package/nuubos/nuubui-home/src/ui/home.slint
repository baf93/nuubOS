import { Theme, Shape } from "theme.slint";
import { SystemVirtualKeyboard } from "components/virtual_keyboard.slint";
export { Theme } from "theme.slint";


component MarqueeText inherits Rectangle {
    in property <string> label: "";
    in property <color> text-color: #ffffff;
    in property <length> text-size: 16px;
    in property <int> text-weight: 400;
    in property <bool> active: true;
    in property <bool> align-right: false;
    in property <bool> align-center: false;
    /* Forward/back passes; a notification scrolls once and holds the end. */
    in property <int> passes: 2;
    out property <length> content-width: marquee-label.preferred-width;
    /* Constant reading speed (~60 px/s): long text scrolls longer, never
     * faster. Short overflows keep the minimum duration. */
    property <length> overflow: max(0px, marquee-label.preferred-width - root.width);
    out property <duration> scroll-duration: max(1250ms, root.overflow / 1px * 16ms);
    /* Time until the end of the text has been shown (0 when it fits). */
    out property <duration> scroll-time: root.overflow > 0px ? 320ms + root.scroll-duration * root.passes : 0ms;
    /* Reading this evaluates the animated position (used to restart). */
    out property <length> offset: marquee-label.x;

    background: #00000000;
    clip: true;

    marquee-label := Text {
        text: root.label;
        color: root.text-color;
        font-size: root.text-size;
        font-weight: root.text-weight;
        width: self.preferred-width;
        height: parent.height;
        vertical-alignment: center;
        x: root.active && self.preferred-width > parent.width
            ? parent.width - self.preferred-width
            /* Overflowing text at rest shows its beginning, whatever the
             * alignment of text that fits. */
            : self.preferred-width > parent.width ? 0px
            : root.align-right ? parent.width - self.preferred-width
            : root.align-center ? (parent.width - self.preferred-width) / 2
            : 0px;
        animate x {
            delay: 320ms;
            duration: root.scroll-duration;
            iteration-count: root.passes;
            direction: alternate;
            easing: linear;
            enabled: root.active && self.preferred-width > parent.width;
        }
    }
}

export struct WifiNetworkEntry {
    ssid: string,
    security: string,
    signal-dbm: int,
    saved: bool,
    current: bool,
}

/* PC streaming host (nuubos-streamd snapshot). online: online|offline|unknown. */
export struct MoonlightHostEntry {
    id: string,
    name: string,
    address: string,
    paired: bool,
    online: string,
    probing: bool,
}

export struct BluetoothDeviceEntry {
    address: string,
    name: string,
    kind: string,
    paired: bool,
    connected: bool,
    trusted: bool,
    rssi: int,
}

export struct ControllerEntry {
    id: string,
    name: string,
    transport: string,
    connected: bool,
    builtin: bool,
    preferred-player: int,
    effective-player: int,
}

/* Connected external controller shown in the top bar. */
export struct TopbarController {
    player: int,
    battery: int,
}

export struct PlayerAssignmentEntry {
    player: int,
    controller-id: string,
    controller-name: string,
    available: bool,
}

/* kind: 0 button, 1 stick axis, 2 stick deadzone, 3 Restore Default Mapping. */
export struct ControllerMappingEntry {
    control: string,
    kind: int,
    label: string,
    value: string,
    customized: bool,
}

/* One row of a data-driven page (Game Details, Game Settings, BIOS Files,
 * RetroAchievements, Gaming, SERVICES...): Rust builds the rows from
 * the owning services; the page only lays them out. */
export struct GenRow {
    title: string,
    value: string,
    detail: string,
    navigates: bool,
    toggle: bool,
    toggle-on: bool,
    enabled: bool,
    /* Waiting for the confirming press (error style, prompt in detail). */
    armed: bool,
}

export struct SettingsChoiceEntry {
    value: string,
    label: string,
}

export struct UserProfileEntry {
    id: string, name: string, avatar-spec: string, avatar-path: string, avatar: image, active: bool, default-user: bool,
}
export struct AvatarChoiceEntry {
    spec: string, label: string, path: string, avatar: image,
}

component BatteryGlyph inherits Rectangle {
    in property <int> percent: -1;
    in property <bool> compact: false;
    in property <bool> charging: false;
    in property <bool> battery-saver: false;

    width: root.compact ? 13px : 32px;
    height: root.compact ? 10px : 24px;
    background: #00000000;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-empty.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent >= 0 && root.percent <= 15;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-quarter.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 15 && root.percent <= 35;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-half.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 35 && root.percent <= 60;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-three-quarters.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 60 && root.percent <= 85;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-full.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 85;
    }
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "?";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text-faint;
        font-size: root.compact ? 8px : 11px;
        font-weight: 700;
        visible: root.percent < 0;
    }

    /* Charging bolt: outline + fill, both from the theme. */
    Image {
        x: (parent.width - (root.compact ? 7px : 15px)) / 2;
        y: (parent.height - (root.compact ? 8px : 17px)) / 2;
        width: root.compact ? 7px : 15px;
        height: root.compact ? 8px : 17px;
        source: @image-url("assets/icons/bolt-outline.svg");
        image-fit: contain;
        colorize: Theme.background;
        visible: root.charging && root.percent >= 0;
    }
    Image {
        x: (parent.width - (root.compact ? 7px : 15px)) / 2;
        y: (parent.height - (root.compact ? 8px : 17px)) / 2;
        width: root.compact ? 7px : 15px;
        height: root.compact ? 8px : 17px;
        source: @image-url("assets/icons/bolt.svg");
        image-fit: contain;
        colorize: Theme.accent;
        visible: root.charging && root.percent >= 0;
    }
}

component ControllerStatus inherits Rectangle {
    in property <int> player: 1;
    in property <int> battery-percent: -1;
    /* Compact: player badge + battery dot only; the group shares one
     * gamepad icon (used when the controllers do not fit next to the clock). */
    in property <bool> compact: false;

    width: root.compact ? 16px : 34px;
    height: 38px;
    background: #00000000;

    Image {
        x: 0;
        y: 14px;
        width: 22px;
        height: 22px;
        source: @image-url("assets/icons/gamepad.svg");
        image-fit: contain;
        visible: !root.compact;
    }

    Rectangle {
        x: root.compact ? 1px : 16px;
        y: root.compact ? 12px : 4px;
        width: 13px;
        height: 13px;
        border-radius: 7px;
        background: Theme.accent;

        Text {
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.player;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
        }
    }

    /* Battery level: green / amber / red dot, hidden when unknown. */
    Rectangle {
        x: root.compact ? 4px : 17px;
        y: root.compact ? 28px : 29px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.background;
        background: root.battery-percent >= 50 ? #43d17a
            : root.battery-percent >= 20 ? Theme.warning : #ff5c5c;
        visible: root.battery-percent >= 0;
    }
}

component WifiStatus inherits Rectangle {
    in property <string> state: "disconnected";

    width: 25px;
    height: 45px;
    background: #00000000;

    Image {
        x: 1px;
        y: 14px;
        width: 22px;
        height: 22px;
        source: @image-url("assets/icons/wifi.svg");
        image-fit: contain;
        opacity: root.state == "connected" ? 1.0 : root.state == "connecting" ? 0.82 : 0.34;
    }

    Image {
        x: 16px;
        y: 5px;
        width: 9px;
        height: 9px;
        source: @image-url("assets/icons/circle-notch.svg");
        image-fit: contain;
        visible: root.state == "connecting";
    }

    Image {
        x: 16px;
        y: 5px;
        width: 9px;
        height: 9px;
        source: @image-url("assets/icons/xmark.svg");
        image-fit: contain;
        opacity: root.state == "off" ? 1.0 : 0.62;
        visible: root.state == "off" || root.state == "disconnected";
    }
}

component MenuActionHint inherits Rectangle {
    width: 26px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "H";
        color: Theme.text;
        font-size: 16px;
        font-weight: 800;
    }
}


/* Settings visual grammar.
 *
 * Every Settings surface is built from the same few primitives so spacing,
 * typography and focus treatment never diverge between categories:
 *   SettingsCategory      rail entry
 *   SettingsSectionHeader accent section label + optional localized scope chip
 *   SettingsSelectableRow title [+ detail] and one right accessory:
 *                         value text, on/off switch or sub-page chevron
 *   SettingsActionButton  explicit action / destructive action
 * Geometry (row height, step, content origin) is owned by HomeWindow and
 * derived from the logical window size; components never assume 640x480. */
component SettingsCategory inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;

    /* M3 navigation drawer item: pill-shaped active indicator. */
    border-radius: self.height / 2;
    background: root.selected ? Theme.secondary-container : #00000000;

    MarqueeText {
        x: 16px;
        y: 0;
        width: parent.width - 28px;
        height: parent.height;
        label: root.label;
        text-color: root.selected ? Theme.on-secondary-container : Theme.text-secondary;
        text-size: 17px;
        text-weight: root.selected ? 700 : 500;
        active: root.selected;
    }
}

component SettingsSectionHeader inherits Rectangle {
    in property <string> label: "";
    /* Localized ownership label (USER / DEVICE). Empty when the section
     * label already is the scope. */
    in property <string> scope-label: "";

    height: 20px;
    background: #00000000;

    section-label := Text {
        x: 0;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: Theme.primary;
        font-size: 13px;
        font-weight: 600;
    }

    Rectangle {
        x: root.label == "" ? 0px : section-label.preferred-width + 8px;
        y: (parent.height - self.height) / 2;
        width: scope-text.preferred-width + 14px;
        height: 18px;
        border-radius: Shape.extra-small;
        background: #00000000;
        border-width: 1px;
        border-color: Theme.outline;
        visible: root.scope-label != "";

        scope-text := Text {
            x: 7px;
            y: 0;
            height: parent.height;
            vertical-alignment: center;
            text: root.scope-label;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 600;
        }
    }
}

component SettingsToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> selected: false;

    /* M3 switch: filled primary track with a large on-primary thumb when
     * on; outlined track with a small outline thumb when off. */
    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.primary : Theme.surface-container-highest;
    border-width: root.checked ? 0px : 2px;
    border-color: Theme.outline;

    Rectangle {
        property <length> size: root.checked ? 18px : 12px;
        x: root.checked ? parent.width - self.size - 3px : 6px;
        y: (parent.height - self.size) / 2;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: root.checked ? Theme.on-primary : Theme.outline;
        animate x, width { duration: 120ms; easing: ease-in-out; }
    }
}

component SettingsSelectableRow inherits Rectangle {
    in property <string> title: "";
    in property <string> detail: "";
    in property <string> value: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /* Live/current entity (connected network, connected device). */
    in property <bool> emphasized: false;
    /* Boolean setting: render the shared switch instead of value text. */
    in property <bool> toggle: false;
    in property <bool> toggle-on: false;
    /* Confirm opens a sub-page. */
    in property <bool> navigates: false;
    /* Circular image accessory (profile pictures). */
    in property <image> preview;
    in property <bool> show-preview: false;
    /* Colour dot accessory (RGB Lighting colour). */
    in property <color> swatch;
    in property <bool> show-swatch: false;
    /* Minimum share reserved for the title when the value itself is long.
     * Short/empty values consume only their preferred width, so the title
     * automatically gets the otherwise-unused space. */
    in property <float> title-fraction: 0.40;
    /* Waiting for the confirming press of a destructive action: the whole
     * row turns to the error roles and its detail line carries the prompt
     * (value and switch step aside), never a note beside the title. */
    in property <bool> armed: false;

    property <string> shown-value: root.armed ? "" : root.value;

    property <bool> has-detail: root.detail != "";
    property <length> accessory-width: root.armed ? 0px : root.toggle ? 42px
        : root.show-preview ? 28px
        : root.show-swatch ? 18px
        : root.navigates ? 10px
        : 0px;
    property <length> value-right: root.width - 12px - root.accessory-width
        - (root.accessory-width > 0px ? 10px : 0px);

    border-radius: Shape.medium;
    background: root.armed ? Theme.error-container
        : root.selected ? Theme.secondary-container : Theme.surface-container-low;
    border-width: root.selected ? 2px : 1px;
    border-color: root.armed ? Theme.error : root.selected ? Theme.primary : root.emphasized ? Theme.primary-container : Theme.surface-container-low;

    SettingsToggle {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        checked: root.toggle-on;
        selected: root.selected;
        visible: root.toggle && !root.armed;
    }

    Text {
        x: parent.width - 12px - root.accessory-width;
        y: 0;
        width: root.accessory-width;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: "›";
        color: root.selected ? Theme.on-secondary-container : Theme.outline;
        font-size: 22px;
        font-weight: 700;
        visible: root.navigates && !root.toggle && !root.show-preview && !root.show-swatch && !root.armed;
    }

    Rectangle {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: self.width / 2;
        background: root.swatch;
        border-width: 2px;
        border-color: root.selected ? Theme.on-secondary-container : Theme.outline-variant;
        visible: root.show-swatch && !root.toggle && !root.armed;
    }

    Rectangle {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 28px;
        height: 28px;
        /* Avatar frames: rounded square, corner = 22% of the side (as the
         * Rust mask, AVATAR_CORNER in main.rs). */
        border-radius: self.width * 0.22;
        border-width: 1px;
        border-color: root.selected ? Theme.accent : Theme.border-soft;
        background: #11151a;
        clip: true;
        visible: root.show-preview && !root.toggle && !root.armed;

        Image {
            x: parent.border-width;
            y: parent.border-width;
            width: parent.width - 2 * parent.border-width;
            height: parent.height - 2 * parent.border-width;
            source: root.preview;
            image-fit: contain;
        }
    }

    value-text := MarqueeText {
        width: root.shown-value == ""
            ? 0px
            : min(self.content-width + 4px,
                  root.value-right * (0.97 - root.title-fraction));
        x: root.value-right - self.width;
        y: 0;
        height: parent.height;
        label: root.shown-value;
        text-color: root.selected ? Theme.on-secondary-container : Theme.text-dim;
        text-size: 14px;
        text-weight: 500;
        align-right: true;
        active: root.selected;
        visible: root.shown-value != "";
    }

    title-text := MarqueeText {
        x: 14px;
        y: root.has-detail ? parent.height * 0.08 : 0px;
        width: root.shown-value == ""
            ? max(0px, root.value-right - 14px)
            : max(0px, value-text.x - 20px);
        height: root.has-detail ? parent.height * 0.50 : parent.height;
        label: root.title;
        text-color: root.armed ? Theme.on-error-container : root.selected ? Theme.text : #d0d3d8;
        text-size: 17px;
        text-weight: root.selected || root.emphasized ? 600 : 500;
        active: root.selected;
    }

    MarqueeText {
        x: 14px;
        y: parent.height * 0.56;
        width: title-text.width;
        height: parent.height * 0.36;
        label: root.detail;
        text-color: root.armed ? Theme.on-error-container : Theme.text-faint;
        text-weight: root.armed ? 600 : 400;
        text-size: 12px;
        active: root.selected;
        visible: root.has-detail;
    }
}

component SettingsActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    /* Waiting for the confirming press: error roles, the action name with
     * the prompt on a second line inside the button. */
    in property <bool> armed: false;
    in property <string> prompt: "";
    property <bool> two-lines: root.armed && root.prompt != "";

    /* M3 common button, full shape: tonal at rest, filled when focused;
     * destructive actions use the error roles. */
    border-radius: self.height / 2;
    background: root.armed ? Theme.error-container
        : root.danger
        ? (root.selected ? Theme.error : Theme.error-container)
        : (root.selected ? Theme.primary : Theme.primary-container);
    border-width: root.armed ? 2px : 0px;
    border-color: Theme.error;
    opacity: root.enabled ? 1.0 : 0.38;

    MarqueeText {
        x: 16px;
        y: root.two-lines ? parent.height * 0.08 : 0px;
        width: parent.width - 32px;
        height: root.two-lines ? parent.height * 0.50 : parent.height;
        label: root.label;
        text-color: root.armed ? Theme.on-error-container
            : root.danger
            ? (root.selected ? #690005 : Theme.on-error-container)
            : (root.selected ? Theme.on-primary : Theme.on-primary-container);
        text-size: root.two-lines ? 15px : 16px;
        text-weight: 600;
        align-center: true;
        active: root.selected;
    }
    if root.two-lines: MarqueeText {
        x: 16px;
        y: parent.height * 0.54;
        width: parent.width - 32px;
        height: parent.height * 0.36;
        label: root.prompt;
        text-color: Theme.on-error-container;
        text-size: 11px;
        text-weight: 500;
        align-center: true;
    }
}

/* Settings empty-state / helper line, aligned to the row grid. */
component SettingsHint inherits Text {
    horizontal-alignment: center;
    vertical-alignment: center;
    color: Theme.text-faint;
    font-size: 13px;
    wrap: word-wrap;
}

component StartActionHint inherits Rectangle {
    width: 50px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "START";
        color: Theme.text;
        font-size: 11px;
        font-weight: 800;
    }
}

component NavigationHint inherits Rectangle {
    width: 28px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "↕";
        color: Theme.text;
        font-size: 18px;
        font-weight: 800;
    }
}

component FaceButtonHint inherits Rectangle {
    in property <int> active-position: -1;

    width: 28px;
    height: 28px;
    background: #00000000;

    Rectangle {
        x: 10px;
        y: 1px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 0 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 0 ? Theme.accent-light : Theme.text-disabled;
    }
    Rectangle {
        x: 19px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 1 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 1 ? Theme.accent-light : Theme.text-disabled;
    }
    Rectangle {
        x: 10px;
        y: 19px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 2 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 2 ? Theme.accent-light : Theme.text-disabled;
    }
    Rectangle {
        x: 1px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 3 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 3 ? Theme.accent-light : Theme.text-disabled;
    }
}


/* One controller hint: keycap + label. Bars are HorizontalLayouts of these,
 * so spacing always follows the real width of localized labels. */
component ActionHint inherits HorizontalLayout {
    in property <string> kind: "face";
    in property <int> face-position: -1;
    in property <string> label: "";
    spacing: 8px;
    alignment: start;
    horizontal-stretch: 0;

    VerticalLayout {
        alignment: center;
        if root.kind == "nav": NavigationHint { }
        if root.kind == "start": StartActionHint { }
        if root.kind == "menu": MenuActionHint { }
        if root.kind == "face": FaceButtonHint { active-position: root.face-position; }
    }
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: 16px;
        font-weight: 500;
        vertical-alignment: center;
    }
}

/* Input Tester controller drawing.
 *
 * A generic, brand-free pad drawn on a 360x200 design grid scaled by `u`
 * (the largest unit that fits the given box), so every layout class gets
 * the same proportions without a master-canvas bitmap. Pressed controls
 * take the primary colour; triggers fill with their analog travel and
 * sticks move their knob with the logical value (-100..100). */
component TesterShoulder inherits Rectangle {
    in property <string> label;
    /* 0..100: analog travel (digital sources report 0 or 100). */
    in property <int> level: 0;
    in property <length> u: 1px;
    property <bool> active: root.level > 0;

    border-radius: 7 * root.u;
    background: Theme.surface-container-highest;
    border-width: 1px;
    border-color: root.active ? Theme.primary : Theme.outline-variant;

    /* Analog travel; rounded itself because the software renderer clips
     * to rectangles only. */
    Rectangle {
        x: 0; y: 0;
        width: parent.width * clamp(root.level, 0, 100) / 100;
        height: parent.height;
        border-radius: min(parent.border-radius, self.width / 2);
        background: Theme.primary;
    }
    Text {
        text: root.label;
        color: root.level >= 50 ? Theme.on-primary : Theme.text;
        font-size: max(10px, 11 * root.u);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TesterFaceButton inherits Rectangle {
    in property <bool> pressed: false;
    border-radius: self.width / 2;
    background: root.pressed ? Theme.primary : Theme.surface-container-highest;
    border-width: 1px;
    border-color: root.pressed ? Theme.primary : Theme.outline;
}

component TesterDpadArm inherits Rectangle {
    in property <bool> pressed: false;
    /* Triangle pointing away from the centre, in a 10x10 viewbox. */
    in property <string> arrow;
    background: root.pressed ? Theme.primary : Theme.surface-container-highest;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width, parent.height) * 0.5;
        height: self.width;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.arrow;
        fill: root.pressed ? Theme.on-primary : Theme.text-dim;
    }
}

component TesterStick inherits Rectangle {
    in property <int> axis-x: 0;
    in property <int> axis-y: 0;
    in property <bool> pressed: false;
    property <bool> moved: abs(root.axis-x) > 8 || abs(root.axis-y) > 8;
    property <length> knob: root.width * 0.48;
    property <length> travel: (root.width - root.knob) / 2 - 2px;

    border-radius: self.width / 2;
    background: Theme.surface-container-low;
    border-width: root.moved || root.pressed ? 2px : 1px;
    border-color: root.moved || root.pressed ? Theme.primary : Theme.outline;

    /* Crosshair: rest position reference. */
    Rectangle { x: parent.width * 0.2; y: parent.height / 2; width: parent.width * 0.6; height: 1px; background: Theme.outline-variant; }
    Rectangle { x: parent.width / 2; y: parent.height * 0.2; width: 1px; height: parent.height * 0.6; background: Theme.outline-variant; }

    Rectangle {
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        x: (parent.width - root.knob) / 2 + root.travel * clamp(root.axis-x, -100, 100) / 100;
        y: (parent.height - root.knob) / 2 + root.travel * clamp(root.axis-y, -100, 100) / 100;
        background: root.pressed ? Theme.primary : root.moved ? Theme.primary-container : Theme.surface-container-highest;
        border-width: 1px;
        border-color: root.moved || root.pressed ? Theme.primary : Theme.outline;
    }
}

component TesterPill inherits Rectangle {
    in property <string> label;
    in property <bool> pressed: false;
    in property <length> u: 1px;

    background: #00000000;
    Rectangle {
        x: (parent.width - self.width) / 2; y: 0;
        width: 30 * root.u; height: 12 * root.u;
        border-radius: self.height / 2;
        background: root.pressed ? Theme.primary : Theme.surface-container-highest;
        border-width: 1px;
        border-color: root.pressed ? Theme.primary : Theme.outline;
    }
    Text {
        y: 15 * root.u;
        width: parent.width;
        text: root.label;
        color: root.pressed ? Theme.primary : Theme.text-dim;
        font-size: max(8px, 8 * root.u);
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component ControllerTesterVisual inherits Rectangle {
    in property <bool> face-south: false;
    in property <bool> face-east: false;
    in property <bool> face-north: false;
    in property <bool> face-west: false;
    in property <bool> dpad-up: false;
    in property <bool> dpad-down: false;
    in property <bool> dpad-left: false;
    in property <bool> dpad-right: false;
    in property <bool> l1: false;
    in property <bool> r1: false;
    in property <bool> l2: false;
    in property <bool> r2: false;
    in property <bool> l3: false;
    in property <bool> r3: false;
    in property <bool> start: false;
    in property <bool> select: false;
    in property <bool> hotkey: false;
    in property <int> left-x: 0;
    in property <int> left-y: 0;
    in property <int> right-x: 0;
    in property <int> right-y: 0;
    in property <int> left-trigger: 0;
    in property <int> right-trigger: 0;

    /* Design grid unit and the centred grid origin. */
    property <length> u: min(root.width / 360, root.height / 200, 2.2px);
    property <length> ox: (root.width - 360 * root.u) / 2;
    property <length> oy: 0;
    /* Height the drawing needs at this width (pages place content below). */
    out property <length> drawn-height: 200 * root.u;

    background: #00000000;

    /* Shoulders sit behind the top edge of the body. */
    TesterShoulder { x: root.ox + 34 * root.u; y: root.oy + 2 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "L2"; level: max(root.l2 ? 100 : 0, root.left-trigger); }
    TesterShoulder { x: root.ox + 98 * root.u; y: root.oy + 8 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "L1"; level: root.l1 ? 100 : 0; }
    TesterShoulder { x: root.ox + 204 * root.u; y: root.oy + 8 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "R1"; level: root.r1 ? 100 : 0; }
    TesterShoulder { x: root.ox + 268 * root.u; y: root.oy + 2 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "R2"; level: max(root.r2 ? 100 : 0, root.right-trigger); }

    /* Body. */
    Rectangle {
        x: root.ox + 14 * root.u; y: root.oy + 34 * root.u;
        width: 332 * root.u; height: 164 * root.u;
        border-radius: 46 * root.u;
        background: Theme.surface-container;
        border-width: 1px;
        border-color: Theme.outline-variant;
    }

    /* D-pad: a cross whose arms light individually. */
    Rectangle {
        x: root.ox + 50 * root.u; y: root.oy + 54 * root.u;
        width: 72 * root.u; height: 72 * root.u;
        border-radius: 36 * root.u;
        background: Theme.surface-container-low;
    }
    TesterDpadArm { x: root.ox + 74 * root.u; y: root.oy + 58 * root.u; width: 24 * root.u; height: 25 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-up; arrow: "M5 1.5 L8.5 7 L1.5 7 Z"; }
    TesterDpadArm { x: root.ox + 74 * root.u; y: root.oy + 97 * root.u; width: 24 * root.u; height: 25 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-down; arrow: "M5 8.5 L8.5 3 L1.5 3 Z"; }
    TesterDpadArm { x: root.ox + 54 * root.u; y: root.oy + 78 * root.u; width: 25 * root.u; height: 24 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-left; arrow: "M1.5 5 L7 1.5 L7 8.5 Z"; }
    TesterDpadArm { x: root.ox + 93 * root.u; y: root.oy + 78 * root.u; width: 25 * root.u; height: 24 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-right; arrow: "M8.5 5 L3 1.5 L3 8.5 Z"; }
    Rectangle { x: root.ox + 78 * root.u; y: root.oy + 82 * root.u; width: 16 * root.u; height: 16 * root.u;
        background: Theme.surface-container-highest; }

    /* Face cluster by position, never by brand letter. */
    Rectangle {
        x: root.ox + 238 * root.u; y: root.oy + 54 * root.u;
        width: 72 * root.u; height: 72 * root.u;
        border-radius: 36 * root.u;
        background: Theme.surface-container-low;
    }
    TesterFaceButton { x: root.ox + 262 * root.u; y: root.oy + 56 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-north; }
    TesterFaceButton { x: root.ox + 284 * root.u; y: root.oy + 78 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-east; }
    TesterFaceButton { x: root.ox + 262 * root.u; y: root.oy + 100 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-south; }
    TesterFaceButton { x: root.ox + 240 * root.u; y: root.oy + 78 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-west; }

    /* System buttons (legends are physical button names, not UI text). */
    TesterPill { x: root.ox + 128 * root.u; y: root.oy + 56 * root.u; width: 36 * root.u; height: 28 * root.u; u: root.u;
        label: "SELECT"; pressed: root.select; }
    TesterPill { x: root.ox + 162 * root.u; y: root.oy + 56 * root.u; width: 36 * root.u; height: 28 * root.u; u: root.u;
        label: "H"; pressed: root.hotkey; }
    TesterPill { x: root.ox + 196 * root.u; y: root.oy + 56 * root.u; width: 36 * root.u; height: 28 * root.u; u: root.u;
        label: "START"; pressed: root.start; }

    /* Sticks; pressing them is L3/R3. */
    TesterStick { x: root.ox + 118 * root.u; y: root.oy + 116 * root.u; width: 54 * root.u; height: 54 * root.u;
        axis-x: root.left-x; axis-y: root.left-y; pressed: root.l3; }
    TesterStick { x: root.ox + 188 * root.u; y: root.oy + 116 * root.u; width: 54 * root.u; height: 54 * root.u;
        axis-x: root.right-x; axis-y: root.right-y; pressed: root.r3; }
    Text { x: root.ox + 118 * root.u; y: root.oy + 172 * root.u; width: 54 * root.u; text: "L3";
        color: root.l3 ? Theme.primary : Theme.text-dim; font-size: max(8px, 8 * root.u); font-weight: 700; horizontal-alignment: center; }
    Text { x: root.ox + 188 * root.u; y: root.oy + 172 * root.u; width: 54 * root.u; text: "R3";
        color: root.r3 ? Theme.primary : Theme.text-dim; font-size: max(8px, 8 * root.u); font-weight: 700; horizontal-alignment: center; }
}


/* Home / Game Library cards (EPIC-001 Home, EPIC-011 browsing).
 *
 * One entry model for every Home row and the library grid. Rust fills it
 * from the nuubos-libraryd snapshot; Slint owns every pixel position.
 *   kind: 0 game, 1 favorites, 2 custom collection, 3 system, 4 application
 *   aspect: card width / height (real cover proportions when the cover is
 *           loaded, the system box-art shape otherwise)
 *   accent: system colour from the registry (not painted by the minimal Home)
 *   x-units: sum of the aspects of the cards before this one in its row,
 *            so variable-width rows are positioned without layout passes. */
export struct HomeCard {
    key: string,
    kind: int,
    title: string,
    detail: string,
    system-name: string,
    cover-path: string,
    cover: image,
    has-cover: bool,
    aspect: float,
    x-units: float,
    accent: color,
    available: bool,
    favorite: bool,
}

/* Five-point star, own geometry (no third-party icon). */
component HomeStar inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M12 1.6 L15.2 8.5 L22.6 9.3 L17.1 14.3 L18.6 21.6 L12 17.9 L5.4 21.6 L6.9 14.3 L1.4 9.3 L8.8 8.5 Z";
    fill: #ffc94a;
    stroke: Theme.background;
    stroke-width: 1px;
}

/* Stacked-cards glyph for custom collections, drawn from rectangles. */
component HomeCollectionGlyph inherits Rectangle {
    in property <color> ink: #c9d6ff;
    background: #00000000;
    Rectangle {
        x: parent.width * 0.22; y: 0; width: parent.width * 0.78; height: parent.height * 0.78;
        border-radius: 3px; border-width: 2px; border-color: root.ink; background: #00000000;
    }
    Rectangle {
        x: 0; y: parent.height * 0.22; width: parent.width * 0.78; height: parent.height * 0.78;
        border-radius: 3px; background: root.ink;
    }
}

/* One Home/library card. The focus treatment (blue ring + soft glow) is
 * drawn outside the card bounds, separated from it by a thin gap, so
 * containers keep a small inset. Covers arrive pre-scaled with rounded
 * corners (Rust cover loader): the software renderer does not clip images
 * to border-radius.
 * Minimal and cheap for the software renderer: every face is one flat
 * matte surface (no gradients, no extra blended layers), so the cover art
 * and the focus ring are the only colour on screen. Games show their cover
 * (or a titled placeholder); tiles (favorites, collections, systems,
 * applications) show a centred monochrome icon + name. Tiles of an
 * unselected row recede through their ink colour. */
component HomeCardView inherits Rectangle {
    in property <HomeCard> card;
    in property <bool> focused: false;
    in property <bool> dimmed: false;
    in property <string> unavailable-label: "";

    /* M3 medium shape; the Rust cover loader rounds covers the same way. */
    property <length> radius: max(Shape.medium, root.height * 0.06);
    property <bool> tile: root.card.kind != 0;
    property <length> icon-size: min(root.height * 0.42, root.width * 0.50);
    property <length> inset: max(6px, min(root.width, root.height) * 0.07);
    /* Tile icon/label colour: unselected rows recede without an extra
     * blended layer. */
    property <color> ink: root.dimmed ? #6f757e : root.focused ? Theme.on-secondary-container : #c9cdd3;

    background: #00000000;

    /* Glow + ring, detached from the card by a dark gap. */
    Rectangle {
        x: -9px; y: -9px; width: parent.width + 18px; height: parent.height + 18px;
        border-radius: root.radius + 9px;
        background: #00000000;
        border-width: 4px;
        border-color: Theme.accent.transparentize(0.8);
        visible: root.focused;
    }
    Rectangle {
        x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px;
        border-radius: root.radius + 6px;
        background: #00000000;
        border-width: 3px;
        border-color: Theme.primary;
        visible: root.focused;
    }

    /* Placeholder / tile face. */
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: root.focused ? Theme.secondary-container : Theme.surface-container;
        visible: root.tile || !root.card.has-cover;
        border-width: 1px;
        border-color: root.focused ? Theme.secondary-container : Theme.surface-container;

        /* Game placeholder: title in the lower-left corner. */
        if !root.tile: Text {
            x: root.inset; y: root.inset;
            width: parent.width - 2 * root.inset; height: parent.height - 2 * root.inset;
            text: root.card.title;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: left;
            vertical-alignment: bottom;
            color: Theme.text;
            font-size: max(11px, min(parent.width * 0.08, parent.height * 0.07));
            font-weight: 700;
        }

        /* Tile icon. */
        if root.card.kind == 1: HomeStar {
            x: (parent.width - root.icon-size) / 2; y: parent.height * 0.14;
            width: root.icon-size; height: root.icon-size;
        }
        if root.card.kind == 2: HomeCollectionGlyph {
            x: (parent.width - root.icon-size * 0.86) / 2; y: parent.height * 0.14 + root.icon-size * 0.07;
            width: root.icon-size * 0.86; height: root.icon-size * 0.80;
            ink: root.ink;
        }
        if (root.card.kind == 3 || root.card.kind == 4) && root.card.has-cover: Image {
            x: (parent.width - root.icon-size) / 2; y: parent.height * 0.14;
            width: root.icon-size; height: root.icon-size;
            source: root.card.cover;
            image-fit: contain;
            colorize: root.card.kind == 3 ? root.ink : #00000000;
        }
        if (root.card.kind == 3 || root.card.kind == 4) && !root.card.has-cover: Image {
            x: (parent.width - root.icon-size * 0.8) / 2; y: parent.height * 0.14 + root.icon-size * 0.1;
            width: root.icon-size * 0.8; height: root.icon-size * 0.8;
            source: @image-url("assets/icons/gamepad.svg");
            colorize: root.ink;
            image-fit: contain;
        }
        if root.tile: Text {
            x: parent.width * 0.06; y: parent.height * 0.66;
            width: parent.width * 0.88; height: parent.height * 0.24;
            text: root.card.title;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.ink;
            font-size: max(13px, parent.height * 0.12);
            font-weight: 500;
        }
    }

    /* Real cover art, already shaped to the card. */
    if !root.tile && root.card.has-cover: Image {
        width: parent.width; height: parent.height;
        source: root.card.cover;
        image-fit: fill;
    }

    if !root.tile && root.card.favorite: HomeStar {
        x: parent.width - self.width - max(4px, parent.width * 0.04);
        y: max(4px, parent.width * 0.04);
        width: max(14px, min(parent.width, parent.height) * 0.14);
        height: self.width;
    }

    /* UNAVAILABLE: entry kept, clearly marked (EPIC-011) with a compact
     * badge in the top-left corner over the faded art. */
    if !root.tile && !root.card.available: Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: #0d0e10a0;
        Rectangle {
            property <length> label-size: max(10px, min(14px, parent.height * 0.08));
            x: root.inset; y: root.inset;
            width: min(parent.width - 2 * root.inset, badge-text.preferred-width + self.label-size * 1.4);
            height: self.label-size * 1.9;
            border-radius: self.height / 2;
            background: #0d0e10e0;
            border-width: 1px;
            border-color: #3a3e45;
            badge-text := Text {
                x: parent.label-size * 0.7; width: parent.width - parent.label-size * 1.4; height: parent.height;
                text: root.unavailable-label;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #c9cdd3;
                font-size: parent.label-size;
                font-weight: 600;
            }
        }
    }

}

/* Compact shelf tile (systems, collections, Favorites, applications):
 * icon, name and count on one tonal chip, so the shelves stay small and
 * the game covers keep the screen. Same focus ring as the cards. */
component HomeChipView inherits Rectangle {
    in property <HomeCard> card;
    in property <bool> focused: false;
    in property <bool> dimmed: false;
    in property <float> s: 1.0;

    property <length> radius: Shape.medium;
    property <length> icon-size: root.height * 0.52;
    property <length> icon-x: (root.height - root.icon-size) / 2 + 2px * root.s;
    property <color> ink: root.dimmed ? #6f757e : root.focused ? Theme.on-secondary-container : #c9cdd3;

    background: #00000000;

    Rectangle {
        x: -9px; y: -9px; width: parent.width + 18px; height: parent.height + 18px;
        border-radius: root.radius + 9px;
        background: #00000000;
        border-width: 4px;
        border-color: Theme.accent.transparentize(0.8);
        visible: root.focused;
    }
    Rectangle {
        x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px;
        border-radius: root.radius + 6px;
        background: #00000000;
        border-width: 3px;
        border-color: Theme.primary;
        visible: root.focused;
    }

    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: root.focused ? Theme.secondary-container : Theme.surface-container;

        if root.card.kind == 1: HomeStar {
            x: root.icon-x; y: (parent.height - root.icon-size) / 2;
            width: root.icon-size; height: root.icon-size;
        }
        if root.card.kind == 2: HomeCollectionGlyph {
            x: root.icon-x + root.icon-size * 0.07; y: (parent.height - root.icon-size * 0.8) / 2;
            width: root.icon-size * 0.86; height: root.icon-size * 0.80;
            ink: root.ink;
        }
        if root.card.kind >= 3 && root.card.has-cover: Image {
            x: root.icon-x; y: (parent.height - root.icon-size) / 2;
            width: root.icon-size; height: root.icon-size;
            source: root.card.cover;
            image-fit: contain;
            colorize: root.card.kind == 3 ? root.ink : #00000000;
        }
        if root.card.kind >= 3 && !root.card.has-cover: Image {
            x: root.icon-x + root.icon-size * 0.1; y: (parent.height - root.icon-size * 0.8) / 2;
            width: root.icon-size * 0.8; height: root.icon-size * 0.8;
            source: @image-url("assets/icons/gamepad.svg");
            colorize: root.ink;
            image-fit: contain;
        }

        VerticalLayout {
            x: root.icon-x + root.icon-size + 10px * root.s;
            width: parent.width - self.x - 10px * root.s;
            height: parent.height;
            alignment: center;
            spacing: 0px;
            MarqueeText {
                height: 20px * root.s;
                label: root.card.title;
                text-color: root.dimmed ? #8a9099 : root.focused ? Theme.on-secondary-container : Theme.text;
                text-size: 15px * root.s;
                text-weight: 600;
                active: root.focused;
            }
            if root.card.detail != "": Text {
                height: 16px * root.s;
                text: root.card.detail;
                overflow: elide;
                vertical-alignment: center;
                color: root.dimmed ? #6f757e : Theme.text-secondary;
                font-size: 12px * root.s;
            }
        }
    }
}

/* Section title; the selected section carries the nuubOS blue bar. */
component HomeSectionTitle inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> label-size: 17px;
    in property <string> status: "";
    in property <color> status-color: Theme.text-faint;
    property <length> status-w: min(root.width * 0.55, root.label-size * 22);

    background: #00000000;
    Rectangle {
        x: 0; y: (parent.height - self.height) / 2; width: 4px; height: root.label-size * 1.05;
        border-radius: 2px;
        background: Theme.primary;
        visible: root.active;
    }
    Text {
        x: root.active ? 12px : 0px;
        y: 0; width: parent.width - self.x - (root.status != "" ? root.status-w + 8px : 0px); height: parent.height;
        text: root.label;
        vertical-alignment: center;
        overflow: elide;
        color: root.active ? Theme.text : #6f757e;
        font-size: root.label-size;
        font-weight: root.active ? 600 : 500;
    }
    if root.status != "": Text {
        x: parent.width - root.status-w; y: 0; width: root.status-w; height: parent.height;
        text: root.status;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        color: root.status-color;
        font-size: root.label-size * 0.86;
    }
}

/* Title + metadata of the focused card, shown under the covers. */
component HomeFocusInfo inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> notice: "";
    in property <float> s: 1.0;
    in property <bool> dimmed: false;

    background: #00000000;
    MarqueeText {
        x: 0; y: 0; width: parent.width; height: 26px * root.s;
        label: root.title;
        active: !root.dimmed;
        text-color: root.dimmed ? Theme.text-secondary : Theme.text;
        text-size: 22px * root.s;
        text-weight: 600;
    }
    MarqueeText {
        x: 0; y: 26px * root.s; width: parent.width; height: 20px * root.s;
        label: root.notice != "" ? root.notice : root.detail;
        active: !root.dimmed;
        text-color: root.notice != "" ? #ffc94a : root.dimmed ? Theme.text-faint : Theme.text-secondary;
        text-size: 15px * root.s;
        text-weight: 400;
    }
}

/* Empty Home section (M3 empty state on an outlined card): an icon, a
 * playful headline and one supporting line, so a fresh console invites to
 * play instead of hiding the section. It takes focus like a card. */
component HomeEmptyCard inherits Rectangle {
    in property <string> headline;
    in property <string> body;
    /* 0 controller (games), 1 shelf (systems), 2 apps. */
    in property <int> icon: 0;
    in property <bool> focused: false;
    in property <bool> dimmed: false;
    in property <float> s: 1.0;

    property <length> radius: max(Shape.medium, root.height * 0.06);
    property <bool> roomy: root.height >= 120px * root.s;
    /* As high as a shelf chip: headline and body on one line each. */
    property <bool> compact: root.height < 64px * root.s;
    property <length> icon-size: root.roomy ? min(root.height * 0.34, 64px * root.s)
        : root.compact ? root.height * 0.40 : min(root.height * 0.46, 36px * root.s);
    property <color> ink: root.dimmed ? #6f757e : Theme.text;

    background: #00000000;

    Rectangle {
        x: -9px; y: -9px; width: parent.width + 18px; height: parent.height + 18px;
        border-radius: root.radius + 9px;
        background: #00000000;
        border-width: 4px;
        border-color: Theme.accent.transparentize(0.8);
        visible: root.focused;
    }
    Rectangle {
        x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px;
        border-radius: root.radius + 6px;
        background: #00000000;
        border-width: 3px;
        border-color: Theme.primary;
        visible: root.focused;
    }

    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: root.focused ? Theme.secondary-container : Theme.surface-container-low;
        border-width: 1px;
        border-color: root.focused ? Theme.secondary-container : Theme.outline-variant;

        /* Icon in a tonal circle, text beside it. */
        icon-bubble := Rectangle {
            property <length> d: root.compact ? root.height * 0.72 : root.icon-size * 1.5;
            x: root.roomy ? 24px * root.s : root.compact ? (parent.height - self.d) / 2 : 14px * root.s;
            y: (parent.height - self.d) / 2;
            width: self.d; height: self.d;
            border-radius: self.d / 2;
            background: root.dimmed ? Theme.surface-container : Theme.primary-container;

            property <color> glyph: root.dimmed ? #6f757e : Theme.on-primary-container;
            if root.icon == 0: Image {
                x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2;
                width: root.icon-size; height: root.icon-size;
                source: @image-url("assets/icons/gamepad.svg");
                colorize: icon-bubble.glyph;
                image-fit: contain;
            }
            /* Folder and app grid: own geometry (no third-party icon). */
            if root.icon == 1: Path {
                x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2;
                width: root.icon-size; height: root.icon-size;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M2 5.5 C2 4.7 2.7 4 3.5 4 L9 4 L11 6 L20.5 6 C21.3 6 22 6.7 22 7.5 L22 18.5 C22 19.3 21.3 20 20.5 20 L3.5 20 C2.7 20 2 19.3 2 18.5 Z";
                fill: icon-bubble.glyph;
            }
            if root.icon == 2: Path {
                x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2;
                width: root.icon-size; height: root.icon-size;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M3 3 L10.5 3 L10.5 10.5 L3 10.5 Z M13.5 3 L21 3 L21 10.5 L13.5 10.5 Z M3 13.5 L10.5 13.5 L10.5 21 L3 21 Z M13.5 13.5 L21 13.5 L21 21 L13.5 21 Z";
                fill: icon-bubble.glyph;
            }
        }

        VerticalLayout {
            x: icon-bubble.x + icon-bubble.width + (root.roomy ? 20px : 14px) * root.s;
            y: 0;
            width: parent.width - self.x - 20px * root.s;
            height: parent.height;
            alignment: center;
            spacing: (root.compact ? 1px : 6px) * root.s;

            Text {
                text: root.headline;
                color: root.ink;
                font-size: (root.roomy ? 22px : root.compact ? 15px : 18px) * root.s;
                font-weight: 600;
                wrap: root.compact ? no-wrap : word-wrap;
                overflow: elide;
            }
            Text {
                text: root.body;
                color: root.dimmed ? #6f757e : Theme.text-secondary;
                font-size: (root.roomy ? 15px : root.compact ? 12px : 13px) * root.s;
                wrap: root.compact ? no-wrap : word-wrap;
                overflow: elide;
                max-height: (root.roomy ? 3 : 2) * 20px * root.s;
            }
        }
    }
}

/* One Home section: title and a horizontal strip. Recently Played shows
 * covers (card-h tall, width from the cover aspect) with the focused
 * game's title + metadata in a fixed band under them (info-h, also while
 * another section is selected, dimmed, so nothing moves); the shelves
 * show compact chips (chip-w > 0). The focused item is kept at the left
 * edge (console catalogue style) until the end of the strip. Notices of
 * the selected section go to the right of its title. */
component HomeRow inherits Rectangle {
    in property <string> label;
    in property <[HomeCard]> cards;
    in property <int> index: 0;
    in property <bool> active: false;
    in property <length> card-h;
    in property <length> chip-w: 0px;
    in property <length> label-h;
    in property <length> info-h: 0px;
    in property <length> pad;
    in property <length> gap;
    in property <float> s: 1.0;
    in property <string> notice: "";
    in property <string> status: "";
    in property <string> unavailable-label;
    /* Shown instead of the cards when the row is empty. */
    in property <string> empty-headline;
    in property <string> empty-body;
    in property <int> empty-icon: 0;

    property <bool> empty: root.cards.length == 0;
    property <bool> chips: root.chip-w > 0px;
    property <length> focus-x: root.chips ? root.index * (root.chip-w + root.gap)
        : root.cards[root.index].x-units * root.card-h + root.index * root.gap;
    property <HomeCard> last: root.cards[root.cards.length - 1];
    property <HomeCard> focused: root.cards[root.index];
    property <length> total-w: root.chips ? root.cards.length * (root.chip-w + root.gap) - root.gap
        : (root.last.x-units + root.last.aspect) * root.card-h + (root.cards.length - 1) * root.gap;
    property <length> h-scroll: max(0px, min(root.focus-x, root.total-w - (root.width - 2 * root.pad)));
    /* Info shows in the title bar when this row has no info band. */
    property <bool> title-notice: root.active && root.notice != "" && (root.chips || root.empty);

    height: root.label-h + root.card-h + root.info-h;
    background: #00000000;

    HomeSectionTitle {
        x: root.pad; y: 0; width: parent.width - 2 * root.pad; height: root.label-h - 6px * root.s;
        label: root.label;
        active: root.active;
        label-size: 16px * root.s;
        status: root.title-notice ? root.notice : root.active ? root.status : "";
        status-color: root.title-notice ? #ffc94a : Theme.text-faint;
    }

    /* Strip with 10 px above/below the cards for the focus glow. */
    Rectangle {
        x: 0; y: root.label-h - 10px; width: parent.width; height: root.card-h + 20px;
        clip: true;
        background: #00000000;

        Rectangle {
            x: root.pad - root.h-scroll; y: 10px; width: root.total-w; height: root.card-h;
            background: #00000000;
            animate x { duration: 180ms; easing: ease-out; }

            for card[i] in root.cards: Rectangle {
                x: root.chips ? i * (root.chip-w + root.gap) : card.x-units * root.card-h + i * root.gap;
                y: 0;
                width: root.chips ? root.chip-w : card.aspect * root.card-h;
                height: root.card-h;
                background: #00000000;

                if !root.chips: HomeCardView {
                    width: parent.width; height: parent.height;
                    card: card;
                    focused: root.active && i == root.index;
                    dimmed: !root.active;
                    unavailable-label: root.unavailable-label;
                }
                if root.chips: HomeChipView {
                    width: parent.width; height: parent.height;
                    card: card;
                    focused: root.active && i == root.index;
                    dimmed: !root.active;
                    s: root.s;
                }
            }
        }
    }

    /* An empty row has no info band: its card already says it all. */
    if root.empty: HomeEmptyCard {
        x: root.pad; y: root.label-h;
        width: parent.width - 2 * root.pad;
        height: root.card-h + root.info-h;
        headline: root.empty-headline;
        body: root.empty-body;
        icon: root.empty-icon;
        focused: root.active;
        dimmed: !root.active;
        s: root.s;
    }

    if root.info-h > 0px && !root.empty: HomeFocusInfo {
        x: root.pad; y: root.label-h + root.card-h + 6px * root.s;
        width: parent.width - 2 * root.pad; height: root.info-h - 6px * root.s;
        title: root.focused.title;
        detail: root.focused.detail;
        notice: root.active ? root.notice : "";
        dimmed: !root.active;
        s: root.s;
    }
}

/* Power dialog choice (M3 tonal button). Armed = waiting for the
 * confirming press: error roles, the prompt under the action name inside
 * the button. */
export component HomeWindow inherits Window {
    /*
     * Two-stage lifecycle transition.
     *
     * line-progress:
     *   0 = branded separator line at its normal splash width
     *   1 = line spans the complete screen width
     *
     * curtain-progress:
     *   0 = lifecycle raster closed/full-screen
     *   1 = top/bottom raster halves fully open off-screen
     */
    in-out property <float> line-progress: 0.0;
    in-out property <float> curtain-progress: 0.0;
    in-out property <string> transition-mode: "boot";
    in-out property <image> splash-image;
    in-out property <float> splash-split: 0.485;
    in-out property <float> splash-line-fraction: 0.483;
    in-out property <length> splash-line-height: 3px;
    /* Rust re-renders the splash whenever the surface size changes while
     * the curtain is on screen (first configure, HDMI hotplug). */
    callback splash-size-changed();
    changed width => { if (root.curtain-progress < 0.999) { root.splash-size-changed(); } }
    changed height => { if (root.curtain-progress < 0.999) { root.splash-size-changed(); } }
    in-out property <[string]> i18n-strings: ["Recently Played", "Systems & Collections", "Copy your games to the roms folder on the SD card, one folder per system.", "Settings", "General", "Connectivity", "Controllers & Input", "Display & Audio", "System", "Connect to Wi-Fi", "Saved Networks", "Connect New Device", "My Devices", "Player Assignment", "Controllers", "Input Tester", "Controller Mapping", "Internal Rumble", "RGB Lighting", "Storage", "System Information", "Restore Defaults", "Profiles, language and time", "Scanning nearby networks…", "Refreshing nearby networks…", "Choose a network or add a hidden network", "Saved device-global Wi-Fi networks", "Password is hidden while typing", "Controller or physical keyboard", "Scanning nearby Bluetooth devices…", "Choose a nearby Bluetooth device", "Paired and connected Bluetooth devices", "Preferred slots are compacted when a controller is unavailable", "Available built-in, USB and Bluetooth controllers", "All buttons and axes • Hotkey + Start to exit", "Press the new button now…", "Select an action to remap", "User preference for the internal console rumble", "Screen Reactive • follows compositor color feed", "User RGB baseline and system effects", "Device-global user storage", "Live read-only device information", "Reset System settings without deleting user content", "Sections", "User & Profile", "Language & Region", "Date & Time", "Rumble & RGB", "Updates & Recovery", "SYSTEM", "Performance Profile", "Battery Saver", "Auto", "Automatic Battery Saver", "Off", "Screensaver After", "Sleep After", "After screensaver", "Power Off", "After Sleep • RTC wake unavailable", "After Sleep", "After Screensaver", "Active Storage", "User Data", "SD2", "Not inserted", "Ready", "Available", "Not yet managed by nuubOS", "Automatic Backup", "Daily", "Weekly", "Monthly", "Backup completed", "Backup due", "Clock unavailable", "Clock check needed", "Move User Data to SD1", "Use SD2 for User Data", "Move User Data to SD2", "Working…", "Insert SD2", "Confirm", "Erase & migrate", "Sync & switch", "Activate", "Press again • SD2 will be erased", "Press again • sync & switch to SD1", "Back Up Now", "Requires active SD2", "Storage Job", "Running", "Completed", "Failed", "Idle", "Move to SD2", "Move to SD1", "Back Up to SD1", "Device", "Kernel", "Battery", "CPU", "GPU", "Network", "RAM", "Uptime", "Restores power, display, audio, backup and controller mapping settings to their defaults.", "Games, BIOS, saves, users and network settings are kept.", "Press again to reset system settings", "Reset System Settings", "CONTROLLERS & INPUT", "P1–P8", "Enabled", "Disabled", "Solid", "Breathing", "Orbit", "Aurora", "Spectrum", "Battery Level", "Console Colors", "Speed", "Automatic", "Left Stick Deadzone", "Right Stick Deadzone", "Test Rumble", "Effect", "Brightness", "Color", "SYSTEM SIGNALS", "LIGHTING", "DISPLAY & AUDIO", "Internal display inactive", "Audio Output", "Volume", "Applications", "System Sounds", "Navigation Sounds", "Power Sounds", "Home Music", "Test Sound", "Stop", "Play", "Color Temperature", "Slow", "Normal", "Fast", "Startup & Sleep", "Connections", "Games", "Tasks", "Welcome, sleep, wake and power off", "Low battery, charging and full charge", "Controllers, headphones, Wi-Fi and USB drives", "Save states, screenshots and errors", "Downloads, backups and failures", "WI-FI", "Wi-Fi", "Connect", "Not connected", "BLUETOOTH", "Bluetooth", "Add Hidden Network", "Scanning…", "Searching for nearby networks…", "No saved Wi-Fi networks", "No new Bluetooth devices found", "No paired Bluetooth devices", "Pair & Connect", "Disconnect", "Forget Device", "Pair with PIN", "Password", "None", "Change", "IPv4", "Manual", "Address", "Subnet Mask", "Gateway", "DNS", "Apply Changes", "Forget Network", "Small System. Big Adventures.", "Navigate", "Select", "Back", "Menu", "POWER MENU", "Sleep", "Restart", "Press again to confirm", "Profile", "Language", "Theme", "Default theme", "Current user", "Interface langu