                        title: root.i18n-strings[51],
                        value: "",
                        detail: root.system-effective-profile != root.system-profile
                            ? root.i18n-strings[214] + (root.system-effective-profile == "battery-saver" ? root.i18n-strings[51] : root.i18n-strings[52])
                            : "",
                        nav: false, slider: false, fraction: 0, tog: true, on: root.system-profile == "battery-saver",
                    },
                    {
                        title: root.i18n-strings[53],
                        value: root.system-auto-battery-threshold <= 0 ? root.i18n-strings[54] : "≤ " + root.system-auto-battery-threshold + "%",
