    in-out property <string> system-storage-mode: root.i18n-strings[211];
    in-out property <string> system-storage-active: root.i18n-strings[211];
    in-out property <string> system-storage-health: root.i18n-strings[211];
    in-out property <string> system-tf2-state: root.i18n-strings[211];
    in-out property <string> system-tf2-cid: "";
    in-out property <string> system-storage-action-required: "NONE";
    in-out property <string> system-backup-policy: root.i18n-strings[211];
    in-out property <string> system-backup-due: root.i18n-strings[211];
    in-out property <string> system-backup-reason: root.i18n-strings[211];
