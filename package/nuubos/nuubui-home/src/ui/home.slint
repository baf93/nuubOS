                        : mapping.kind == 3 && root.controller-mapping-reset-armed ? root.i18n-strings[366]
                        : mapping.value;
                    selected: root.settings-view == 15 && root.controller-mapping-index == i;
                    visible: root.settings-view == 15
                        && root.srow-visible(i, root.controller-mapping-scroll-offset, root.settings-list-visible-rows);
                }

                /* Internal rumble. */
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(0, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[112];
                    toggle: true;
                    toggle-on: root.rumble-enabled;
                    selected: root.settings-view == 16 && root.rumble-index == 0;
                    visible: root.settings-view == 16;
                }
                SettingsSelectableRow {
                    x: root.settings-content-x; y: root.srow-y(1, 0, 0); width: root.settings-content-width; height: root.settings-row-height;
                    title: root.i18n-strings[125];
                    selected: root.settings-view == 16 && root.rumble-index == 1;
                    visible: root.settings-view == 16;
                }

                /* RGB Lighting. */
                for row[k] in [
                    { title: root.i18n-strings[126], value: root.lighting-mode-label, enabled: true, toggle: false },
                    { title: root.i18n-strings[127], value: root.lighting-brightness + "%", enabled: true, toggle: false },
                    {
                        title: root.i18n-strings[128],
                        value: root.lighting-color-capable ? root.lighting-color-name : root.i18n-strings[122],
                        enabled: root.lighting-color-capable,
                        toggle: false,
                    },
                    { title: root.i18n-strings[129], value: "", enabled: true, toggle: true },
                    { title: root.i18n-strings[130], value: "", enabled: true, toggle: false },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    toggle: row.toggle;
                    toggle-on: root.lighting-system-effects;
                    selected: root.settings-view == 17 && root.lighting-index == k;
                    visible: root.settings-view == 17
                        && root.srow-visible(k, 0, root.settings-list-visible-rows);
                }

                /* --------------------------------------------------- Display & Audio */
                for row[k] in [
                    {
                        title: root.i18n-strings[127],
                        value: root.display-brightness-available ? root.display-brightness + "%" : root.i18n-strings[132],
                        enabled: root.display-brightness-available, toggle: false, on: false, shown: true,
                    },
                    { title: root.i18n-strings[133], value: root.audio-output-label, enabled: true, toggle: false, on: false, shown: true },
                    {
                        title: root.i18n-strings[134],
                        value: root.audio-volume-supported ? root.audio-volume + "%" : root.audio-selected == "hdmi" ? root.i18n-strings[223] : root.i18n-strings[205],
                        enabled: root.audio-volume-supported, toggle: false, on: false, shown: true,
                    },
                    { title: root.i18n-strings[135], value: root.applications-volume + "%", enabled: true, toggle: false, on: false, shown: true },
                    { title: root.i18n-strings[136], value: root.system-sounds-volume + "%", enabled: true, toggle: false, on: false, shown: true },
                    { title: root.i18n-strings[137], value: "", enabled: true, toggle: true, on: root.navigation-sounds-enabled, shown: true },
                    { title: root.i18n-strings[138], value: "", enabled: true, toggle: true, on: root.power-sounds-enabled, shown: true },
                    { title: root.i18n-strings[139], value: root.home-music-volume + "%", enabled: true, toggle: false, on: false, shown: true },
                    { title: root.i18n-strings[140], value: root.audio-test-tone-playing ? root.i18n-strings[141] : root.i18n-strings[142], enabled: true, toggle: false, on: false, shown: true },
                    {
                        title: root.i18n-strings[143],
                        value: root.display-color-temperature + root.i18n-strings[224],
                        enabled: true, toggle: false, on: false,
                        shown: root.display-color-temperature-available,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.display-audio-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    selected: root.settings-view == 18 && root.display-audio-index == k;
                    visible: row.shown && root.page-display-audio
                        && root.srow-visible(k, root.display-audio-scroll-offset, root.settings-list-visible-rows);
                }

                /* ------------------------------------------------------ Connectivity */
                for row[k] in [
                    { title: root.i18n-strings[157], value: "", toggle: true, on: root.wifi-enabled, enabled: true, nav: false },
                    {
                        title: root.i18n-strings[158],
                        value: root.connectivity-wifi-active ? root.wifi-current-ssid : root.i18n-strings[159],
                        toggle: false, on: false, enabled: root.wifi-enabled, nav: root.wifi-enabled,
                    },
                    {
                        title: root.i18n-strings[10],
                        value: root.wifi-saved-networks.length + root.i18n-strings[225],
                        toggle: false, on: false, enabled: true, nav: true,
                    },
                    { title: root.i18n-strings[161], value: "", toggle: true, on: root.bluetooth-enabled, enabled: true, nav: false },
                    { title: root.i18n-strings[11], value: "", toggle: false, on: false, enabled: root.bluetooth-enabled, nav: root.bluetooth-enabled },
                    {
                        title: root.i18n-strings[12],
                        value: root.bluetooth-known-devices.length + root.i18n-strings[226],
                        toggle: false, on: false, enabled: root.bluetooth-enabled, nav: root.bluetooth-enabled,
                    },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.connectivity-scroll-offset, 3);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    toggle: row.toggle;
                    toggle-on: row.on;
                    enabled: row.enabled;
                    navigates: row.nav;
                    selected: root.settings-view == 1 && root.connectivity-selected-index == k;
                    visible: root.page-connectivity
                        && root.srow-visible(k, root.connectivity-scroll-offset, root.settings-sectioned-visible-rows);
                }

                /* Connect page. Entering this view starts a product-service scan
                 * session; results stay live until this page is left. */
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(0, root.wifi-network-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[162];
                    navigates: true;
                    selected: root.settings-view == 2 && root.wifi-network-index == 0;
                    visible: root.settings-view == 2
                        && root.srow-visible(0, root.wifi-network-scroll-offset, root.settings-list-visible-rows);
                }
                for network[i] in root.wifi-networks: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i + 1, root.wifi-network-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: network.ssid;
                    detail: network.current ? root.i18n-strings[198]
                        : network.saved ? network.security + root.i18n-strings[228]
                        : network.security;
                    value: root.signal-label(network.signal-dbm);
                    emphasized: network.current;
                    title-fraction: 0.62;
                    selected: root.settings-view == 2 && root.wifi-network-index == i + 1;
                    visible: root.settings-view == 2
                        && root.srow-visible(i + 1, root.wifi-network-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.wifi-scanning ? root.i18n-strings[163] : root.i18n-strings[164];
                    visible: root.settings-view == 2 && root.wifi-networks.length == 0;
                }

                /* Saved networks are a flat list. Selecting one opens the same
                 * editor used by the current network. */
                for network[i] in root.wifi-saved-networks: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.wifi-saved-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: network.ssid;
                    detail: network.current ? root.i18n-strings[198] : network.security + root.i18n-strings[228];
                    value: root.signal-label(network.signal-dbm);
                    emphasized: network.current;
                    navigates: true;
                    title-fraction: 0.62;
                    selected: root.settings-view == 3 && root.wifi-saved-index == i;
                    visible: root.settings-view == 3
                        && root.srow-visible(i, root.wifi-saved-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.i18n-strings[165];
                    visible: root.settings-view == 3 && root.wifi-saved-networks.length == 0;
                }

                /* Network editor. Password and IP parameters live on one scrollable
                 * list to avoid a stack of nested settings pages. */
                for row[k] in [
                    {
                        title: root.wifi-selected-current ? root.i18n-strings[169] : root.i18n-strings[158],
                        value: root.wifi-selected-current ? root.i18n-strings[198] : "",
                        enabled: true,
                    },
                    {
                        title: root.i18n-strings[172],
                        value: root.wifi-selected-security == root.i18n-strings[212] ? root.i18n-strings[173] : root.i18n-strings[174],
                        enabled: root.wifi-selected-security != root.i18n-strings[212],
                    },
                    { title: root.i18n-strings[175], value: root.wifi-ip-mode == "automatic" ? root.i18n-strings[122] : root.i18n-strings[176], enabled: true },
                    { title: root.i18n-strings[177], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-address : root.wifi-ip-address, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[178], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-netmask : root.wifi-ip-netmask, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[179], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-gateway : root.wifi-ip-gateway, enabled: root.wifi-ip-mode == "manual" },
                    { title: root.i18n-strings[180], value: root.wifi-ip-mode == "automatic" ? root.wifi-runtime-dns : root.wifi-ip-dns, enabled: root.wifi-ip-mode == "manual" },
                ]: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(k, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    enabled: row.enabled;
                    selected: root.settings-view == 4 && root.wifi-detail-index == k;
                    visible: root.settings-view == 4
                        && root.srow-visible(k, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(7, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[181];
                    selected: root.settings-view == 4 && root.wifi-detail-index == 7;
                    visible: root.settings-view == 4
                        && root.srow-visible(7, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(8, root.wifi-detail-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.i18n-strings[182];
                    danger: true;
                    enabled: root.wifi-selected-saved;
                    selected: root.settings-view == 4 && root.wifi-detail-index == 8;
                    visible: root.settings-view == 4
                        && root.srow-visible(8, root.wifi-detail-scroll-offset, root.wifi-detail-visible-rows);
                }

                /* Bluetooth discovery is active only while this page is open. */
                for device[i] in root.bluetooth-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.bluetooth-device-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind;
                    value: root.bluetooth-state-label(device.connected, device.paired, device.rssi);
                    emphasized: device.connected;
                    title-fraction: 0.62;
                    selected: root.settings-view == 7 && root.bluetooth-device-index == i;
                    visible: root.settings-view == 7
                        && root.srow-visible(i, root.bluetooth-device-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.bluetooth-scanning ? root.i18n-strings[163] : root.i18n-strings[166];
                    visible: root.settings-view == 7 && root.bluetooth-devices.length == 0;
                }

                /* Paired/connected Bluetooth devices. */
                for device[i] in root.bluetooth-known-devices: SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.srow-y(i, root.bluetooth-known-scroll-offset, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: device.name;
                    detail: device.kind;
                    value: root.bluetooth-state-label(device.connected, device.paired, device.rssi);
                    emphasized: device.connected;
                    navigates: true;
                    title-fraction: 0.62;
                    selected: root.settings-view == 8 && root.bluetooth-known-index == i;
                    visible: root.settings-view == 8
                        && root.srow-visible(i, root.bluetooth-known-scroll-offset, root.settings-list-visible-rows);
                }
                SettingsHint {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    text: root.i18n-strings[167];
                    visible: root.settings-view == 8 && root.bluetooth-known-devices.length == 0;
                }

                /* One device, one management surface. */
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(0, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: !root.bluetooth-selected-paired ? root.i18n-strings[168]
                        : root.bluetooth-selected-connected ? root.i18n-strings[169]
                        : root.i18n-strings[158];
                    selected: root.bluetooth-detail-index == 0;
                    visible: root.settings-view == 9;
                }
                SettingsActionButton {
                    x: root.settings-content-x;
                    y: root.srow-y(1, 0, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    label: root.bluetooth-selected-paired ? root.i18n-strings[170] : root.i18n-strings[171];
                    selected: root.bluetooth-detail-index == 1;
                    danger: root.bluetooth-selected-paired;
                    visible: root.settings-view == 9;
                }

                /* Generic dropdown used by every discrete multi-value Settings
                 * choice. */
                Rectangle {
                    x: root.settings-content-x - 6px;
                    y: root.settings-section-y - 4px;
                    width: root.settings-content-width + 12px;
                    height: min(
                        parent.height - self.y - 12px,
                        root.settings-choice-list-y + min(root.settings-choice-options.length, root.settings-choice-visible-rows) * root.settings-row-step + 4px
                    );
                    background: #17191d;
                    border-width: 1px;
                    border-color: #3a86ff;
                    border-radius: 8px;
                    clip: true;
                    visible: root.settings-choice-open;
                    z: 95;

                    MarqueeText {
                        x: 16px; y: 10px; width: parent.width - 32px; height: 28px;
                        label: root.settings-choice-title;
                        text-color: #f5f6f8; text-size: 18px; text-weight: 700;
                        active: true;
                    }
                    for option[i] in root.settings-choice-options: SettingsSelectableRow {
                        x: 12px;
                        y: root.settings-choice-list-y + (i - root.settings-choice-scroll) * root.settings-row-step;
                        width: parent.width - 24px;
                        height: root.settings-row-height;
                        title: option.label;
                        selected: root.settings-choice-index == i;
                        visible: i >= root.settings-choice-scroll
                            && i < root.settings-choice-scroll + root.settings-choice-visible-rows;
                    }
                }

                /* System Effect preview carousel. It overlays RGB Settings and can be
                 * interrupted immediately with Back. */
                Rectangle {
                    x: root.settings-content-x - 8px;
                    y: root.settings-section-y;
                    width: root.settings-content-width + 16px;
                    height: min(parent.height - self.y - 12px, 280px);
                    background: #17191d;
                    border-width: 1px;
                    border-color: #3a86ff;
                    border-radius: 10px;
                    visible: root.settings-view == 17 && root.lighting-preview-open;
                    z: 90;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: root.i18n-strings[144];
                            color: #f5f6f8; font-size: 20px; font-weight: 700;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                width: 56px; height: 56px;
                                source: root.lighting-preview-index == 0
                                    ? @image-url("assets/icons/battery-empty.svg")
                                    : root.lighting-preview-index == 1
                                    ? @image-url("assets/icons/gamepad.svg")
                                    : root.lighting-preview-index == 2
                                    ? @image-url("assets/icons/wifi.svg")
                                    : @image-url("assets/icons/circle-notch.svg");
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: root.lighting-preview-index == 0 ? root.i18n-strings[145]
                                : root.lighting-preview-index == 1 ? root.i18n-strings[146]
                                : root.lighting-preview-index == 2 ? root.i18n-strings[147]
                                : root.lighting-preview-index == 3 ? root.i18n-strings[148]
                                : root.i18n-strings[149];
                            color: #f5f6f8; font-size: 19px; font-weight: 700;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.lighting-preview-index == 0 ? root.i18n-strings[150]
                                : root.lighting-preview-index == 1 ? root.i18n-strings[151]
                                : root.lighting-preview-index == 2 ? root.i18n-strings[152]
                                : root.lighting-preview-index == 3 ? root.i18n-strings[153]
                                : root.i18n-strings[154];
                            color: #8e949d; font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: (root.lighting-preview-index + 1) + " / 5";
                            color: #3a86ff; font-size: 14px; font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.i18n-strings[155];
                            color: #7f858e; font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                /* One status line at the pane bottom, reserved by the row grid. */
                MarqueeText {
                    x: root.settings-content-x;
                    y: parent.height - root.settings-notice-height - 4px;
                    width: root.settings-content-width;
                    height: root.settings-notice-height;
                    label: root.settings-notice;
                    text-color: #d5a34c;
                    text-size: 11px;
                    align-right: true;
                    visible: root.settings-notice != "";
                }
            }
        }

        /* System-wide virtual keyboard bottom sheet. It intentionally spans the
         * full display width so every Settings domain shares the same keyboard
         * surface, independent of the right-pane width. */
        system-keyboard := SystemVirtualKeyboard {
            x: 0px;
            y: 176px;
            width: parent.width;
            height: parent.height - 228px;
            z: 20;
            visible: root.settings-open && root.settings-view == 6;
            value <=> root.keyboard-value;
            title: root.keyboard-title;
            secret: root.keyboard-secret;
            input-kind: root.keyboard-input-kind;
            layout-name: root.keyboard-layout;
            selected-index: root.keyboard-index;
            page: root.keyboard-page;
            row-zero: root.keyboard-row-zero;
            row-one: root.keyboard-row-one;
            row-two: root.keyboard-row-two;
            row-three: root.keyboard-row-three;
            accepted => { root.system-keyboard-accepted(); }
        }

        /* Context-sensitive bottom action bar. */
        Rectangle {
            x: 0;
            y: parent.height - 52px;
            width: parent.width;
            height: 52px;
            background: #0d0e10;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: #25282d;
            }

            HorizontalLayout {
                x: 18px;
                y: 0;
                width: parent.width - 36px;
                height: parent.height;
                spacing: 20px;

                if !root.settings-open: Text {
                    text: root.i18n-strings[183];
                    color: #7f858e;
                    font-size: 17px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.settings-open: ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                if root.settings-select-hint-visible: ActionHint {
                    kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185];
                }
                if root.settings-open: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
                if root.settings-open: Rectangle { horizontal-stretch: 1; }
                if !root.settings-open: ActionHint { kind: "start"; label: root.i18n-strings[3]; }
                ActionHint { kind: "menu"; label: root.i18n-strings[187]; }
            }
        }
    }

    /* OOB Welcome (step 0) and Ready (step 4): one obvious action each. The
     * column is centred in the logical window and only its type sizes grow
     * mildly with the height, so 640x480 stays compact and TV stays legible. */
    oob-hero := Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #0d0e10;
        visible: root.oob-active && (root.oob-step == 0 || root.oob-step == 4);
        z: 150;

        property <float> type-scale: max(1.0, min(1.35, root.height / 480px));
        property <bool> ready: root.oob-step == 4;

        VerticalLayout {
            x: 32px;
            y: 0px;
            width: parent.width - 64px;
            height: parent.height - 58px;
            alignment: center;
            spacing: 14px;

            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                Text { text: "nuub"; color: #f5f6f8; font-size: 40px * oob-hero.type-scale; font-weight: 700; }
                Text { text: "OS"; color: #3a86ff; font-size: 40px * oob-hero.type-scale; font-weight: 700; }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle { width: 86px; height: 3px; background: #3a86ff; border-radius: 2px; }
            }
            Rectangle { height: 4px; }
            Text {
                text: oob-hero.ready ? root.i18n-strings[394] : root.i18n-strings[388];
                color: #f5f6f8;
                font-size: 26px * oob-hero.type-scale;
                font-weight: 700;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    max-width: 520px;
                    text: oob-hero.ready ? root.i18n-strings[395] : root.i18n-strings[389];
                    color: #a8adb5;
                    font-size: 16px * oob-hero.type-scale;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            Rectangle { height: 10px; }
            HorizontalLayout {
                alignment: center;
                SettingsActionButton {
                    width: min(300px, root.width - 64px);
                    height: root.settings-row-height;
                    label: oob-hero.ready ? root.i18n-strings[396] : root.i18n-strings[390];
                    selected: true;
                }
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                for i in 5: Rectangle {
                    width: i == root.oob-step ? 18px : 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: i <= root.oob-step ? #3a86ff : #2c3036;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: #0a0b0d;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: #25282d; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185]; }
                if root.oob-step == 4: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #090b0f;
        visible: root.user-picker-open;
        z: 180;
        clip: true;

        /* Same nuubOS chrome as Home/Settings: matte top bar and the
         * controller-agnostic action bar remain visible during user selection. */
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 58px;
            background: #0d0e10;
            z: 2;
            HorizontalLayout {
                x: 20px; y: 10px; height: 32px;
                spacing: 0px;
                alignment: start;
                Text { text: "nuub"; color: #f5f6f8; font-size: 25px; font-weight: 700; vertical-alignment: center; }
                Text { text: "OS"; color: #3a86ff; font-size: 25px; font-weight: 700; vertical-alignment: center; }
            }
            Text {
                x: 0; y: 13px; width: parent.width; height: 28px;
                text: root.i18n-strings[291];
                color: #f3f5f7;
                font-size: 19px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { x: 16px; y: 57px; width: parent.width - 32px; height: 1px; background: #25282d; }
        }

        for user[i] in root.users : user-card := Rectangle {
            property <bool> focused: root.user-picker-index == i;
            property <length> card-width: root.layout-class == 2 ? 174px : 142px;
            property <length> card-height: root.layout-class == 2 ? 224px : 194px;
            property <length> card-gap: root.layout-class == 2 ? 196px : 160px;

            x: parent.width / 2 - user-card.card-width / 2
                + (i - root.user-picker-index) * user-card.card-gap;
            y: 58px + (parent.height - 116px) / 2 - user-card.card-height / 2;
            width: user-card.card-width;
            height: user-card.card-height;
            border-radius: 14px;
            background: user-card.focused ? #151c27 : #101318;
            border-width: user-card.focused ? 2px : 1px;
            border-color: user-card.focused ? #3a86ff : #252b33;
            visible: i >= root.user-picker-index - 2 && i <= root.user-picker-index + 2;

            Rectangle {
                x: (parent.width - (user-card.focused ? 112px : 88px)) / 2;
                y: user-card.focused ? 24px : 36px;
                width: user-card.focused ? 112px : 88px;
                height: user-card.focused ? 112px : 88px;
                border-radius: user-card.focused ? 56px : 44px;
                border-width: user-card.focused ? 2px : 1px;
                border-color: user-card.focused ? #5b9cff : #343a43;
                background: #11151a;
                clip: true;

                Image {
                    x: parent.border-width;
                    y: parent.border-width;
                    width: parent.width - 2 * parent.border-width;
                    height: parent.height - 2 * parent.border-width;
                    source: user.avatar;
                    image-fit: contain;
                }
            }

            MarqueeText {
                x: 10px;
                y: parent.height - 51px;
                width: parent.width - 20px;
                height: 30px;
                label: user.name;
                text-color: user-card.focused ? #ffffff : #a9afb8;
                text-size: user-card.focused ? 20px : 16px;
                text-weight: user-card.focused ? 700 : 600;
                active: user-card.focused;
                align-center: true;
                
                
            }
        }

        Rectangle {
            x: 0; y: parent.height - 58px; width: parent.width; height: 58px;
            background: #0a0b0d;
            z: 2;
            Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: #25282d; }
            HorizontalLayout {
                x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                spacing: 20px;
                alignment: start;
                ActionHint { kind: "nav"; label: root.i18n-strings[184]; }
                ActionHint { kind: "face"; face-position: root.select-face-position; label: root.i18n-strings[185]; }
                if !root.user-picker-forced: ActionHint {
                    kind: "face"; face-position: root.back-face-position; label: root.i18n-strings[186];
                }
            }
        }
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #05070bdc;
        visible: root.avatar-picker-open;
        z: 185;

        Rectangle {
            width: min(parent.width - 48px, 540px);
            height: min(parent.height - 64px, 66px + 5 * root.settings-row-step + 34px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #0d1014;
            border-radius: 14px;
            border-width: 1px;
            border-color: #28303a;

            MarqueeText {
                x: 22px; y: 10px;
                width: parent.width - 44px; height: 32px;
                label: root.i18n-strings[321];
                text-color: #f3f5f7;
                text-size: 19px;
                text-weight: 700;
                align-center: true;
            }
            Rectangle {
                x: (parent.width - 86px) / 2;
                y: 49px;
                width: 86px; height: 3px;
                background: #3a86ff;
                border-radius: 2px;
            }
            for avatar[i] in root.avatar-choices : SettingsSelectableRow {
                x: 22px;
                y: 66px + (i - root.avatar-picker-scroll) * root.settings-row-step;
                width: parent.width - 44px;
                height: root.settings-row-height;
                title: avatar.label;
                preview: avatar.avatar;
                show-preview: true;
                selected: root.avatar-picker-index == i;
                visible: i >= root.avatar-picker-scroll && i < root.avatar-picker-scroll + 5;
            }
            MarqueeText {
                x: 22px;
                y: parent.height - 28px;
                width: parent.width - 44px;
                label: root.i18n-strings[294] + " • /userdata/users/" + root.profile-edit-user-id + "/profile/avatars";
                text-color: #737b86;
                text-size: 10px;
                align-center: true;
                
            }
        }
    }

    /* Screensaver lifecycle state. The logo moves continuously using
     * resolution-independent permille coordinates; the first input wakes it
     * and is consumed instead of leaking into the underlying UI. */
    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #050608;
        visible: root.screensaver-active && !root.power-menu-open;
        z: 200;

        logo := Rectangle {
            width: 150px;
            height: 46px;
            x: (parent.width - self.width) * root.screensaver-x-permille / 1000;
            y: (parent.height - self.height) * root.screensaver-y-permille / 1000;
            background: #00000000;

            Text {
                x: 0px; y: 0px;
                width: 98px; height: parent.height;
                text: "nuub";
                horizontal-alignment: right;
                vertical-alignment: center;
                color: #e8ebef;
                font-size: 28px;
                font-weight: 700;
            }
            Text {
                x: 98px; y: 0px;
                width: 52px; height: parent.height;
                text: "OS";
                horizontal-alignment: left;
                vertical-alignment: center;
                color: #3a86ff;
                font-size: 28px;
                font-weight: 700;
            }
        }
    }

    /* Power OSD: compact nuubOS console styling. The UI only presents
     * lifecycle actions; nuubos-systemd owns their behavior. */
    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #000000d4;
        visible: root.power-menu-open;
        z: 210;

        Rectangle {
            width: min(parent.width - 56px, 500px);
            height: 256px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #0d1014;
            border-radius: 14px;
            border-width: 1px;
            border-color: #252b33;

            Text {
                x: 0px; y: 15px;
                width: parent.width; height: 30px;
                text: root.i18n-strings[188];
                color: #f3f5f7;
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                x: (parent.width - 92px) / 2;
                y: 49px;
                width: 92px;
                height: 3px;
                background: #3a86ff;
                border-radius: 2px;
            }

            Rectangle {
                x: 24px; y: 64px;
                width: parent.width - 48px; height: 92px;
                background: root.power-menu-index == 0 ? #18283c : #15191f;
                border-radius: 11px;
                border-width: root.power-menu-index == 0 ? 2px : 1px;
                border-color: root.power-menu-index == 0 ? #3a86ff : #2a3038;

                Text {
                    x: 18px; y: 0; width: parent.width - 36px; height: parent.height;
                    text: root.i18n-strings[189];
                    color: #f3f5f7;
                    font-size: 25px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                x: 24px; y: 172px;
                width: (parent.width - 56px) / 2; height: 60px;
                background: root.power-menu-index == 1 ? #18283c : #15191f;
                border-radius: 10px;
                border-width: root.power-menu-index == 1 ? 2px : 1px;
                border-color: root.power-menu-index == 1 ? #3a86ff : #2a3038;

                Text {
                    x: 12px; y: 0;
                    width: root.power-menu-index == 1 && root.power-menu-confirm ? 72px : parent.width - 24px;
                    height: parent.height;
                    text: root.i18n-strings[190];
                    color: #f3f5f7;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: root.power-menu-index == 1 && root.power-menu-confirm ? left : center;
                    vertical-alignment: center;
                }
                Text {
                    x: 84px; y: 0; width: parent.width - 96px; height: parent.height;
                    text: root.power-menu-index == 1 && root.power-menu-confirm ? root.i18n-strings[191] : "";
                    color: #f2b84b;
                    font-size: 10px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                x: 32px + (parent.width - 56px) / 2; y: 172px;
                width: (parent.width - 56px) / 2; height: 60px;
                background: root.power-menu-index == 2 ? #18283c : #15191f;
                border-radius: 10px;
                border-width: root.power-menu-index == 2 ? 2px : 1px;
                border-color: root.power-menu-index == 2 ? #3a86ff : #2a3038;

                Text {
                    x: 12px; y: 0;
                    width: root.power-menu-index == 2 && root.power-menu-confirm ? 84px : parent.width - 24px;
                    height: parent.height;
                    text: root.i18n-strings[58];
                    color: #f3f5f7;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: root.power-menu-index == 2 && root.power-menu-confirm ? left : center;
                    vertical-alignment: center;
                }
                Text {
                    x: 96px; y: 0; width: parent.width - 108px; height: parent.height;
                    text: root.power-menu-index == 2 && root.power-menu-confirm ? root.i18n-strings[191] : "";
                    color: #f2b84b;
                    font-size: 10px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }

    /* Lifecycle curtain. The splash is rendered by Rust (src/splash.rs) at the
     * exact physical output size, identical to the kernel and compositor
     * frames; it is drawn 1:1, never rescaled. The curtain splits on the
     * splash accent line. */
    Rectangle {
        x: 0;
        y: -(parent.height * root.splash-split) * root.curtain-progress;
        width: parent.width;
        height: parent.height * root.splash-split;
        clip: true;
        visible: root.curtain-progress < 0.999;

        Image {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            source: root.splash-image;
            image-fit: fill;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height * root.splash-split
            + (parent.height * (1 - root.splash-split)) * root.curtain-progress;
        width: parent.width;
        height: parent.height * (1 - root.splash-split);
        clip: true;
        visible: root.curtain-progress < 0.999;

        Image {
            x: 0;
            y: -(root.height * root.splash-split);
            width: root.width;
            height: root.height;
            source: root.splash-image;
            image-fit: fill;
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            - (parent.height * root.splash-split) * root.curtain-progress;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: root.splash-line-height;
        background: #5b86d6;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            + (parent.height * (1 - root.splash-split)) * root.curtain-progress
            - self.height;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: root.splash-line-height;
        background: #5b86d6;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            - (parent.height * root.splash-split) * root.curtain-progress
            - 2px;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: 7px;
        background: #5b86d6;
        opacity: 0.06;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * root.splash-split
            + (parent.height * (1 - root.splash-split)) * root.curtain-progress
            - 5px;
        width: parent.width * (root.splash-line-fraction + (1 - root.splash-line-fraction) * root.line-progress);
        height: 7px;
        background: #5b86d6;
        opacity: 0.06;
        visible: root.curtain-progress < 0.999;
    }
}
