                        && root.sec-row-visible(k, root.gaming-scroll-offset, root.gaming-split, root.gaming-split2, 0);
                }

                /* ------------------------------------------------------------ Power */
                for section[i] in [
                    { start: root.power-battery-start, label: root.i18n-strings[814] },
