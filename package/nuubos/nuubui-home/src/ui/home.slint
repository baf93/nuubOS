component BatteryGlyph inherits Rectangle {
    in property <int> percent: -1;
    in property <bool> compact: false;
    in property <bool> charging: false;

    width: root.compact ? 13px : 32px;
    height: root.compact ? 10px : 24px;
    background: #00000000;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-empty.svg");
        image-fit: contain;
        visible: root.percent >= 0 && root.percent <= 15;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-quarter.svg");
        image-fit: contain;
        visible: root.percent > 15 && root.percent <= 35;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-half.svg");
        image-fit: contain;
        visible: root.percent > 35 && root.percent <= 60;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-three-quarters.svg");
        image-fit: contain;
        visible: root.percent > 60 && root.percent <= 85;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-full.svg");
        image-fit: contain;
        visible: root.percent > 85;
    }
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "?";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #7f858e;
        font-size: root.compact ? 8px : 11px;
        font-weight: 700;
        visible: root.percent < 0;
    }

    Image {
        x: (parent.width - (root.compact ? 7px : 15px)) / 2;
        y: (parent.height - (root.compact ? 8px : 17px)) / 2;
        width: root.compact ? 7px : 15px;
        height: root.compact ? 8px : 17px;
        source: @image-url("assets/icons/bolt.svg");
        image-fit: contain;
        visible: root.charging && root.percent >= 0;
    }
}

component ControllerStatus inherits Rectangle {
    in property <string> player-label: "1";
    in property <int> battery-percent: -1;

    width: 34px;
    height: 38px;
    background: #00000000;

    Image {
        x: 0;
        y: 14px;
        width: 22px;
        height: 22px;
        source: @image-url("assets/icons/gamepad.svg");
        image-fit: contain;
    }

    Rectangle {
        x: 16px;
        y: 4px;
        width: 13px;
        height: 13px;
        border-radius: 7px;
        background: #3a86ff;

        Text {
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.player-label;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
        }
    }

    BatteryGlyph {
        x: 19px;
        y: 34px;
        compact: true;
        percent: root.battery-percent;
    }
}

component WifiStatus inherits Rectangle {
    in property <string> state: "disconnected";

    width: 25px;
    height: 45px;
    background: #00000000;

    Image {
        x: 1px;
        y: 14px;
        width: 22px;
        height: 22px;
        source: @image-url("assets/icons/wifi.svg");
        image-fit: contain;
        opacity: root.state == "connected" ? 1.0 : root.state == "connecting" ? 0.82 : 0.34;
    }

    Image {
        x: 16px;
        y: 5px;
        width: 9px;
        height: 9px;
        source: @image-url("assets/icons/circle-notch.svg");
        image-fit: contain;
        visible: root.state == "connecting";
    }

    Image {
        x: 16px;
        y: 5px;
        width: 9px;
        height: 9px;
        source: @image-url("assets/icons/xmark.svg");
        image-fit: contain;
        opacity: root.state == "off" ? 1.0 : 0.62;
        visible: root.state == "off" || root.state == "disconnected";
    }
}

component MenuActionHint inherits Rectangle {
    width: 26px;
    height: 26px;
    border-radius: 5px;
    background: #d8dbe0;
    border-width: 1px;
    border-color: #f5f6f8;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "H";
        color: #0d0e10;
        font-size: 16px;
        font-weight: 800;
    }
}


component SettingsCategory inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;

    height: 40px;
    border-radius: 6px;
    background: root.selected ? #1b2940 : #00000000;
    border-width: 1px;
    border-color: root.selected ? #3a86ff : #00000000;

    Text {
        x: 12px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: root.selected ? #f5f6f8 : #a8adb5;
        font-size: 18px;
        font-weight: root.selected ? 700 : 600;
    }
}

component SettingsTopic inherits Rectangle {
    in property <string> label: "";
    in property <bool> visible-topic: true;

    height: 38px;
    visible: root.visible-topic;
    border-radius: 6px;
    background: #15171b;
    border-width: 1px;
    border-color: #24272d;

    Text {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: #c8ccd2;
        font-size: 17px;
        font-weight: 600;
    }
}

component StartActionHint inherits Rectangle {
    width: 50px;
    height: 26px;
    border-radius: 5px;
    background: #d8dbe0;
    border-width: 1px;
    border-color: #f5f6f8;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "START";
        color: #0d0e10;
        font-size: 11px;
        font-weight: 800;
    }
}

component NavigationHint inherits Rectangle {
    width: 28px;
    height: 26px;
    border-radius: 5px;
    background: #d8dbe0;
    border-width: 1px;
    border-color: #f5f6f8;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "↕";
        color: #0d0e10;
        font-size: 18px;
        font-weight: 800;
    }
}

component FaceButtonHint inherits Rectangle {
    in property <int> active-position: -1;

    width: 28px;
    height: 28px;
    background: #00000000;

    Rectangle {
        x: 10px;
        y: 1px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 0 ? #3a86ff : #24272d;
        border-width: 1px;
        border-color: root.active-position == 0 ? #73a8ff : #555b64;
    }
    Rectangle {
        x: 19px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 1 ? #3a86ff : #24272d;
        border-width: 1px;
        border-color: root.active-position == 1 ? #73a8ff : #555b64;
    }
    Rectangle {
        x: 10px;
        y: 19px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 2 ? #3a86ff : #24272d;
        border-width: 1px;
        border-color: root.active-position == 2 ? #73a8ff : #555b64;
    }
    Rectangle {
        x: 1px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 3 ? #3a86ff : #24272d;
        border-width: 1px;
        border-color: root.active-position == 3 ? #73a8ff : #555b64;
    }
}

export component HomeWindow inherits Window {
    /*
     * Two-stage lifecycle transition.
     *
     * line-progress:
     *   0 = branded separator line at its normal splash width
     *   1 = line spans the complete screen width
     *
     * curtain-progress:
     *   0 = lifecycle raster closed/full-screen
     *   1 = top/bottom raster halves fully open off-screen
     */
    in-out property <float> line-progress: 0.0;
    in-out property <float> curtain-progress: 0.0;
    in-out property <string> transition-mode: "boot";

    in-out property <string> topbar-time: "--:--";
    in-out property <string> current-user-name: "Player";
    in-out property <string> wifi-state: "disconnected";
    in-out property <int> battery-percent: -1;
    in-out property <string> battery-state: "unknown";
    in-out property <string> battery-label: "--%";
    in-out property <int> controller-count: 0;
    in-out property <int> controller-one-battery: -1;
    in-out property <int> controller-two-battery: -1;
    in-out property <int> controller-three-battery: -1;
    in-out property <int> controller-four-battery: -1;

    in-out property <bool> settings-open: false;
    in-out property <int> settings-selected-index: 0;
    in-out property <int> back-face-position: -1;

    property <length> controllers-start-x:
        root.controller-count >= 4 ? root.width - 253px
        : root.controller-count == 3 ? root.width - 219px
        : root.controller-count == 2 ? root.width - 185px
        : root.controller-count == 1 ? root.width - 151px
        : root.width - 113px;

    title: "nuubOS";
    background: #0d0e10;
    default-font-family: "Cantarell";

    animate line-progress {
        duration: 220ms;
        easing: ease-in-out;
    }

    animate curtain-progress {
        duration: 460ms;
        easing: ease-in-out;
    }

    /* HOME stays completely still behind the lifecycle curtain. */
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #0d0e10;

        /* Topbar: matte background shared with the Quick Menu. */
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 50px;
            background: #0d0e10;

            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #25282d;
            }

            /* Left: nuubOS wordmark + current user. Keep both color runs content-sized
             * in one zero-spacing layout so the mark reads as one continuous word. */
            HorizontalLayout {
                x: 18px;
                y: 13px;
                width: 96px;
                height: 25px;
                spacing: 0px;
                alignment: start;

                Text {
                    text: "nuub";
                    color: #f5f6f8;
                    font-size: 21px;
                    font-weight: 700;
                }
                Text {
                    text: "OS";
                    color: #3a86ff;
                    font-size: 21px;
                    font-weight: 700;
                }
            }
            Rectangle {
                x: 118px;
                y: 11px;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                border-width: 1px;
                border-color: #2c3036;
                background: #00000000;
            }
            Image {
                x: 122px;
                y: 15px;
                width: 20px;
                height: 20px;
                source: @image-url("assets/icons/user.svg");
                image-fit: contain;
            }

            /* Center: wall clock supplied by nuubos-statusd. */
            Text {
                x: (parent.width - 76px) / 2;
                y: 15px;
                width: 76px;
                horizontal-alignment: center;
                text: root.topbar-time;
                color: #d9dce1;
                font-size: 19px;
                font-weight: 600;
            }

            /* Right: up to four connected Bluetooth controllers. */
            ControllerStatus {
                x: root.controllers-start-x;
                y: 0px;
                player-label: "1";
                battery-percent: root.controller-one-battery;
                visible: root.controller-count >= 1;
            }
            ControllerStatus {
                x: root.controllers-start-x + 34px;
                y: 0px;
                player-label: "2";
                battery-percent: root.controller-two-battery;
                visible: root.controller-count >= 2;
            }
            ControllerStatus {
                x: root.controllers-start-x + 68px;
                y: 0px;
                player-label: "3";
                battery-percent: root.controller-three-battery;
                visible: root.controller-count >= 3;
            }
            ControllerStatus {
                x: root.controllers-start-x + 102px;
                y: 0px;
                player-label: "4";
                battery-percent: root.controller-four-battery;
                visible: root.controller-count >= 4;
            }

            WifiStatus {
                x: parent.width - 113px;
                y: 0px;
                state: root.wifi-state;
            }

            BatteryGlyph {
                x: parent.width - 84px;
                y: 13px;
                percent: root.battery-percent;
                charging: root.battery-state == "charging";
            }

            Text {
                x: parent.width - 48px;
                y: 14px;
                width: 40px;
                height: 24px;
                horizontal-alignment: right;
                vertical-alignment: center;
                text: root.battery-label;
                color: #e5e7eb;
                font-size: 19px;
                font-weight: 700;
            }
        }

        /* Home content. */
        Rectangle {
            x: 0;
            y: 50px;
            width: parent.width;
            height: parent.height - 102px;
            background: #0d0e10;
            visible: !root.settings-open;

            Rectangle {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                height: parent.height - 40px;
                background: #111214;
                border-width: 1px;
                border-color: #1c1e22;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: 4px;
                    height: parent.height;
                    background: #3a86ff;
                }

                Text {
                    x: 24px;
                    y: 24px;
                    text: "Recently Played";
                    color: #f5f6f8;
                    font-size: 27px;
                    font-weight: 700;
                }

                Text {
                    x: 24px;
                    y: 68px;
                    text: "nuubUI graphics foundation";
                    color: #a8adb5;
                    font-size: 19px;
                }

                Text {
                    x: 24px;
                    y: 100px;
                    text: "Native layout • 640×480 • Wayland";
                    color: #7f858e;
                    font-size: 16px;
                }
            }
        }

        /* Settings shell: thematic categories only, no fake functionality. */
        Rectangle {
            x: 0;
            y: 50px;
            width: parent.width;
            height: parent.height - 102px;
            background: #0d0e10;
            visible: root.settings-open;

            Text {
                x: 18px;
                y: 14px;
                text: "Settings";
                color: #f5f6f8;
                font-size: 29px;
                font-weight: 700;
            }

            Rectangle {
                x: 18px;
                y: 54px;
                width: 198px;
                height: parent.height - 70px;
                background: #101114;
                border-width: 1px;
                border-color: #202329;
                border-radius: 8px;

                SettingsCategory {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    label: "General";
                    selected: root.settings-selected-index == 0;
                }
                SettingsCategory {
                    x: 8px;
                    y: 52px;
                    width: parent.width - 16px;
                    label: "Connectivity";
                    selected: root.settings-selected-index == 1;
                }
                SettingsCategory {
                    x: 8px;
                    y: 96px;
                    width: parent.width - 16px;
                    label: "Controllers & Input";
                    selected: root.settings-selected-index == 2;
                }
                SettingsCategory {
                    x: 8px;
                    y: 140px;
                    width: parent.width - 16px;
                    label: "Display & Audio";
                    selected: root.settings-selected-index == 3;
                }
                SettingsCategory {
                    x: 8px;
                    y: 184px;
                    width: parent.width - 16px;
                    label: "Gaming";
                    selected: root.settings-selected-index == 4;
                }
                SettingsCategory {
                    x: 8px;
                    y: 228px;
                    width: parent.width - 16px;
                    label: "System";
                    selected: root.settings-selected-index == 5;
                }
            }

            Rectangle {
                x: 230px;
                y: 0px;
                width: parent.width - 230px;
                height: parent.height;
                background: #111214;
                border-width: 1px;
                border-color: #202329;
                border-radius: 0px;

                Text {
                    x: 22px;
                    y: 16px;
                    width: parent.width - 44px;
                    text: root.settings-selected-index == 0 ? "General"
                        : root.settings-selected-index == 1 ? "Connectivity"
                        : root.settings-selected-index == 2 ? "Controllers & Input"
                        : root.settings-selected-index == 3 ? "Display & Audio"
                        : root.settings-selected-index == 4 ? "Gaming"
                        : "System";
                    color: #f5f6f8;
                    font-size: 26px;
                    font-weight: 700;
                            }

                Text {
                    x: 22px;
                    y: 52px;
                    width: parent.width - 44px;
                    text: root.settings-selected-index == 0
                        ? "Profiles, language and time"
                        : root.settings-selected-index == 1
                            ? "Wireless connections and paired devices"
                            : root.settings-selected-index == 2
                                ? "Controllers, mapping and input tools"
                                : root.settings-selected-index == 3
                                    ? "Screen, HDMI, brightness and audio"
                                    : root.settings-selected-index == 4
                                        ? "Gaming behaviour and performance"
                                        : "Power, storage and system maintenance";
                    color: #7f858e;
                    font-size: 16px;
                    font-weight: 500;
                            }

                Text {
                    x: 22px;
                    y: 88px;
                    text: "Sections";
                    color: #8e949d;
                    font-size: 15px;
                    font-weight: 700;
                }

                SettingsTopic {
                    x: 22px;
                    y: 116px;
                    width: parent.width - 44px;
                    label: root.settings-selected-index == 0 ? "User & Profile"
                        : root.settings-selected-index == 1 ? "Wi-Fi"
                        : root.settings-selected-index == 2 ? "Controllers"
                        : root.settings-selected-index == 3 ? "Display & HDMI"
                        : root.settings-selected-index == 4 ? "Performance Profiles"
                        : "Battery & Power";
                }

                SettingsTopic {
                    x: 22px;
                    y: 166px;
                    width: parent.width - 44px;
                    label: root.settings-selected-index == 0 ? "Language & Region"
                        : root.settings-selected-index == 1 ? "Bluetooth"
                        : root.settings-selected-index == 2 ? "Controller Mapping"
                        : root.settings-selected-index == 3 ? "Brightness"
                        : root.settings-selected-index == 4 ? "Global Gaming Options"
                        : "Storage";
                }

                SettingsTopic {
                    x: 22px;
                    y: 216px;
                    width: parent.width - 44px;
                    label: root.settings-selected-index == 0 ? "Date & Time"
                        : root.settings-selected-index == 2 ? "Input Tester"
                        : root.settings-selected-index == 3 ? "Audio"
                        : root.settings-selected-index == 5 ? "System Information"
                        : "";
                    visible-topic: root.settings-selected-index == 0
                        || root.settings-selected-index == 2
                        || root.settings-selected-index == 3
                        || root.settings-selected-index == 5;
                }

                SettingsTopic {
                    x: 22px;
                    y: 266px;
                    width: parent.width - 44px;
                    label: root.settings-selected-index == 2 ? "Rumble & RGB"
                        : root.settings-selected-index == 5 ? "Updates & Recovery"
                        : "";
                    visible-topic: root.settings-selected-index == 2
                        || root.settings-selected-index == 5;
                }
            }
        }

        /* Context-sensitive bottom action bar. */
        Rectangle {
            x: 0;
            y: parent.height - 52px;
            width: parent.width;
            height: 52px;
            background: #0d0e10;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: #25282d;
            }

            Text {
                x: 18px;
                y: 16px;
                text: "Small System. Big Adventures.";
                color: #7f858e;
                font-size: 17px;
                font-weight: 500;
                visible: !root.settings-open;
            }

            StartActionHint {
                x: parent.width - 282px;
                y: 13px;
                visible: !root.settings-open;
            }

            Text {
                x: parent.width - 224px;
                y: 17px;
                width: 72px;
                text: "Settings";
                color: #a8adb5;
                font-size: 16px;
                font-weight: 600;
                visible: !root.settings-open;
            }

            NavigationHint {
                x: 18px;
                y: 13px;
                visible: root.settings-open;
            }

            Text {
                x: 54px;
                y: 17px;
                text: "Navigate";
                color: #a8adb5;
                font-size: 17px;
                font-weight: 600;
                visible: root.settings-open;
            }

            FaceButtonHint {
                x: 150px;
                y: 12px;
                active-position: root.back-face-position;
                visible: root.settings-open;
            }

            Text {
                x: 186px;
                y: 17px;
                text: "Back";
                color: #a8adb5;
                font-size: 17px;
                font-weight: 600;
                visible: root.settings-open;
            }

            MenuActionHint {
                x: parent.width - 102px;
                y: 13px;
            }

            Text {
                x: parent.width - 68px;
                y: 17px;
                width: 50px;
                text: "Menu";
                color: #a8adb5;
                font-size: 16px;
                font-weight: 600;
            }
        }
    }

    /* Lifecycle curtain below is intentionally unchanged. */
    Rectangle {
        x: 0;
        y: -(parent.height * 0.485) * root.curtain-progress;
        width: parent.width;
        height: parent.height * 0.485;
        clip: true;
        visible: root.curtain-progress < 0.999;

        Image {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            source: root.transition-mode == "reboot"
                ? @image-url("assets/reboot-splash.png")
                : root.transition-mode == "poweroff"
                    ? @image-url("assets/poweroff-splash.png")
                    : @image-url("assets/boot-splash.png");
            image-fit: fill;
            image-rendering: pixelated;
        }
    }

    Rectangle {
        x: 0;
        y: parent.height * 0.485
            + (parent.height * 0.515) * root.curtain-progress;
        width: parent.width;
        height: parent.height * 0.515;
        clip: true;
        visible: root.curtain-progress < 0.999;

        Image {
            x: 0;
            y: -(root.height * 0.485);
            width: root.width;
            height: root.height;
            source: root.transition-mode == "reboot"
                ? @image-url("assets/reboot-splash.png")
                : root.transition-mode == "poweroff"
                    ? @image-url("assets/poweroff-splash.png")
                    : @image-url("assets/boot-splash.png");
            image-fit: fill;
            image-rendering: pixelated;
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.485
            - (parent.height * 0.485) * root.curtain-progress;
        width: parent.width * (0.483 + 0.517 * root.line-progress);
        height: 3px;
        background: #5b86d6;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.485
            + (parent.height * 0.515) * root.curtain-progress
            - self.height;
        width: parent.width * (0.483 + 0.517 * root.line-progress);
        height: 3px;
        background: #5b86d6;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.485
            - (parent.height * 0.485) * root.curtain-progress
            - 2px;
        width: parent.width * (0.483 + 0.517 * root.line-progress);
        height: 7px;
        background: #5b86d6;
        opacity: 0.06;
        visible: root.curtain-progress < 0.999;
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.485
            + (parent.height * 0.515) * root.curtain-progress
            - 5px;
        width: parent.width * (0.483 + 0.517 * root.line-progress);
        height: 7px;
        background: #5b86d6;
        opacity: 0.06;
        visible: root.curtain-progress < 0.999;
    }
}
