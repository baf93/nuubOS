component SettingsSelectableRow inherits Rectangle {
    in property <string> title: "";
    in property <string> detail: "";
    in property <string> value: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;

    height: 40px;
    border-radius: 6px;
    background: root.selected ? #1b2940 : #15171b;
    border-width: 1px;
    border-color: root.selected ? #3a86ff : #24272d;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        x: 12px;
        y: root.detail == "" ? 0px : 5px;
        width: parent.width - 130px;
        height: root.detail == "" ? parent.height : 20px;
        vertical-alignment: center;
        text: root.title;
        color: root.selected ? #f5f6f8 : #c8ccd2;
        font-size: 18px;
        font-weight: root.selected ? 700 : 600;
    }

    Text {
        x: 12px;
        y: 23px;
        width: parent.width - 130px;
        text: root.detail;
        color: #7f858e;
        font-size: 11px;
        visible: root.detail != "";
    }

    Text {
        x: parent.width - 118px;
        y: 0;
        width: 106px;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.value;
        color: root.selected ? #cfe2ff : #8e949d;
        font-size: 15px;
        font-weight: 600;
    }
}


