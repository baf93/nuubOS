    in-out property <bool> settings-open: false;

    /* Home (EPIC-001) and Game Library browsing (EPIC-011), fed by
     * nuubos-libraryd. home-row: 0 Recently Played, 1 Systems &
     * Collections, 2 Applications; each row remembers its own position. */
    in-out property <[HomeCard]> home-recent: [];
    in-out property <[HomeCard]> home-shelf: [];
    in-out property <[HomeCard]> home-apps: [];
    in-out property <int> home-row: 0;
    in-out property <int> home-recent-index: 0;
    in-out property <int> home-shelf-index: 0;
    in-out property <int> home-apps-index: 0;
    in-out property <bool> library-scanning: false;
    /* Picks the playful message of empty Home sections (Rust, per session
     * / user switch). */
    in-out property <int> home-empty-variant: 0;
    in-out property <string> home-notice: "";
    in-out property <bool> library-open: false;
    in-out property <string> library-title: "";
    in-out property <string> library-detail: "";
    in-out property <[HomeCard]> library-games: [];
    in-out property <int> library-index: 0;
    in-out property <float> library-aspect: 0.75;
    in-out property <int> context-face-position: -1;
    /* Settings pages: label of an extra action on the north face
     * (e.g. Remove on a Web bookmark); empty = none. */
    in-out property <string> settings-north-hint: "";

    /* Home metrics, derived from the logical window (never a scaled
     * canvas): type and spacing grow mildly with the height, card sizes
     * follow the space actually available. */
    property <float> home-s: max(1.0, min(1.4, root.height / 480px));
    property <length> home-pad: 22px * root.home-s;
    property <length> home-top-pad: 8px * root.home-s;
    property <length> home-rows-h: root.height - 102px - root.home-top-pad;
    property <length> home-label-h: 28px * root.home-s;
    property <length> home-info-h: 52px * root.home-s;
    property <length> home-gap: 14px * root.home-s;
    /* One screen, no vertical scrolling (user request 2026-10-08): the
     * shelves are compact chip rows and Recently Played takes all the
     * height left, so the covers stay the largest thing on screen. The
     * last 10 px keep the focus glow of the bottom row. */
    property <length> home-chip-h: 44px * root.home-s;
    property <length> home-chip-w: max(160px * root.home-s, min(240px * root.home-s,
        (root.width - 2 * root.home-pad) / 3.2));
    property <length> home-row-gap: 6px * root.home-s;
    property <length> home-big-h: max(96px, root.home-rows-h - 10px - 3 * root.home-label-h
        - 2 * root.home-chip-h - 2 * root.home-row-gap - root.home-info-h);
    property <length> library-view-h: root.home-rows-h - root.home-label-h - root.home-info-h;
    /* Grid density: about one column per 320 logical px (2 on handhelds,
     * up to 5 on wide screens), never taller than ~1.6 rows per screen. */
    property <int> library-target-columns: max(2, min(5, round(root.width / 320px)));
    property <length> library-cell-h: max(110px, min(root.library-view-h * 0.60,
        ((root.width - 2 * root.home-pad + root.home-gap) / root.library-target-columns - root.home-gap)
        / root.library-aspect));
    property <length> library-cell-w: root.library-cell-h * root.library-aspect;
    out property <int> library-columns: max(1, floor((root.width - 2 * root.home-pad + root.home-gap)
        / (root.library-cell-w + root.home-gap)));
    /* Rust decodes covers once at this logical height (x scale factor)
     * and only for grid rows near the visible ones. */
    out property <length> home-cover-h: max(root.home-big-h, root.library-cell-h);
    out property <int> library-visible-rows: max(1, ceil(root.library-view-h
        / (root.library-cell-h + root.home-gap)));
    property <HomeCard> home-focused: root.library-open ? root.library-games[root.library-index]
        : root.home-row == 0 ? root.home-recent[root.home-recent-index]
        : root.home-row == 1 ? root.home-shelf[root.home-shelf-index]
        : root.home-apps[root.home-apps-index];
    property <bool> home-focus-valid: root.library-open ? root.library-games.length > 0
        : root.home-row == 0 ? root.home-recent.length > 0
        : root.home-row == 1 ? root.home-shelf.length > 0
        : root.home-apps.length > 0;
