                    height: root.settings-row-height;
                    title: row.title;
                    value: row.value;
                    detail: row.detail;
                    navigates: row.nav;
                    show-slider: row.slider;
                    slider-fraction: row.fraction;
                    toggle: row.tog;
                    toggle-on: row.on;
                    /* Fast Startup asks a second press before it turns on. */
                    armed: k == 4 && root.fast-startup-armed;
                    selected: root.settings-view == 69 && root.power-index == k;
                    visible: root.page-power
                        && root.sec-row-visible(k, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                }
                SettingsSelectableRow {
                    x: root.settings-content-x;
                    y: root.sec-row-y(8, root.power-scroll-offset, root.power-battery-start, root.power-devices-start, 0);
                    width: root.settings-content-width;
                    height: root.settings-row-height;
                    title: root.i18n-strings[900];
                    value: root.system-charge-limit >= 100 ? root.i18n-strings[54] : root.system-charge-limit + "%";
                    selected: root.settings-view == 69 && root.power-index == 8;
