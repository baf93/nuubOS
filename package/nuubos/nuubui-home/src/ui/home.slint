 {0}", "Optional: more requests per day", "Scan for New Games", "Finds games copied to the SD card since the last scan", "New games found: {0}", "No new games found", "BACKGROUND TASK", "Stop", "Stopping…", "Starting game…", "Muted", "Power", "BATTERY", "ACCESSORY BATTERIES", "Charge", "Battery Health", "Discharging", "Not charging", "Good", "Overheating", "Too cold", "Worn out", "Check the battery", "No accessories connected", "ENERGY SAVING", "Find a Game", "Find", "Random Game", "Random Unplayed Game", "Title", "Decade", "Any", "Never Played Only", "Show Results ({0})", "No games match these filters", "Results", "Add to Collection", "Delete Collection", "Systems", "SURPRISE ME", "SEARCH", "Rename Collection", "Clear Filters", "Picks one of your games for you", "Added to {0}", "Removed from {0}", "Collection deleted", "Manage", "Games stay in your library; only the collection goes away", "Notification Sounds", "Automatic Updates", "Restore Version {0}", "The new version did not start", "Version {0} restored", "New versions install when you open Steam Link; one that does not start is undone automatically", "VIDEO", "PC", "Audio Channels", "Stereo", "5.1 Surround", "7.1 Surround", "Play Audio on the PC", "Optimize Game Settings", "Lets the PC adapt the game to the stream resolution", "Quit the App on the PC After Streaming", "Left and right change it", "Metadata in Your Language", "Gets descriptions and genres in your language; the languages already downloaded stay saved", "Every game with missing data", "Not tried in the last hour", "Not tried in the last day", "Not tried in the last week", "Not tried in the last month", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday", "Day", "Month", "Year", "Hour", "Minute"];

    in-out property <string> topbar-time: "--:--";
    in-out property <string> current-user-name: root.i18n-strings[204];
    in-out property <image> current-user-avatar;
    in-out property <bool> current-user-avatar-available: false;
    in-out property <string> wifi-state: "disconnected";
    in-out property <int> battery-percent: -1;
    in-out property <string> battery-state: "unknown";
    /* statusd BATTERY_HEALTH (power_supply health, lowercase-dashed). */
    in-out property <string> battery-health: "unknown";
    in-out property <string> battery-label: "--%";
    /* Connected external controllers in player order (Controllers service). */
    in-out property <[TopbarController]> topbar-controllers: [];
    property <int> controller-count: root.topbar-controllers.length;

    in-out property <bool> settings-open: false;

    /* Home (EPIC-001) and Game Library browsing (EPIC-011), fed by
     * nuubos-libraryd. home-row: 0 Recently Played, 1 Systems,
     * 2 Collections (ends with New Collection), 3 Applications; each row
     * remembers its own position. */
    in-out property <[HomeCard]> home-recent: [];
    in-out property <[HomeCard]> home-systems: [];
    in-out property <[HomeCard]> home-collections: [];
    in-out property <[HomeCard]> home-apps: [];
    in-out property <int> home-row: 0;
    in-out property <int> home-recent-index: 0;
    in-out property <int> home-systems-index: 0;
