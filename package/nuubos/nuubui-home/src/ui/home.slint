import { Theme, Shape } from "theme.slint";
import { SystemVirtualKeyboard } from "components/virtual_keyboard.slint";
import { NuubLogo } from "components/logo.slint";
import { MarqueeText } from "components/marquee.slint";
import { MediaApp, MediaTile, MediaShelf, MediaTrack } from "components/media_app.slint";
import { FilesApp, FilePane, FileRow } from "components/files_app.slint";
export { MediaTile, MediaShelf, MediaTrack } from "components/media_app.slint";
export { FilePane, FileRow } from "components/files_app.slint";
export { Theme } from "theme.slint";


export struct WifiNetworkEntry {
    ssid: string,
    security: string,
    signal-dbm: int,
    saved: bool,
    current: bool,
}

/* PC streaming host (nuubos-streamd snapshot). online: online|offline|unknown. */
export struct MoonlightHostEntry {
    id: string,
    name: string,
    address: string,
    paired: bool,
    online: string,
    probing: bool,
    /* Wake-on-LAN possible (the paired PC advertised its MAC) */
    wol: bool,
    waking: bool,
}

export struct BluetoothDeviceEntry {
    address: string,
    name: string,
    kind: string,
    paired: bool,
    connected: bool,
    trusted: bool,
    rssi: int,
}

export struct ControllerEntry {
    id: string,
    name: string,
    transport: string,
    connected: bool,
    builtin: bool,
    preferred-player: int,
    effective-player: int,
}

/* Connected external controller shown in the top bar. */
/* Settings → Power, CONNECTED DEVICES: kind = controller | headphones |
 * device; battery -1 = not reported. */
export struct PowerDevice {
    name: string,
    kind: string,
    battery: int,
}

export struct TopbarController {
    player: int,
    battery: int,
}

export struct PlayerAssignmentEntry {
    player: int,
    controller-id: string,
    controller-name: string,
    available: bool,
}

/* kind: 0 button, 1 stick axis, 2 stick deadzone, 3 Restore Default Mapping. */
export struct ControllerMappingEntry {
    control: string,
    kind: int,
    label: string,
    value: string,
    customized: bool,
}

/* One row of a data-driven page (Game Details, Game Settings, BIOS Files,
 * RetroAchievements, Gaming, SERVICES...): Rust builds the rows from
 * the owning services; the page only lays them out. */
export struct GenRow {
    title: string,
    value: string,
    detail: string,
    navigates: bool,
    toggle: bool,
    toggle-on: bool,
    enabled: bool,
    /* Waiting for the confirming press (error style, prompt in detail). */
    armed: bool,
    /* A running operation of this row: a bar along its bottom, 0..1. */
    progress-shown: bool,
    progress: float,
}

export struct SettingsChoiceEntry {
    value: string,
    label: string,
}

export struct UserProfileEntry {
    id: string, name: string, avatar-spec: string, avatar-path: string, avatar: image, active: bool, default-user: bool,
}
/* One wheel of the manual Date & Time picker: above = value + 1. */
export struct DateTimeField {
    label: string, above: string, value: string, below: string,
}

export struct AvatarChoiceEntry {
    spec: string, label: string, path: string, avatar: image,
}

component BatteryGlyph inherits Rectangle {
    in property <int> percent: -1;
    in property <bool> compact: false;
    in property <bool> charging: false;
    in property <bool> battery-saver: false;

    width: root.compact ? 13px : 32px;
    height: root.compact ? 10px : 24px;
    background: #00000000;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-empty.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent >= 0 && root.percent <= 15;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-quarter.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 15 && root.percent <= 35;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-half.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 35 && root.percent <= 60;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-three-quarters.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 60 && root.percent <= 85;
    }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/battery-full.svg");
        image-fit: contain;
        colorize: root.battery-saver ? Theme.warning : #00000000;
        visible: root.percent > 85;
    }
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: "?";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text-faint;
        font-size: root.compact ? 8px : 11px;
        font-weight: 700;
        visible: root.percent < 0;
    }

    /* Charging bolt: outline + fill, both from the theme. */
    Image {
        x: (parent.width - (root.compact ? 7px : 15px)) / 2;
        y: (parent.height - (root.compact ? 8px : 17px)) / 2;
        width: root.compact ? 7px : 15px;
        height: root.compact ? 8px : 17px;
        source: @image-url("assets/icons/bolt-outline.svg");
        image-fit: contain;
        colorize: Theme.background;
        visible: root.charging && root.percent >= 0;
    }
    Image {
        x: (parent.width - (root.compact ? 7px : 15px)) / 2;
        y: (parent.height - (root.compact ? 8px : 17px)) / 2;
        width: root.compact ? 7px : 15px;
        height: root.compact ? 8px : 17px;
        source: @image-url("assets/icons/bolt.svg");
        image-fit: contain;
        colorize: Theme.accent;
        visible: root.charging && root.percent >= 0;
    }
}

component ControllerStatus inherits Rectangle {
    in property <int> player: 1;
    in property <int> battery-percent: -1;
    /* Compact: player badge + battery dot only; the group shares one
     * gamepad icon (used when the controllers do not fit next to the clock). */
    in property <bool> compact: false;

    width: root.compact ? 16px : 34px;
    height: 38px;
    background: #00000000;

    Image {
        x: 0;
        y: 14px;
        width: 22px;
        height: 22px;
        source: @image-url("assets/icons/gamepad.svg");
        image-fit: contain;
        visible: !root.compact;
    }

    Rectangle {
        x: root.compact ? 1px : 16px;
        y: root.compact ? 12px : 4px;
        width: 13px;
        height: 13px;
        border-radius: 7px;
        background: Theme.accent;

        Text {
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.player;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
        }
    }

    /* Battery level: green / amber / red dot, hidden when unknown. */
    Rectangle {
        x: root.compact ? 4px : 17px;
        y: root.compact ? 28px : 29px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        /* Outline = fill under the dot (strokes are costly, FaceButtonDot). */
        background: Theme.background;
        visible: root.battery-percent >= 0;
        Rectangle {
            x: 1px; y: 1px; width: 6px; height: 6px;
            border-radius: 3px;
            background: root.battery-percent >= 50 ? #43d17a
                : root.battery-percent >= 20 ? Theme.warning : #ff5c5c;
        }
    }
}

component WifiStatus inherits Rectangle {
    in property <string> state: "disconnected";

    width: 25px;
    height: 45px;
    background: #00000000;

    Image {
        x: 1px;
        y: 14px;
        width: 22px;
        height: 22px;
        source: @image-url("assets/icons/wifi.svg");
        image-fit: contain;
        opacity: root.state == "connected" ? 1.0 : root.state == "connecting" ? 0.82 : 0.34;
    }

    Image {
        x: 16px;
        y: 5px;
        width: 9px;
        height: 9px;
        source: @image-url("assets/icons/circle-notch.svg");
        image-fit: contain;
        visible: root.state == "connecting";
    }

    Image {
        x: 16px;
        y: 5px;
        width: 9px;
        height: 9px;
        source: @image-url("assets/icons/xmark.svg");
        image-fit: contain;
        opacity: root.state == "off" ? 1.0 : 0.62;
        visible: root.state == "off" || root.state == "disconnected";
    }
}

component MenuActionHint inherits Rectangle {
    width: 26px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "H";
        color: Theme.text;
        font-size: 16px;
        font-weight: 800;
    }
}


/* Settings visual grammar.
 *
 * Every Settings surface is built from the same few primitives so spacing,
 * typography and focus treatment never diverge between categories:
 *   SettingsCategory      rail entry
 *   SettingsSectionHeader accent section label + optional localized scope chip
 *   SettingsSelectableRow title [+ detail] and one right accessory:
 *                         value text, on/off switch or sub-page chevron
 *   SettingsActionButton  explicit action / destructive action
 * Geometry (row height, step, content origin) is owned by HomeWindow and
 * derived from the logical window size; components never assume 640x480. */
component SettingsCategory inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;

    /* M3 navigation drawer item: pill-shaped active indicator. */
    border-radius: self.height / 2;
    background: root.selected ? Theme.secondary-container : #00000000;

    MarqueeText {
        x: 16px;
        y: 0;
        width: parent.width - 28px;
        height: parent.height;
        label: root.label;
        text-color: root.selected ? Theme.on-secondary-container : Theme.text-secondary;
        text-size: 17px;
        text-weight: root.selected ? 700 : 500;
        active: root.selected;
    }
}

component SettingsSectionHeader inherits Rectangle {
    in property <string> label: "";
    /* Localized ownership label (USER / DEVICE). Empty when the section
     * label already is the scope. */
    in property <string> scope-label: "";

    height: 20px;
    background: #00000000;

    section-label := Text {
        x: 0;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: Theme.primary;
        font-size: 13px;
        font-weight: 600;
    }

    Rectangle {
        x: root.label == "" ? 0px : section-label.preferred-width + 8px;
        y: (parent.height - self.height) / 2;
        width: scope-text.preferred-width + 14px;
        height: 18px;
        border-radius: Shape.extra-small;
        /* Outline = this fill under an inset page-coloured one: FemtoVG
         * strokes take three stencil passes, a fill one. */
        background: Theme.outline;
        visible: root.scope-label != "";
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: max(0px, Shape.extra-small - 1px);
            background: Theme.background;
        }

        scope-text := Text {
            x: 7px;
            y: 0;
            height: parent.height;
            vertical-alignment: center;
            text: root.scope-label;
            color: Theme.text-secondary;
            font-size: 10px;
            font-weight: 600;
        }
    }
}

component SettingsToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> selected: false;

    /* M3 switch: filled primary track with a large on-primary thumb when
     * on; outlined track with a small outline thumb when off. */
    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    /* Off: the outline is this fill under the inset track (no stroke). */
    background: root.checked ? Theme.primary : Theme.outline;
    Rectangle {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
        border-radius: self.height / 2;
        background: Theme.surface-container-highest;
        visible: !root.checked;
    }

    Rectangle {
        property <length> size: root.checked ? 18px : 12px;
        x: root.checked ? parent.width - self.size - 3px : 6px;
        y: (parent.height - self.size) / 2;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: root.checked ? Theme.on-primary : Theme.outline;
        animate x, width { duration: 120ms; easing: ease-in-out; }
    }
}

/* M3 slider (identical copy of the Quick Menu's MaterialSlider): thick
 * rounded track split by a bar handle with a small gap on each side;
 * active part primary, inactive part tonal. */
component MaterialSlider inherits Rectangle {
    in property <float> fraction: 0.0;

    property <length> track-h: 8px;
    property <length> gap: 3px;
    property <length> handle-x: (root.width - 4px) * root.fraction;

    height: 18px;
    background: #00000000;

    Rectangle {
        x: 0;
        y: (parent.height - root.track-h) / 2;
        width: max(0px, root.handle-x - root.gap);
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: Theme.primary;
        visible: self.width > 0px;
    }
    Rectangle {
        x: root.handle-x + 4px + root.gap;
        y: (parent.height - root.track-h) / 2;
        width: max(0px, parent.width - self.x);
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: Theme.surface-container-highest;
        visible: self.width > 0px;
    }

    Rectangle {
        x: root.handle-x;
        y: 0px;
        width: 4px;
        height: parent.height;
        border-radius: 2px;
        background: Theme.primary;
    }
}

component SettingsSelectableRow inherits Rectangle {
    in property <string> title: "";
    in property <string> detail: "";
    in property <string> value: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /* Live/current entity (connected network, connected device). */
    in property <bool> emphasized: false;
    /* Boolean setting: render the shared switch instead of value text. */
    in property <bool> toggle: false;
    in property <bool> toggle-on: false;
    /* Confirm opens a sub-page. */
    in property <bool> navigates: false;
    /* Circular image accessory (profile pictures). */
    in property <image> preview;
    in property <bool> show-preview: false;
    /* Colour dot accessory (RGB Lighting colour). */
    in property <color> swatch;
    in property <bool> show-swatch: false;
    /* Minimum share reserved for the title when the value itself is long.
     * Short/empty values consume only their preferred width, so the title
     * automatically gets the otherwise-unused space. */
    in property <float> title-fraction: 0.40;
    /* Waiting for the confirming press of a destructive action: the whole
     * row turns to the error roles and its detail line carries the prompt
     * (value and switch step aside), never a note beside the title. */
    in property <bool> armed: false;
    /* Level setting: the Quick Menu slider between title and value; the
     * value keeps a fixed slot so sliders line up row to row. */
    in property <bool> show-slider: false;
    in property <float> slider-fraction: 0.0;
    /* A running operation (download, installation): a bar along the
     * bottom of the row, 0..1; the value carries the percentage. */
    in property <bool> progress-shown: false;
    in property <float> progress: 0.0;

    property <string> shown-value: root.armed ? "" : root.value;
    property <bool> slider-shown: root.show-slider && !root.armed;
    property <length> slider-width: min(root.width * 0.34, 240px);
    property <length> slider-value-slot: 64px;

    /* The progress bar takes the detail line's place. */
    property <bool> has-detail: root.detail != "" || root.progress-shown;
    property <length> accessory-width: root.armed ? 0px : root.toggle ? 42px
        : root.show-preview ? 28px
        : root.show-swatch ? 18px
        : root.navigates ? 10px
        : 0px;
    property <length> value-right: root.width - 12px - root.accessory-width
        - (root.accessory-width > 0px ? 10px : 0px);

    /* Outline = the row's own fill, the face an inset fill above it: one
     * pass each instead of a stencil stroke (three passes in FemtoVG). */
    property <length> outline-width: root.selected ? 2px : 1px;
    border-radius: Shape.medium;
    background: root.armed ? Theme.error : root.selected ? Theme.primary : root.emphasized ? Theme.primary-container : Theme.surface-container-low;
    Rectangle {
        x: root.outline-width; y: root.outline-width;
        width: parent.width - 2 * root.outline-width; height: parent.height - 2 * root.outline-width;
        border-radius: max(0px, Shape.medium - root.outline-width);
        background: root.armed ? Theme.error-container
            : root.selected ? Theme.secondary-container : Theme.surface-container-low;
    }

    SettingsToggle {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        checked: root.toggle-on;
        selected: root.selected;
        visible: root.toggle && !root.armed;
    }

    Text {
        x: parent.width - 12px - root.accessory-width;
        y: 0;
        width: root.accessory-width;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: "›";
        color: root.selected ? Theme.on-secondary-container : Theme.outline;
        font-size: 22px;
        font-weight: 700;
        visible: root.navigates && !root.toggle && !root.show-preview && !root.show-swatch && !root.armed;
    }

    Rectangle {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: self.width / 2;
        background: root.selected ? Theme.on-secondary-container : Theme.outline-variant;
        visible: root.show-swatch && !root.toggle && !root.armed;
        Rectangle {
            x: 2px; y: 2px; width: 14px; height: 14px;
            border-radius: 7px;
            background: root.swatch;
        }
    }

    Rectangle {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 28px;
        height: 28px;
        /* Avatar frames: rounded square, corner = 22% of the side (as the
         * Rust mask, AVATAR_CORNER in main.rs). */
        border-radius: self.width * 0.22;
        /* Frame = fill under an inset fill (no stroke, no rounded clip). */
        background: root.selected ? Theme.accent : Theme.border-soft;
        visible: root.show-preview && !root.toggle && !root.armed;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: self.width * 0.22;
            background: #11151a;
        }

        Image {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            source: root.preview;
            image-fit: contain;
        }
    }

    Rectangle {
        x: 14px; y: parent.height * 0.70 - self.height / 2;
        width: parent.width - 28px; height: 5px;
        border-radius: 2px;
        background: Theme.surface-container-highest;
        visible: root.progress-shown;
        Rectangle {
            x: 0; y: 0; height: parent.height;
            width: parent.width * max(0.02, min(1.0, root.progress));
            border-radius: 2px;
            background: Theme.primary;
            animate width { duration: 400ms; easing: ease-out; }
        }
    }

    MaterialSlider {
        x: root.value-right - root.slider-value-slot - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: root.slider-width;
        fraction: max(0.0, min(1.0, root.slider-fraction));
        visible: root.slider-shown;
    }

    value-text := MarqueeText {
        width: root.shown-value == ""
            ? 0px
            : root.slider-shown ? root.slider-value-slot
            : min(self.content-width + 4px,
                  root.value-right * (0.97 - root.title-fraction));
        x: root.value-right - self.width;
        y: 0;
        height: parent.height;
        label: root.shown-value;
        text-color: root.selected ? Theme.on-secondary-container : Theme.text-dim;
        text-size: 14px;
        text-weight: 500;
        align-right: true;
        active: root.selected;
        visible: root.shown-value != "";
    }

    title-text := MarqueeText {
        x: 14px;
        y: root.has-detail ? parent.height * 0.08 : 0px;
        width: root.slider-shown ? max(0px, root.value-right - root.slider-value-slot - root.slider-width - 12px - 20px - 14px)
            : root.shown-value == ""
            ? max(0px, root.value-right - 14px)
            : max(0px, value-text.x - 20px);
        height: root.has-detail ? parent.height * 0.50 : parent.height;
        label: root.title;
        text-color: root.armed ? Theme.on-error-container : root.selected ? Theme.text : #d0d3d8;
        text-size: 17px;
        text-weight: root.selected || root.emphasized ? 600 : 500;
        active: root.selected;
    }

    MarqueeText {
        x: 14px;
        y: parent.height * 0.56;
        width: title-text.width;
        height: parent.height * 0.36;
        label: root.detail;
        text-color: root.armed ? Theme.on-error-container : Theme.text-faint;
        text-weight: root.armed ? 600 : 400;
        text-size: 12px;
        active: root.selected;
        visible: root.has-detail && !root.progress-shown;
    }
}

/* Generic dropdown sheet of a discrete multi-value choice (Settings pages
 * and the Game Details page). */
component SettingsChoiceSheet inherits Rectangle {
    in property <string> title;
    in property <[SettingsChoiceEntry]> options;
    in property <int> index;
    in property <int> scroll;
    in property <int> visible-rows;
    in property <length> list-y;
    in property <length> row-step;
    in property <length> row-height;

    background: Theme.surface-container-high;
    border-radius: Shape.large;
    clip: true;

    MarqueeText {
        x: 16px; y: 10px; width: parent.width - 32px; height: 28px;
        label: root.title;
        text-color: Theme.text; text-size: 18px; text-weight: 700;
        active: true;
    }
    for option[i] in root.options: SettingsSelectableRow {
        x: 12px;
        y: root.list-y + (i - root.scroll) * root.row-step;
        width: parent.width - 24px;
        height: root.row-height;
        title: option.label;
        selected: root.index == i;
        visible: i >= root.scroll && i < root.scroll + root.visible-rows;
    }
}

component SettingsActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    /* Waiting for the confirming press: error roles, the action name with
     * the prompt on a second line inside the button. */
    in property <bool> armed: false;
    in property <string> prompt: "";
    property <bool> two-lines: root.armed && root.prompt != "";

    /* M3 common button, full shape: tonal at rest, filled when focused;
     * destructive actions use the error roles. */
    border-radius: self.height / 2;
    background: root.armed ? Theme.error-container
        : root.danger
        ? (root.selected ? Theme.error : Theme.error-container)
        : (root.selected ? Theme.primary : Theme.primary-container);
    border-width: root.armed ? 2px : 0px;
    border-color: Theme.error;
    opacity: root.enabled ? 1.0 : 0.38;

    MarqueeText {
        x: 16px;
        y: root.two-lines ? parent.height * 0.08 : 0px;
        width: parent.width - 32px;
        height: root.two-lines ? parent.height * 0.50 : parent.height;
        label: root.label;
        text-color: root.armed ? Theme.on-error-container
            : root.danger
            ? (root.selected ? #690005 : Theme.on-error-container)
            : (root.selected ? Theme.on-primary : Theme.on-primary-container);
        text-size: root.two-lines ? 15px : 16px;
        text-weight: 600;
        align-center: true;
        active: root.selected;
    }
    if root.two-lines: MarqueeText {
        x: 16px;
        y: parent.height * 0.54;
        width: parent.width - 32px;
        height: parent.height * 0.36;
        label: root.prompt;
        text-color: Theme.on-error-container;
        text-size: 11px;
        text-weight: 500;
        align-center: true;
    }
}

/* Settings empty-state / helper line, aligned to the row grid. */
component SettingsHint inherits Text {
    horizontal-alignment: center;
    vertical-alignment: center;
    color: Theme.text-faint;
    font-size: 13px;
    wrap: word-wrap;
}

component StartActionHint inherits Rectangle {
    in property <string> label: "START";
    width: 50px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: Theme.text;
        font-size: 11px;
        font-weight: 800;
    }
}

/* L1/R1 at the ends of a game list header (GitHub #14): the previous /
 * next system or collection. Same look as the hint bar's key chips. */
component ShoulderHint inherits Rectangle {
    in property <string> label: "L1";
    in property <float> s: 1.0;
    width: 30px * root.s;
    height: 22px * root.s;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: Theme.text;
        font-size: 11px * root.s;
        font-weight: 800;
    }
}

component NavigationHint inherits Rectangle {
    width: 28px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "↕";
        color: Theme.text;
        font-size: 18px;
        font-weight: 800;
    }
}

component FaceButtonDot inherits Rectangle {
    in property <bool> active: false;

    /* Ring = an outer fill under an inner one, not border-width: FemtoVG
     * strokes borders through the stencil buffer (three passes + state
     * changes), a fill is one pass. */
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.active ? Theme.accent-light : Theme.text-disabled;
    Rectangle {
        x: 1px; y: 1px; width: 6px; height: 6px;
        border-radius: 3px;
        background: root.active ? Theme.accent : Theme.surface;
    }
}

component FaceButtonHint inherits Rectangle {
    in property <int> active-position: -1;

    width: 28px;
    height: 28px;
    background: #00000000;

    FaceButtonDot { x: 10px; y: 1px; active: root.active-position == 0; }
    FaceButtonDot { x: 19px; y: 10px; active: root.active-position == 1; }
    FaceButtonDot { x: 10px; y: 19px; active: root.active-position == 2; }
    FaceButtonDot { x: 1px; y: 10px; active: root.active-position == 3; }
}


/* One controller hint: keycap + label. Bars are HorizontalLayouts of these,
 * so spacing always follows the real width of localized labels. */
component ActionHint inherits HorizontalLayout {
    in property <string> kind: "face";
    in property <int> face-position: -1;
    in property <string> label: "";
    spacing: 8px;
    alignment: start;
    horizontal-stretch: 0;

    VerticalLayout {
        alignment: center;
        if root.kind == "nav": NavigationHint { }
        if root.kind == "start": StartActionHint { }
        if root.kind == "select": StartActionHint { label: "SELECT"; width: 58px; }
        if root.kind == "menu": MenuActionHint { }
        if root.kind == "face": FaceButtonHint { active-position: root.face-position; }
    }
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: 16px;
        font-weight: 500;
        vertical-alignment: center;
    }
}

/* Input Tester controller drawing.
 *
 * A generic, brand-free pad drawn on a 360x200 design grid scaled by `u`
 * (the largest unit that fits the given box), so every layout class gets
 * the same proportions without a master-canvas bitmap. Pressed controls
 * take the primary colour; triggers fill with their analog travel and
 * sticks move their knob with the logical value (-100..100). */
component TesterShoulder inherits Rectangle {
    in property <string> label;
    /* 0..100: analog travel (digital sources report 0 or 100). */
    in property <int> level: 0;
    in property <length> u: 1px;
    property <bool> active: root.level > 0;

    border-radius: 7 * root.u;
    background: Theme.surface-container-highest;
    border-width: 1px;
    border-color: root.active ? Theme.primary : Theme.outline-variant;

    /* Analog travel; rounded itself because the software renderer clips
     * to rectangles only. */
    Rectangle {
        x: 0; y: 0;
        width: parent.width * clamp(root.level, 0, 100) / 100;
        height: parent.height;
        border-radius: min(parent.border-radius, self.width / 2);
        background: Theme.primary;
    }
    Text {
        text: root.label;
        color: root.level >= 50 ? Theme.on-primary : Theme.text;
        font-size: max(10px, 11 * root.u);
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TesterFaceButton inherits Rectangle {
    in property <bool> pressed: false;
    border-radius: self.width / 2;
    background: root.pressed ? Theme.primary : Theme.surface-container-highest;
    border-width: 1px;
    border-color: root.pressed ? Theme.primary : Theme.outline;
}

component TesterDpadArm inherits Rectangle {
    in property <bool> pressed: false;
    /* Triangle pointing away from the centre, in a 10x10 viewbox. */
    in property <string> arrow;
    background: root.pressed ? Theme.primary : Theme.surface-container-highest;
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width, parent.height) * 0.5;
        height: self.width;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.arrow;
        fill: root.pressed ? Theme.on-primary : Theme.text-dim;
    }
}

component TesterStick inherits Rectangle {
    in property <int> axis-x: 0;
    in property <int> axis-y: 0;
    in property <bool> pressed: false;
    property <bool> moved: abs(root.axis-x) > 8 || abs(root.axis-y) > 8;
    property <length> knob: root.width * 0.48;
    property <length> travel: (root.width - root.knob) / 2 - 2px;

    border-radius: self.width / 2;
    background: Theme.surface-container-low;
    border-width: root.moved || root.pressed ? 2px : 1px;
    border-color: root.moved || root.pressed ? Theme.primary : Theme.outline;

    /* Crosshair: rest position reference. */
    Rectangle { x: parent.width * 0.2; y: parent.height / 2; width: parent.width * 0.6; height: 1px; background: Theme.outline-variant; }
    Rectangle { x: parent.width / 2; y: parent.height * 0.2; width: 1px; height: parent.height * 0.6; background: Theme.outline-variant; }

    Rectangle {
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        x: (parent.width - root.knob) / 2 + root.travel * clamp(root.axis-x, -100, 100) / 100;
        y: (parent.height - root.knob) / 2 + root.travel * clamp(root.axis-y, -100, 100) / 100;
        background: root.pressed ? Theme.primary : root.moved ? Theme.primary-container : Theme.surface-container-highest;
        border-width: 1px;
        border-color: root.moved || root.pressed ? Theme.primary : Theme.outline;
    }
}

component TesterPill inherits Rectangle {
    in property <string> label;
    in property <bool> pressed: false;
    in property <length> u: 1px;

    background: #00000000;
    Rectangle {
        x: (parent.width - self.width) / 2; y: 0;
        width: 30 * root.u; height: 12 * root.u;
        border-radius: self.height / 2;
        background: root.pressed ? Theme.primary : Theme.surface-container-highest;
        border-width: 1px;
        border-color: root.pressed ? Theme.primary : Theme.outline;
    }
    Text {
        y: 15 * root.u;
        width: parent.width;
        text: root.label;
        color: root.pressed ? Theme.primary : Theme.text-dim;
        font-size: max(8px, 8 * root.u);
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component ControllerTesterVisual inherits Rectangle {
    in property <bool> face-south: false;
    in property <bool> face-east: false;
    in property <bool> face-north: false;
    in property <bool> face-west: false;
    in property <bool> dpad-up: false;
    in property <bool> dpad-down: false;
    in property <bool> dpad-left: false;
    in property <bool> dpad-right: false;
    in property <bool> l1: false;
    in property <bool> r1: false;
    in property <bool> l2: false;
    in property <bool> r2: false;
    in property <bool> l3: false;
    in property <bool> r3: false;
    in property <bool> start: false;
    in property <bool> select: false;
    in property <bool> hotkey: false;
    in property <int> left-x: 0;
    in property <int> left-y: 0;
    in property <int> right-x: 0;
    in property <int> right-y: 0;
    in property <int> left-trigger: 0;
    in property <int> right-trigger: 0;

    /* Design grid unit and the centred grid origin. */
    property <length> u: min(root.width / 360, root.height / 200, 2.2px);
    property <length> ox: (root.width - 360 * root.u) / 2;
    property <length> oy: 0;
    /* Height the drawing needs at this width (pages place content below). */
    out property <length> drawn-height: 200 * root.u;

    background: #00000000;

    /* Shoulders sit behind the top edge of the body. */
    TesterShoulder { x: root.ox + 34 * root.u; y: root.oy + 2 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "L2"; level: max(root.l2 ? 100 : 0, root.left-trigger); }
    TesterShoulder { x: root.ox + 98 * root.u; y: root.oy + 8 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "L1"; level: root.l1 ? 100 : 0; }
    TesterShoulder { x: root.ox + 204 * root.u; y: root.oy + 8 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "R1"; level: root.r1 ? 100 : 0; }
    TesterShoulder { x: root.ox + 268 * root.u; y: root.oy + 2 * root.u; width: 58 * root.u; height: 24 * root.u; u: root.u;
        label: "R2"; level: max(root.r2 ? 100 : 0, root.right-trigger); }

    /* Body. */
    Rectangle {
        x: root.ox + 14 * root.u; y: root.oy + 34 * root.u;
        width: 332 * root.u; height: 164 * root.u;
        border-radius: 46 * root.u;
        background: Theme.surface-container;
        border-width: 1px;
        border-color: Theme.outline-variant;
    }

    /* D-pad: a cross whose arms light individually. */
    Rectangle {
        x: root.ox + 50 * root.u; y: root.oy + 54 * root.u;
        width: 72 * root.u; height: 72 * root.u;
        border-radius: 36 * root.u;
        background: Theme.surface-container-low;
    }
    TesterDpadArm { x: root.ox + 74 * root.u; y: root.oy + 58 * root.u; width: 24 * root.u; height: 25 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-up; arrow: "M5 1.5 L8.5 7 L1.5 7 Z"; }
    TesterDpadArm { x: root.ox + 74 * root.u; y: root.oy + 97 * root.u; width: 24 * root.u; height: 25 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-down; arrow: "M5 8.5 L8.5 3 L1.5 3 Z"; }
    TesterDpadArm { x: root.ox + 54 * root.u; y: root.oy + 78 * root.u; width: 25 * root.u; height: 24 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-left; arrow: "M1.5 5 L7 1.5 L7 8.5 Z"; }
    TesterDpadArm { x: root.ox + 93 * root.u; y: root.oy + 78 * root.u; width: 25 * root.u; height: 24 * root.u;
        border-radius: 4 * root.u; pressed: root.dpad-right; arrow: "M8.5 5 L3 1.5 L3 8.5 Z"; }
    Rectangle { x: root.ox + 78 * root.u; y: root.oy + 82 * root.u; width: 16 * root.u; height: 16 * root.u;
        background: Theme.surface-container-highest; }

    /* Face cluster by position, never by brand letter. */
    Rectangle {
        x: root.ox + 238 * root.u; y: root.oy + 54 * root.u;
        width: 72 * root.u; height: 72 * root.u;
        border-radius: 36 * root.u;
        background: Theme.surface-container-low;
    }
    TesterFaceButton { x: root.ox + 262 * root.u; y: root.oy + 56 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-north; }
    TesterFaceButton { x: root.ox + 284 * root.u; y: root.oy + 78 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-east; }
    TesterFaceButton { x: root.ox + 262 * root.u; y: root.oy + 100 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-south; }
    TesterFaceButton { x: root.ox + 240 * root.u; y: root.oy + 78 * root.u; width: 24 * root.u; height: 24 * root.u; pressed: root.face-west; }

    /* System buttons (legends are physical button names, not UI text). */
    TesterPill { x: root.ox + 128 * root.u; y: root.oy + 56 * root.u; width: 36 * root.u; height: 28 * root.u; u: root.u;
        label: "SELECT"; pressed: root.select; }
    TesterPill { x: root.ox + 162 * root.u; y: root.oy + 56 * root.u; width: 36 * root.u; height: 28 * root.u; u: root.u;
        label: "H"; pressed: root.hotkey; }
    TesterPill { x: root.ox + 196 * root.u; y: root.oy + 56 * root.u; width: 36 * root.u; height: 28 * root.u; u: root.u;
        label: "START"; pressed: root.start; }

    /* Sticks; pressing them is L3/R3. */
    TesterStick { x: root.ox + 118 * root.u; y: root.oy + 116 * root.u; width: 54 * root.u; height: 54 * root.u;
        axis-x: root.left-x; axis-y: root.left-y; pressed: root.l3; }
    TesterStick { x: root.ox + 188 * root.u; y: root.oy + 116 * root.u; width: 54 * root.u; height: 54 * root.u;
        axis-x: root.right-x; axis-y: root.right-y; pressed: root.r3; }
    Text { x: root.ox + 118 * root.u; y: root.oy + 172 * root.u; width: 54 * root.u; text: "L3";
        color: root.l3 ? Theme.primary : Theme.text-dim; font-size: max(8px, 8 * root.u); font-weight: 700; horizontal-alignment: center; }
    Text { x: root.ox + 188 * root.u; y: root.oy + 172 * root.u; width: 54 * root.u; text: "R3";
        color: root.r3 ? Theme.primary : Theme.text-dim; font-size: max(8px, 8 * root.u); font-weight: 700; horizontal-alignment: center; }
}


/* Home / Game Library cards (EPIC-001 Home, EPIC-011 browsing).
 *
 * One entry model for every Home row and the library grid. Rust fills it
 * from the nuubos-libraryd snapshot; Slint owns every pixel position.
 *   kind: 0 game, 1 New Collection, 2 custom collection, 3 system,
 *         4 application, 5 Find results (library grid header only)
 *   aspect: card width / height (real cover proportions when the cover is
 *           loaded, the system box-art shape otherwise)
 *   accent: system colour from the registry (not painted by the minimal Home)
 *   x-units: sum of the aspects of the cards before this one in its row,
 *            so variable-width rows are positioned without layout passes. */
/* Find a Game filter chip: label shows the choice ("Genre • Platform"). */
export struct FindChip {
    label: string,
    active: bool,
}

export struct HomeSheetItem {
    label: string,
    detail: string,
    check: int,
    armed: bool,
}

/* A save state row of the Start Game sheet: tile = slot number ("" =
 * the automatic save, drawn as a clock). */
export struct StartSheetItem {
    label: string,
    detail: string,
    tile: string,
    latest: bool,
}

export struct HomeCard {
    key: string,
    kind: int,
    title: string,
    detail: string,
    /* Games: the info panel's chips (detail stays the one-line form). */
    last-played: string,
    play-time: string,
    system-name: string,
    cover-path: string,
    cover: image,
    has-cover: bool,
    /* Apps: a full-colour icon (PortMaster's) fills the icon well. */
    full-icon: bool,
    aspect: float,
    x-units: float,
    accent: color,
    available: bool,
    /* Games: the user's tags as chips on the cover (libraryd field 13; a
     * status tag first, then Broken), localized label and colour; "" = none. */
    tag1: string,
    tag1-color: color,
    tag2: string,
    tag2-color: color,
    /* Systems and collections: covers of up to four of their games (most
     * recently played first), shown as a fanned stack. */
    p0: image,
    p1: image,
    p2: image,
    p3: image,
    previews: int,
    /* Focus of a cached card, set by Rust only on the cards that change
     * (library.rs sync_focus): a binding on the shared index would mark
     * every card layer dirty on every move. */
    focused: bool,
}

/* Plus sign (New Collection), own geometry. */
component HomePlusGlyph inherits Rectangle {
    in property <color> ink: #c9d6ff;
    background: #00000000;
    Rectangle { x: (parent.width - self.width) / 2; y: 0; width: parent.width * 0.16; height: parent.height;
        border-radius: self.width / 2; background: root.ink; }
    Rectangle { x: 0; y: (parent.height - self.height) / 2; width: parent.width; height: parent.height * 0.16;
        border-radius: self.height / 2; background: root.ink; }
}

/* Stacked-cards glyph for custom collections, drawn from rectangles. */
component HomeCollectionGlyph inherits Rectangle {
    in property <color> ink: #c9d6ff;
    background: #00000000;
    Rectangle {
        x: parent.width * 0.22; y: 0; width: parent.width * 0.78; height: parent.height * 0.78;
        border-radius: 3px; border-width: 2px; border-color: root.ink; background: #00000000;
    }
    Rectangle {
        x: 0; y: parent.height * 0.22; width: parent.width * 0.78; height: parent.height * 0.78;
        border-radius: 3px; background: root.ink;
    }
}

/* Focus ring of the Home cards and tiles: the nuubOS ring detached from
 * the item by a dark gap, plus a soft glow; it fades in and out. */
component HomeFocusRing inherits Rectangle {
    in property <length> radius;
    in property <bool> shown: false;

    /* The fade animates the fill colours, not `opacity`: an Opacity
     * below 1 over several children renders them through an offscreen
     * layer on every frame, even at 0 and even when clipped out, and every
     * card carries a ring. Hidden rings are not drawn at all. */
    property <float> fade: root.shown ? 1.0 : 0.0;
    animate fade { duration: 140ms; easing: ease-out; }

    background: #00000000;
    visible: root.fade > 0.0;

    /* Glow, ring and the dark gap as three concentric 3 px borders. Each
     * border's inner edge is the next one's outer edge (a border is drawn
     * inside its rectangle, inner radius = radius - width), the gap's inner
     * edge is the card outline. They used to be stacked fills of the whole
     * card under it: ~0.45 Mpx of fragments per frame for the focused cover,
     * a quarter of Home's fill on the Mali-G31 (HDMI 1280x720, 2026-10-15);
     * the strokes rasterize the bands only. */
    Rectangle {
        x: -9px; y: -9px; width: parent.width + 18px; height: parent.height + 18px;
        border-radius: root.radius + 9px;
        border-width: 3px;
        border-color: Theme.accent.transparentize(1.0 - 0.2 * root.fade);
    }
    Rectangle {
        x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px;
        border-radius: root.radius + 6px;
        border-width: 3px;
        border-color: Theme.primary.transparentize(1.0 - root.fade);
    }
    Rectangle {
        x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px;
        border-radius: root.radius + 3px;
        border-width: 3px;
        border-color: Theme.background;
    }
}

/* One Home/library card. The focus treatment (blue ring + soft glow) is
 * drawn outside the card bounds, separated from it by a thin gap, so
 * containers keep a small inset. Covers arrive pre-scaled with rounded
 * corners (Rust cover loader): the software renderer does not clip images
 * to border-radius.
 * Minimal and cheap for the software renderer: every face is one flat
 * matte surface (no gradients, no extra blended layers), so the cover art
 * and the focus ring are the only colour on screen. Games show their cover
 * (or a titled placeholder); tiles (favorites, collections, systems,
 * applications) show a centred monochrome icon + name. Tiles of an
 * unselected row recede through their ink colour. */
/* A tag on a game cover: dark pill (readable on any art), coloured dot,
 * label elided to the cover width. */
component HomeTagPill inherits Rectangle {
    in property <string> text;
    in property <color> dot;
    in property <length> label-size: 12px;
    in property <length> max-w: 200px;

    property <length> lead: root.label-size * 0.6;
    property <length> d: root.label-size * 0.62;
    height: root.label-size * 1.9;
    /* Left-aligned in the stack, as wide as its label. */
    HorizontalLayout {
        alignment: start;
        Rectangle {
            width: min(root.max-w, root.lead + root.d + root.label-size * 0.45 + measure.preferred-width + root.label-size * 0.7);
            border-radius: self.height / 2;
            /* Outline = fill under the pill (no stroke). */
            background: #3a3e45;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: self.height / 2;
                background: #0d0e10e6;
            }
            Rectangle {
                x: root.lead; y: (parent.height - self.height) / 2;
                width: root.d; height: root.d;
                border-radius: self.width / 2;
                background: root.dot;
            }
            measure := Text {
                visible: false;
                text: root.text;
                font-size: root.label-size;
                font-weight: 600;
            }
            Text {
                x: root.lead + root.d + root.label-size * 0.45;
                width: max(0px, parent.width - self.x - root.label-size * 0.7);
                height: parent.height;
                text: root.text;
                overflow: elide;
                vertical-alignment: center;
                color: #e3e6ea;
                font-size: root.label-size;
                font-weight: 600;
            }
        }
    }
}

component HomeCardView inherits Rectangle {
    in property <HomeCard> card;
    in property <bool> focused: false;
    /* False when the container draws the ring outside the card's cached
     * layer (cache-rendering-hint): a focus change then leaves the layer
     * valid instead of re-rendering it into a new texture. */
    in property <bool> draw-ring: true;
    in property <bool> dimmed: false;
    in property <string> unavailable-label: "";

    /* M3 medium shape; the Rust cover loader rounds covers the same way. */
    property <length> radius: max(Shape.medium, root.height * 0.06);
    property <bool> tile: root.card.kind != 0;
    property <length> icon-size: min(root.height * 0.42, root.width * 0.50);
    property <length> inset: max(6px, min(root.width, root.height) * 0.07);
    /* Badge text size (Unavailable, tags). */
    property <length> tag-size: max(10px, min(14px, root.height * 0.08));
    /* Tile icon/label colour: unselected rows recede without an extra
     * blended layer. */
    property <color> ink: root.dimmed ? #6f757e : root.focused ? Theme.on-secondary-container : #c9cdd3;

    background: #00000000;

    /* Glow + ring, detached from the card by a dark gap. Not even
     * instantiated when the container draws it: its fade animation would
     * tie a cached layer to the animation driver. */
    if root.draw-ring: HomeFocusRing {
        width: parent.width; height: parent.height;
        radius: root.radius;
        shown: root.focused;
    }

    /* Placeholder / tile face. */
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: root.focused ? Theme.secondary-container : Theme.surface-container;
        visible: root.tile || !root.card.has-cover;

        /* Game placeholder: title in the lower-left corner. */
        if !root.tile: Text {
            x: root.inset; y: root.inset;
            width: parent.width - 2 * root.inset; height: parent.height - 2 * root.inset;
            text: root.card.title;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: left;
            vertical-alignment: bottom;
            color: Theme.text;
            font-size: max(11px, min(parent.width * 0.08, parent.height * 0.07));
            font-weight: 700;
        }

        /* Tile icon. */
        if root.card.kind == 2: HomeCollectionGlyph {
            x: (parent.width - root.icon-size * 0.86) / 2; y: parent.height * 0.14 + root.icon-size * 0.07;
            width: root.icon-size * 0.86; height: root.icon-size * 0.80;
            ink: root.ink;
        }
        if (root.card.kind == 3 || root.card.kind == 4) && root.card.has-cover: Image {
            x: (parent.width - root.icon-size) / 2; y: parent.height * 0.14;
            width: root.icon-size; height: root.icon-size;
            source: root.card.cover;
            image-fit: contain;
            colorize: root.card.kind == 3 ? root.ink : #00000000;
        }
        if (root.card.kind == 3 || root.card.kind == 4) && !root.card.has-cover: Image {
            x: (parent.width - root.icon-size * 0.8) / 2; y: parent.height * 0.14 + root.icon-size * 0.1;
            width: root.icon-size * 0.8; height: root.icon-size * 0.8;
            source: @image-url("assets/icons/gamepad.svg");
            colorize: root.ink;
            image-fit: contain;
        }
        if root.tile: Text {
            x: parent.width * 0.06; y: parent.height * 0.66;
            width: parent.width * 0.88; height: parent.height * 0.24;
            text: root.card.title;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: root.ink;
            font-size: max(13px, parent.height * 0.12);
            font-weight: 500;
        }
    }

    /* Real cover art, already shaped to the card. */
    if !root.tile && root.card.has-cover: Image {
        width: parent.width; height: parent.height;
        source: root.card.cover;
        image-fit: fill;
    }


    /* UNAVAILABLE: entry kept, clearly marked (EPIC-011) with a compact
     * badge in the top-left corner over the faded art. */
    if !root.tile && !root.card.available: Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: #0d0e10a0;
        Rectangle {
            property <length> label-size: max(10px, min(14px, parent.height * 0.08));
            x: root.inset; y: root.inset;
            width: min(parent.width - 2 * root.inset, badge-text.preferred-width + self.label-size * 1.4);
            height: self.label-size * 1.9;
            border-radius: self.height / 2;
            /* Outline = fill under the pill (no stroke). */
            background: #3a3e45;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: self.height / 2;
                background: #0d0e10f0;
            }
            badge-text := Text {
                x: parent.label-size * 0.7; width: parent.width - parent.label-size * 1.4; height: parent.height;
                text: root.unavailable-label;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #c9cdd3;
                font-size: parent.label-size;
                font-weight: 600;
            }
        }
    }

    /* Tags: the same compact pills, a dot in the tag colour, stacked
     * under the top-left corner (below the Unavailable badge). */
    if !root.tile && (root.card.tag1 != "" || root.card.tag2 != ""): VerticalLayout {
        x: root.inset;
        y: root.inset + (root.card.available ? 0px : root.tag-size * 1.9 + 4px);
        width: root.width - 2 * root.inset;
        height: self.preferred-height;
        spacing: 4px;
        alignment: start;
        if root.card.tag1 != "": HomeTagPill {
            text: root.card.tag1; dot: root.card.tag1-color; label-size: root.tag-size;
            max-w: root.width - 2 * root.inset;
        }
        if root.card.tag2 != "": HomeTagPill {
            text: root.card.tag2; dot: root.card.tag2-color; label-size: root.tag-size;
            max-w: root.width - 2 * root.inset;
        }
    }

}

/* Shelf tile (systems, collections, Favorites, applications): the icon
 * in a tonal well (systems: tinted with the system colour), the name and
 * the count beside it, large enough to read from arm's length. Same focus
 * ring as the cards. */
component HomeTileView inherits Rectangle {
    in property <HomeCard> card;
    in property <bool> focused: false;
    /* See HomeCardView.draw-ring. */
    in property <bool> draw-ring: true;
    in property <bool> dimmed: false;
    in property <float> s: 1.0;

    property <length> radius: Shape.large;
    property <length> well: min(root.height - 28px * root.s, 56px * root.s);
    property <length> icon-size: root.well * 0.56;
    property <color> ink: root.focused ? Theme.on-secondary-container
        : root.dimmed ? Theme.text-secondary : Theme.text;

    background: #00000000;

    if root.draw-ring: HomeFocusRing {
        width: parent.width; height: parent.height;
        radius: root.radius;
        shown: root.focused;
    }

    /* No animated property inside the tile: it is cached in a layer, and an
     * animation binding makes the layer depend on the animation driver, so
     * every tile layer was re-rendered on the first frame after the UI went
     * idle (~40 ms, a missed frame on each new move). The ring outside the
     * layer carries the focus fade. */
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: root.focused ? Theme.secondary-container : Theme.surface-container;

        well := Rectangle {
            x: 14px * root.s; y: (parent.height - root.well) / 2;
            width: root.well; height: root.well;
            border-radius: Shape.medium;
            background: root.card.kind == 3 ? root.card.accent.transparentize(root.focused ? 0.35 : 0.55)
                : root.focused ? Theme.primary-container : Theme.surface-container-highest;

            if root.card.kind == 2: HomeCollectionGlyph {
                x: (parent.width - root.icon-size * 0.86) / 2; y: (parent.height - root.icon-size * 0.8) / 2;
                width: root.icon-size * 0.86; height: root.icon-size * 0.80;
                ink: root.ink;
            }
            if root.card.kind >= 3 && root.card.has-cover: Image {
                property <length> size: root.card.full-icon ? parent.width : root.icon-size;
                x: (parent.width - self.size) / 2; y: (parent.height - self.size) / 2;
                width: self.size; height: self.size;
                source: root.card.cover;
                image-fit: contain;
                colorize: root.card.kind == 3 ? #ffffff : #00000000;
            }
            if root.card.kind >= 3 && !root.card.has-cover: Image {
                x: (parent.width - root.icon-size * 0.8) / 2; y: (parent.height - root.icon-size * 0.8) / 2;
                width: root.icon-size * 0.8; height: root.icon-size * 0.8;
                source: @image-url("assets/icons/gamepad.svg");
                colorize: #ffffff;
                image-fit: contain;
            }
        }

        VerticalLayout {
            x: well.x + well.width + 14px * root.s;
            width: parent.width - self.x - 14px * root.s;
            height: parent.height;
            alignment: center;
            spacing: 2px * root.s;
            /* Marquee (animated) only on the focused tile, see above. */
            if root.focused: MarqueeText {
                height: 24px * root.s;
                label: root.card.title;
                text-color: root.ink;
                text-size: 18px * root.s;
                text-weight: 600;
                active: true;
            }
            if !root.focused: Text {
                height: 24px * root.s;
                text: root.card.title;
                overflow: elide;
                vertical-alignment: center;
                color: root.ink;
                font-size: 18px * root.s;
                font-weight: 600;
            }
            if root.card.detail != "": Text {
                height: 19px * root.s;
                text: root.card.detail;
                overflow: elide;
                vertical-alignment: center;
                color: root.focused ? Theme.on-secondary-container.transparentize(0.25) : Theme.text-secondary;
                font-size: 14px * root.s;
            }
        }
    }
}

/* Showcase card of the Systems and Collections rows (user request
 * 2026-10-10: the content first). The games themselves, as a fanned stack
 * of up to three covers on the right over a wash of the system colour
 * (collections: the primary colour); name and count on the left over a
 * fade of the card face. Without covers the platform glyph stands in.
 * New Collection (kind 1) is a tonal card with a plus. Cached in a layer
 * like the other cards: nothing in here animates. */
component HomeShowcaseView inherits Rectangle {
    in property <HomeCard> card;
    in property <bool> focused: false;
    in property <float> s: 1.0;

    property <length> radius: Shape.large;
    property <color> tint: root.card.kind == 3 ? root.card.accent : Theme.primary;
    property <color> face: root.focused ? Theme.secondary-container : Theme.surface-container;
    property <length> pad: 12px * root.s;
    property <length> cover-h: root.height - 2 * root.pad;
    property <length> cover-w: root.cover-h * 0.76;
    property <length> step: root.cover-w * 0.5;
    property <length> front-x: root.width - root.pad - root.cover-w;
    property <color> ink: root.focused ? Theme.on-secondary-container : Theme.text;

    background: #00000000;

    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        background: root.face;
        clip: true;

        /* Colour wash from the top right. */
        Rectangle {
            width: parent.width; height: parent.height;
            background: @linear-gradient(225deg, root.tint.transparentize(root.card.kind == 1 ? 0.88 : 0.42) 0%,
                root.tint.transparentize(0.86) 55%, root.tint.transparentize(1.0) 100%);
        }

        /* The stack: back covers first, each a little smaller and lower,
         * dimmed by a scrim. */
        if root.card.previews > 2: Rectangle {
            x: root.front-x - 2 * root.step; y: root.pad + root.cover-h * 0.12;
            width: root.cover-w * 0.84; height: root.cover-h * 0.84;
            Image { width: parent.width; height: parent.height; source: root.card.p2; image-fit: contain; vertical-alignment: bottom; }
            Rectangle { width: parent.width; height: parent.height; border-radius: Shape.medium; background: root.face.transparentize(0.6); }
        }
        if root.card.previews > 1: Rectangle {
            x: root.front-x - root.step; y: root.pad + root.cover-h * 0.06;
            width: root.cover-w * 0.92; height: root.cover-h * 0.92;
            Image { width: parent.width; height: parent.height; source: root.card.p1; image-fit: contain; vertical-alignment: bottom; }
            Rectangle { width: parent.width; height: parent.height; border-radius: Shape.medium; background: root.face.transparentize(0.82); }
        }
        if root.card.previews > 0: Image {
            x: root.front-x; y: root.pad;
            width: root.cover-w; height: root.cover-h;
            source: root.card.p0;
            image-fit: contain;
            vertical-alignment: bottom;
        }
        /* No covers yet: the platform glyph / collection stack / plus. */
        if root.card.previews == 0 && root.card.kind == 3: Image {
            property <length> d: root.cover-h * 0.62;
            x: root.width - root.pad - self.d - root.cover-w * 0.12; y: (parent.height - self.d) / 2;
            width: self.d; height: self.d;
            source: root.card.has-cover ? root.card.cover : @image-url("assets/icons/gamepad.svg");
            image-fit: contain;
            colorize: root.tint.transparentize(0.25);
        }
        if root.card.previews == 0 && root.card.kind == 2: HomeCollectionGlyph {
            property <length> d: root.cover-h * 0.5;
            x: root.width - root.pad - self.d - root.cover-w * 0.18; y: (parent.height - self.d) / 2;
            width: self.d; height: self.d * 0.92;
            ink: root.tint.transparentize(0.25);
        }
        if root.card.kind == 1: Rectangle {
            property <length> d: min(root.cover-h * 0.56, 72px * root.s);
            x: root.width - root.pad - self.d - root.cover-w * 0.15; y: (parent.height - self.d) / 2;
            width: self.d; height: self.d;
            border-radius: self.d / 2;
            background: root.focused ? Theme.primary : Theme.primary-container;
            HomePlusGlyph {
                x: parent.width * 0.3; y: parent.height * 0.3;
                width: parent.width * 0.4; height: parent.height * 0.4;
                ink: root.focused ? Theme.on-primary : Theme.on-primary-container;
            }
        }

        /* Fade of the face under the text. */
        Rectangle {
            width: parent.width * 0.58; height: parent.height;
            background: @linear-gradient(90deg, root.face.transparentize(0.05) 0%, root.face.transparentize(0.35) 50%, root.face.transparentize(1.0) 100%);
            visible: root.card.previews > 0;
        }

        /* Identity: icon well, then name and count at the bottom. */
        if root.card.kind == 3 || root.card.kind == 2: Rectangle {
            x: root.pad; y: root.pad;
            width: 30px * root.s; height: self.width;
            border-radius: Shape.medium;
            background: root.tint.transparentize(root.focused ? 0.15 : 0.35);
            if root.card.kind == 3 && root.card.has-cover: Image {
                x: parent.width * 0.18; y: parent.height * 0.18;
                width: parent.width * 0.64; height: parent.height * 0.64;
                source: root.card.cover;
                image-fit: contain;
                colorize: #ffffff;
            }
            if root.card.kind == 2: HomeCollectionGlyph {
                x: parent.width * 0.22; y: parent.height * 0.24;
                width: parent.width * 0.56; height: parent.height * 0.52;
                ink: #ffffff;
            }
        }
        VerticalLayout {
            x: root.pad; y: parent.height * 0.42;
            width: (root.card.previews > 0 ? root.front-x - root.step : root.width * 0.62) - root.pad;
            height: parent.height * 0.58 - root.pad * 0.6;
            alignment: end;
            spacing: 1px;
            Text {
                text: root.card.title;
                wrap: word-wrap;
                overflow: elide;
                max-height: 2 * 23px * root.s;
                vertical-alignment: bottom;
                color: root.ink;
                /* Long names get a smaller size so a long word is not
                 * broken ("Entertainme/nt" on 720x720, 2026-10-20). */
                font-size: (root.card.title.character-count > 22 ? 15px : 18px) * root.s;
                font-weight: 700;
            }
            if root.card.detail != "": Text {
                text: root.card.detail;
                overflow: elide;
                color: root.focused ? Theme.on-secondary-container.transparentize(0.2) : Theme.text-secondary;
                font-size: 14px * root.s;
            }
        }
    }
}

/* Section title; the selected section carries the nuubOS blue bar. */
component HomeSectionTitle inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> label-size: 17px;
    in property <string> status: "";
    in property <color> status-color: Theme.text-faint;
    property <length> status-w: min(root.width * 0.55, root.label-size * 22);

    background: #00000000;
    Rectangle {
        x: 0; y: (parent.height - self.height) / 2; width: 4px; height: root.label-size * 1.05;
        border-radius: 2px;
        background: Theme.primary;
        visible: root.active;
    }
    Text {
        x: root.active ? 14px : 0px;
        animate x { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        y: 0; width: parent.width - self.x - (root.status != "" ? root.status-w + 8px : 0px); height: parent.height;
        text: root.label;
        vertical-alignment: center;
        overflow: elide;
        color: root.active ? Theme.text : Theme.text-secondary;
        font-size: root.label-size;
        font-weight: 600;
    }
    if root.status != "": Text {
        x: parent.width - root.status-w; y: 0; width: root.status-w; height: parent.height;
        text: root.status;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        color: root.status-color;
        font-size: root.label-size * 0.86;
    }
}

/* One chip of the info panel: a dot in the system colour or an icon,
 * then the text (the Game Details chip style). */
component HomeInfoChip inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <color> dot: #00000000;
    in property <bool> has-dot: false;
    in property <bool> warn: false;
    in property <bool> dimmed: false;
    in property <float> s: 1.0;

    property <color> ink: root.warn ? Theme.warning : root.dimmed ? Theme.text-secondary : Theme.text;
    property <length> lead: (root.has-icon || root.has-dot ? 28px : 11px) * root.s;
    height: 30px * root.s;
    /* Same margin right as left of the content (11 px); a row too narrow
     * for every chip shrinks them down to min-width, eliding the label. */
    preferred-width: measure.preferred-width + root.lead + 11px * root.s;
    min-width: min(self.preferred-width, root.lead + 56px * root.s);
    max-width: self.preferred-width;
    border-radius: self.height / 2;
    background: root.warn ? Theme.warning.transparentize(0.86) : Theme.surface-container-high.transparentize(0.2);

    if root.has-dot: Rectangle {
        x: 11px * root.s; y: (parent.height - self.height) / 2;
        width: 10px * root.s; height: self.width;
        border-radius: self.width / 2;
        background: root.dot;
    }
    if root.has-icon && !root.has-dot: Image {
        x: 10px * root.s; y: (parent.height - self.height) / 2;
        width: 14px * root.s; height: self.width;
        source: root.icon;
        colorize: root.warn ? Theme.warning : Theme.text-secondary;
        image-fit: contain;
    }
    measure := Text {
        visible: false;
        text: root.text;
        font-size: 14px * root.s;
        font-weight: 500;
    }
    Text {
        x: root.lead;
        y: 0; height: parent.height;
        width: max(0px, parent.width - self.x - 11px * root.s);
        text: root.text;
        color: root.ink;
        font-size: 14px * root.s;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
}

/* The focused game under the covers: its title, then chips for the
 * system (in its colour), last played and time played, like the Game
 * Details page. A notice replaces the chips while it is shown. */
component HomeInfoPanel inherits Rectangle {
    in property <HomeCard> card;
    in property <string> notice: "";
    in property <string> unavailable-label;
    in property <float> s: 1.0;
    in property <bool> dimmed: false;
    property <length> line-h: 30px * root.s;

    background: #00000000;
    MarqueeText {
        x: 0; y: 0;
        width: parent.width;
        height: 32px * root.s;
        label: root.card.title;
        active: !root.dimmed;
        text-color: root.dimmed ? Theme.text-secondary : Theme.text;
        text-size: 24px * root.s;
        text-weight: 700;
    }
    if root.notice != "": MarqueeText {
        x: 0; y: 38px * root.s;
        width: parent.width; height: root.line-h;
        label: root.notice;
        active: true;
        text-color: #ffc94a;
        text-size: 15px * root.s;
        text-weight: 500;
    }
    /* Chips shrink (eliding their label) instead of being cut when a
     * long system name does not leave room for all of them. */
    Rectangle {
        visible: root.notice == "";
        x: 0; y: 38px * root.s;
        width: parent.width; height: root.line-h;
        clip: true;
        chip-row := HorizontalLayout {
            alignment: start;
            spacing: 8px * root.s;
            if !root.card.available: HomeInfoChip {
                text: root.unavailable-label; warn: true; s: root.s;
                icon: @image-url("assets/icons/triangle-exclamation.svg");
            }
            HomeInfoChip {
                text: root.card.system-name; dot: root.card.accent; has-dot: true; has-icon: false;
                dimmed: root.dimmed; s: root.s;
            }
            if root.card.last-played != "": HomeInfoChip {
                text: root.card.last-played; dimmed: root.dimmed; s: root.s;
                icon: @image-url("assets/icons/clock.svg");
            }
            if root.card.play-time != "": HomeInfoChip {
                text: root.card.play-time; dimmed: root.dimmed; s: root.s;
                icon: @image-url("assets/icons/play.svg");
            }
        }
    }
}

/* Empty Home section (M3 empty state on an outlined card): an icon, a
 * playful headline and one supporting line, so a fresh console invites to
 * play instead of hiding the section. It takes focus like a card. */
component HomeEmptyCard inherits Rectangle {
    in property <string> headline;
    in property <string> body;
    /* 0 controller (games), 1 shelf (systems), 2 apps. */
    in property <int> icon: 0;
    in property <bool> focused: false;
    in property <bool> dimmed: false;
    in property <float> s: 1.0;

    property <length> radius: max(Shape.medium, root.height * 0.06);
    property <bool> roomy: root.height >= 120px * root.s;
    /* As high as a shelf chip: headline and body on one line each. */
    property <bool> compact: root.height < 64px * root.s;
    property <length> icon-size: root.roomy ? min(root.height * 0.34, 64px * root.s)
        : root.compact ? root.height * 0.40 : min(root.height * 0.46, 36px * root.s);
    property <color> ink: root.dimmed ? #6f757e : Theme.text;

    background: #00000000;

    HomeFocusRing {
        width: parent.width; height: parent.height;
        radius: root.radius;
        shown: root.focused;
    }

    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: root.radius;
        /* Outline = this fill under an inset one (no stroke). */
        background: root.focused ? Theme.secondary-container : Theme.outline-variant;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: max(0px, root.radius - 1px);
            background: root.focused ? Theme.secondary-container : Theme.surface-container-low;
        }

        /* Icon in a tonal circle, text beside it. */
        icon-bubble := Rectangle {
            property <length> d: root.compact ? root.height * 0.72 : root.icon-size * 1.5;
            x: root.roomy ? 24px * root.s : root.compact ? (parent.height - self.d) / 2 : 14px * root.s;
            y: (parent.height - self.d) / 2;
            width: self.d; height: self.d;
            border-radius: self.d / 2;
            background: root.dimmed ? Theme.surface-container : Theme.primary-container;

            property <color> glyph: root.dimmed ? #6f757e : Theme.on-primary-container;
            if root.icon == 0: Image {
                x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2;
                width: root.icon-size; height: root.icon-size;
                source: @image-url("assets/icons/gamepad.svg");
                colorize: icon-bubble.glyph;
                image-fit: contain;
            }
            /* Folder and app grid: own geometry (no third-party icon). */
            if root.icon == 1: Path {
                x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2;
                width: root.icon-size; height: root.icon-size;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M2 5.5 C2 4.7 2.7 4 3.5 4 L9 4 L11 6 L20.5 6 C21.3 6 22 6.7 22 7.5 L22 18.5 C22 19.3 21.3 20 20.5 20 L3.5 20 C2.7 20 2 19.3 2 18.5 Z";
                fill: icon-bubble.glyph;
            }
            if root.icon == 2: Path {
                x: (parent.width - root.icon-size) / 2; y: (parent.height - root.icon-size) / 2;
                width: root.icon-size; height: root.icon-size;
                viewbox-width: 24; viewbox-height: 24;
                commands: "M3 3 L10.5 3 L10.5 10.5 L3 10.5 Z M13.5 3 L21 3 L21 10.5 L13.5 10.5 Z M3 13.5 L10.5 13.5 L10.5 21 L3 21 Z M13.5 13.5 L21 13.5 L21 21 L13.5 21 Z";
                fill: icon-bubble.glyph;
            }
        }

        VerticalLayout {
            x: icon-bubble.x + icon-bubble.width + (root.roomy ? 20px : 14px) * root.s;
            y: 0;
            width: parent.width - self.x - 20px * root.s;
            height: parent.height;
            alignment: center;
            spacing: (root.compact ? 1px : 6px) * root.s;

            Text {
                text: root.headline;
                color: root.ink;
                font-size: (root.roomy ? 22px : root.compact ? 15px : 18px) * root.s;
                font-weight: 600;
                wrap: root.compact ? no-wrap : word-wrap;
                overflow: elide;
            }
            Text {
                text: root.body;
                color: root.dimmed ? #6f757e : Theme.text-secondary;
                font-size: (root.roomy ? 15px : root.compact ? 12px : 13px) * root.s;
                wrap: root.compact ? no-wrap : word-wrap;
                overflow: elide;
                max-height: (root.roomy ? 3 : 2) * 20px * root.s;
            }
        }
    }
}

/* One Home section: title and a horizontal strip. Recently Played shows
 * covers (card-h tall, width from the cover aspect) with the focused
 * game's info panel under them (info-h, also while another section is
 * selected, dimmed, so nothing moves); the shelves show tiles
 * (chip-w > 0). The focused item is kept at the left edge (console
 * catalogue style) until the end of the strip; the strip glides there
 * with the M3 emphasized curve. Every card is a cached layer, so a
 * scroll only composites them. Notices of a tile section go to the right
 * of its title. */
component HomeRow inherits Rectangle {
    in property <string> label;
    in property <[HomeCard]> cards;
    in property <int> index: 0;
    in property <bool> active: false;
    in property <length> card-h;
    in property <length> chip-w: 0px;
    /* Systems / Collections: showcase cards of this width. */
    in property <length> show-w: 0px;
    in property <length> label-h;
    in property <length> info-h: 0px;
    in property <length> pad;
    in property <length> gap;
    in property <float> s: 1.0;
    in property <string> notice: "";
    in property <string> status: "";
    in property <string> unavailable-label;
    /* Shown instead of the cards when the row is empty. */
    in property <string> empty-headline;
    in property <string> empty-body;
    in property <int> empty-icon: 0;

    property <bool> empty: root.cards.length == 0;
    property <bool> show: root.show-w > 0px;
    property <bool> chips: root.chip-w > 0px || root.show;
    property <length> slot-w: root.show ? root.show-w : root.chip-w;
    property <length> focus-x: root.chips ? root.index * (root.slot-w + root.gap)
        : root.cards[root.index].x-units * root.card-h + root.index * root.gap;
    property <HomeCard> last: root.cards[root.cards.length - 1];
    property <HomeCard> focused: root.cards[root.index];
    property <length> total-w: root.chips ? root.cards.length * (root.slot-w + root.gap) - root.gap
        : (root.last.x-units + root.last.aspect) * root.card-h + (root.cards.length - 1) * root.gap;
    property <length> h-scroll: max(0px, min(root.focus-x, root.total-w - (root.width - 2 * root.pad)));
    /* Info shows in the title bar when this row has no info panel. */
    property <bool> title-notice: root.active && root.notice != "" && (root.chips || root.empty);

    height: root.label-h + root.card-h + root.info-h;
    background: #00000000;

    HomeSectionTitle {
        x: root.pad; y: 0; width: parent.width - 2 * root.pad; height: root.label-h - 8px * root.s;
        label: root.label;
        active: root.active;
        label-size: 19px * root.s;
        status: root.title-notice ? root.notice : root.active ? root.status : "";
        status-color: root.title-notice ? #ffc94a : Theme.text-faint;
    }

    /* Strip with 12 px above/below the cards for the focus glow. */
    Rectangle {
        x: 0; y: root.label-h - 12px; width: parent.width; height: root.card-h + 24px;
        clip: true;
        background: #00000000;

        Rectangle {
            x: root.pad - root.h-scroll; y: 12px; width: root.total-w; height: root.card-h;
            background: #00000000;
            animate x { duration: 260ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

            for card[i] in root.cards: Rectangle {
                x: root.chips ? i * (root.slot-w + root.gap) : card.x-units * root.card-h + i * root.gap;
                y: 0;
                width: root.chips ? root.slot-w : card.aspect * root.card-h;
                height: root.card-h;
                background: #00000000;

                /* Ring outside the cached card layer (draw-ring: false). */
                HomeFocusRing {
                    width: parent.width; height: parent.height;
                    radius: root.chips ? Shape.large : max(Shape.medium, parent.height * 0.06);
                    shown: root.active && i == root.index;
                }
                if !root.chips: HomeCardView {
                    width: parent.width; height: parent.height;
                    cache-rendering-hint: true;
                    draw-ring: false;
                    card: card;
                    focused: card.focused;
                    unavailable-label: root.unavailable-label;
                }
                if root.show: HomeShowcaseView {
                    width: parent.width; height: parent.height;
                    cache-rendering-hint: true;
                    card: card;
                    focused: card.focused;
                    s: root.s;
                }
                if root.chips && !root.show: HomeTileView {
                    width: parent.width; height: parent.height;
                    cache-rendering-hint: true;
                    draw-ring: false;
                    card: card;
                    focused: card.focused;
                    s: root.s;
                }
                /* An inactive row recedes under a scrim drawn outside the
                 * cached tile layers: changing their ink would re-render
                 * every tile layer of both rows on each row change (Slint
                 * re-renders a dirty layer even when it is clipped out). */
                if root.chips: Rectangle {
                    width: parent.width; height: parent.height;
                    border-radius: Shape.large;
                    background: Theme.background.transparentize(0.62);
                    visible: !root.active;
                }
            }
        }
    }

    /* An empty row has no info panel: its card already says it all. */
    if root.empty: HomeEmptyCard {
        x: root.pad; y: root.label-h;
        width: parent.width - 2 * root.pad;
        height: root.card-h + root.info-h;
        headline: root.empty-headline;
        body: root.empty-body;
        icon: root.empty-icon;
        focused: root.active;
        dimmed: !root.active;
        s: root.s;
    }

    if root.info-h > 0px && !root.empty: HomeInfoPanel {
        x: root.pad; y: root.label-h + root.card-h + 12px * root.s;
        width: parent.width - 2 * root.pad; height: root.info-h - 12px * root.s;
        card: root.focused;
        notice: root.active ? root.notice : "";
        unavailable-label: root.unavailable-label;
        dimmed: !root.active;
        s: root.s;
    }
}

/* Power dialog choice (M3 tonal button). Armed = waiting for the
 * confirming press: error roles, the prompt under the action name inside
 * the button. */
/* Game Details page (EPIC-016): a console game page instead of a
 * settings list. A blurred, dimmed backdrop of the game (its screenshot,
 * else its cover; blurred by Rust), the cover as the hero, title, system,
 * one metadata line and chips (players, rating, play time, warnings), the
 * description (up/down scrolls it) and one row of actions moved with
 * left/right: Play is a labelled primary pill, the others are round icon
 * buttons whose label opens while focused. The line under the actions says
 * what the focused action does (or its armed prompt / the last notice). */
export struct DetailAction {
    /* DetailIcon index. */
    icon: int,
    label: string,
    primary: bool,
    /* Toggle state (Favorite). */
    on: bool,
    enabled: bool,
    /* Waiting for the confirming press (error style). */
    armed: bool,
    /* Work in progress (spinner icon). */
    busy: bool,
}

export struct DetailChip {
    icon: int,
    text: string,
    warn: bool,
}

/* Font Awesome Free icons (assets/icons, CC BY 4.0) by index: 0 play,
 * 1 star, 2 collections, 3 settings, 4 get metadata, 5 update metadata,
 * 6 accept, 7 reject, 8 BIOS, 9 reset, 10 delete, 11 players, 12 time,
 * 13 warning, 14 star outline, 15 more, 16 working, 17 search; nuubOS
 * own geometry: 18 PC, 19 add; Font Awesome again: 20 folder, 21 file,
 * 22 image, 23 music, 24 film, 25 hard drive, 26 network, 27 SD card,
 * 28 archive, 29 palette, 30 new folder, 31 paste, 32 server, 33 TV,
 * 34 power, 35 tag, 36 gamepad. */
component DetailIcon inherits Image {
    in property <int> icon;
    in property <color> ink;
    source: root.icon == 0 ? @image-url("assets/icons/play.svg")
        : root.icon == 1 ? @image-url("assets/icons/star.svg")
        : root.icon == 2 ? @image-url("assets/icons/layer-group.svg")
        : root.icon == 3 ? @image-url("assets/icons/sliders.svg")
        : root.icon == 4 ? @image-url("assets/icons/cloud-arrow-down.svg")
        : root.icon == 5 ? @image-url("assets/icons/rotate.svg")
        : root.icon == 6 ? @image-url("assets/icons/check.svg")
        : root.icon == 7 ? @image-url("assets/icons/xmark.svg")
        : root.icon == 8 ? @image-url("assets/icons/microchip.svg")
        : root.icon == 9 ? @image-url("assets/icons/rotate-left.svg")
        : root.icon == 10 ? @image-url("assets/icons/trash-can.svg")
        : root.icon == 11 ? @image-url("assets/icons/user-group.svg")
        : root.icon == 12 ? @image-url("assets/icons/clock.svg")
        : root.icon == 13 ? @image-url("assets/icons/triangle-exclamation.svg")
        : root.icon == 14 ? @image-url("assets/icons/star-outline.svg")
        : root.icon == 15 ? @image-url("assets/icons/chevron-down.svg")
        : root.icon == 17 ? @image-url("assets/icons/magnifying-glass.svg")
        : root.icon == 18 ? @image-url("assets/icons/desktop.svg")
        : root.icon == 19 ? @image-url("assets/icons/plus.svg")
        : root.icon == 20 ? @image-url("assets/icons/folder.svg")
        : root.icon == 21 ? @image-url("assets/icons/file.svg")
        : root.icon == 22 ? @image-url("assets/icons/image.svg")
        : root.icon == 23 ? @image-url("assets/icons/music.svg")
        : root.icon == 24 ? @image-url("assets/icons/film.svg")
        : root.icon == 25 ? @image-url("assets/icons/hard-drive.svg")
        : root.icon == 26 ? @image-url("assets/icons/network-wired.svg")
        : root.icon == 27 ? @image-url("assets/icons/sd-card.svg")
        : root.icon == 28 ? @image-url("assets/icons/box-archive.svg")
        : root.icon == 29 ? @image-url("assets/icons/palette.svg")
        : root.icon == 30 ? @image-url("assets/icons/folder-plus.svg")
        : root.icon == 31 ? @image-url("assets/icons/paste.svg")
        : root.icon == 32 ? @image-url("assets/icons/server.svg")
        : root.icon == 33 ? @image-url("assets/icons/tv.svg")
        : root.icon == 34 ? @image-url("assets/icons/power-off.svg")
        : root.icon == 35 ? @image-url("assets/icons/tag.svg")
        : root.icon == 36 ? @image-url("assets/icons/gamepad.svg")
        : @image-url("assets/icons/circle-notch.svg");
    colorize: root.ink;
    image-fit: contain;
}

component DetailActionButton inherits Rectangle {
    in property <DetailAction> action;
    in property <bool> focused: false;
    in property <float> s: 1.0;
    /* Many actions: the primary one keeps its label only while focused. */
    in property <bool> compact: false;

    property <length> h: 42px * root.s;
    property <length> icon-size: root.h * 0.40;
    property <bool> open: (root.action.primary && !root.compact) || root.focused;
    property <color> ink: !root.action.enabled ? Theme.text-disabled
        : root.action.armed ? Theme.on-error-container
        : root.action.primary ? (root.focused ? Theme.on-primary : Theme.on-primary-container)
        : root.action.on ? Theme.primary
        : root.focused ? Theme.on-secondary-container
        : Theme.text-secondary;

    height: root.h;
    width: root.open ? root.h * 0.42 + root.icon-size + 8px * root.s + label.preferred-width + root.h * 0.48 : root.h;
    border-radius: root.h / 2;
    background: root.action.armed ? Theme.error-container
        : root.action.primary ? (root.focused ? Theme.primary : Theme.primary-container)
        : root.focused ? Theme.secondary-container
        : Theme.surface-container-high.transparentize(0.25);
    animate width { duration: 140ms; easing: ease-out; }

    /* Focus ring detached by a gap, as on the Home cards. */
    Rectangle {
        x: -5px; y: -5px; width: parent.width + 10px; height: parent.height + 10px;
        border-radius: parent.border-radius + 5px;
        border-width: 2.5px;
        border-color: root.action.armed ? Theme.error : Theme.primary;
        visible: root.focused;
    }
    DetailIcon {
        x: root.open ? root.h * 0.42 : (parent.width - root.icon-size) / 2;
        y: (parent.height - root.icon-size) / 2;
        width: root.icon-size; height: root.icon-size;
        icon: root.action.busy ? 16 : root.action.icon == 1 && !root.action.on ? 14 : root.action.icon;
        ink: root.ink;
    }
    label := Text {
        x: root.h * 0.42 + root.icon-size + 8px * root.s;
        y: 0; height: parent.height;
        text: root.action.label;
        color: root.ink;
        font-size: 15px * root.s;
        font-weight: 600;
        vertical-alignment: center;
        visible: root.open;
    }
}

component DetailChipView inherits Rectangle {
    in property <DetailChip> chip;
    in property <float> s: 1.0;

    property <color> ink: root.chip.warn ? Theme.warning : root.chip.icon == 1 ? #ffc94a : Theme.text-secondary;
    height: 26px * root.s;
    border-radius: self.height / 2;
    background: root.chip.warn ? Theme.warning.transparentize(0.86) : Theme.surface-container-high.transparentize(0.35);
    HorizontalLayout {
        padding-left: 10px * root.s; padding-right: 11px * root.s;
        spacing: 6px * root.s;
        DetailIcon {
            y: (parent.height - self.height) / 2;
            width: 13px * root.s; height: 13px * root.s;
            icon: root.chip.icon; ink: root.ink;
        }
        /* Elides when the row is too narrow (720x720, 640x480): the
         * layout shrinks the chips instead of cutting them at the edge. */
        Text {
            text: root.chip.text;
            color: root.chip.warn ? Theme.warning : Theme.text;
            font-size: 13px * root.s;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            min-width: 24px * root.s;
        }
    }
}

/* Detail chips that wrap onto further rows when the column is too narrow
 * (720x720, 640x480): every chip keeps its whole text. Up to five chips
 * (Game Details has at most five); a single chip wider than the column is
 * the only case that elides. */
component ChipFlow inherits Rectangle {
    in property <[DetailChip]> chips;
    in property <float> s: 1.0;
    property <length> gap: 6px * root.s;
    property <length> row-h: 26px * root.s;
    property <int> n: min(5, root.chips.length);
    property <length> w0: min(c0.preferred-width, root.width);
    property <length> w1: min(c1.preferred-width, root.width);
    property <length> w2: min(c2.preferred-width, root.width);
    property <length> w3: min(c3.preferred-width, root.width);
    property <length> w4: min(c4.preferred-width, root.width);
    property <length> x0: 0px;
    property <int> r0: 0;
    property <bool> b1: root.x0 + root.w0 + root.gap + root.w1 > root.width && root.x0 + root.w0 > 0px;
    property <length> x1: root.b1 ? 0px : root.x0 + root.w0 + root.gap;
    property <int> r1: root.b1 ? root.r0 + 1 : root.r0;
    property <bool> b2: root.x1 + root.w1 + root.gap + root.w2 > root.width && root.x1 + root.w1 > 0px;
    property <length> x2: root.b2 ? 0px : root.x1 + root.w1 + root.gap;
    property <int> r2: root.b2 ? root.r1 + 1 : root.r1;
    property <bool> b3: root.x2 + root.w2 + root.gap + root.w3 > root.width && root.x2 + root.w2 > 0px;
    property <length> x3: root.b3 ? 0px : root.x2 + root.w2 + root.gap;
    property <int> r3: root.b3 ? root.r2 + 1 : root.r2;
    property <bool> b4: root.x3 + root.w3 + root.gap + root.w4 > root.width && root.x3 + root.w3 > 0px;
    property <length> x4: root.b4 ? 0px : root.x3 + root.w3 + root.gap;
    property <int> r4: root.b4 ? root.r3 + 1 : root.r3;
    out property <int> rows: root.n == 0 ? 0 : root.n == 1 ? 1 : root.n == 2 ? root.r1 + 1
        : root.n == 3 ? root.r2 + 1 : root.n == 4 ? root.r3 + 1 : root.r4 + 1;
    height: root.rows * root.row-h + max(0, root.rows - 1) * root.gap;
    c0 := DetailChipView {
        chip: root.n > 0 ? root.chips[0] : { icon: 0, text: "", warn: false };
        s: root.s;
        x: root.x0;
        y: root.r0 * (root.row-h + root.gap);
        width: min(self.preferred-width, root.width);
        visible: root.n > 0;
    }
    c1 := DetailChipView {
        chip: root.n > 1 ? root.chips[1] : { icon: 0, text: "", warn: false };
        s: root.s;
        x: root.x1;
        y: root.r1 * (root.row-h + root.gap);
        width: min(self.preferred-width, root.width);
        visible: root.n > 1;
    }
    c2 := DetailChipView {
        chip: root.n > 2 ? root.chips[2] : { icon: 0, text: "", warn: false };
        s: root.s;
        x: root.x2;
        y: root.r2 * (root.row-h + root.gap);
        width: min(self.preferred-width, root.width);
        visible: root.n > 2;
    }
    c3 := DetailChipView {
        chip: root.n > 3 ? root.chips[3] : { icon: 0, text: "", warn: false };
        s: root.s;
        x: root.x3;
        y: root.r3 * (root.row-h + root.gap);
        width: min(self.preferred-width, root.width);
        visible: root.n > 3;
    }
    c4 := DetailChipView {
        chip: root.n > 4 ? root.chips[4] : { icon: 0, text: "", warn: false };
        s: root.s;
        x: root.x4;
        y: root.r4 * (root.row-h + root.gap);
        width: min(self.preferred-width, root.width);
        visible: root.n > 4;
    }
}

component GameDetailsPage inherits Rectangle {
    in property <float> s: 1.0;
    in property <string> title;
    in property <string> system-name;
    in property <string> meta;
    in property <string> description;
    in property <image> cover;
    in property <bool> has-cover: false;
    in property <image> backdrop;
    in property <bool> has-backdrop: false;
    in property <[DetailChip]> chips;
    in property <[DetailAction]> actions;
    in property <int> index: 0;
    in property <string> caption;
    in property <bool> caption-armed: false;
    in property <string> notice;
    in property <int> desc-step: 0;
    /* Scroll steps the description needs to show its end (Rust clamps). */
    out property <int> desc-steps: max(0, ceil((desc.preferred-height - desc-box.height) / root.step-px));

    property <length> pad: 22px * root.s;
    property <length> bar-h: 42px * root.s;
    property <length> caption-h: 20px * root.s;
    property <length> bar-y: root.height - 10px * root.s - root.caption-h - 10px * root.s - root.bar-h;
    property <length> hero-y: 16px * root.s;
    property <length> hero-h: root.bar-y - 18px * root.s - root.hero-y;
    property <float> aspect: root.has-cover && root.cover.height > 0
        ? max(0.5, min(1.8, root.cover.width / root.cover.height)) : 0.72;
    /* Square and 4:3 screens give the text column more of the width. */
    property <length> cover-w: min(root.hero-h * root.aspect,
        root.width * (root.width < root.height * 1.15 ? 0.34 : root.width < root.height * 1.5 ? 0.37 : 0.40));
    property <length> cover-h: root.cover-w / root.aspect;
    property <length> text-x: root.pad + root.cover-w + 22px * root.s;
    property <length> desc-size: 14px * root.s;
    property <length> step-px: root.desc-size * 1.3 * 3;

    clip: true;

    /* Everything but the action bar as one cached layer (background,
     * backdrop, scrims, hero cover and its shadow, the text column): it
     * changes with the game and while the description scrolls, but was
     * redrawn on every frame of an action-bar move (~3.5 screens of blended
     * fill and the description's text per frame on the HDMI Mali-G31,
     * 2026-10-15). */
    Rectangle {
        width: parent.width; height: parent.height;
        cache-rendering-hint: true;
        background: Theme.background;

        if root.has-backdrop: Image {
            width: parent.width; height: parent.height;
            source: root.backdrop;
            image-fit: ImageFit.cover;
            opacity: 0.55;
        }
        /* Scrims: the text side and the action bar stay readable. */
        Rectangle {
            width: parent.width; height: parent.height;
            background: @linear-gradient(90deg, Theme.background.transparentize(0.55) 0%,
                Theme.background.transparentize(0.25) 45%, Theme.background.transparentize(0.1) 100%);
        }
        Rectangle {
            y: root.bar-y - 40px * root.s; width: parent.width; height: parent.height - self.y;
            background: @linear-gradient(180deg, Theme.background.transparentize(1.0) 0%,
                Theme.background.transparentize(0.1) 45%, Theme.background 100%);
        }

        /* Hero cover (pre-rounded by Rust), or a titled placeholder. */
        Rectangle {
            x: root.pad; y: root.hero-y + 4px * root.s;
            width: root.cover-w; height: root.cover-h;
            border-radius: max(Shape.medium, self.height * 0.04);
            background: root.has-cover ? Theme.background : Theme.surface-container;
            drop-shadow-blur: 24px * root.s;
            drop-shadow-offset-y: 6px * root.s;
            drop-shadow-color: #000000b0;

            if root.has-cover: Image {
                width: parent.width; height: parent.height;
                source: root.cover;
                image-fit: contain;
            }
            if !root.has-cover: Image {
                x: (parent.width - self.width) / 2; y: parent.height * 0.30;
                width: parent.width * 0.42; height: self.width * 0.8;
                source: @image-url("assets/icons/gamepad.svg");
                colorize: Theme.text-faint;
                image-fit: contain;
            }
            if !root.has-cover: Text {
                x: 12px * root.s; y: parent.height * 0.62;
                width: parent.width - 24px * root.s; height: parent.height * 0.34;
                text: root.system-name;
                color: Theme.text-dim;
                font-size: 13px * root.s;
                font-weight: 600;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            x: root.text-x; y: root.hero-y;
            width: root.width - root.text-x - root.pad; height: root.hero-h;
            spacing: 6px * root.s;

            Text {
                text: root.system-name;
                color: Theme.primary;
                font-size: 12px * root.s;
                font-weight: 700;
                letter-spacing: 1.2px;
                overflow: elide;
                vertical-stretch: 0;
            }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 26px * root.s;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                max-height: 26px * root.s * 2.6;
                vertical-stretch: 0;
            }
            if root.meta != "": Text {
                text: root.meta;
                color: Theme.text-secondary;
                font-size: 14px * root.s;
                overflow: elide;
                vertical-stretch: 0;
            }
            if root.chips.length > 0: Rectangle {
                vertical-stretch: 0;
                height: game-chips.height + 8px * root.s;
                game-chips := ChipFlow { y: 4px * root.s; width: parent.width; chips: root.chips; s: root.s; }
            }
            /* Place of the description: drawn above the cached layer (below)
             * so scrolling it does not re-render the whole page. */
            desc-box := Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    /* The description over the cached layer, where desc-box is laid out. */
    Rectangle {
        x: root.text-x + desc-box.x; y: root.hero-y + desc-box.y;
        width: desc-box.width; height: desc-box.height;
        clip: true;
        desc := Text {
            x: 0;
            y: -min(root.desc-step * root.step-px, max(0px, self.preferred-height - parent.height));
            width: parent.width;
            height: self.preferred-height;
            text: root.description;
            color: Theme.text-secondary;
            font-size: root.desc-size;
            wrap: word-wrap;
            animate y { duration: 160ms; easing: ease-out; }
        }
        /* More text below: a fade and a chevron. */
        Rectangle {
            y: parent.height - 22px * root.s; width: parent.width; height: 22px * root.s;
            background: @linear-gradient(180deg, Theme.background.transparentize(1.0) 0%, Theme.background.transparentize(0.15) 100%);
            visible: root.desc-step < root.desc-steps;
            DetailIcon {
                x: parent.width - self.width; y: parent.height - self.height;
                width: 12px * root.s; height: 12px * root.s;
                icon: 15; ink: Theme.text-dim;
            }
        }
    }

    HorizontalLayout {
        x: root.pad; y: root.bar-y;
        width: root.width - 2 * root.pad; height: root.bar-h;
        spacing: 10px * root.s;
        alignment: start;
        for action[i] in root.actions: DetailActionButton {
            action: action;
            focused: root.index == i;
            s: root.s;
            compact: root.actions.length >= 8;
        }
    }
    MarqueeText {
        x: root.pad; y: root.bar-y + root.bar-h + 10px * root.s;
        width: root.width - 2 * root.pad; height: root.caption-h;
        label: root.notice != "" ? root.notice : root.caption;
        text-color: root.notice != "" ? #ffc94a : root.caption-armed ? Theme.error : Theme.text-dim;
        text-size: 13px * root.s;
        text-weight: 400;
        active: true;
    }
}

/* Application page (Moonlight, Steam Link): the Game Details look for an
 * application. The app's colour washes the top, its icon is the hero;
 * kicker, title, one meta line and chips beside it, then its entries
 * (PCs, PC applications) as rows, or a large pairing PIN, or a download
 * progress bar, and one row of actions with the caption of the focused
 * item under it. index runs over the entries, then the actions (the
 * services' own order); up/down and left/right both move. */
/* A controller hint of a full-screen application (Files, Media): kind
 * "face" with role 0 confirm, 1 back, 2 north, 3 west; or "nav" / "select". */
export struct AppHint {
    kind: string,
    role: int,
    label: string,
}

export struct AppEntry {
    title: string,
    detail: string,
    value: string,
    /* DetailIcon index. */
    icon: int,
    good: bool,
    caption: string,
}

component AppEntryRow inherits Rectangle {
    in property <AppEntry> entry;
    in property <bool> focused: false;
    in property <float> s: 1.0;

    property <color> ink: root.focused ? Theme.on-secondary-container : Theme.text;
    border-radius: Shape.large;
    background: root.focused ? Theme.secondary-container : Theme.surface-container.transparentize(0.15);
    animate background { duration: 150ms; easing: ease-out; }

    HomeFocusRing {
        width: parent.width; height: parent.height;
        radius: Shape.large;
        shown: root.focused;
    }
    Rectangle {
        x: 12px * root.s; y: (parent.height - self.height) / 2;
        width: parent.height - 20px * root.s; height: self.width;
        border-radius: Shape.medium;
        background: root.focused ? Theme.primary-container : Theme.surface-container-highest;
        DetailIcon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: parent.width * 0.48; height: self.width;
            icon: root.entry.icon;
            ink: root.focused ? Theme.on-primary-container : Theme.text-secondary;
        }
    }
    VerticalLayout {
        x: parent.height + 4px * root.s;
        width: parent.width - self.x - (root.entry.value != "" ? value.preferred-width + 30px * root.s : 14px * root.s);
        alignment: center;
        spacing: 1px * root.s;
        MarqueeText {
            height: 23px * root.s;
            label: root.entry.title;
            text-color: root.ink;
            text-size: 17px * root.s;
            text-weight: 600;
            active: root.focused;
        }
        if root.entry.detail != "": Text {
            height: 18px * root.s;
            text: root.entry.detail;
            color: root.focused ? Theme.on-secondary-container.transparentize(0.25) : Theme.text-secondary;
            font-size: 13px * root.s;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    Rectangle {
        visible: root.entry.value != "";
        x: parent.width - self.width - 14px * root.s; y: (parent.height - self.height) / 2;
        width: value.preferred-width + 18px * root.s; height: 26px * root.s;
        border-radius: self.height / 2;
        background: root.entry.good ? Theme.primary.transparentize(0.78) : Theme.surface-container-highest;
        value := Text {
            x: 9px * root.s; height: parent.height;
            text: root.entry.value;
            color: root.entry.good ? Theme.primary : Theme.text-secondary;
            font-size: 13px * root.s;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component AppPage inherits Rectangle {
    in property <float> s: 1.0;
    in property <string> kicker;
    in property <string> title;
    in property <string> meta;
    in property <string> description;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> accent: Theme.primary;
    in property <[DetailChip]> chips;
    in property <[AppEntry]> entries;
    in property <[DetailAction]> actions;
    in property <[string]> action-captions;
    in property <int> index: 0;
    in property <string> notice;
    /* Pairing PIN to show large ("" = none). */
    in property <string> pin;
    in property <string> pin-label;
    /* Download progress 0..1, below 0 = none. */
    in property <float> progress: -1;
    in property <string> progress-label;

    property <length> pad: 22px * root.s;
    property <length> bar-h: 42px * root.s;
    property <length> caption-h: 20px * root.s;
    property <length> bar-y: root.height - 10px * root.s - root.caption-h - 10px * root.s - root.bar-h;
    property <length> top: 16px * root.s;
    property <length> hero: min(132px * root.s, root.width * 0.26);
    property <length> text-x: root.pad + root.hero + 22px * root.s;
    property <length> row-h: 52px * root.s;
    property <length> row-step: root.row-h + 10px * root.s;
    property <length> list-y: root.top + root.hero + 18px * root.s;
    property <length> list-h: root.bar-y - 14px * root.s - root.list-y;
    property <int> entry-focus: root.index < root.entries.length ? root.index : -1;
    property <int> action-focus: root.index - root.entries.length;
    property <length> list-scroll: root.entry-focus < 0 ? 0px
        : max(0px, min(root.entry-focus * root.row-step - root.list-h / 2 + root.row-h / 2,
                       root.entries.length * root.row-step - 10px * root.s - root.list-h));
    property <string> caption: root.entry-focus >= 0 ? root.entries[root.entry-focus].caption
        : root.action-captions[root.action-focus];
    property <bool> caption-armed: root.action-focus >= 0 && root.actions[root.action-focus].armed;

    background: Theme.background;
    clip: true;

    /* The app's colour washes down from the top. */
    Rectangle {
        x: 0; y: 0; width: parent.width; height: root.list-y + 40px * root.s;
        background: @linear-gradient(180deg, root.accent.transparentize(0.68) 0%, Theme.background.transparentize(1.0) 100%);
    }
    /* Hero: the app icon on a raised tile. */
    Rectangle {
        x: root.pad; y: root.top;
        width: root.hero; height: root.hero;
        border-radius: Shape.extra-large;
        background: Theme.surface-container-high;
        drop-shadow-blur: 20px * root.s;
        drop-shadow-offset-y: 6px * root.s;
        drop-shadow-color: #00000090;
        if root.has-icon: Image {
            x: parent.width * 0.2; y: parent.height * 0.2;
            width: parent.width * 0.6; height: parent.height * 0.6;
            source: root.icon;
            image-fit: contain;
        }
        if !root.has-icon: Image {
            x: parent.width * 0.24; y: parent.height * 0.28;
            width: parent.width * 0.52; height: parent.height * 0.44;
            source: @image-url("assets/icons/gamepad.svg");
            colorize: Theme.text-faint;
            image-fit: contain;
        }
    }
    VerticalLayout {
        x: root.text-x; y: root.top;
        width: root.width - root.text-x - root.pad; height: root.hero;
        alignment: center;
        spacing: 6px * root.s;
        Text {
            text: root.kicker;
            color: Theme.primary;
            font-size: 12px * root.s;
            font-weight: 700;
            letter-spacing: 1.2px;
            overflow: elide;
        }
        MarqueeText {
            height: 34px * root.s;
            label: root.title;
            text-color: Theme.text;
            text-size: 26px * root.s;
            text-weight: 700;
            active: true;
        }
        if root.meta != "": Text {
            text: root.meta;
            color: Theme.text-secondary;
            font-size: 14px * root.s;
            overflow: elide;
        }
        if root.chips.length > 0: Rectangle {
            height: app-chips.height + 4px * root.s;
            app-chips := ChipFlow { y: 2px * root.s; width: parent.width; chips: root.chips; s: root.s; }
        }
    }

    /* Entries, or the PIN, or the download, or the description. */
    Rectangle {
        x: 0; y: root.list-y - 12px; width: parent.width; height: root.list-h + 24px;
        clip: true;
        Rectangle {
            y: 12px - root.list-scroll;
            width: parent.width; height: root.entries.length * root.row-step;
            animate y { duration: 260ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
            /* Only rows near the focus exist: a Files folder can hold
             * hundreds of entries (cards keep their layer until destroyed). */
            for entry[i] in root.entries: Rectangle {
                x: root.pad; y: i * root.row-step;
                width: parent.width - 2 * root.pad; height: root.row-h;
                if abs(i - max(0, root.entry-focus)) <= ceil(root.list-h / root.row-step) + 1: AppEntryRow {
                    width: parent.width; height: parent.height;
                    cache-rendering-hint: true;
                    entry: entry;
                    focused: root.entry-focus == i;
                    s: root.s;
                }
            }
        }
    }
    if root.entries.length == 0 && root.pin != "": Rectangle {
        x: root.pad; y: root.list-y;
        width: root.width - 2 * root.pad; height: min(root.list-h, 96px * root.s);
        border-radius: Shape.large;
        background: Theme.primary-container;
        Text {
            x: 20px * root.s; width: parent.width * 0.5; height: parent.height;
            text: root.pin-label;
            color: Theme.on-primary-container;
            font-size: 15px * root.s;
            font-weight: 500;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        Text {
            x: parent.width * 0.5; width: parent.width * 0.5 - 20px * root.s; height: parent.height;
            text: root.pin;
            color: Theme.on-primary-container;
            font-size: 44px * root.s;
            font-weight: 700;
            letter-spacing: 8px * root.s;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if root.entries.length == 0 && root.pin == "": VerticalLayout {
        x: root.pad; y: root.list-y;
        width: root.width - 2 * root.pad; height: root.list-h;
        spacing: 12px * root.s;
        alignment: start;
        if root.progress >= 0: Rectangle {
            height: 10px * root.s;
            border-radius: self.height / 2;
            background: Theme.surface-container-highest;
            Rectangle {
                x: 0; height: parent.height;
                width: parent.width * max(0.02, min(1.0, root.progress));
                border-radius: parent.border-radius;
                background: Theme.primary;
                animate width { duration: 300ms; easing: ease-out; }
            }
        }
        if root.progress >= 0 && root.progress-label != "": Text {
            text: root.progress-label;
            color: Theme.text;
            font-size: 15px * root.s;
            font-weight: 600;
        }
        if root.description != "": Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: 15px * root.s;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        x: root.pad; y: root.bar-y;
        width: root.width - 2 * root.pad; height: root.bar-h;
        spacing: 10px * root.s;
        alignment: start;
        for action[i] in root.actions: DetailActionButton {
            action: action;
            focused: root.action-focus == i;
            s: root.s;
        }
    }
    MarqueeText {
        x: root.pad; y: root.bar-y + root.bar-h + 10px * root.s;
        width: root.width - 2 * root.pad; height: root.caption-h;
        label: root.notice != "" ? root.notice : root.caption;
        text-color: root.notice != "" ? #ffc94a : root.caption-armed ? Theme.error : Theme.text-dim;
        text-size: 13px * root.s;
        text-weight: 400;
        active: true;
    }
}

export component HomeWindow inherits Window {
    /* Lifecycle splash (boot, restart, power off), drawn by src/splash.rs:
     * `splash-image` = boot/reboot raster, `splash-base` = power-off raster,
     * pixel-identical to the kernel splash and labwc's first frame, drawn
     * 1:1; the accent pill animates on the track (logical px). */
    in-out property <bool> lifecycle-on: true;
    in-out property <string> transition-mode: "boot";
    in-out property <image> splash-image;
    in-out property <image> splash-base;
    in-out property <float> splash-top-alpha: 1.0;
    in-out property <float> splash-base-alpha: 0.0;
    in-out property <float> splash-fill-from: 0.5;
    in-out property <float> splash-fill-to: 0.5;
    in-out property <float> splash-fill-alpha: 0.0;
    in-out property <length> splash-track-x;
    in-out property <length> splash-track-y;
    in-out property <length> splash-track-w;
    in-out property <length> splash-track-h;
    in-out property <color> splash-accent: #3a86ff;
    /* Rust re-renders the splash whenever the surface size changes while
     * it is on screen (first configure, HDMI hotplug). */
    callback splash-size-changed();
    changed width => { if (root.lifecycle-on) { root.splash-size-changed(); } }
    changed height => { if (root.lifecycle-on) { root.splash-size-changed(); } }
    /* The Settings dialog belongs to the page that opened it. */
    changed settings-open => { if (!root.settings-open) { root.settings-dialog-open = false; } }
    in-out property <[string]> i18n-strings: ["Recently Played", "Systems & Collections", "Copy your games to the roms folder on the SD card, one folder per system.", "Settings", "General", "Connectivity", "Controllers & Input", "Display & Audio", "System", "Connect to Wi-Fi", "Saved Networks", "Connect New Device", "My Devices", "Player Assignment", "Controllers", "Input Tester", "Controller Mapping", "Internal Rumble", "RGB Lighting", "Storage", "System Information", "Restore Defaults", "Profiles, language and time", "Scanning nearby networks…", "Refreshing nearby networks…", "Choose a network or add a hidden network", "Saved device-global Wi-Fi networks", "Password is hidden while typing", "Controller or physical keyboard", "Scanning nearby Bluetooth devices…", "Choose a nearby Bluetooth device", "Paired and connected Bluetooth devices", "Preferred slots are compacted when a controller is unavailable", "Available built-in, USB and Bluetooth controllers", "All buttons and axes • Hotkey + Start to exit", "Press the new button now…", "Select an action to remap", "User preference for the internal console rumble", "Screen Reactive • follows compositor color feed", "User RGB baseline and system effects", "Device-global user storage", "Live read-only device information", "Reset System settings without deleting user content", "Sections", "User & Profile", "Language & Region", "Date & Time", "Rumble & RGB", "Updates & Recovery", "SYSTEM", "Performance Profile", "Battery Saver", "Auto", "Automatic Battery Saver", "Off", "Screensaver After", "Sleep After", "After screensaver", "Power Off", "After Sleep • RTC wake unavailable", "After Sleep", "After Screensaver", "Active Storage", "User Data", "SD2", "Not inserted", "Ready", "Available", "Not yet managed by nuubOS", "Automatic Backup", "Daily", "Weekly", "Monthly", "Backup completed", "Backup due", "Clock unavailable", "Clock check needed", "Move User Data to SD1", "Use SD2 for User Data", "Move User Data to SD2", "Working…", "Insert SD2", "Confirm", "Erase & migrate", "Sync & switch", "Activate", "Press again • SD2 will be erased", "Press again • sync & switch to SD1", "Back Up Now", "Requires active SD2", "Storage Job", "Running", "Completed", "Failed", "Idle", "Move to SD2", "Move to SD1", "Back Up to SD1", "Device", "Kernel", "Battery", "CPU", "GPU", "Network", "RAM", "Uptime", "Restores power, display, audio, backup and controller mapping settings to their defaults.", "Games, BIOS, saves, users and network settings are kept.", "Press again to reset system settings", "Reset System Settings", "CONTROLLERS & INPUT", "P1–P8", "Enabled", "Disabled", "Solid", "Breathing", "Orbit", "Aurora", "Spectrum", "Battery Level", "Console Colors", "Speed", "Automatic", "Left Stick Deadzone", "Right Stick Deadzone", "Test Rumble", "Effect", "Brightness", "Color", "SYSTEM SIGNALS", "LIGHTING", "DISPLAY & AUDIO", "Internal display inactive", "Audio Output", "Volume", "Applications", "System Sounds", "Navigation Sounds", "Power Sounds", "Home Music", "Test Sound", "Stop", "Play", "Color Temperature", "Slow", "Normal", "Fast", "Startup & Sleep", "Connections", "Games", "Tasks", "Welcome, sleep, wake and power off", "Low battery, charging and full charge", "Controllers, headphones, Wi-Fi and USB drives", "Save states, screenshots and errors", "Downloads, backups and failures", "WI-FI", "Wi-Fi", "Connect", "Not connected", "BLUETOOTH", "Bluetooth", "Add Hidden Network", "Scanning…", "Searching for nearby networks…", "No saved Wi-Fi networks", "No new Bluetooth devices found", "No paired Bluetooth devices", "Pair & Connect", "Disconnect", "Forget Device", "Pair with PIN", "Password", "None", "Change", "IPv4", "Manual", "Address", "Subnet Mask", "Gateway", "DNS", "Apply Changes", "Forget Network", "Small System. Big Adventures.", "Navigate", "Select", "Back", "Menu", "POWER MENU", "Sleep", "Restart", "Press again to confirm", "Profile", "Language", "Mood", "Default mood", "Current user", "Interface language", "Connected", "Saved", "Excellent", "Good", "Fair", "Weak", "Player", "Unavailable", "Waiting for Wi-Fi service", "Waiting for Bluetooth service", "Waiting for input", "Blue", "Automatic • Speaker", "Unknown", "Open", "System effect • ", "Effective: ", " min", "ABSENT", "SD2 → SD1", "Failed (", " available", "Player ", " • unavailable", "On", "TV / Receiver", " K", " saved", " devices", " • Runtime P", " • Saved", " • Connected", " • Paired", "CONTEXT", "nuubOS Quick Menu", "Quick Menu", "DISPLAY / AUDIO", "Audio", "Performance", "Reboot", "Adjust", "Close", "Speaker", "Unavailable", "Enabling Bluetooth…", "Disabling Bluetooth…", "Bluetooth toggle failed: {0}", "Discovery failed: {0}", "Bluetooth operation failed: {0}", "Pairing with PIN…", "Bluetooth PIN pairing failed: {0}", "Press any control", "Enabling Wi-Fi…", "Disabling Wi-Fi…", "Wi-Fi toggle failed: {0}", "Scan failed: {0}", "Connecting to {0}…", "Connect failed: {0}", "Disconnecting…", "Disconnect failed: {0}", "Forgetting {0}…", "Forget failed: {0}", "IP configuration failed: {0}", "Applying network settings…", "SSID is required", "Password must contain at least 8 characters", "Hidden", "Enter a valid IPv4 address", "Prefix must be between 0 and 32", "Gateway must be empty or a valid IPv4 address", "DNS must contain IPv4 addresses separated by comma or space", "Enter a contiguous IPv4 subnet mask", "PIN/passkey must contain 1 to 16 characters", "This network security mode is not supported", "TV", "Volume controlled by TV / receiver", "Player", "Users", "Startup", "User Picker", "Direct Login", "Default User", "Timezone", "Automatic Time", "Sync Now", "Keyboard Layout", "Edit Profile", "Username", "Profile Picture", "Manage Users", "Add User", "Delete User", "Press again to delete", "Choose Profile", "Switch User", "Profile Pictures", "Custom pictures from your profile folder", "Create User", "Enter username", "Cannot delete the active user", "At least one user is required", "Time synchronized", "Time synchronization failed", "Last Sync", "Never", "Default", "Active", "Profile data only; shared games and apps are kept", "Select a default user", "Show user picker at boot", "Load the default user at boot", "Automatic network time", "Use NTP when network is available", "Physical and virtual keyboard", "USER", "DEVICE", "Avatar {0}", "Custom", "No custom pictures found", "Place PNG or JPG files in {0}", "User created", "User deleted", "Profile updated", "Choose an avatar", "Automatic time is off", "Syncing…", "Boot User", "Other Users", "Date", "Time", "Power Off After", "Skip Track", "Headphones", "Bluetooth Audio", "Analog Audio", "PROFILE", "USERS", "DATE & TIME", "KEYBOARD", "Face South", "Face East", "Face North", "Face West", "D-Pad Up", "D-Pad Down", "D-Pad Left", "D-Pad Right", "L1", "R1", "L2", "R2", "L3", "R3", "Start", "Select", "Hotkey", "Left Stick X", "Left Stick Y", "Right Stick X", "Right Stick Y", "Button {0}", "Axis {0}", "Inverted", "Not assigned", "Press the new control • wait 5 s to cancel", "Move the stick right • any button cancels", "Move the stick down • any button cancels", "Restore Default Mapping", "Press again to restore defaults", "BUTTONS", "STICKS", "Now Playing", "Controller connected", "Controller disconnected", "Headphones connected", "Headphones disconnected", "Bluetooth audio connected", "Bluetooth audio disconnected", "Battery Saver on", "Battery at {0}%", "Low battery", "{0}% remaining", "Battery critically low", "{0}% remaining • connect the charger", "Charging", "Fully charged", "Wi-Fi connected", "Wi-Fi connection lost", "Setup", "Welcome", "Welcome to nuubOS", "Let's get your console ready in a few quick steps.", "Get Started", "Continue", "Skip", "You can connect later from Settings", "You're all set", "Your console is ready. You can change these choices at any time in Settings.", "Let's Play", "Finish", "No games yet", "Favorites", "{0} games", "1 game", "today", "yesterday", "{0} days ago", "Never played", "Played {0}", "{0