    /* First visible grid row. */
    in-out property <int> avatar-picker-scroll: 0;
    /* Avatar picker grid: large tiles, as many columns/rows as the screen
     * holds (4×2 at 640×480); Rust reads both for navigation and scroll. */
    property <length> avatar-picker-card-width: min(root.width - 32px, 820px);
    property <length> avatar-picker-card-height: root.height - 32px;
    out property <int> avatar-picker-columns:
        max(1, floor((root.avatar-picker-card-width - 32px) / (root.layout-class == 2 ? 168px : 140px)));
    out property <int> avatar-picker-rows:
        max(1, floor((root.avatar-picker-card-height - 112px) / (root.layout-class == 2 ? 172px : 150px)));
    /* Rows share the whole height (no empty band below the grid). */
    property <length> avatar-picker-tile-height:
        min((root.avatar-picker-card-height - 112px) / root.avatar-picker-rows, 220px);
