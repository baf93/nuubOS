                        title: root.i18n-strings[56],
                        value: root.system-sleep-after-min <= 0 ? root.i18n-strings[54] : root.system-sleep-after-min + root.i18n-strings[215],
                        detail: "", nav: false, slider: false, fraction: 0, tog: false, on: false,
                    },
                    {
                        title: root.i18n-strings[1347],
                        value: "",
                        detail: root.system-hypersleep ? root.i18n-strings[1348] : root.i18n-strings[1349],
                        nav: false, slider: false, fraction: 0, tog: true, on: root.system-hypersleep,
                    },
                    {
                        title: root.i18n-strings[1354],
                        value: "",
                        detail: root.fast-startup-armed ? root.i18n-strings[1373]
                            : root.system-fast-startup ? root.i18n-strings[1355] : root.i18n-strings[1356],
                        nav: false, slider: false, fraction: 0, tog: true, on: root.system-fast-startup,
                    },
                    {
                        title: root.i18n-strings[1388],
                        value: "",
                        detail: root.system-power-key-sleep ? root.i18n-strings[1389] : root.i18n-strings[1390],
                        nav: false, slider: false, fraction: 0, tog: true, on: root.system-power-key-sleep,
                    },
                    {
                        title: root.i18n-strings[816],
                        value: root.battery-state == "absent" ? root.i18n-strings[1301]
