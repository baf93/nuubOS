                /* --------------------------------------------- OOB Date & Time (30) */
                /* Same regional rows and Product Service as General → DATE & TIME. */
                for row[k] in [
                    { title: root.i18n-strings[280], value: root.timezone, toggle: false, on: false, enabled: true, detail: "" },
                    { title: root.i18n-strings[281], value: "", toggle: true, on: root.automatic-time, enabled: true, detail: root.i18n-strings[310] },
                    { title: root.i18n-strings[326], value: root.manual-date-label, toggle: false, on: false, enabled: !root.automatic-time, detail: "" },
                    { title: root.i18n-strings[327], value: root.manual-time-label, toggle: false, on: false, enabled: !root.automatic-time, detail: "" },
