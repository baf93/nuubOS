config BR2_PACKAGE_NUUBOS_SCRAPER
	bool "nuubos-scraper"
	depends on BR2_USE_MMU
	select BR2_PACKAGE_NUUBOS_JOBS
	select BR2_PACKAGE_NUUBOS_LIBRARY
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_SKYSCRAPER if BR2_PACKAGE_QT6
	help
	  EPIC-015 optional game metadata and media, stored in the
	  provider-neutral Library metadata store. Sources: ScreenScraper
	  and TheGamesDB through Skyscraper (package skyscraper, needs
	  Qt6), libretro thumbnails directly.
