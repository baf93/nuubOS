#!/bin/sh
# nuubOS PC Game Streaming Service (Moonlight). Starts after the
# users and input services, before the UI.

DAEMON=/usr/sbin/nuubos-streamd
PIDFILE=/run/nuubos/streamd.pid
SOCKET=/run/nuubos/streamd.sock

streamd_running()
{
    [ -r "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$PID" ] || return 1
    [ "$(tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p')" = "$DAEMON" ]
}

start_service()
{
    mkdir -p /run/nuubos
    streamd_running && return 0
    rm -f "$PIDFILE" "$SOCKET"
    "$DAEMON" >>/run/nuubos/streamd.log 2>&1 &
    return 0
}

stop_service()
{
    if streamd_running; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"
        kill -TERM "$PID" 2>/dev/null || true
        # A running stream is ended first (bounded).
        for _ in 1 2 3 4 5 6 7 8; do
            [ -d "/proc/$PID" ] || break
            sleep 1
        done
    fi
    rm -f "$PIDFILE" "$SOCKET"
    return 0
}

case "${1:-}" in
    start) start_service ;;
    stop) stop_service ;;
    restart) stop_service; start_service ;;
    *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
