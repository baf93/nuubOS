#!/bin/sh
# nuubOS diagnostics (EPIC-052).
#
#   nuubos-diag summary           product/hardware/service overview (read-only)
#   nuubos-diag bundle [OUTDIR]   support bundle (.tar[.gz]); prints its path
#   nuubos-diag redact            stdin -> stdout secret filter
#
# A bundle holds diagnostics only: never ROMs, BIOS, SSH keys, user secrets
# directories, Wi-Fi PSKs, passwords, pairing PINs or service keys. Every text
# file goes through the same redaction filter. Generation happens in a staging
# directory and the finished archive is moved into place atomically, so a
# failure leaves nothing partial behind. NUUBOS_ROOT (default empty) prefixes
# every path read; it exists for the host test.

R="${NUUBOS_ROOT:-}"
OUT_DEFAULT="$R/userdata/diagnostics"
KEEP=5
LOG_LINES=500

redact()
{
    sed -E \
        -e 's/(^|[^A-Za-z0-9])((psk|password|passwd|passphrase|secret|token|private[_-]?key|api[_-]?key|wep_key[0-3]?|sae_password|identity|anonymous_identity|pairing[_-]?pin|auth[A-Za-z_]*|cookie)[A-Za-z0-9_.-]*[[:space:]]*[=:][[:space:]]*)("[^"]*"|[^[:space:]]+)/\1\2<redacted>/Ig' \
        -e 's/(^|[^A-Za-z0-9])(pin(_code)?[[:space:]]*[=:][[:space:]]*)("[^"]*"|[^[:space:]]+)/\1\2<redacted>/Ig' \
        -e 's/(Authorization:[[:space:]]*)[^[:space:]].*/\1<redacted>/Ig' \
        -e 's/-----BEGIN [A-Z ]*PRIVATE KEY-----.*/<redacted private key>/' \
        -e 's/\b[0-9a-fA-F]{64}\b/<redacted-hex>/g'
}

# Worker protocol of nuubos-jobd (EPIC-007), only when run as a job.
progress()
{
    [ -n "${NUUBOS_JOB_ID:-}" ] && printf '@progress %s %s\n' "$1" "$2"
    return 0
}

job_error()
{
    [ -n "${NUUBOS_JOB_ID:-}" ] && printf '@error %s\n' "$1"
    return 0
}

sec()
{
    printf '\n=== %s ===\n' "$1"
}

run()
{
    "$@" 2>&1 || true
}

# BusyBox has no timeout applet: a stuck service must not block the bundle.
bounded()
{
    secs="$1"; shift
    "$@" 2>&1 &
    pid=$!
    ( sleep "$secs"; kill "$pid" 2>/dev/null ) &
    killer=$!
    wait "$pid" 2>/dev/null
    kill "$killer" 2>/dev/null
    wait "$killer" 2>/dev/null
    return 0
}

# Prints a text file through the filter, or nothing when it is missing.
cat_redacted()
{
    [ -r "$1" ] || return 0
    redact < "$1"
}

tail_redacted()
{
    [ -r "$1" ] || return 0
    tail -n "$LOG_LINES" "$1" | redact
}

identity()
{
    sec identity
    echo "bundle_format=1"
    echo "generated=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
    if [ -r "$R/etc/os-release" ]; then
        redact < "$R/etc/os-release"
    fi
    if [ -r "$R/usr/share/nuubos/build-id" ]; then
        printf 'build_id='; cat "$R/usr/share/nuubos/build-id"
    fi
    printf 'board='
    tr -d '\000' < "$R/proc/device-tree/model" 2>/dev/null; echo
    if [ -r "$R/boot/nuubos.conf" ]; then
        sed -n 's/^DEVICE=/device_selector=/p' "$R/boot/nuubos.conf"
    fi
    printf 'kernel='; uname -srvm 2>/dev/null || echo unknown
    printf 'uptime_s='; cut -d. -f1 "$R/proc/uptime" 2>/dev/null || echo 0
    printf 'cmdline='; redact < "$R/proc/cmdline" 2>/dev/null
}

hardware()
{
    sec memory
    head -n 6 "$R/proc/meminfo" 2>/dev/null
    sec storage
    cat_redacted "$R/proc/partitions"
    cat_redacted "$R/proc/mounts"
    run df -h
    sec power
    for p in "$R"/sys/class/power_supply/*; do
        [ -d "$p" ] || continue
        echo "-- ${p##*/}"
        for f in type status capacity voltage_now current_now temp health; do
            [ -r "$p/$f" ] && printf '%s=%s\n' "$f" "$(cat "$p/$f" 2>/dev/null)"
        done
    done
    sec thermal
    for t in "$R"/sys/class/thermal/thermal_zone*; do
        [ -r "$t/temp" ] || continue
        printf '%s %s %s\n' "${t##*/}" "$(cat "$t/type" 2>/dev/null)" "$(cat "$t/temp" 2>/dev/null)"
    done
    sec modules
    cat_redacted "$R/proc/modules" | cut -d' ' -f1-3
    sec input-devices
    cat_redacted "$R/proc/bus/input/devices"
}

network()
{
    sec network
    run ip -brief addr
    run ip route
    sec wifi
    run iw dev
    run wpa_cli -i wlan0 status
    # SSIDs are useful for support; keys are not part of this output.
    if [ -r "$R/state/network/wpa_supplicant.conf" ]; then
        sec wifi-saved-networks
        redact < "$R/state/network/wpa_supplicant.conf"
    fi
    sec bluetooth
    run bluetoothctl show
    run bluetoothctl devices
}

services()
{
    sec services
    for pf in "$R"/run/nuubos/*.pid; do
        [ -r "$pf" ] || continue
        n="${pf##*/}"; n="${n%.pid}"
        pid="$(cat "$pf" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            printf '%s running pid=%s\n' "$n" "$pid"
        else
            printf '%s NOT RUNNING\n' "$n"
        fi
    done
    sec processes
    run ps
    sec nuubos-services
    for c in "nuubos-systemctl status" "nuubos-usersctl status" "nuubos-libraryctl status" \
             "nuubos-emuctl status" "nuubos-streamctl status"; do
        printf -- '-- %s\n' "$c"
        # shellcheck disable=SC2086
        bounded 5 $c | redact
    done
}

config()
{
    sec nuubos.conf
    cat_redacted "$R/state/config/nuubos.conf"
    sec users
    n=0
    for d in "$R"/state/users/*; do
        [ -f "$d/profile.conf" ] && n=$((n + 1))
    done
    echo "user_count=$n"
    sec recovery-state
    for f in "$R"/state/recovery/*; do
        [ -f "$f" ] || continue
        echo "-- ${f##*/}"
        tail -n 40 "$f" | redact
    done
}

logs_dir()
{
    # $1: destination directory
    mkdir -p "$1/logs"
    for f in "$R"/run/nuubos/*.log; do
        [ -f "$f" ] || continue
        tail_redacted "$f" > "$1/logs/${f##*/}"
    done
    dmesg 2>/dev/null | tail -n 1000 | redact > "$1/logs/dmesg.txt"
    for f in "$R"/boot/nuubos-debug/*.txt; do
        [ -f "$f" ] || continue
        redact < "$f" > "$1/logs/boot-${f##*/}"
    done
}

summary()
{
    identity
    hardware
    network
    services
    config
}

prune()
{
    # Keep the newest $KEEP bundles.
    ls -1t "$1"/nuubos-support-*.tar* 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r old; do
        rm -f "$old"
    done
}

bundle()
{
    out="${1:-$OUT_DEFAULT}"
    mkdir -p "$out" || { echo "[FAIL] cannot create $out" >&2; job_error storage; return 1; }
    ts="$(date -u '+%Y%m%d-%H%M%S' 2>/dev/null || echo unknown)"
    name="nuubos-support-$ts"
    stage="$(mktemp -d "$out/.stage.XXXXXX")" || { echo "[FAIL] no staging space" >&2; return 1; }
    # Cancel (SIGTERM from nuubos-jobd) or failure: nothing partial remains.
    trap 'rm -rf "$stage"' EXIT
    trap 'rm -rf "$stage"; exit 1' INT TERM
    mkdir -p "$stage/$name"

    progress 10 summary
    summary > "$stage/$name/summary.txt" 2>&1
    progress 60 logs
    logs_dir "$stage/$name"
    {
        echo "nuubOS support bundle"
        echo "Contains diagnostics only. Redacted: Wi-Fi keys, passwords, tokens,"
        echo "pairing PINs, private keys, 64-digit hex secrets."
        echo "Never included: ROMs, BIOS, saves, SSH keys, user secrets, media."
        echo "Attach this file to a GitHub issue."
    } > "$stage/$name/README.txt"
    ( cd "$stage/$name" && find . -type f | sort ) > "$stage/$name/MANIFEST.txt"

    progress 85 archive
    if ! tar -C "$stage" -cf "$stage/$name.tar" "$name" 2>/dev/null; then
        echo "[FAIL] archive creation failed" >&2
        job_error storage
        return 1
    fi
    file="$name.tar"
    if command -v gzip >/dev/null 2>&1 && gzip -9 "$stage/$name.tar" 2>/dev/null; then
        file="$name.tar.gz"
    fi
    # The archive is complete: only now does it appear in the output folder.
    mv "$stage/$file" "$out/$file" || { echo "[FAIL] cannot publish bundle" >&2; job_error storage; return 1; }
    chmod 600 "$out/$file" 2>/dev/null
    prune "$out"
    sync
    if [ -n "${NUUBOS_JOB_ID:-}" ]; then
        printf '@result %s\n' "$out/$file"
    else
        printf '%s\n' "$out/$file"
    fi
}

case "${1:-}" in
    summary) summary ;;
    bundle) shift; bundle "$@" ;;
    redact) redact ;;
    *) echo "Usage: nuubos-diag summary | bundle [OUTDIR] | redact" >&2; exit 1 ;;
esac
