#!/bin/sh
DAEMON=/usr/sbin/nuubos-regionald
PIDFILE=/run/nuubos/regionald.pid
case "${1:-start}" in
 start) mkdir -p /run/nuubos; "$DAEMON" >/run/nuubos/regionald.log 2>&1 & echo $! > "$PIDFILE" ;;
 stop) [ -r "$PIDFILE" ] && kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null || true; rm -f "$PIDFILE" /run/nuubos/regionald.sock ;;
 restart) "$0" stop; "$0" start ;;
 *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
