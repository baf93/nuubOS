
/* Presentation tokens of the active theme (EPIC-008). Defaults are the
 * built-in nuubOS theme; nuubUI sets them from the user's theme package
 * (themes.rs) and falls back to these values on any theme error. Colors
 * not covered by a token are fixed by the product design. */
export global Theme {
    in-out property <color> accent: #3a86ff;
    in-out property <color> accent-light: #73a8ff;
    in-out property <color> accent-muted: #5b86d6;
    in-out property <color> accent-text: #cfe2ff;
    in-out property <color> focus-fill: #18283c;
    in-out property <color> text: #f5f6f8;
    in-out property <color> text-secondary: #a8adb5;
    in-out property <color> text-dim: #8e949d;
    in-out property <color> text-faint: #7f858e;
    in-out property <color> text-disabled: #555b64;
    in-out property <color> background: #0d0e10;
    in-out property <color> surface: #24272d;
    in-out property <color> border: #30343b;
    in-out property <color> border-soft: #2c3036;
    in-out property <color> warning: #f2b84b;

    /* Material 3 colour roles (dark scheme), derived from the tokens above;
     * identical to the Theme roles in nuubui-home home.slint. */
    out property <color> primary: root.accent-light;
    out property <color> on-primary: root.background;
    out property <color> primary-container: root.accent.mix(root.background, 0.38);
    out property <color> on-primary-container: root.accent-text;
    out property <color> secondary-container: root.focus-fill;
    out property <color> on-secondary-container: root.accent-text;
    out property <color> surface-container-low: root.surface.mix(root.background, 0.38);
    out property <color> surface-container: root.surface.mix(root.background, 0.62);
    out property <color> surface-container-high: root.surface;
    out property <color> surface-container-highest: root.surface.mix(root.text, 0.88);
    out property <color> outline: root.text-disabled;
    out property <color> outline-variant: root.border;
    out property <color> error: #ffb4ab;
    out property <color> error-container: #6e1f26;
    out property <color> on-error-container: #ffdad6;
}

/* Material 3 shape scale (same as home.slint). */
global Shape {
    out property <length> extra-small: 4px;
    out property <length> small: 8px;
    out property <length> medium: 12px;
    out property <length> large: 16px;
    out property <length> extra-large: 28px;
}


component MarqueeText inherits Rectangle {
    in property <string> label: "";
    in property <color> text-color: #ffffff;
    in property <length> text-size: 16px;
    in property <int> text-weight: 400;
    in property <bool> active: true;
    in property <bool> align-right: false;
    in property <bool> align-center: false;
    /* Forward/back passes; a notification scrolls once and holds the end. */
    in property <int> passes: 2;
    out property <length> content-width: marquee-label.preferred-width;
    /* Constant reading speed (~60 px/s): long text scrolls longer, never
     * faster. Short overflows keep the minimum duration. */
    property <length> overflow: max(0px, marquee-label.preferred-width - root.width);
    out property <duration> scroll-duration: max(1250ms, root.overflow / 1px * 16ms);
    /* Time until the end of the text has been shown (0 when it fits). */
    out property <duration> scroll-time: root.overflow > 0px ? 320ms + root.scroll-duration * root.passes : 0ms;
    /* Reading this evaluates the animated position (used to restart). */
    out property <length> offset: marquee-label.x;

    background: #00000000;
    clip: true;

    marquee-label := Text {
        text: root.label;
        color: root.text-color;
        font-size: root.text-size;
        font-weight: root.text-weight;
        width: self.preferred-width;
        height: parent.height;
        vertical-alignment: center;
        x: root.active && self.preferred-width > parent.width
            ? parent.width - self.preferred-width
            /* Overflowing text at rest shows its beginning, whatever the
             * alignment of text that fits. */
            : self.preferred-width > parent.width ? 0px
            : root.align-right ? parent.width - self.preferred-width
            : root.align-center ? (parent.width - self.preferred-width) / 2
            : 0px;
        animate x {
            delay: 320ms;
            duration: root.scroll-duration;
            iteration-count: root.passes;
            direction: alternate;
            easing: linear;
            enabled: root.active && self.preferred-width > parent.width;
        }
    }
}

component BatteryGlyph inherits Rectangle {
    in property <int> percent: -1;
    in property <bool> charging: false;
    in property <bool> battery-saver: false;

    width: 32px;
    height: 24px;
    background: #00000000;

    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: @image-url("assets/icons/battery-empty.svg"); image-fit: contain; colorize: root.battery-saver ? Theme.warning : #00000000; visible: root.percent >= 0 && root.percent <= 15; }
    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: @image-url("assets/icons/battery-quarter.svg"); image-fit: contain; colorize: root.battery-saver ? Theme.warning : #00000000; visible: root.percent > 15 && root.percent <= 35; }
    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: @image-url("assets/icons/battery-half.svg"); image-fit: contain; colorize: root.battery-saver ? Theme.warning : #00000000; visible: root.percent > 35 && root.percent <= 60; }
    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: @image-url("assets/icons/battery-three-quarters.svg"); image-fit: contain; colorize: root.battery-saver ? Theme.warning : #00000000; visible: root.percent > 60 && root.percent <= 85; }
    Image { x: 0; y: 0; width: parent.width; height: parent.height; source: @image-url("assets/icons/battery-full.svg"); image-fit: contain; colorize: root.battery-saver ? Theme.warning : #00000000; visible: root.percent > 85; }

    Text {
        x: 0; y: 0; width: parent.width; height: parent.height;
        text: "?";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text-faint;
        font-size: 14px;
        font-weight: 700;
        visible: root.percent < 0;
    }

    /* Charging bolt: outline + fill, both from the theme. */
    Image {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 17px) / 2;
        width: 15px;
        height: 17px;
        source: @image-url("assets/icons/bolt-outline.svg");
        image-fit: contain;
        colorize: Theme.background;
        visible: root.charging && root.percent >= 0;
    }
    Image {
        x: (parent.width - 15px) / 2;
        y: (parent.height - 17px) / 2;
        width: 15px;
        height: 17px;
        source: @image-url("assets/icons/bolt.svg");
        image-fit: contain;
        colorize: Theme.accent;
        visible: root.charging && root.percent >= 0;
    }
}

component FaceButtonHint inherits Rectangle {
    in property <int> active-position: -1;

    width: 28px;
    height: 28px;
    background: #00000000;

    Rectangle {
        x: 10px;
        y: 1px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 0 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 0 ? Theme.accent-light : Theme.text-disabled;
    }

    Rectangle {
        x: 19px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 1 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 1 ? Theme.accent-light : Theme.text-disabled;
    }

    Rectangle {
        x: 10px;
        y: 19px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 2 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 2 ? Theme.accent-light : Theme.text-disabled;
    }

    Rectangle {
        x: 1px;
        y: 10px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.active-position == 3 ? Theme.accent : Theme.surface;
        border-width: 1px;
        border-color: root.active-position == 3 ? Theme.accent-light : Theme.text-disabled;
    }
}

component MenuActionHint inherits Rectangle {
    width: 26px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "H";
        color: Theme.text;
        font-size: 16px;
        font-weight: 800;
    }
}

component HorizontalAdjustHint inherits Rectangle {
    width: 28px;
    height: 26px;
    border-radius: Shape.small;
    background: Theme.surface-container-highest;

    Text {
        x: 2px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: "↔";
        color: Theme.text;
        font-size: 18px;
        font-weight: 700;
    }
}

component MaterialSlider inherits Rectangle {
    in property <float> fraction: 0.0;

    /* M3 slider: thick rounded track split by a bar handle with a small
     * gap on each side; active part primary, inactive part tonal. */
    property <length> track-h: 8px;
    property <length> gap: 3px;
    property <length> handle-x: (root.width - 4px) * root.fraction;

    height: 18px;
    background: #00000000;

    Rectangle {
        x: 0;
        y: (parent.height - root.track-h) / 2;
        width: max(0px, root.handle-x - root.gap);
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: Theme.primary;
        visible: self.width > 0px;
    }
    Rectangle {
        x: root.handle-x + 4px + root.gap;
        y: (parent.height - root.track-h) / 2;
        width: max(0px, parent.width - self.x);
        height: root.track-h;
        border-radius: root.track-h / 2;
        background: Theme.surface-container-highest;
        visible: self.width > 0px;
    }

    Rectangle {
        x: root.handle-x;
        y: 0px;
        width: 4px;
        height: parent.height;
        border-radius: 2px;
        background: Theme.primary;
    }
}

/*
 * Global notification card (EPIC-006 Toast / Live Notification). Passive:
 * it never takes controller focus. Severity: 0 info, 1 success, 2 warning,
 * 3 error. Icon ids are mapped from the event kind by Rust.
 */
component NotificationCard inherits Rectangle {
    in property <int> icon: 0;
    in property <int> severity: 0;
    in property <string> title: "";
    in property <string> detail: "";
    in property <int> battery: -1;
    /* Determinate progress 0..1; negative hides the bar (indeterminate Live
     * Notifications stay static instead of animating continuously). */
    in property <float> progress: -1;

    property <color> accent: root.severity == 3 ? #ff6b78
        : root.severity == 2 ? Theme.warning : Theme.accent;
    property <length> trailing: root.battery >= 0 ? 82px : 0px;
    /* Time needed to scroll the longest line once to its end. */
    out property <duration> scroll-time: max(title-text.scroll-time, root.detail != "" ? detail-text.scroll-time : 0ms);
    out property <length> marquee-offset: title-text.offset + detail-text.offset;

    height: 72px;
    background: Theme.surface-container-high;
    border-radius: Shape.large;
    border-width: root.severity >= 2 ? 1px : 0px;
    border-color: root.accent;

    Rectangle {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: root.severity == 3 ? #3d1c22 : root.severity == 2 ? #3a2f16 : Theme.primary-container;

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: root.accent;
            source: root.icon == 1 ? @image-url("assets/icons/music.svg")
                : root.icon == 2 ? @image-url("assets/icons/gamepad.svg")
                : root.icon == 3 ? @image-url("assets/icons/headphones.svg")
                : root.icon == 4 ? @image-url("assets/icons/volume-high.svg")
                : root.icon == 5 ? @image-url("assets/icons/battery-quarter.svg")
                : root.icon == 6 ? @image-url("assets/icons/leaf.svg")
                : root.icon == 7 ? @image-url("assets/icons/plug.svg")
                : root.icon == 8 ? @image-url("assets/icons/wifi.svg")
                : root.icon == 9 ? @image-url("assets/icons/hard-drive.svg")
                : root.icon == 10 ? @image-url("assets/icons/circle-check.svg")
                : root.icon == 11 ? @image-url("assets/icons/circle-xmark.svg")
                : root.icon == 12 ? @image-url("assets/icons/forward-step.svg")
                : @image-url("assets/icons/triangle-exclamation.svg");
        }
    }

    title-text := MarqueeText {
        x: 66px; y: 11px; width: parent.width - 80px - root.trailing; height: 25px;
        passes: 1;
        label: root.title;
        text-color: Theme.text;
        text-size: 17px;
        text-weight: 600;
    }

    detail-text := MarqueeText {
        x: 66px; y: 36px; width: parent.width - 80px; height: 22px;
        passes: 1;
        label: root.detail;
        text-color: Theme.text-secondary;
        text-size: 14px;
        text-weight: 400;
        visible: root.detail != "";
    }

    BatteryGlyph {
        x: parent.width - 14px - 44px - self.width;
        y: 12px;
        percent: root.battery;
        visible: root.battery >= 0;
    }

    Text {
        x: parent.width - 14px - 42px; y: 12px; width: 42px; height: 24px;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.battery + "%";
        color: #e5e7eb;
        font-size: 15px;
        font-weight: 700;
        visible: root.battery >= 0;
    }

    Rectangle {
        x: 66px; y: parent.height - 11px; width: parent.width - 80px; height: 3px;
        border-radius: 1.5px;
        background: Theme.surface-container-highest;
        visible: root.progress >= 0;

        Rectangle {
            x: 0; y: 0; height: parent.height;
            width: parent.width * max(0, min(1, root.progress));
            border-radius: 1.5px;
            background: root.accent;
        }
    }
}

/* Quick Menu rows share the Settings visual grammar (colors, radii,
 * typography) so both surfaces read as one product. */
component QmSectionHeader inherits Rectangle {
    in property <string> label: "";
    height: 20px;
    background: #00000000;

    Text {
        x: 4px;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: Theme.primary;
        font-size: 13px;
        font-weight: 600;
        overflow: elide;
    }
}

/* M3 switch, identical to nuubUI's SettingsToggle. */
component QmSwitch inherits Rectangle {
    in property <bool> checked: false;

    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.primary : Theme.surface-container-highest;
    border-width: root.checked ? 0px : 2px;
    border-color: Theme.outline;

    Rectangle {
        property <length> size: root.checked ? 18px : 12px;
        x: root.checked ? parent.width - self.size - 3px : 6px;
        y: (parent.height - self.size) / 2;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: root.checked ? Theme.on-primary : Theme.outline;
    }
}

component QmRow inherits Rectangle {
    in property <string> title: "";
    in property <string> value: "";
    in property <bool> selected: false;
    /* Boolean setting: the shared switch instead of value text. */
    in property <bool> toggle: false;
    in property <bool> toggle-on: false;
    /* Optional trailing action icon (e.g. Skip Track). */
    in property <image> icon;
    in property <bool> show-icon: false;
    /* Waiting for the confirming press: error roles, the prompt on a second
     * line under the title (value and icon step aside). */
    in property <bool> armed: false;
    in property <string> prompt: "";

    property <string> shown-value: root.armed ? "" : root.value;

    border-radius: Shape.medium;
    background: root.armed ? Theme.error-container
        : root.selected ? Theme.secondary-container : Theme.surface-container-low;
    border-width: root.selected || root.armed ? 2px : 1px;
    border-color: root.armed ? Theme.error : root.selected ? Theme.primary : Theme.surface-container-low;

    QmSwitch {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        checked: root.toggle-on;
        visible: root.toggle;
    }

    Image {
        x: parent.width - 12px - self.width;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
        colorize: root.selected ? Theme.on-secondary-container : Theme.text-dim;
        visible: root.show-icon && !root.armed;
    }

    value-text := MarqueeText {
        width: root.shown-value == "" ? 0px : min(self.content-width + 4px, parent.width * 0.5);
        x: parent.width - 12px - self.width - (root.show-icon ? 26px : 0px);
        y: 0;
        height: parent.height;
        label: root.shown-value;
        text-color: root.selected ? Theme.on-secondary-container : Theme.text-dim;
        text-size: 14px;
        text-weight: 500;
        align-right: true;
        active: root.selected;
        visible: root.shown-value != "";
    }

    MarqueeText {
        x: 12px;
        y: root.armed ? parent.height * 0.06 : 0px;
        width: root.shown-value == "" ? parent.width - 24px - (root.show-icon && !root.armed ? 26px : 0px) - (root.toggle ? 54px : 0px) : max(0px, value-text.x - 22px);
        height: root.armed ? parent.height * 0.52 : parent.height;
        label: root.title;
        text-color: root.armed ? Theme.on-error-container : root.selected ? Theme.text : #d0d3d8;
        text-size: root.armed ? 16px : 17px;
        text-weight: root.selected ? 600 : 500;
        active: root.selected;
    }

    MarqueeText {
        x: 12px;
        y: parent.height * 0.54;
        width: parent.width - 24px;
        height: parent.height * 0.38;
        label: root.prompt;
        text-color: Theme.on-error-container;
        text-size: 12px;
        text-weight: 500;
        active: root.armed;
        visible: root.armed;
    }
}

/* Identical copy of nuubUI's TextEntryField (components/virtual_keyboard.slint):
 * the one text field of nuubOS, label above an M3 filled field. */
component QmTextEntryField inherits Rectangle {
    in property <string> title: "";

    height: 72px;
    background: #00000000;

    Text {
        x: 2px; y: 0; width: parent.width - 4px; height: 26px;
        text: root.title;
        color: Theme.text;
        font-size: 19px;
        font-weight: 700;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: 32px; width: parent.width; height: 40px;
        border-radius: Shape.extra-small;
        background: Theme.surface-container-high;
        clip: true;

        @children

        /* Active indicator. */
        Rectangle {
            x: 0; y: parent.height - 2px; width: parent.width; height: 2px;
            background: Theme.primary;
        }
    }
}

/* One key of the Web Mode keyboard (same look as nuubUI's KeyboardKey). */
component QmKey inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;

    border-radius: Shape.small;
    background: root.selected ? Theme.primary : Theme.surface-container-high;
    visible: root.label != "";

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label;
        color: root.selected ? Theme.on-primary : Theme.text;
        font-size: root.label.character-count > 1 ? 12px : 15px;
        font-weight: root.selected ? 600 : 500;
    }
}

/* Title and value on the first line, slider on its own second line. */
component QmSliderRow inherits Rectangle {
    in property <string> title: "";
    in property <string> value: "";
    in property <float> fraction: 0.0;
    in property <bool> show-slider: true;
    in property <bool> selected: false;

    property <length> line-height: root.show-slider ? root.height - 26px : root.height;

    border-radius: Shape.medium;
    background: root.selected ? Theme.secondary-container : Theme.surface-container-low;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.primary : Theme.surface-container-low;

    value-text := MarqueeText {
        width: root.value == "" ? 0px : min(self.content-width + 4px, parent.width * 0.58);
        x: parent.width - 12px - self.width;
        y: root.show-slider ? 4px : 0px;
        height: root.line-height;
        label: root.value;
        text-color: root.selected ? Theme.on-secondary-container : Theme.text-dim;
        text-size: 14px;
        text-weight: 500;
        align-right: true;
        active: root.selected;
        visible: root.value != "";
    }

    MarqueeText {
        x: 12px;
        y: root.show-slider ? 4px : 0px;
        width: root.value == "" ? parent.width - 24px : max(0px, value-text.x - 22px);
        height: root.line-height;
        label: root.title;
        text-color: root.selected ? Theme.text : #d0d3d8;
        text-size: 17px;
        text-weight: root.selected ? 600 : 500;
        active: root.selected;
    }

    MaterialSlider {
        x: 12px;
        y: parent.height - 24px;
        width: parent.width - 24px;
        fraction: root.fraction;
        visible: root.show-slider;
    }
}

/* Power OSD choice (Restart / Power Off): pill, error roles while armed. */
component PowerChoice inherits Rectangle {
    in property <string> label;
    in property <string> prompt;
    in property <bool> selected: false;
    in property <bool> armed: false;

    background: root.armed ? Theme.error-container
        : root.selected ? Theme.secondary-container : Theme.surface-container-highest;
    border-radius: self.height / 2;
    border-width: root.armed || root.selected ? 3px : 0px;
    border-color: root.armed ? Theme.error : Theme.primary;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        spacing: 1px;
        MarqueeText {
            height: 23px;
            label: root.label;
            text-color: root.armed ? Theme.on-error-container : Theme.text;
            text-size: 18px;
            text-weight: 600;
            align-center: true;
            active: root.selected;
        }
        if root.armed: MarqueeText {
            height: 16px;
            label: root.prompt;
            text-color: Theme.on-error-container;
            text-size: 12px;
            text-weight: 500;
            align-center: true;
        }
    }
}

export component QuickMenuWindow inherits Window {
    in-out property <[string]> i18n-strings: ["Recently Played", "Systems & Collections", "Copy your games to the roms folder on the SD card, one folder per system.", "Settings", "General", "Connectivity", "Controllers & Input", "Display & Audio", "System", "Connect to Wi-Fi", "Saved Networks", "Connect New Device", "My Devices", "Player Assignment", "Controllers", "Input Tester", "Controller Mapping", "Internal Rumble", "RGB Lighting", "Storage", "System Information", "Restore Defaults", "Profiles, language and time", "Scanning nearby networks…", "Refreshing nearby networks…", "Choose a network or add a hidden network", "Saved device-global Wi-Fi networks", "Password is hidden while typing", "Controller or physical keyboard", "Scanning nearby Bluetooth devices…", "Choose a nearby Bluetooth device", "Paired and connected Bluetooth devices", "Preferred slots are compacted when a controller is unavailable", "Available built-in, USB and Bluetooth controllers", "All buttons and axes • Hotkey + Start to exit", "Press the new button now…", "Select an action to remap", "User preference for the internal console rumble", "Screen Reactive • follows compositor color feed", "User RGB baseline and system effects", "Device-global user storage", "Live read-only device information", "Reset System settings without deleting user content", "Sections", "User & Profile", "Language & Region", "Date & Time", "Rumble & RGB", "Updates & Recovery", "SYSTEM", "Performance Profile", "Battery Saver", "Auto", "Automatic Battery Saver", "Off", "Screensaver After", "Sleep After", "After screensaver", "Power Off", "After Sleep • RTC wake unavailable", "After Sleep", "After Screensaver", "Active Storage", "User Data", "SD2", "Not inserted", "Ready", "Available", "Not yet managed by nuubOS", "Automatic Backup", "Daily", "Weekly", "Monthly", "Backup completed", "Backup due", "Clock unavailable", "Clock check needed", "Move User Data to SD1", "Use SD2 for User Data", "Move User Data to SD2", "Working…", "Insert SD2", "Confirm", "Erase & migrate", "Sync & switch", "Activate", "Press again • SD2 will be erased", "Press again • sync & switch to SD1", "Back Up Now", "Requires active SD2", "Storage Job", "Running", "Completed", "Failed", "Idle", "Move to SD2", "Move to SD1", "Back Up to SD1", "Device", "Kernel", "Battery", "CPU", "GPU", "Network", "RAM", "Uptime", "Restores power, display, audio, backup and controller mapping settings to their defaults.", "Games, BIOS, saves, users and network settings are kept.", "Press again to reset system settings", "Reset System Settings", "CONTROLLERS & INPUT", "P1–P8", "Enabled", "Disabled", "Solid", "Breathing", "Orbit", "Aurora", "Spectrum", "Battery Level", "Console Colors", "Speed", "Automatic", "Left Stick Deadzone", "Right Stick Deadzone", "Test Rumble", "Effect", "Brightness", "Color", "SYSTEM SIGNALS", "LIGHTING", "DISPLAY & AUDIO", "Internal display inactive", "Audio Output", "Volume", "Applications", "System Sounds", "Navigation Sounds", "Power Sounds", "Home Music", "Test Sound", "Stop", "Play", "Color Temperature", "Slow", "Normal", "Fast", "Startup & Sleep", "Connections", "Games", "Tasks", "Welcome, sleep, wake and power off", "Low battery, charging and full charge", "Controllers, headphones, Wi-Fi and USB drives", "Save states, screenshots and errors", "Downloads, backups and failures", "WI-FI", "Wi-Fi", "Connect", "Not connected", "BLUETOOTH", "Bluetooth", "Add Hidden Network", "Scanning…", "Searching for nearby networks…", "No saved Wi-Fi networks", "No new Bluetooth devices found", "No paired Bluetooth devices", "Pair & Connect", "Disconnect", "Forget Device", "Pair with PIN", "Password", "None", "Change", "IPv4", "Manual", "Address", "Subnet Mask", "Gateway", "DNS", "Apply Changes", "Forget Network", "Small System. Big Adventures.", "Navigate", "Select", "Back", "Menu", "POWER MENU", "Sleep", "Restart", "Press again to confirm", "Profile", "Language", "Mood", "Default mood", "Current user", "Interface languag