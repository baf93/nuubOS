#!/bin/sh
#
# Lifecycle hook for Product Lighting: sleep | wake | shutdown.
# nuubos-lightingd keeps the lifecycle phase in memory (nothing is
# persisted), so an interrupted suspend or a power loss leaves no stale
# state behind. "sleep" returns once the LEDs are dark.

ACTION="${1:-}"
# nuubOS 0.5 saved the brightness here while asleep; no longer used.
LEGACY=/state/config/nuubos-lifecycle-lighting-restore

case "$ACTION" in
    sleep|wake|shutdown) ;;
    *)
        echo "nuubOS lifecycle lighting: invalid action '$ACTION'" >&2
        exit 2
        ;;
esac

rm -f "$LEGACY"
command -v dbus-send >/dev/null 2>&1 || exit 1
dbus-send --system --print-reply --reply-timeout=1500 \
    --dest=org.nuubOS.Lighting /org/nuubOS/Lighting \
    org.nuubOS.Lighting1.Lifecycle "string:$ACTION" >/dev/null 2>&1
