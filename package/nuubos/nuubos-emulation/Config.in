config BR2_PACKAGE_NUUBOS_EMULATION
	bool "nuubOS emulation service"
	depends on BR2_INSTALL_LIBSTDCPP # retroarch
	depends on BR2_TOOLCHAIN_HAS_THREADS # retroarch
	depends on BR2_PACKAGE_HAS_LIBEGL # retroarch
	depends on BR2_PACKAGE_HAS_LIBGLES # retroarch
	depends on BR2_PACKAGE_WAYLAND # retroarch
	select BR2_PACKAGE_NUUBOS_NOTIFY
	select BR2_PACKAGE_NUUBOS_LIBRARY
	select BR2_PACKAGE_RETROARCH
	select BR2_PACKAGE_RETROARCH_ASSETS
	select BR2_PACKAGE_LIBRETRO_CORE_INFO
	# Default core matrix qualified for H700 (cores.conf). Other
	# cores can be downloaded by the user from RetroArch.
	select BR2_PACKAGE_LIBRETRO_FCEUMM
	select BR2_PACKAGE_LIBRETRO_SNES9X
	select BR2_PACKAGE_LIBRETRO_GAMBATTE
	select BR2_PACKAGE_LIBRETRO_MGBA
	select BR2_PACKAGE_LIBRETRO_PCSX_REARMED
	select BR2_PACKAGE_LIBRETRO_GENESIS_PLUS_GX
	select BR2_PACKAGE_LIBRETRO_PICODRIVE
	select BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST
	select BR2_PACKAGE_LIBRETRO_FBNEO
	select BR2_PACKAGE_LIBRETRO_BEETLE_NGP
	select BR2_PACKAGE_LIBRETRO_BEETLE_WSWAN
	select BR2_PACKAGE_LIBRETRO_BEETLE_VB
	select BR2_PACKAGE_LIBRETRO_HANDY
	select BR2_PACKAGE_LIBRETRO_STELLA2014
	select BR2_PACKAGE_LIBRETRO_FAKE08
	# Demanding systems: part of their library runs on H700.
	select BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT
	select BR2_PACKAGE_LIBRETRO_MELONDS
	select BR2_PACKAGE_LIBRETRO_YABASANSHIRO
	select BR2_PACKAGE_LIBRETRO_FLYCAST
	select BR2_PACKAGE_LIBRETRO_PPSSPP
	# Computers and engines.
	select BR2_PACKAGE_LIBRETRO_VICE
	select BR2_PACKAGE_LIBRETRO_PUAE
	select BR2_PACKAGE_LIBRETRO_SCUMMVM
	select BR2_PACKAGE_LIBRETRO_DOSBOX_PURE
	# Further consoles, computers and handhelds.
	select BR2_PACKAGE_LIBRETRO_CAP32
	select BR2_PACKAGE_LIBRETRO_A5200
	select BR2_PACKAGE_LIBRETRO_PROSYSTEM
	select BR2_PACKAGE_LIBRETRO_ATARI800
	select BR2_PACKAGE_LIBRETRO_HATARI
	select BR2_PACKAGE_EMUTOS
	select BR2_PACKAGE_LIBRETRO_FREECHAF
	select BR2_PACKAGE_LIBRETRO_GEARCOLECO
	select BR2_PACKAGE_LIBRETRO_POTATOR
	select BR2_PACKAGE_LIBRETRO_SAMEDUCK
	select BR2_PACKAGE_LIBRETRO_GEOLITH
	select BR2_PACKAGE_LIBRETRO_FREEINTV
	select BR2_PACKAGE_LIBRETRO_LUTRO
	select BR2_PACKAGE_LIBRETRO_MINIVMAC
	select BR2_PACKAGE_LIBRETRO_MAME2003_PLUS
	select BR2_PACKAGE_LIBRETRO_BLUEMSX
	select BR2_PACKAGE_LIBRETRO_NEOCD
	select BR2_PACKAGE_LIBRETRO_O2EM
	select BR2_PACKAGE_LIBRETRO_MU
	select BR2_PACKAGE_LIBRETRO_QUASI88
	select BR2_PACKAGE_LIBRETRO_NP2KAI
	select BR2_PACKAGE_LIBRETRO_POKEMINI
	select BR2_PACKAGE_LIBRETRO_SIMCOUPE
	select BR2_PACKAGE_LIBRETRO_VECX
	select BR2_PACKAGE_LIBRETRO_XMIL
	select BR2_PACKAGE_LIBRETRO_PX68K
	select BR2_PACKAGE_LIBRETRO_FUSE
	select BR2_PACKAGE_LIBRETRO_TIC80
	select BR2_PACKAGE_LIBRETRO_MAME
	help
	  Emulation service (EPIC-013, EPIC-019, EPIC-020): launches
	  Library games in RetroArch with nuubOS-managed per-user
	  configuration, owns the running game session (pause, save/load
	  state, slots, reset, quit, RetroArch Advanced) and reports
	  sessions to the Game Library.
