#!/bin/sh
# nuubOS BIOS Manager (EPIC-033).
#
#   nuubos-biosctl status [SYSTEM]
#
# Requirements come from the qualified emulator configuration, never from a
# hand-copied list: for every system in cores.conf, the firmware entries of
# the core nuubOS launches (first bundled, else downloaded core) in its
# libretro core-info file, with the MD5 references those files publish.
# MAME machine systems need their machine ROM set (mame/bios/<machine>.zip).
# BIOS files are shared by every user in /userdata/bios; nuubOS never
# ships or downloads them.
#
# Output (tab separated):
#   system=<id> <name> <core> <ready|missing|optional|invalid> <present> <total>
#   file=<id> <path> <required 0|1> <ok|missing|invalid|unverified> <description>
#   end=1
# "optional": the core runs without firmware (HLE) but can use it.

R="${NUUBOS_ROOT:-}"
CORES_CONF="$R/usr/share/nuubos/emulation/cores.conf"
SYSTEMS_CONF="$R/usr/share/nuubos/systems.conf"
INFO_DIR="$R/usr/share/libretro/info"
BUNDLED="$R/usr/lib/libretro"
DOWNLOADED="$R/userdata/retroarch/cores"
BIOS_DIR="$R/userdata/bios"
BIOS_CONF="$R/usr/share/nuubos/emulation/bios.conf"
ONLY="${2:-}"

[ "${1:-}" = status ] || { echo "Usage: nuubos-biosctl status [SYSTEM]" >&2; exit 2; }

system_name()
{
    awk -F'|' -v id="$1" '$1 == id { print $2; exit }' "$SYSTEMS_CONF" 2>/dev/null
}

effective_core()
{
    # $1: comma separated cores in preference order
    for root in "$BUNDLED" "$DOWNLOADED"; do
        for c in $(printf '%s' "$1" | tr ',' ' '); do
            if [ -f "$root/${c}_libretro.so" ]; then
                echo "$c"
                return 0
            fi
        done
    done
    return 1
}

# Lines "<path>\t<opt>\t<md5>\t<desc>" from a core-info file.
firmware_of()
{
    info="$INFO_DIR/$1_libretro.info"
    [ -f "$info" ] || return 0
    awk '
        function val(s) { sub(/^[^=]*=[ \t]*"?/, "", s); sub(/"[ \t]*$/, "", s); return s }
        /^firmware[0-9]+_path/ { n = $0; sub(/^firmware/, "", n); sub(/_.*/, "", n); path[n] = val($0) }
        /^firmware[0-9]+_opt/  { n = $0; sub(/^firmware/, "", n); sub(/_.*/, "", n); opt[n] = val($0) }
        /^firmware[0-9]+_desc/ { n = $0; sub(/^firmware/, "", n); sub(/_.*/, "", n); desc[n] = val($0) }
        /^notes/ {
            s = val($0); k = split(s, part, "|")
            for (i = 1; i <= k; i++)
                if (match(part[i], /\(md5\): [0-9a-fA-F]+/)) {
                    f = part[i]; sub(/^\(!\) */, "", f); sub(/ \(md5\).*/, "", f)
                    h = substr(part[i], RSTART + 7, RLENGTH - 7)
                    md5[f] = tolower(h)
                }
        }
        END {
            for (n in path) {
                p = path[n]; b = p; sub(/.*\//, "", b)
                m = (p in md5) ? md5[p] : ((b in md5) ? md5[b] : "")
                printf "%s\t%s\t%s\t%s\n", p, (opt[n] == "true" ? 1 : 0), m, desc[n]
            }
        }' "$info" | sort
}

file_state()
{
    # $1 path, $2 expected md5 (may be empty)
    f="$BIOS_DIR/$1"
    if [ ! -f "$f" ]; then
        echo missing
    elif [ -z "$2" ]; then
        echo unverified
    elif [ "$(md5sum "$f" 2>/dev/null | cut -d' ' -f1)" = "$2" ]; then
        echo ok
    else
        echo invalid
    fi
}

US="$(printf '\037')"

# Curated "<mode>|<files>" of a system, empty when not curated.
curated()
{
    awk -F'|' -v id="$1" '$1 == id { print $2 "|" $3; exit }' "$BIOS_CONF" 2>/dev/null
}

# Entries "<path>US<required>US<md5>US<desc>" for a system.
entries_for()
{
    # $1 system, $2 core, $3 mode, $4 files, $5 machine
    if [ -n "$5" ]; then
        printf 'mame/bios/%s.zip%s1%s%s%s ROM set\n' "$5" "$US" "$US" "$US" "$5"
        return
    fi
    firmware_of "$2" | awk -F'\t' -v us="$US" -v mode="$3" -v files="$4" '
        BEGIN { n = split(files, want, ","); for (i = 1; i <= n; i++) listed[want[i]] = 1 }
        {
            if (mode != "" && !($1 in listed)) next
            req = mode == "required" || mode == "any" ? 1 : mode == "optional" ? 0 : ($2 == 1 ? 0 : 1)
            seen[$1] = 1
            printf "%s%s%d%s%s%s%s\n", $1, us, req, us, $3, us, $4
        }
        END {
            for (i = 1; i <= n; i++)
                if (mode != "" && !(want[i] in seen))
                    printf "%s%s%d%s%s%s%s\n", want[i], us,
                        (mode == "optional" ? 0 : 1), us, "", us, want[i]
        }' | sort
}

grep -v '^[[:space:]]*#' "$CORES_CONF" 2>/dev/null | while IFS='|' read -r sys cores machine media; do
    [ -n "$sys" ] || continue
    [ -z "$ONLY" ] || [ "$ONLY" = "$sys" ] || continue
    core="$(effective_core "$cores")" || continue
    cur="$(curated "$sys")"
    mode="${cur%%|*}"
    files="${cur#*|}"
    [ "$mode" = none ] && continue
    [ -n "$machine" ] && mode=required
    name="$(system_name "$sys")"
    [ -n "$name" ] || name="$sys"

    entries="$(entries_for "$sys" "$core" "$mode" "$files" "$machine")"
    [ -n "$entries" ] || continue

    total=0; present=0; req_total=0; req_ok=0; bad=0; opt_present=0
    out=""
    while IFS="$US" read -r path req md5 desc; do
        [ -n "$path" ] || continue
        st="$(file_state "$path" "$md5")"
        total=$((total + 1))
        [ "$req" = 1 ] && req_total=$((req_total + 1))
        case "$st" in
            ok|unverified)
                present=$((present + 1))
                if [ "$req" = 1 ]; then req_ok=$((req_ok + 1)); else opt_present=$((opt_present + 1)); fi ;;
            invalid) bad=$((bad + 1)) ;;
        esac
        out="${out}file=${sys}	${path}	${req}	${st}	${desc}
"
    done <<EOT
$entries
EOT

    if [ "$mode" = any ]; then
        # Variants: one valid file is enough.
        if [ "$req_ok" -gt 0 ]; then state=ready
        elif [ "$bad" -gt 0 ]; then state=invalid
        else state=missing; fi
    elif [ "$req_total" -gt 0 ]; then
        if [ "$req_ok" -eq "$req_total" ]; then state=ready
        elif [ "$bad" -gt 0 ]; then state=invalid
        else state=missing; fi
    elif [ "$opt_present" -gt 0 ]; then
        state=ready
    else
        state=optional
    fi
    printf 'system=%s\t%s\t%s\t%s\t%s\t%s\n' "$sys" "$name" "$core" "$state" "$present" "$total"
    printf '%s' "$out"
done
echo "end=1"
