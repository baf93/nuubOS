#!/bin/sh

DAEMON=/usr/sbin/nuubos-statusd
PIDFILE=/run/nuubos/statusd.pid
SOCKET=/run/nuubos/statusd.sock
STATE=/run/nuubos/statusd.state
WPA_ACTION=/usr/libexec/nuubos-status-wifi-event
WPA_PIDFILE=/run/nuubos/status-wpa.pid
TIME_SYNC=/usr/libexec/nuubos-status-time-sync

pid_command()
{
    PID="$1"
    [ -n "$PID" ] || return 1
    [ -r "/proc/$PID/cmdline" ] || return 1
    tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p'
}

statusd_running()
{
    [ -r "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null)"
    [ "$(pid_command "$PID")" = "$DAEMON" ]
}

stop_wpa_listener()
{
    if [ ! -r "$WPA_PIDFILE" ]; then
        return 0
    fi

    PID="$(cat "$WPA_PIDFILE" 2>/dev/null)"
    CMD="$(pid_command "$PID")"
    case "$CMD" in
        */wpa_cli|wpa_cli)
            kill -TERM "$PID" 2>/dev/null || true
            ;;
    esac
    rm -f "$WPA_PIDFILE"
}

start_wpa_listener()
{
    stop_wpa_listener

    if ! command -v wpa_cli >/dev/null 2>&1; then
        return 0
    fi

    if [ ! -d /sys/class/net/wlan0 ]; then
        return 0
    fi

    wpa_cli -B -i wlan0 -a "$WPA_ACTION" -P "$WPA_PIDFILE" \
        >/dev/null 2>&1 || true
}

request_time_sync()
{
    [ -x "$TIME_SYNC" ] || return 0
    "$TIME_SYNC" online >/dev/null 2>&1 &
}

start_service()
{
    mkdir -p /run/nuubos

    if statusd_running; then
        start_wpa_listener
        request_time_sync
        return 0
    fi

    rm -f "$PIDFILE" "$SOCKET" "$STATE"
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON"
    RC=$?
    if [ "$RC" -ne 0 ]; then
        echo "nuubOS status: failed to start statusd" >&2
        return "$RC"
    fi

    start_wpa_listener
    request_time_sync
    return 0
}

stop_service()
{
    stop_wpa_listener

    if statusd_running; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"
        kill -TERM "$PID" 2>/dev/null || true
    fi

    rm -f "$PIDFILE" "$SOCKET" "$STATE"
    return 0
}

case "${1:-}" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service
        start_service
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac

exit 0
