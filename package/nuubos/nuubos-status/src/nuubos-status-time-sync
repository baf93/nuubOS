#!/bin/sh
#
# Automatic network time (only with Automatic Time on; a manual date/time
# turns it off). No argument: the hourly/boot check, syncs when the last
# sync is 6 h old or more. "online": the device just came online (Wi-Fi
# connected, boot): waits up to 30 s for a default route and working DNS
# (right after CONNECTED the old lease/route may still be there) and syncs
# unless the last sync is less than 10 min old (reconnect flapping).

MODE="${1:-}"
VALID_AFTER=1577836800
LOCKDIR=/run/nuubos/status-time-sync.lock
LOG=/run/nuubos/status-time-sync.log
STATUS_PIDFILE=/run/nuubos/statusd.pid
STATUS_DAEMON=/usr/sbin/nuubos-statusd

pid_command()
{
    PID="$1"
    [ -n "$PID" ] || return 1
    [ -r "/proc/$PID/cmdline" ] || return 1
    tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null | sed -n '1p'
}

clock_valid()
{
    NOW="$(date +%s 2>/dev/null)"
    case "$NOW" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$NOW" -ge "$VALID_AFTER" ]
}

automatic_time_enabled()
{
    CFG=/state/config/regional.conf
    [ -r "$CFG" ] || return 0
    VALUE="$(sed -n 's/^AUTOMATIC_TIME=//p' "$CFG" | tail -1)"
    [ "$VALUE" != "0" ]
}

last_sync_recent()
{
    WINDOW="$1"
    FILE=/state/time/last-sync
    [ -r "$FILE" ] || return 1
    LAST="$(sed -n 's/^LAST_NTP_SYNC=//p' "$FILE" | tail -1)"
    NOW="$(date +%s 2>/dev/null)"
    case "$LAST:$NOW" in *[!0-9:]*|:*) return 1 ;; esac
    [ $((NOW - LAST)) -lt "$WINDOW" ]
}

wifi_connected()
{
    command -v wpa_cli >/dev/null 2>&1 || return 1
    wpa_cli -i wlan0 status 2>/dev/null | grep -qx 'wpa_state=COMPLETED'
}

signal_statusd()
{
    [ -r "$STATUS_PIDFILE" ] || return 0
    PID="$(cat "$STATUS_PIDFILE" 2>/dev/null)"
    if [ "$(pid_command "$PID")" = "$STATUS_DAEMON" ]; then
        kill -USR1 "$PID" 2>/dev/null || true
    fi
}

mkdir -p /run/nuubos

automatic_time_enabled || exit 0

if [ "$MODE" = online ]; then
    WINDOW=600
else
    WINDOW=21600
fi

if clock_valid && last_sync_recent "$WINDOW"; then
    signal_statusd
    exit 0
fi

if [ "$MODE" = online ]; then
    TRIES=30
    while ! ip route 2>/dev/null | grep -q '^default ' ||
          ! nslookup pool.ntp.org >/dev/null 2>&1; do
        TRIES=$((TRIES - 1))
        [ "$TRIES" -gt 0 ] || exit 0
        sleep 1
    done
fi

wifi_connected || exit 0
command -v nuubos-timectl >/dev/null 2>&1 || exit 0

if ! mkdir "$LOCKDIR" 2>/dev/null; then
    exit 0
fi

cleanup()
{
    rmdir "$LOCKDIR" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

{
    echo "time-sync-start=$(date +%s 2>/dev/null || echo 0) mode=${MODE:-periodic}"
    /usr/sbin/nuubos-timectl sync
    RC=$?
    echo "time-sync-rc=$RC"
} >> "$LOG" 2>&1

if clock_valid; then
    signal_statusd
fi

exit 0
