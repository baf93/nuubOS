config BR2_PACKAGE_NUUBOS_WEB
	bool "nuubos-web"
	depends on BR2_PACKAGE_WPEWEBKIT_ARCH_SUPPORTS
	depends on BR2_INSTALL_LIBSTDCPP # wpewebkit
	depends on BR2_PACKAGE_HAS_LIBEGL # wpewebkit
	depends on BR2_PACKAGE_HAS_LIBGLES # wpewebkit
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11 # wpewebkit
	depends on BR2_USE_WCHAR # wpewebkit
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL # wpewebkit
	depends on !BR2_STATIC_LIBS # wpewebkit
	select BR2_PACKAGE_NUUBOS_NOTIFY
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_WPEWEBKIT
	select BR2_PACKAGE_WPEWEBKIT_SANDBOX
	select BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA
	select BR2_PACKAGE_COG
	select BR2_PACKAGE_COG_PLATFORM_FDO
	select BR2_PACKAGE_COG_USE_SYSTEM_DBUS
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_V4L2CODECS # Cedrus
	select BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL
	select BR2_PACKAGE_CA_CERTIFICATES # HTTPS
	help
	  EPIC-030 Web Mode: an optional controller-friendly browser.
	  nuubos-webd runs WPE WebKit through Cog (Wayland, GLES,
	  WebKit bubblewrap sandbox) as one session with a per-user
	  profile; nuubos-inputd turns the controller into keyboard and
	  pointer for it and the Quick Menu provides text entry through
	  the Wayland input-method protocol.
